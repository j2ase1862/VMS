<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <!--
      커스텀 UI(WixUI_VmsInstall)는 표준 다이얼로그 문자열을 UI.wixext 의
      로컬라이제이션에서 가져온다 — Cultures 미지정 시 en-US 로 링크되므로
      한국어(ko-KR)를 명시해야 설치 마법사 문구가 한글로 나온다.
      Firewall 확장은 ko-KR 문자열이 없어 FirewallStrings.ko-KR.wxl 로 보충.
    -->
    <Cultures>ko-KR</Cultures>
    <!--
      Directory.Build.props 의 $(Version) 을 WiX preprocessor 변수로 전달.
      Package.wxs 가 $(var.BuildVersion) 으로 참조 → MSI/Assembly 버전 동기화.
      MSI 는 4 부분(major.minor.build.revision) 형식 요구하므로 누락 시 .0 보강.
    -->
    <BuildVersionFull Condition=" '$(Version)' != '' AND !$(Version.Contains('.')) ">$(Version).0.0.0</BuildVersionFull>
    <BuildVersionFull Condition=" '$(Version)' != '' AND $(Version.Split('.').Length) == 2 ">$(Version).0.0</BuildVersionFull>
    <BuildVersionFull Condition=" '$(Version)' != '' AND $(Version.Split('.').Length) == 3 ">$(Version).0</BuildVersionFull>
    <BuildVersionFull Condition=" '$(BuildVersionFull)' == '' ">$(Version)</BuildVersionFull>
    <DefineConstants>$(DefineConstants);BuildVersion=$(BuildVersionFull)</DefineConstants>
    <!--
      MSI 파일명에 버전 명시 (VMS-1.4.6.msi) — GitHub 릴리즈 자산 명명과 동일.
      현장에서 USB/다운로드 파일만 보고 버전을 식별할 수 있도록.
    -->
    <OutputName>VMS-$(Version)</OutputName>
    <!--
      BODA.VMS.Web 동봉 (선택적): tools/stage-web-payload.ps1 이 WebPayload/ 에
      self-contained publish 산출물을 채워 두면 WebServer Feature 가 컴파일된다.
      CI 는 Web 리포(별도 프라이빗) 접근 불가 → payload 없이도 빌드 성공 (경고만).
      릴리즈 MSI 는 반드시 payload 포함 빌드여야 한다 — release_manual_procedure 참조.
    -->
    <WebPayloadDir>$(MSBuildProjectDirectory)\WebPayload\</WebPayloadDir>
    <HasWebPayload Condition="Exists('$(WebPayloadDir)BODA.VMS.Web.exe')">true</HasWebPayload>
    <DefineConstants Condition="'$(HasWebPayload)' == 'true'">$(DefineConstants);WebPayloadDir=$(WebPayloadDir)</DefineConstants>
  </PropertyGroup>

  <!-- Cultures 지정 시 WiX SDK 가 산출물을 bin\Release\ko-KR\ 하위로 내린다.
       릴리즈 절차(release_manual_procedure)·CI(build.yml)가 bin\Release\*.msi 를
       참조하므로 루트로 옮겨 기존 경로 계약을 유지한다. -->
  <Target Name="FlattenCultureOutput" AfterTargets="Build">
    <ItemGroup>
      <CultureOutput Include="$(OutputPath)ko-KR\*.msi" />
    </ItemGroup>
    <Move SourceFiles="@(CultureOutput)" DestinationFolder="$(OutputPath)" Condition="'@(CultureOutput)' != ''" />
  </Target>

  <Target Name="WarnNoWebPayload" BeforeTargets="CoreCompile" Condition="'$(HasWebPayload)' != 'true'">
    <Warning Text="WebPayload 없음 — Web 서버 미포함 MSI (CI/개발 빌드 전용). 릴리즈 빌드는 tools/stage-web-payload.ps1 을 먼저 실행하세요." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VMS\VMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
