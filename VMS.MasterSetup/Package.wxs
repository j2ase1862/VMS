<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="BODA Vision System"
           Manufacturer="VASIM"
           Version="$(var.BuildVersion)"
           UpgradeCode="A70E988A-739F-4CDC-BE08-EBFE03DACA32"
           Codepage="949"
           Language="1042">

    <MajorUpgrade DowngradeErrorMessage="최신 버전이 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="BODA Vision System" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuShortcutComp" />
      <ComponentRef Id="StartMenuAppSetupShortcutComp" />
      <ComponentRef Id="StartMenuVisionSetupShortcutComp" />
    </Feature>

<?ifndef ExcludeAiTools ?>
    <!-- AI 학습 도구 (VMS.DeepLearning 라벨링·학습 앱 + scripts\ 파이썬 학습 스크립트) — 선택 Feature.
         검사 런타임(VMS·VisionSetup 의 Detection/Classify/Anomaly/OCR 추론 도구)은 Main 에 남고,
         "모델을 만드는" 기능만 여기로 분리한다. 파이썬·GPU 환경이 있는 학습 PC 에서만 필요.
         기본값은 "제외" (2026-09-10, 라벨링·학습이 MLOps 플랫폼으로 옮겨 가면서 전환) — INSTALLWEB 과 반대다.
         포함 경로:
           · 설치 마법사 "설치 구성 선택" 화면의 체크 (INSTALLAITOOLS=1)
           · 무인 설치: msiexec /i VMS-x.y.z.msi INSTALLAITOOLS=1
         업그레이드: 이전 설치가 AiTools 를 포함했으면 그 선택을 기억한다 — Feature 안의 레지스트리 마커
         (HKLM\Software\VASIM\BODA Vision System\AiToolsInstalled=1) 를 AppSearch 로 읽어 속성을 미리 채우므로,
         인앱 업데이트/무인 업그레이드에서 학습 PC 의 도구가 조용히 사라지지 않는다. 체크를 해제하고 업그레이드하면
         마커 컴포넌트가 함께 제거되어 다음부터는 기억하지 않는다.
         GS 인증 제출 빌드: dotnet build VMS.MasterSetup.wixproj -p:ExcludeAiTools=true
             → 이 Feature 자체가 컴파일되지 않아 MSI 에 파일이 아예 없다 (산출물 VMS-x.y.z-cert.msi). -->
    <Property Id="INSTALLAITOOLS" Secure="yes">
      <RegistrySearch Id="AiToolsPrevChoice" Root="HKLM" Key="Software\VASIM\BODA Vision System"
                      Name="AiToolsInstalled" Type="raw" />
    </Property>
    <!-- 마커가 없던 옛 버전(v1.33 이하)에서 올라오는 첫 업그레이드 폴백: 기본 설치 폴더에 VMS.DeepLearning.exe 가
         이미 있으면 "이전에 포함했던 PC" 로 보고 INSTALLAITOOLS=1 로 채운다. 이것이 없으면 학습 PC 의 인앱(무인) 업데이트가
         도구를 조용히 지운다. 사용자 지정 폴더에 설치한 PC 는 이 폴백이 닿지 않으므로 첫 업그레이드는 MSI 수동 실행으로 체크 확인. -->
    <Property Id="AITOOLS_PREVFILE" Secure="yes">
      <DirectorySearch Id="AiToolsPrevDir" Path="[ProgramFilesFolder]VASIM\BODA Vision System" Depth="0">
        <FileSearch Id="AiToolsPrevExe" Name="VMS.DeepLearning.exe" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="INSTALLAITOOLS" Value="1" After="AppSearch" Sequence="both"
                 Condition="AITOOLS_PREVFILE AND NOT INSTALLAITOOLS" />
    <Feature Id="AiTools" Title="AI 학습 도구 (VMS.DeepLearning)" Level="1" AllowAbsent="yes">
      <Level Value="0" Condition="INSTALLAITOOLS=0 OR NOT INSTALLAITOOLS" />
      <ComponentGroupRef Id="AiToolsAppFiles" />
      <ComponentGroupRef Id="AiToolsScriptFiles" />
      <ComponentRef Id="AiToolsMarkerComp" />
    </Feature>
<?endif?>

<?ifdef WebPayloadDir ?>
    <!-- BODA.VMS.Web 동봉 (릴리즈 빌드 전용 — tools/stage-web-payload.ps1 이
         WebPayload/ 를 채웠을 때만 컴파일됨. CI 는 Web 리포 접근 불가라 이 Feature 없이 빌드).
         서비스는 등록만 하고 시작하지 않는다 — 초기 구성(admin 비밀번호·Jwt:Key) 은
         AppSetup 마법사가 담당하며, 구성 전에는 앱이 스스로 부팅을 거부한다.
         제외 경로 2가지 — 같은 INSTALLWEB 속성 공유:
           · 설치 마법사 "설치 구성 선택" 화면의 체크 해제 (WebOptionDlg — 해제 시 속성 제거)
           · 무인 설치: msiexec /i VMS-x.y.z.msi INSTALLWEB=0
         기본값 1(Property) 이라 UI 없는 설치도 기본은 포함. -->
    <Property Id="INSTALLWEB" Value="1" Secure="yes" />
    <Feature Id="WebServer" Title="BODA VMS Web 서버" Level="1" AllowAbsent="yes">
      <Level Value="0" Condition="INSTALLWEB=0 OR NOT INSTALLWEB" />
      <ComponentGroupRef Id="WebFiles" />
      <ComponentRef Id="WebServiceComp" />
    </Feature>
<?endif?>

    <!-- 커스텀 다이얼로그 세트 (WixUI_VmsInstall.wxs) — 라이선스 화면 없는
         WixUI_InstallDir 변형 + VASIM 브랜딩 비트맵. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_VmsInstall" />
    <WixVariable Id="WixUIBannerBmp" Value="Resources\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Resources\dialog.bmp" />

  </Package>

  <!-- Directory Structure -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VASIM\BODA Vision System" />
    </StandardDirectory>
  </Fragment>

  <!-- Application Files: harvest all files from VMS build output -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.VMS.TargetDir)**">
        <!-- AI 학습 도구는 AiTools Feature 로 분리 (ExcludeAiTools 빌드에서는 어디에도 포함되지 않음) -->
        <Exclude Files="$(var.VMS.TargetDir)VMS.DeepLearning.*" />
        <Exclude Files="$(var.VMS.TargetDir)scripts\**" />
        <!-- 개발 PC 빌드 출력에 남은 stale publish 산출물(win-x64\, 2026-06-01 self-contained 실험 잔재 1.3GB)이
             MSI 에 수확되던 사고 방어 (v1.25.0~v1.30.0 MSI 에 포함돼 있었음). RID 출력은 루트로 오므로 win-x64\ 는 항상 잔재. -->
        <Exclude Files="$(var.VMS.TargetDir)win-x64\**" />
      </Files>
    </ComponentGroup>
  </Fragment>

<?ifndef ExcludeAiTools ?>
  <!-- AI 학습 도구 설치 마커 — 업그레이드 때 "이전에 포함했었는지" 를 기억하는 값 (Package 의 INSTALLAITOOLS RegistrySearch 가 읽음).
       Feature 와 함께 설치/제거되므로 값이 있다는 것 = 지금 도구가 설치돼 있다는 뜻. -->
  <Fragment>
    <Component Id="AiToolsMarkerComp" Directory="INSTALLFOLDER" Guid="6B1F1E2A-3C4D-4E5F-9A0B-1C2D3E4F5A61">
      <RegistryValue Root="HKLM" Key="Software\VASIM\BODA Vision System"
                     Name="AiToolsInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- AI 학습 도구 파일: 앱 4개 파일(exe/dll/deps/runtimeconfig) + scripts\*.py (train_dfine/yolo/classifier/anomaly/ppocr, export_mobile_sam) -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="ScriptsFolder" Name="scripts" />
    </DirectoryRef>

    <ComponentGroup Id="AiToolsAppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.VMS.TargetDir)VMS.DeepLearning.*" />
    </ComponentGroup>

    <ComponentGroup Id="AiToolsScriptFiles" Directory="ScriptsFolder">
      <Files Include="$(var.VMS.TargetDir)scripts\**" />
    </ComponentGroup>
  </Fragment>
<?endif?>

  <!-- Desktop Shortcut -->
  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComp">
        <Shortcut Id="DesktopShortcut"
                  Name="VMS 실행"
                  Target="[INSTALLFOLDER]VMS.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\VASIM\BODA Vision System"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <!-- Start Menu Shortcut -->
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="VASIM">
        <Component Id="StartMenuShortcutComp">
          <Shortcut Id="StartMenuShortcut"
                    Name="BODA Vision System"
                    Target="[INSTALLFOLDER]VMS.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <!-- AppSetup 은 설치/업데이트 직후 반드시 1회 실행해야 하는 필수 단계
             (보안 모드·admin 시드) — 바로가기가 없으면 운영자가 설치 폴더를
             직접 뒤져야 해서 단계를 건너뛰기 쉬움 (현장 보안 정책 오류의 주원인). -->
        <Component Id="StartMenuAppSetupShortcutComp">
          <Shortcut Id="StartMenuAppSetupShortcut"
                    Name="BODA VMS 설정 마법사 (AppSetup)"
                    Target="[INSTALLFOLDER]VMS.AppSetup.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuAppSetupShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <!-- VisionSetup 은 카메라 뷰어 + 검사 툴 설정을 겸하는 독립 앱
             (Mech-Eye Viewer + Mech-Vision 포지션) — 단독 실행 진입점 제공. -->
        <Component Id="StartMenuVisionSetupShortcutComp">
          <Shortcut Id="StartMenuVisionSetupShortcut"
                    Name="BODA VMS 비전 설정 (VisionSetup)"
                    Target="[INSTALLFOLDER]VMS.VisionSetup.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuVisionSetupShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Fragment>

<?ifdef WebPayloadDir ?>
  <!-- Web Server: 파일 + Windows Service + 방화벽.
       서비스는 demand(수동) 로 등록 — 초기 구성 전 재부팅 시 크래시 루프 방지
       (앱은 Jwt:Key/admin 시드 없으면 부팅 거부). AppSetup 마법사가 구성 완료 시
       auto 전환 + 시작을 수행한다. 기존 스크립트 설치 현장(BodaVmsWeb 서비스 존재) 은
       Uninstall-Web.ps1 로 선제거 필요 — msi_build_guide §13 참조. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="WebFolder" Name="Web" />
    </DirectoryRef>

    <ComponentGroup Id="WebFiles" Directory="WebFolder">
      <Files Include="$(var.WebPayloadDir)**">
        <Exclude Files="$(var.WebPayloadDir)BODA.VMS.Web.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="WebServiceComp" Directory="WebFolder">
      <File Id="WebServerExe" Source="$(var.WebPayloadDir)BODA.VMS.Web.exe" KeyPath="yes" />
      <ServiceInstall Id="WebSvcInstall"
                      Name="BodaVmsWeb"
                      DisplayName="BODA VMS Web Server"
                      Description="BODA Vision Management System - Web Server"
                      Type="ownProcess"
                      Start="demand"
                      ErrorControl="normal"
                      Arguments="--environment Production --urls=http://0.0.0.0:5292">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="10"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="WebSvcControl" Name="BodaVmsWeb" Stop="both" Remove="uninstall" Wait="yes" />
      <fw:FirewallException Id="WebFirewallException"
                            Name="BODA VMS Web (5292/TCP)"
                            Port="5292"
                            Protocol="tcp"
                            Scope="any"
                            Profile="all" />
    </Component>
  </Fragment>
<?endif?>

</Wix>
