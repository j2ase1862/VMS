<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!-- 제품명 = BODA VMS (GS 인증 신청명 — 제어판 · 설치 창 · 바로가기 · 기본 설치 폴더 동일 표기).
       옛 폴더에 설치된 버전의 업그레이드는 그 폴더를 유지한다(아래 LEGACYDIR*). 바로가기 키패스용
       HKCU 레지스트리 키 "Software\VASIM\BODA Vision System" 은 화면에 안 보이는 내부 키라 그대로 둔다. -->
  <Package Name="BODA VMS"
           Manufacturer="VASIM"
           Version="$(var.BuildVersion)"
           UpgradeCode="A70E988A-739F-4CDC-BE08-EBFE03DACA32"
           Codepage="949"
           Language="1042">

    <!-- AllowSameVersionUpgrades: 같은 버전(예: 1.48.1)을 다시 빌드한 설치 파일도 기존 설치를 지우고 교체한다.
         없으면 제품이 두 개로 등록되고 파일 버전이 같은 DLL 은 바뀌지 않아 수정이 빠질 수 있다. -->
    <!-- MigrateFeatures="no": 기능 상태는 아래 INSTALLWEB 결정(이전 설치에 Web 이 있었는지)만으로 정한다.
         기본값(yes)이면 MigrateFeatureStates 가 업그레이드 화면에서 고른 Web 포함 여부를 이전 상태로 덮어쓸 수 있다
         (기능이 Main · WebServer 둘뿐이고 Main 은 항상 설치라 옮길 상태가 따로 없다). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" MigrateFeatures="no" DowngradeErrorMessage="최신 버전이 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="BODA VMS" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuShortcutComp" />
      <ComponentRef Id="StartMenuAppSetupShortcutComp" />
      <ComponentRef Id="StartMenuVisionSetupShortcutComp" />
      <ComponentRef Id="StartMenuUninstallShortcutComp" />
    </Feature>

<?ifdef WebPayloadDir ?>
    <!-- BODA.VMS.Web 동봉 (릴리즈 빌드 전용 — tools/stage-web-payload.ps1 이
         WebPayload/ 를 채웠을 때만 컴파일됨. CI 는 Web 리포 접근 불가라 이 Feature 없이 빌드).
         서비스는 등록만 하고 시작하지 않는다 — 초기 구성(admin 비밀번호·Jwt:Key) 은
         AppSetup 마법사가 담당하며, 구성 전에는 앱이 스스로 부팅을 거부한다.
         제외 경로 2가지 — 같은 INSTALLWEB 속성 공유:
           · 설치 마법사 "설치 구성 선택" 화면의 체크 해제 (WebOptionDlg — 해제 시 속성 제거)
           · 무인 설치: msiexec /i VMS-x.y.z.msi INSTALLWEB=0
         새 설치의 기본은 포함(1). 업그레이드(인앱 업데이트 · 같은 버전 교체 포함)는 이전 설치의 구성을 따른다 —
         이전 설치에 Web 서비스 구성 요소(WebServiceComp)가 있으면 1, 없으면 비워 둔다(= 제외 유지).
         이전 설치 확인은 Windows Installer 의 구성 요소 등록(ComponentSearch)을 읽으므로 이 방식 이전 버전
         (v1.48.1 까지)에서 올릴 때도 맞게 동작한다. 명령줄의 INSTALLWEB=0/1 은 그대로 우선한다.
         실행 단계(execute) 결정은 마법사 없이 도는 설치(인앱 업데이트 · /passive · /qn)에서만 —
         전체 UI 설치는 화면 체크 결과가 넘어온다(체크 해제 = 속성 없음). 설치된 제품의 유지 관리 · 제거
         (업그레이드가 옛 제품을 지우는 경우 포함)는 예전처럼 늘 1 이라 WebServer 기능이 비활성화되지 않는다. -->
    <Property Id="INSTALLWEB" Secure="yes" />
    <Property Id="WEBPREVINSTALLED" Secure="yes">
      <ComponentSearch Id="WebServiceCompSearch" Guid="{D5190E50-9255-5E23-A1FE-5EB0D2562D97}" Type="file" />
    </Property>
    <SetProperty Id="INSTALLWEB" Action="SetInstallWebDefaultUi" Value="1" After="AppSearch" Sequence="ui"
                 Condition="NOT INSTALLWEB AND (Installed OR WEBPREVINSTALLED OR NOT WIX_UPGRADE_DETECTED)" />
    <SetProperty Id="INSTALLWEB" Action="SetInstallWebDefault" Value="1" After="AppSearch" Sequence="execute"
                 Condition="NOT INSTALLWEB AND (Installed OR (UILevel &lt; 5 AND (WEBPREVINSTALLED OR NOT WIX_UPGRADE_DETECTED)))" />
    <!-- 업그레이드 전 Web 서비스 시작 유형 — 서비스 등록 값 Start(2 = 자동 · 3 = 수동 · 4 = 사용 안 함).
         AppSearch 는 이전 제품을 지우기(RemoveExistingProducts) 전에 돌아 이전 설치의 값을 읽는다.
         아래 ServiceInstall 은 늘 demand 로 다시 등록하므로, 이전에 자동이었으면 StartServices 뒤에
         자동(지연) 전환 + 시작을 되돌린다 — 인앱 업데이트 부트스트래퍼(UpdateInstallService)와 같은 정책.
         릴리스 페이지에서 받은 MSI 를 직접 설치하면 부트스트래퍼가 없어 Web 이 꺼진 채 남았다(VO-15).
         처음 설치 · 수동 · 사용 안 함이던 서비스는 그대로 demand(구성 전 크래시 루프 방지). -->
    <Property Id="WEBSVCPREVSTART" Secure="yes">
      <RegistrySearch Id="WebSvcPrevStartSearch" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\BodaVmsWeb"
                      Name="Start" Type="raw" />
    </Property>
    <SetProperty Id="WebSvcRestoreAutoStart" Action="SetWebSvcRestoreAutoStartCmd" Before="WebSvcRestoreAutoStart" Sequence="execute"
                 Value="&quot;[SystemFolder]sc.exe&quot; config BodaVmsWeb start= delayed-auto" />
    <SetProperty Id="WebSvcRestoreStart" Action="SetWebSvcRestoreStartCmd" Before="WebSvcRestoreStart" Sequence="execute"
                 Value="&quot;[SystemFolder]sc.exe&quot; start BodaVmsWeb" />
    <!-- 실패해도 설치를 되돌리지 않는다(Return="ignore") — 서비스는 AppSetup [서비스 시작] 으로 켤 수 있다. -->
    <CustomAction Id="WebSvcRestoreAutoStart" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="WebSvcRestoreStart" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="WebSvcRestoreAutoStart" After="StartServices"
              Condition="WEBSVCPREVSTART=&quot;#2&quot; AND NOT REMOVE~=&quot;ALL&quot; AND (&amp;WebServer=3 OR !WebServer=3)" />
      <Custom Action="WebSvcRestoreStart" After="WebSvcRestoreAutoStart"
              Condition="WEBSVCPREVSTART=&quot;#2&quot; AND NOT REMOVE~=&quot;ALL&quot; AND (&amp;WebServer=3 OR !WebServer=3)" />
    </InstallExecuteSequence>
    <Feature Id="WebServer" Title="BODA VMS Web 서버" Level="1" AllowAbsent="yes">
      <Level Value="0" Condition="INSTALLWEB=0 OR NOT INSTALLWEB" />
      <ComponentGroupRef Id="WebFiles" />
      <ComponentRef Id="WebServiceComp" />
    </Feature>
<?endif?>

    <!-- 커스텀 다이얼로그 세트 (WixUI_VmsInstall.wxs) — 라이선스 화면 없는
         WixUI_InstallDir 변형 + VASIM 브랜딩 비트맵. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- 옛 기본 폴더(VASIM\BODA Vision System)에 설치된 버전을 올릴 때는 그 폴더에 그대로 설치한다.
         새 기본 폴더(VASIM\BODA VMS)로 옮기면 ① 설치 폴더에만 있는 Web\appsettings.Production.json
         (Jwt 키 · DB 경로 — MSI 파일이 아님)이 남겨져 Web 이 시작되지 못하고 ② 이미 배포된 구버전의
         인앱 업데이트 스크립트가 옛 경로의 VMS.exe 를 다시 실행하려다 실패한다.
         새 기본 폴더는 신규 설치에만 적용된다. 32비트 패키지라 ProgramFilesFolder 가 기본 위치,
         64비트 쪽도 함께 찾는다. -->
    <Property Id="LEGACYDIR86">
      <DirectorySearch Id="LegacyDir86" Path="[ProgramFilesFolder]VASIM\BODA Vision System" Depth="0" AssignToProperty="yes">
        <FileSearch Id="LegacyExe86" Name="VMS.exe" />
      </DirectorySearch>
    </Property>
    <Property Id="LEGACYDIR64">
      <DirectorySearch Id="LegacyDir64" Path="[ProgramFiles64Folder]VASIM\BODA Vision System" Depth="0" AssignToProperty="yes">
        <FileSearch Id="LegacyExe64" Name="VMS.exe" />
      </DirectorySearch>
    </Property>
    <!-- 설치 마법사(전체 UI)에서는 폴더 화면의 기본값으로만 넣고(사용자가 바꾸면 그 값이 실행 단계로 넘어감),
         마법사 없이 도는 설치(인앱 업데이트 · /passive · /qn)에서만 실행 단계가 직접 정한다. -->
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderLegacy64Ui" Value="[LEGACYDIR64]" After="AppSearch" Sequence="ui"
                 Condition="LEGACYDIR64 AND NOT Installed" />
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderLegacy86Ui" Value="[LEGACYDIR86]" After="AppSearch" Sequence="ui"
                 Condition="LEGACYDIR86 AND NOT Installed" />
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderLegacy64" Value="[LEGACYDIR64]" After="AppSearch" Sequence="execute"
                 Condition="LEGACYDIR64 AND NOT Installed AND UILevel &lt; 5" />
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderLegacy86" Value="[LEGACYDIR86]" After="AppSearch" Sequence="execute"
                 Condition="LEGACYDIR86 AND NOT Installed AND UILevel &lt; 5" />
    <UIRef Id="WixUI_VmsInstall" />
    <WixVariable Id="WixUIBannerBmp" Value="Resources\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Resources\dialog.bmp" />

  </Package>

  <!-- Directory Structure -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VASIM\BODA VMS" />
    </StandardDirectory>
  </Fragment>

  <!-- Application Files: harvest all files from VMS build output -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.VMS.TargetDir)**">
        <!-- 옛 AI 학습 도구(VMS.DeepLearning · scripts\, 2026-10 MLOps 로 일원화하며 제거) 의 빌드 출력이 개발 · 빌드 PC 의
             VMS 출력 폴더에 남아 있어도 MSI 에 수확되지 않게 막는다 (win-x64\ 잔재와 같은 방어). -->
        <Exclude Files="$(var.VMS.TargetDir)VMS.DeepLearning.*" />
        <Exclude Files="$(var.VMS.TargetDir)scripts\**" />
        <!-- 개발 PC 빌드 출력에 남은 stale publish 산출물(win-x64\, 2026-06-01 self-contained 실험 잔재 1.3GB)이
             MSI 에 수확되던 사고 방어 (v1.25.0~v1.30.0 MSI 에 포함돼 있었음). RID 출력은 루트로 오므로 win-x64\ 는 항상 잔재. -->
        <Exclude Files="$(var.VMS.TargetDir)win-x64\**" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- Desktop Shortcut -->
  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComp">
        <Shortcut Id="DesktopShortcut"
                  Name="BODA VMS"
                  Target="[INSTALLFOLDER]VMS.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\VASIM\BODA Vision System"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <!-- Start Menu Shortcut -->
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="VASIM">
        <Component Id="StartMenuShortcutComp">
          <Shortcut Id="StartMenuShortcut"
                    Name="BODA VMS"
                    Target="[INSTALLFOLDER]VMS.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <!-- AppSetup 은 설치/업데이트 직후 반드시 1회 실행해야 하는 필수 단계
             (보안 모드·admin 시드) — 바로가기가 없으면 운영자가 설치 폴더를
             직접 뒤져야 해서 단계를 건너뛰기 쉬움 (현장 보안 정책 오류의 주원인). -->
        <Component Id="StartMenuAppSetupShortcutComp">
          <Shortcut Id="StartMenuAppSetupShortcut"
                    Name="BODA VMS 설정 마법사 (AppSetup)"
                    Target="[INSTALLFOLDER]VMS.AppSetup.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuAppSetupShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <!-- VisionSetup 은 카메라 뷰어 + 검사 툴 설정을 겸하는 독립 앱
             (Mech-Eye Viewer + Mech-Vision 포지션) — 단독 실행 진입점 제공. -->
        <Component Id="StartMenuVisionSetupShortcutComp">
          <Shortcut Id="StartMenuVisionSetupShortcut"
                    Name="BODA VMS 비전 설정 (VisionSetup)"
                    Target="[INSTALLFOLDER]VMS.VisionSetup.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuVisionSetupShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <!-- 제거 바로가기 — 사용자 매뉴얼 2.6 "시작 메뉴의 제거 바로가기". Windows Installer 에 이 제품의
             제거를 요청할 뿐이다(설정 → 앱 → 제거와 같은 동작 · 확인 창이 먼저 뜬다). 32비트 패키지라
             SystemFolder 는 32비트 시스템 폴더이고 거기의 msiexec.exe 를 부른다. -->
        <Component Id="StartMenuUninstallShortcutComp">
          <Shortcut Id="StartMenuUninstallShortcut"
                    Name="BODA VMS 제거"
                    Description="BODA VMS 를 이 PC 에서 제거합니다"
                    Target="[SystemFolder]msiexec.exe"
                    Arguments="/x [ProductCode]" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuUninstallShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Fragment>

<?ifdef WebPayloadDir ?>
  <!-- Web Server: 파일 + Windows Service + 방화벽.
       서비스는 demand(수동) 로 등록 — 초기 구성 전 재부팅 시 크래시 루프 방지
       (앱은 Jwt:Key/admin 시드 없으면 부팅 거부). AppSetup 마법사가 구성 완료 시
       auto 전환 + 시작을 수행한다. 업그레이드 전에 자동이었으면 위 WebSvcRestore* 가 되돌린다. 기존 스크립트 설치 현장(BodaVmsWeb 서비스 존재) 은
       Uninstall-Web.ps1 로 선제거 필요 — msi_build_guide §13 참조. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="WebFolder" Name="Web" />
    </DirectoryRef>

    <ComponentGroup Id="WebFiles" Directory="WebFolder">
      <Files Include="$(var.WebPayloadDir)**">
        <Exclude Files="$(var.WebPayloadDir)BODA.VMS.Web.exe" />
      </Files>
    </ComponentGroup>

    <!-- Guid 는 v1.48.0 · v1.48.1 MSI 에 자동 생성돼 있던 값 그대로 고정 — 위 WEBPREVINSTALLED 의
         ComponentSearch 가 이 값으로 이전 설치의 Web 포함 여부를 찾는다. 바꾸지 말 것. -->
    <Component Id="WebServiceComp" Guid="{D5190E50-9255-5E23-A1FE-5EB0D2562D97}" Directory="WebFolder">
      <File Id="WebServerExe" Source="$(var.WebPayloadDir)BODA.VMS.Web.exe" KeyPath="yes" />
      <ServiceInstall Id="WebSvcInstall"
                      Name="BodaVmsWeb"
                      DisplayName="BODA VMS Web Server"
                      Description="BODA Vision Management System - Web Server"
                      Type="ownProcess"
                      Start="demand"
                      ErrorControl="normal"
                      Arguments="--environment Production --urls=http://0.0.0.0:5292">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="10"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="WebSvcControl" Name="BodaVmsWeb" Stop="both" Remove="uninstall" Wait="yes" />
      <fw:FirewallException Id="WebFirewallException"
                            Name="BODA VMS Web (5292/TCP)"
                            Port="5292"
                            Protocol="tcp"
                            Scope="any"
                            Profile="all" />
    </Component>
  </Fragment>
<?endif?>

</Wix>
