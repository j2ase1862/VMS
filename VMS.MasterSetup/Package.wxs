<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="BODA Vision System"
           Manufacturer="VASIM"
           Version="$(var.BuildVersion)"
           UpgradeCode="A70E988A-739F-4CDC-BE08-EBFE03DACA32"
           Codepage="949"
           Language="1042">

    <MajorUpgrade DowngradeErrorMessage="최신 버전이 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="BODA Vision System" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuShortcutComp" />
      <ComponentRef Id="StartMenuAppSetupShortcutComp" />
      <ComponentRef Id="StartMenuVisionSetupShortcutComp" />
    </Feature>

<?ifdef WebPayloadDir ?>
    <!-- BODA.VMS.Web 동봉 (릴리즈 빌드 전용 — tools/stage-web-payload.ps1 이
         WebPayload/ 를 채웠을 때만 컴파일됨. CI 는 Web 리포 접근 불가라 이 Feature 없이 빌드).
         서비스는 등록만 하고 시작하지 않는다 — 초기 구성(admin 비밀번호·Jwt:Key) 은
         AppSetup 마법사가 담당하며, 구성 전에는 앱이 스스로 부팅을 거부한다.
         제외 설치: msiexec /i VMS-x.y.z.msi INSTALLWEB=0 -->
    <Feature Id="WebServer" Title="BODA VMS Web 서버" Level="1" AllowAbsent="yes">
      <Level Value="0" Condition="INSTALLWEB=0" />
      <ComponentGroupRef Id="WebFiles" />
      <ComponentRef Id="WebServiceComp" />
    </Feature>
<?endif?>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>

  <!-- Directory Structure -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VASIM\BODA Vision System" />
    </StandardDirectory>
  </Fragment>

  <!-- Application Files: harvest all files from VMS build output -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.VMS.TargetDir)**" />
    </ComponentGroup>
  </Fragment>

  <!-- Desktop Shortcut -->
  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComp">
        <Shortcut Id="DesktopShortcut"
                  Name="VMS 실행"
                  Target="[INSTALLFOLDER]VMS.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\VASIM\BODA Vision System"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <!-- Start Menu Shortcut -->
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="VASIM">
        <Component Id="StartMenuShortcutComp">
          <Shortcut Id="StartMenuShortcut"
                    Name="BODA Vision System"
                    Target="[INSTALLFOLDER]VMS.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <!-- AppSetup 은 설치/업데이트 직후 반드시 1회 실행해야 하는 필수 단계
             (보안 모드·admin 시드) — 바로가기가 없으면 운영자가 설치 폴더를
             직접 뒤져야 해서 단계를 건너뛰기 쉬움 (현장 보안 정책 오류의 주원인). -->
        <Component Id="StartMenuAppSetupShortcutComp">
          <Shortcut Id="StartMenuAppSetupShortcut"
                    Name="BODA VMS 설정 마법사 (AppSetup)"
                    Target="[INSTALLFOLDER]VMS.AppSetup.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuAppSetupShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <!-- VisionSetup 은 카메라 뷰어 + 검사 툴 설정을 겸하는 독립 앱
             (Mech-Eye Viewer + Mech-Vision 포지션) — 단독 실행 진입점 제공. -->
        <Component Id="StartMenuVisionSetupShortcutComp">
          <Shortcut Id="StartMenuVisionSetupShortcut"
                    Name="BODA VMS 비전 설정 (VisionSetup)"
                    Target="[INSTALLFOLDER]VMS.VisionSetup.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\VASIM\BODA Vision System"
                         Name="StartMenuVisionSetupShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Fragment>

<?ifdef WebPayloadDir ?>
  <!-- Web Server: 파일 + Windows Service + 방화벽.
       서비스는 demand(수동) 로 등록 — 초기 구성 전 재부팅 시 크래시 루프 방지
       (앱은 Jwt:Key/admin 시드 없으면 부팅 거부). AppSetup 마법사가 구성 완료 시
       auto 전환 + 시작을 수행한다. 기존 스크립트 설치 현장(BodaVmsWeb 서비스 존재) 은
       Uninstall-Web.ps1 로 선제거 필요 — msi_build_guide §13 참조. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="WebFolder" Name="Web" />
    </DirectoryRef>

    <ComponentGroup Id="WebFiles" Directory="WebFolder">
      <Files Include="$(var.WebPayloadDir)**">
        <Exclude Files="$(var.WebPayloadDir)BODA.VMS.Web.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="WebServiceComp" Directory="WebFolder">
      <File Id="WebServerExe" Source="$(var.WebPayloadDir)BODA.VMS.Web.exe" KeyPath="yes" />
      <ServiceInstall Id="WebSvcInstall"
                      Name="BodaVmsWeb"
                      DisplayName="BODA VMS Web Server"
                      Description="BODA Vision Management System - Web Server"
                      Type="ownProcess"
                      Start="demand"
                      ErrorControl="normal"
                      Arguments="--environment Production --urls=http://0.0.0.0:5292">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="10"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="WebSvcControl" Name="BodaVmsWeb" Stop="both" Remove="uninstall" Wait="yes" />
      <fw:FirewallException Id="WebFirewallException"
                            Name="BODA VMS Web (5292/TCP)"
                            Port="5292"
                            Protocol="tcp"
                            Scope="any"
                            Profile="all" />
    </Component>
  </Fragment>
<?endif?>

</Wix>
