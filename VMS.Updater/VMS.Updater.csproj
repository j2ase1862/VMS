<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\VMS\icon\Vasim.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 릴리즈(Release) 배포는 self-contained(.NET 런타임 동봉) — 현장 PC에 .NET 설치 불필요.
       AppendRuntimeIdentifierToOutputPath=false 로 출력 경로를 기존과 동일하게 유지
       (VMS 출력으로의 post-build 복사·MSI harvest 경로가 RID 세그먼트를 모름). -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>


  <ItemGroup>
    <Resource Include="..\VMS\icon\Vasim.ico" Link="Resources\Vasim.ico" />
  </ItemGroup>

  <!-- 주의: 패키지는 CommunityToolkit.Mvvm 하나만 유지할 것.
       업데이트 부트스트랩이 설치 폴더에서 임시 폴더로 VMS.Updater.* +
       CommunityToolkit.Mvvm.dll 만 복사해 실행한다 (자기 자신이 MSI 로 교체되는
       동안 잠긴 파일이 없도록). 패키지를 추가하면 그 복사 목록도 함께 늘려야 한다
       — UpdateInstallService.BuildBootstrapScript 참조. -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- 공용 다크 메시지 다이얼로그 (Phase B) — Linked Page 라 BAML 이 VMS.Updater.dll 에
       포함되므로 부트스트랩의 "VMS.Updater.* + CommunityToolkit.Mvvm.dll 만 복사" 제약을
       위반하지 않는다 (추가 dll 불필요). -->
  <ItemGroup>
    <Page Include="..\VMS.VisionSetup\Styles\WindowStyles.xaml" Link="Styles\WindowStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\VMS.VisionSetup\Views\Common\MessageDialog.xaml" Link="Views\Common\MessageDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\VMS.VisionSetup\Views\Common\MessageDialog.xaml.cs" Link="Views\Common\MessageDialog.xaml.cs" />
  </ItemGroup>

  <!-- After build, copy output to VMS output directory (MSI 하베스트 대상) -->
  <Target Name="CopyToVmsOutput" AfterTargets="Build">
    <PropertyGroup>
      <VmsOutputDir>..\VMS\bin\$(Configuration)\net8.0-windows7.0\</VmsOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <UpdaterOutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(VmsOutputDir)" Condition="!Exists('$(VmsOutputDir)')" />
    <Copy SourceFiles="@(UpdaterOutputFiles)" DestinationFolder="$(VmsOutputDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
