<Window x:Class="VMS.DeepLearning.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VMS.DeepLearning.ViewModels"
        xmlns:ann="clr-namespace:VMS.Core.Models.Annotation;assembly=VMS.Core"
        xmlns:local="clr-namespace:VMS.DeepLearning.Views"
        Title="{Binding WindowTitle}" Width="1400" Height="900"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#1E1E1E"
        Icon="/Resources/app.ico">
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmSamLabelCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClearSamPreviewCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PreviousImageCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextImageCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VMS Labeling" FontSize="16" FontWeight="Bold"
                           Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <Button Content="New Dataset" Command="{Binding CreateDatasetCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Padding="10,4"/>
                <Button Content="Save" Command="{Binding SaveDatasetCommand}"
                        Margin="0,0,4,0" Padding="10,4"/>
                <Separator Margin="8,0" Width="1" Background="#555"/>
                <Button Content="Add Images" Command="{Binding AddImagesCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Padding="10,4"/>
                <Separator Margin="8,0" Width="1" Background="#555"/>
                <Button Content="Auto Split" Command="{Binding AutoSplitCommand}"
                        Margin="0,0,4,0" Padding="10,4"/>
                <Button Content="Export" Command="{Binding ExportForCurrentTaskCommand}"
                        Style="{StaticResource SuccessButton}" Margin="0,0,4,0" Padding="10,4"/>
            </StackPanel>
        </Border>

        <!-- ═══ Main Content ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Left Panel: Dataset & Image List ═══ -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Dataset Section -->
                    <Expander Grid.Row="0" IsExpanded="True" Margin="8,8,8,4">
                        <Expander.Header>
                            <TextBlock Text="Dataset" Style="{StaticResource SectionHeader}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <ListBox ItemsSource="{Binding Datasets}" SelectedItem="{Binding CurrentDataset}"
                                     MaxHeight="120" Margin="0,0,0,6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                            <TextBlock Foreground="#888" FontSize="10" Margin="6,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding DatasetTaskType, StringFormat='[{0}]', Mode=OneWay}"/>
                                                <Run Text="{Binding TotalImages, StringFormat=' ({0})', Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- New Dataset: Name + Task Type -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewDatasetName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="+" Width="30" Margin="4,0,0,0"
                                        Command="{Binding CreateDatasetCommand}"
                                        Style="{StaticResource PrimaryButton}" FontWeight="Bold"/>
                            </Grid>

                            <!-- Task Type Selector -->
                            <ComboBox ItemsSource="{Binding DatasetTaskTypes}"
                                      SelectedValue="{Binding NewDatasetTaskType}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="11" Margin="0,4,0,0"/>

                            <!-- Task Type 설명 -->
                            <Border Background="#1A1A2E" CornerRadius="4" Padding="8,6"
                                    Margin="0,4,0,0" BorderBrush="#333" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding NewDatasetTaskDescription}"
                                               Foreground="#AAAAAA" FontSize="10.5"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="▶" Foreground="#0078D4" FontSize="9"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding NewDatasetTaskWorkflow}"
                                                   Foreground="#4FC3F7" FontSize="9.5"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Load" Command="{Binding SelectDatasetCommand}"
                                        CommandParameter="{Binding CurrentDataset}"
                                        Padding="10,3" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="Save" Command="{Binding SaveDatasetCommand}"
                                        Padding="10,3" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="Delete" Command="{Binding DeleteDatasetCommand}"
                                        Style="{StaticResource DangerButton}" Padding="10,3" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Image Actions Bar -->
                    <Border Grid.Row="1" Margin="8,4" Padding="0,4"
                            BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Images" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Add" Command="{Binding AddImagesCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                                    <Button Content="- Del" Command="{Binding RemoveCurrentImageCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="8,2" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- Navigation -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <Button Content="◀" Command="{Binding PreviousImageCommand}"
                                        Width="34" Padding="0,2" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                    <Run Text="{Binding CurrentImageIndex, Mode=OneWay, StringFormat='{}{0}'}"
                                         FontWeight="Bold"/>
                                    <Run Text=" / " Foreground="#888"/>
                                    <Run Text="{Binding CurrentDataset.TotalImages, Mode=OneWay, FallbackValue=0}"
                                         Foreground="#888"/>
                                </TextBlock>
                                <Button Content="▶" Command="{Binding NextImageCommand}"
                                        Width="34" Padding="0,2" FontSize="12" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- Dataset Stats: 라벨/학습됨/미학습 -->
                            <Border Background="#1A1A1A" CornerRadius="3" Padding="6,3" Margin="0,0,0,2"
                                    Visibility="{Binding CurrentDataset, Converter={StaticResource NotNullToVis}, FallbackValue=Collapsed}"
                                    ToolTip="라벨: 라벨이 있는 이미지 수&#x0a;학습됨: 마지막 학습 스냅샷에 포함된 이미지 수&#x0a;미학습: 학습 후 추가됐거나 한 번도 학습 안 된 이미지 수">
                                <TextBlock FontSize="10" TextWrapping="Wrap">
                                    <Run Text="이미지" Foreground="#888"/>
                                    <Run Text="{Binding CurrentDataset.TotalImages, Mode=OneWay, FallbackValue=0}"
                                         Foreground="#DDD" FontWeight="SemiBold"/>
                                    <Run Text=" · 라벨 " Foreground="#888"/>
                                    <Run Text="{Binding CurrentDataset.LabeledImages, Mode=OneWay, FallbackValue=0}"
                                         Foreground="#4CAF50"/>
                                    <Run Text=" · 학습됨 " Foreground="#888"/>
                                    <Run Text="{Binding CurrentDataset.TrainedImagesCount, Mode=OneWay, FallbackValue=0}"
                                         Foreground="#4FC3F7"/>
                                    <Run Text=" · 미학습 " Foreground="#888"/>
                                    <Run Text="{Binding CurrentDataset.UnTrainedImagesCount, Mode=OneWay, FallbackValue=0}"
                                         Foreground="#FF9800"/>
                                </TextBlock>
                            </Border>

                            <!-- v1 Inference Mode: 학습 후 즉시 검증 -->
                            <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                    CornerRadius="3" Padding="6,4" Margin="0,2,0,2">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="Inference Mode"
                                                  IsChecked="{Binding IsInferenceModeEnabled}"
                                                  Foreground="#DDD" FontSize="11" FontWeight="SemiBold"
                                                  VerticalAlignment="Center"
                                                  ToolTip="학습된 ONNX 모델로 prev/next 이미지마다 즉시 검증 (Detection only)"/>
                                        <TextBlock Text="●" Foreground="#00DCFF" FontSize="11"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsInferenceRunning, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                Visibility="{Binding IsInferenceModeEnabled, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <Button Content="모델..." Command="{Binding BrowseInferenceModelCommand}"
                                                Padding="6,1" FontSize="10" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding InferenceStatus}" Foreground="#888"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Conf/IoU thresholds (학습 직후 검증용) -->
                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding IsInferenceModeEnabled, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Conf" Foreground="#AAA"
                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0.01" Maximum="0.95"
                                                Value="{Binding ConfidenceThreshold}" TickFrequency="0.05"
                                                VerticalAlignment="Center"
                                                ToolTip="신뢰도 임계값. 학습 직후 모델은 낮게(0.05~0.15) 설정 권장"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding ConfidenceThreshold, StringFormat='{}{0:F2}'}"
                                                   Foreground="#CCC" FontSize="10" Width="32"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="IoU" Foreground="#AAA"
                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="0.9"
                                                Value="{Binding IouThreshold}" TickFrequency="0.05"
                                                VerticalAlignment="Center"
                                                ToolTip="NMS IoU 임계값. 박스 중복 제거 강도"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                   Text="{Binding IouThreshold, StringFormat='{}{0:F2}'}"
                                                   Foreground="#CCC" FontSize="10" Width="32"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Active Learning: 외부 테스트 폴더 일괄 추론 → 실패 이미지 데이터셋에 추가 -->
                            <Expander Header="Active Learning" Margin="0,2,0,0" IsExpanded="False"
                                      Foreground="#DDD" FontSize="11"
                                      Visibility="{Binding IsInferenceModeEnabled, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                      ToolTip="학습되지 않은 외부 테스트 폴더로 일괄 추론하여 실패 이미지를 데이터셋에 추가">
                                <StackPanel Margin="0,4,0,0">
                                    <!-- 폴더 선택 -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding TestFolderPath}" FontSize="10"
                                                 IsReadOnly="True" Padding="4,2"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="학습되지 않은 검증용 이미지 폴더"/>
                                        <Button Grid.Column="1" Content="폴더..." Margin="4,0,0,0"
                                                Command="{Binding BrowseTestFolderCommand}"
                                                Padding="6,2" FontSize="10"/>
                                    </Grid>

                                    <!-- 실패 임계값 -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="실패 기준" Foreground="#AAA" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Slider Grid.Column="1" Minimum="0.01" Maximum="0.5"
                                                Value="{Binding FailureThreshold}" TickFrequency="0.05"
                                                VerticalAlignment="Center"
                                                ToolTip="MaxConfidence가 이 값 미만이면 '실패'로 자동 선택"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FailureThreshold, StringFormat='{}{0:F2}'}"
                                                   Foreground="#CCC" FontSize="10" Width="32"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 일괄 추론 실행 + 진행률 -->
                                    <Button Content="▶ 일괄 추론 실행"
                                            Command="{Binding RunBatchInferenceCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="0,4" FontSize="11"/>
                                    <ProgressBar Height="4" Margin="0,2,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding BatchProgress}"
                                                 Visibility="{Binding IsBatchInferring, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                    <TextBlock Text="{Binding BatchStatus}" Foreground="#888"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                    <!-- 결과 리스트 (낮은 conf 가 위로) -->
                                    <ListBox ItemsSource="{Binding FailedImages}" MaxHeight="180"
                                             BorderThickness="1" BorderBrush="#3F3F46"
                                             Background="#1E1E1E" Margin="0,4,0,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center" Margin="2,0,6,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                               Foreground="#DDD" FontSize="10"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DetectionCount, StringFormat='{}#{0}'}"
                                                                   Foreground="#888" FontSize="10" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding MaxConfidence, StringFormat='{}{0:F3}'}"
                                                                   FontSize="10" Width="40" TextAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 선택 액션 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="모두 선택" Command="{Binding SelectAllFailedCommand}"
                                                Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button Content="모두 해제" Command="{Binding DeselectAllFailedCommand}"
                                                Padding="6,2" FontSize="10"/>
                                    </StackPanel>

                                    <CheckBox Content="모델 예측을 초기 라벨로 사용"
                                              IsChecked="{Binding UsePredictionsAsInitialLabels}"
                                              Foreground="#DDD" FontSize="10" Margin="0,4,0,0"
                                              ToolTip="체크 시 검출 박스가 라벨로 미리 채워집니다 (IsVerified=false — 수동 검토 필요)"/>

                                    <Button Content="✚ 데이터셋에 추가 (선택)"
                                            Command="{Binding AddSelectedToDatasetCommand}"
                                            Style="{StaticResource SuccessButton}"
                                            Padding="0,4" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Image List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding CurrentDataset.Images}"
                             SelectedItem="{Binding CurrentImage}"
                             BorderThickness="0" Margin="8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding SelectImageCommand}"
                                          CommandParameter="{Binding CurrentImage}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" Cursor="Hand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#555"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLabeled}" Value="True">
                                                        <Setter Property="Fill" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding ImagePath}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Margin="6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Labels.Count, StringFormat='[{0}]'}"
                                               Foreground="#888" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══ Center: Image Canvas ═══ -->
            <Grid Grid.Column="1" Background="#1A1A1A">
                <Border x:Name="ImageBorder" Margin="8" Background="#111" BorderBrush="#333" BorderThickness="1"
                        ClipToBounds="True"
                        MouseWheel="ImageBorder_MouseWheel"
                        PreviewMouseDown="ImageBorder_PreviewMouseDown"
                        PreviewMouseUp="ImageBorder_PreviewMouseUp"
                        MouseMove="ImageBorder_MouseMove">
                    <Grid x:Name="ImageContainer">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="PanTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Image display -->
                        <Image x:Name="MainImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                        <!-- Canvas for bounding box drawing (Detection/OCR) and SAM clicks (Segmentation) -->
                        <Canvas x:Name="AnnotationCanvas"
                                Background="Transparent"
                                MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                MouseMove="AnnotationCanvas_MouseMove"
                                MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"
                                MouseRightButtonDown="AnnotationCanvas_MouseRightButtonDown"/>

                        <!-- Floating toolbar for bounding box drawing (Detection/OCR) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="12,12,0,0" Padding="6,4" CornerRadius="6"
                                Background="#CC2D2D30" BorderBrush="#555" BorderThickness="1"
                                Visibility="{Binding IsBoundingBoxMode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#0078D4" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M2,2 L18,2 L18,18 L2,18 Z"
                                              Stroke="White" StrokeThickness="1.5" StrokeDashArray="3,2"
                                              Fill="Transparent" Width="14" Height="14"
                                              Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="Draw Box" Foreground="White" FontSize="11"
                                                   FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Foreground="#999" FontSize="11" VerticalAlignment="Center">
                                    <Run Text="드래그로 바운딩 박스 생성" FontStyle="Italic"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- SAM floating toolbar (Segmentation mode) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="12,12,0,0" Padding="6,4" CornerRadius="6"
                                Background="#CC2D2D30" BorderBrush="#555" BorderThickness="1"
                                Visibility="{Binding IsSegmentationMode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#0078D4" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#4CAF50"
                                                     Stroke="White" StrokeThickness="1" VerticalAlignment="Center"/>
                                            <TextBlock Text="SAM Segment" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Foreground="#999" FontSize="11" VerticalAlignment="Center">
                                        <Run Text="좌클릭=전경  우클릭=배경" FontStyle="Italic"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Confirm (Enter)" Command="{Binding ConfirmSamLabelCommand}"
                                            Style="{StaticResource SuccessButton}"
                                            Padding="8,3" FontSize="10" Margin="0,0,4,0"/>
                                    <Button Content="Clear (Esc)" Command="{Binding ClearSamPreviewCommand}"
                                            Padding="8,3" FontSize="10" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SamStatusMessage}" Foreground="#4FC3F7"
                                               FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Classification/Anomaly: Current class indicator overlay -->
                        <Border x:Name="ClassIndicatorOverlay"
                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="16" Padding="12,6" CornerRadius="4"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ClassIndicatorText" FontSize="16" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>

                        <!-- Placeholder text -->
                        <TextBlock Text="이미지를 선택하세요" FontSize="18" Foreground="#555"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding CurrentMat, Converter={StaticResource BoolToVis},
                                       ConverterParameter=Invert, FallbackValue=Visible}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Right Panel: Classes, Labels, Training ═══ -->
            <Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <!-- Classes Section -->
                        <Expander IsExpanded="True" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="Classes" Style="{StaticResource SectionHeader}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <!-- Classification/Anomaly: 클래스 버튼으로 표시 -->
                                <ItemsControl ItemsSource="{Binding CurrentDataset.Classes}"
                                              Visibility="{Binding IsClassificationMode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="2,2"
                                                    Padding="12,8" FontSize="13" FontWeight="Bold"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.AssignClassCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#3E3E42"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Anomaly: good/defect 버튼 -->
                                <StackPanel Visibility="{Binding IsAnomalyMode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <Button Content="GOOD (정상)" Margin="2,2" Padding="12,10"
                                            FontSize="14" FontWeight="Bold" Cursor="Hand"
                                            Background="#2E7D32" Foreground="White"
                                            Command="{Binding AssignClassCommand}"
                                            CommandParameter="good"/>
                                    <Button Content="DEFECT (불량)" Margin="2,2" Padding="12,10"
                                            FontSize="14" FontWeight="Bold" Cursor="Hand"
                                            Background="#C62828" Foreground="White"
                                            Command="{Binding AssignClassCommand}"
                                            CommandParameter="defect"/>
                                </StackPanel>

                                <!-- Detection/OCR/Segmentation: 기존 클래스 리스트 -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBoundingBoxMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSegmentationMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ListBox ItemsSource="{Binding CurrentDataset.Classes}"
                                             SelectedItem="{Binding SelectedClassName}"
                                             MaxHeight="140">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="13" Padding="4,2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Add class (모든 모드 공통) -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewClassName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+" Width="30" Margin="4,0,0,0"
                                            Command="{Binding AddClassCommand}"
                                            Style="{StaticResource PrimaryButton}" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Labels Section (Detection/OCR/Segmentation 표시) -->
                        <Expander IsExpanded="True" Margin="0,0,0,8">
                            <Expander.Style>
                                <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBoundingBoxMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSegmentationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <Expander.Header>
                                <Grid>
                                    <TextBlock Text="Labels" Style="{StaticResource SectionHeader}"/>
                                    <Button Content="Delete" HorizontalAlignment="Right"
                                            Command="{Binding DeleteSelectedLabelCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="8,1" FontSize="10"/>
                                </Grid>
                            </Expander.Header>
                            <ListBox ItemsSource="{Binding CurrentImage.Labels}"
                                     SelectedItem="{Binding SelectedLabel}"
                                     MaxHeight="200" Margin="0,6,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ClassName}"
                                                           FontWeight="Bold" FontSize="12"
                                                           Foreground="#4FC3F7"/>
                                                <TextBlock Text="{Binding BoundingBox, StringFormat=' [{0}]'}"
                                                           Foreground="#888" FontSize="10" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Transcription}"
                                                       Foreground="#AED581" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <!-- Classification/Anomaly: Current Image Class Display -->
                        <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                                Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClassificationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAnomalyMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Current Image Class" Style="{StaticResource SectionHeader}"/>
                                <TextBlock FontSize="20" FontWeight="Bold" Margin="0,6,0,0"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CurrentImageClass, FallbackValue='(미분류)'}"/>
                                            <Setter Property="Foreground" Value="#FFD700"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentImageClass}" Value="good">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentImageClass}" Value="defect">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentImageClass}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="(미분류)"/>
                                                    <Setter Property="Foreground" Value="#888"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Selected Label Editor (Detection/OCR만 표시) -->
                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                Padding="10" Margin="0,0,0,8" CornerRadius="3"
                                Visibility="{Binding SelectedLabel,
                                    Converter={StaticResource NotNullToVis},
                                    FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="Label Editor" Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Class:" Foreground="#999" FontSize="11" Margin="0,4,0,2"/>
                                <ComboBox ItemsSource="{Binding CurrentDataset.Classes}"
                                          SelectedItem="{Binding SelectedLabel.ClassName}"
                                          FontSize="12" Margin="0,0,0,8"/>

                                <TextBlock Text="Transcription:" Foreground="#999" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedLabel.Transcription, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" FontFamily="Consolas"
                                         Padding="6,4" Margin="0,0,0,4"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Verified:" Foreground="#999" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <CheckBox IsChecked="{Binding SelectedLabel.IsVerified}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SAM Model Section (Segmentation only) -->
                        <Expander IsExpanded="True" Margin="0,0,0,8"
                                  Visibility="{Binding IsSegmentationMode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <Expander.Header>
                                <TextBlock Text="SAM Model" Style="{StaticResource SectionHeader}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <Grid>
                                    <TextBlock Text="Encoder:" Foreground="#999" FontSize="11"/>
                                    <Button Content="..." HorizontalAlignment="Right" Width="28"
                                            Command="{Binding SelectSamEncoderCommand}"
                                            Padding="0,1" FontSize="10"/>
                                </Grid>
                                <TextBox Text="{Binding SamEncoderPath, UpdateSourceTrigger=LostFocus}"
                                         FontSize="10" Margin="0,2,0,6"/>

                                <Grid>
                                    <TextBlock Text="Decoder:" Foreground="#999" FontSize="11"/>
                                    <Button Content="..." HorizontalAlignment="Right" Width="28"
                                            Command="{Binding SelectSamDecoderCommand}"
                                            Padding="0,1" FontSize="10"/>
                                </Grid>
                                <TextBox Text="{Binding SamDecoderPath, UpdateSourceTrigger=LostFocus}"
                                         FontSize="10" Margin="0,2,0,6"/>

                                <Button Content="Load SAM Model" Command="{Binding LoadSamModelCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="8,6" FontSize="12" Margin="0,4,0,4"/>

                                <TextBlock Foreground="#888" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="MobileSAM Encoder/Decoder ONNX 파일을 지정하세요."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSamModelLoaded}" Value="True">
                                                    <Setter Property="Text" Value="SAM 모델 로드됨 — 이미지 위를 클릭하세요."/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <!-- Export Section -->
                        <Expander IsExpanded="False" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="Export" Style="{StaticResource SectionHeader}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <Button Content="Auto Split (Train/Val)" Command="{Binding AutoSplitCommand}"
                                        Padding="8,6" FontSize="12" Margin="0,0,0,4"/>
                                <Button Content="Export for Training" Command="{Binding ExportForCurrentTaskCommand}"
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,6" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Foreground="#888" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="Detection → YOLO format"/>
                                    <LineBreak/>
                                    <Run Text="Classification → ImageFolder format"/>
                                    <LineBreak/>
                                    <Run Text="Anomaly → MVTec format"/>
                                    <LineBreak/>
                                    <Run Text="OCR → PaddleOCR format"/>
                                    <LineBreak/>
                                    <Run Text="Segmentation → YOLO-Seg format"/>
                                </TextBlock>
                            </StackPanel>
                        </Expander>

                        <!-- Training Section -->
                        <Expander IsExpanded="False" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="Training" Style="{StaticResource SectionHeader}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Python:" Foreground="#999" FontSize="11"/>
                                <TextBox Text="{Binding TrainingConfig.PythonPath, UpdateSourceTrigger=LostFocus}"
                                         FontSize="12" Margin="0,2,0,6"/>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Script" Foreground="#999" FontSize="11"/>
                                        <TextBlock Text=" (자동 매칭)" Foreground="#4CAF50" FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="..." HorizontalAlignment="Right" Width="28"
                                            Command="{Binding SelectTrainingScriptCommand}"
                                            Padding="0,1" FontSize="10"/>
                                </Grid>
                                <TextBox Text="{Binding TrainingConfig.TrainingScriptPath, UpdateSourceTrigger=LostFocus}"
                                         FontSize="11" Margin="0,2,0,6"/>

                                <Grid>
                                    <TextBlock Text="Output:" Foreground="#999" FontSize="11"/>
                                    <Button Content="..." HorizontalAlignment="Right" Width="28"
                                            Command="{Binding SelectOutputDirCommand}"
                                            Padding="0,1" FontSize="10"/>
                                </Grid>
                                <TextBox Text="{Binding TrainingConfig.OutputDir, UpdateSourceTrigger=LostFocus}"
                                         FontSize="11" Margin="0,2,0,6"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Epochs:" Foreground="#999" FontSize="11"/>
                                        <TextBox Text="{Binding TrainingConfig.Epochs}"
                                                 FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Batch Size:" Foreground="#999" FontSize="11"/>
                                        <TextBox Text="{Binding TrainingConfig.BatchSize}"
                                                 FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ═══ Anomaly (PatchCore) ═══ -->
                                <Expander IsExpanded="False" Margin="0,8,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="Anomaly (PatchCore)" Foreground="#BBB" FontSize="11"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Foreground="#888" FontSize="10" TextWrapping="Wrap"
                                                   Margin="0,0,0,6"
                                                   Text="anomalib 사용 시 적용됩니다. 미세 결함 검출률 개선을 위해 resnet50 + coreset 0.2 이상을 시도해 보세요."/>

                                        <TextBlock Text="Method:" Foreground="#999" FontSize="11"/>
                                        <ComboBox SelectedValue="{Binding TrainingConfig.AnomalyMethod}"
                                                  SelectedValuePath="Content"
                                                  FontSize="12" Margin="0,2,0,6">
                                            <ComboBoxItem Content="patchcore"/>
                                            <ComboBoxItem Content="fastflow"/>
                                            <ComboBoxItem Content="efficient_ad"/>
                                        </ComboBox>

                                        <TextBlock Text="Backbone:" Foreground="#999" FontSize="11"/>
                                        <ComboBox SelectedValue="{Binding TrainingConfig.AnomalyBackbone}"
                                                  SelectedValuePath="Content"
                                                  FontSize="12" Margin="0,2,0,6">
                                            <ComboBoxItem Content="resnet18"/>
                                            <ComboBoxItem Content="resnet50"/>
                                            <ComboBoxItem Content="wide_resnet50_2"/>
                                        </ComboBox>

                                        <TextBlock Text="Coreset Ratio (0.01~1.0):" Foreground="#999" FontSize="11"/>
                                        <TextBox Text="{Binding TrainingConfig.CoresetRatio, StringFormat=F2}"
                                                 FontSize="12" Margin="0,2,0,0"
                                                 ToolTip="코어셋 샘플링 비율. 값↑=미검률↓ + 메모리↑ (기본 0.10)"/>
                                    </StackPanel>
                                </Expander>

                                <!-- ═══ Augmentation (YOLO) ═══ -->
                                <Expander IsExpanded="False" Margin="0,8,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="Augmentation (YOLO)" Foreground="#BBB" FontSize="11"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Foreground="#888" FontSize="10" TextWrapping="Wrap"
                                                   Margin="0,0,0,6"
                                                   Text="Ultralytics 증강 파라미터. 조명/색감 변동이 큰 공장 환경에서는 hsv_v를 0.5~0.7로 높이세요."/>

                                        <!-- Preset Buttons -->
                                        <TextBlock Text="Presets" Foreground="#999" FontSize="10" Margin="0,0,0,4"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="Default" Command="{Binding PresetAugDefaultCommand}"
                                                    Padding="8,3" FontSize="10" Margin="0,0,4,4"
                                                    ToolTip="Ultralytics 기본값"/>
                                            <Button Content="Factory Lighting" Command="{Binding PresetAugFactoryLightingCommand}"
                                                    Padding="8,3" FontSize="10" Margin="0,0,4,4"
                                                    ToolTip="공장 조명 변동 강건화 (HSV-V=0.7)"/>
                                            <Button Content="Small Defects" Command="{Binding PresetAugSmallDefectsCommand}"
                                                    Padding="8,3" FontSize="10" Margin="0,0,4,4"
                                                    ToolTip="작은 결함 검출 (Mixup 0.15)"/>
                                            <Button Content="Minimal" Command="{Binding PresetAugMinimalCommand}"
                                                    Padding="8,3" FontSize="10" Margin="0,0,4,4"
                                                    ToolTip="최소 증강 (대규모 데이터셋용)"/>
                                        </WrapPanel>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Mosaic (0~1):" Foreground="#999" FontSize="11"/>
                                                <TextBox Text="{Binding TrainingConfig.Mosaic, StringFormat=F2}"
                                                         FontSize="12"
                                                         ToolTip="Mosaic 증강 확률. 1.0=항상 적용. 작은 객체 검출 향상에 효과적 (기본 1.0)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Mixup (0~1):" Foreground="#999" FontSize="11"/>
                                                <TextBox Text="{Binding TrainingConfig.Mixup, StringFormat=F2}"
                                                         FontSize="12"
                                                         ToolTip="Mixup 증강 확률. 분류 분기 강건화 (기본 0.0)"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,2,0">
                                                <TextBlock Text="HSV-H:" Foreground="#999" FontSize="11"/>
                                                <TextBox Text="{Binding TrainingConfig.HsvH, StringFormat=F3}"
                                                         FontSize="12"
                                                         ToolTip="Hue 색감 증강 (기본 0.015)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="2,0">
                                                <TextBlock Text="HSV-S:" Foreground="#999" FontSize="11"/>
                                                <TextBox Text="{Binding TrainingConfig.HsvS, StringFormat=F2}"
                                                         FontSize="12"
                                                         ToolTip="Saturation 포화도 증강 (기본 0.7)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="2,0,0,0">
                                                <TextBlock Text="HSV-V:" Foreground="#999" FontSize="11"/>
                                                <TextBox Text="{Binding TrainingConfig.HsvV, StringFormat=F2}"
                                                         FontSize="12"
                                                         ToolTip="Value/Brightness 증강. 조명 변동 대응의 핵심 (기본 0.4)"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Start/Stop -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Start Training" Command="{Binding StartTrainingCommand}"
                                            Style="{StaticResource SuccessButton}"
                                            Padding="8,6" FontSize="12" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="Stop"
                                            Command="{Binding StopTrainingCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="8,6" FontSize="12" Margin="4,0,0,0"/>
                                </Grid>

                                <!-- Progress -->
                                <ProgressBar Value="{Binding TrainingStatus.Progress, Mode=OneWay}"
                                             Minimum="0" Maximum="100"
                                             Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding TrainingStatus.Message, Mode=OneWay}"
                                           Foreground="#AAA" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Metrics -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Foreground="#888" FontSize="11">
                                        <Run Text="Loss: "/>
                                        <Run Text="{Binding TrainingStatus.Loss, Mode=OneWay, StringFormat='F4'}"
                                             Foreground="#FF9800"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#888" FontSize="11" Margin="16,0,0,0">
                                        <Run Text="Acc: "/>
                                        <Run Text="{Binding TrainingStatus.Accuracy, Mode=OneWay, StringFormat='P1'}"
                                             Foreground="#4CAF50"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Log -->
                                <ListBox ItemsSource="{Binding TrainingLog}" MaxHeight="150"
                                         Background="#1A1A1A" BorderBrush="#333" BorderThickness="1"
                                         FontSize="10" FontFamily="Consolas" Margin="0,6,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#888"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="2" Background="#007ACC" Padding="8,2">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="11"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
