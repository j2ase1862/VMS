<Window x:Class="VMS.DeepLearning.Views.ModelUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="학습 모델 등록"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <!-- 색·서체는 DarkTheme.xaml 의 암시적 스타일을 그대로 받는다.
         PasswordBox·RadioButton 은 암시적 스타일이 없어 여기서만 직접 칠한다. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource FgPrimaryBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 무엇을 올리는지 -->
        <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="파일" Style="{StaticResource FieldLabel}" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="크기" Style="{StaticResource FieldLabel}" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSizeText}" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="작업" Style="{StaticResource FieldLabel}" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaskTypeText}" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="클래스" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ClassesText}" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- 로그인 — 사람의 계정으로 올린다 -->
        <StackPanel Grid.Row="1" Visibility="{Binding ShowSignIn, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource SectionHeader}" Text="계정"/>
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="모델 등록은 엔지니어 이상 계정이어야 합니다. 웹 계정으로 로그인하세요."/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding RegistryUrl}"
                       TextTrimming="CharacterEllipsis"/>
            <Grid Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,8,0"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                <PasswordBox x:Name="PasswordInput" Grid.Column="1" Margin="0,0,8,0"
                             PasswordChanged="OnPasswordChanged"/>
                <Button Grid.Column="2" Content="로그인" MinWidth="90"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Command="{Binding SignInCommand}"/>
            </Grid>
        </StackPanel>

        <!-- 어디에 올릴지 -->
        <StackPanel Grid.Row="2" Visibility="{Binding SignedIn, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource SectionHeader}" Text="등록 대상"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <RadioButton Content="새 모델 계열" GroupName="Target" IsChecked="{Binding CreateNew}"/>
                <RadioButton Content="기존 계열의 새 버전" GroupName="Target" IsChecked="{Binding UseExisting}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="모델 이름"
                       Visibility="{Binding CreateNew, Converter={StaticResource BoolToVis}}"/>
            <TextBox Margin="0,0,0,10"
                     Visibility="{Binding CreateNew, Converter={StaticResource BoolToVis}}"
                     Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- 클래스까지 같이 보여 준다 — 이름만으로는 어느 계열에 올려야 할지 가르기 어렵다.
                 DisplayMemberPath 대신 템플릿을 쓴다 (둘은 함께 지정할 수 없다). -->
            <ComboBox Margin="0,0,0,10"
                      Visibility="{Binding UseExisting, Converter={StaticResource BoolToVis}}"
                      ItemsSource="{Binding Models}"
                      SelectedItem="{Binding SelectedModel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Summary}" FontSize="11"
                                       Foreground="{StaticResource FgSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Style="{StaticResource FieldLabel}" Text="라이선스 (YOLO 계열은 필수 — AGPL-3.0)"/>
            <TextBox Margin="0,0,0,10" Text="{Binding License, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="메모 (선택)"/>
            <TextBox Margin="0,0,0,14" Height="52" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- 진행·결과 -->
        <TextBlock Grid.Row="3" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{StaticResource FgSecondaryBrush}"
                   Text="{Binding Status}"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="4" Margin="0,0,0,12" Padding="10"
                Background="#2A1F1F" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource FgPrimaryBrush}"/>
        </Border>

        <Border Grid.Row="4" Margin="0,0,0,12" Padding="10"
                Background="#1F2A1F" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Result}" TextWrapping="Wrap"
                       Foreground="{StaticResource FgPrimaryBrush}"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="닫기" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="OnCloseClick"/>
            <Button Content="올리기" MinWidth="110"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding UploadCommand}"/>
        </StackPanel>
    </Grid>
</Window>
