<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VMS.DeepLearning</RootNamespace>
    <AssemblyName>VMS.DeepLearning</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 릴리즈(Release) 배포는 self-contained(.NET 런타임 동봉) — 현장 PC에 .NET 설치 불필요.
       AppendRuntimeIdentifierToOutputPath=false 로 출력 경로를 기존과 동일하게 유지
       (VMS 출력으로의 post-build 복사·MSI harvest 경로가 RID 세그먼트를 모름). -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.21.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.11.0.20250507" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMS.Core\VMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- VisionSetup 의 HelpIcon(? 아이콘 → hover/클릭 팝업) 컨트롤을 Linked Page 로 재사용
       — 4개 앱 도움말 UX 통일 (AppSetup 과 동일 패턴). ProjectReference 는 순환 참조라 불가
       (VisionSetup 이 DeepLearning 을 빌드 순서 참조). HelpContent.cs 는 HelpIcon.xaml.cs 의
       컴파일 의존성 — DeepLearning 에서는 CustomTitle/CustomDescription 경로만 사용. -->
  <ItemGroup>
    <Page Include="..\VMS.VisionSetup\Controls\HelpIcon.xaml" Link="Controls\HelpIcon.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\VMS.VisionSetup\Controls\HelpIcon.xaml.cs" Link="Controls\HelpIcon.xaml.cs" />
    <Compile Include="..\VMS.VisionSetup\Models\HelpContent.cs" Link="Models\HelpContent.cs" />
  </ItemGroup>

  <!-- 공용 다크 메시지 다이얼로그 (Phase B) — AppSetup 과 동일한 Linked Page 관례.
       다이얼로그가 참조하는 WindowStyles.xaml 도 함께 링크하고, App.xaml 에서
       DarkTheme 보다 먼저 merge (암시적 스타일 충돌 시 기존 DarkTheme 이 우선). -->
  <ItemGroup>
    <Page Include="..\VMS.VisionSetup\Styles\WindowStyles.xaml" Link="Styles\WindowStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\VMS.VisionSetup\Views\Common\MessageDialog.xaml" Link="Views\Common\MessageDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\VMS.VisionSetup\Views\Common\MessageDialog.xaml.cs" Link="Views\Common\MessageDialog.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="scripts\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Publish 시 제외 — VMS.VisionSetup 과 같은 경로 충돌 + 운영자 PC 에 불필요 -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- After build, copy DeepLearning EXE to VisionSetup output directory -->
  <Target Name="CopyToVisionSetupOutput" AfterTargets="Build">
    <PropertyGroup>
      <VisionSetupOutputDir>..\VMS.VisionSetup\bin\$(Configuration)\$(TargetFramework)\</VisionSetupOutputDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetDir)VMS.DeepLearning.exe;$(TargetDir)VMS.DeepLearning.dll;$(TargetDir)VMS.DeepLearning.deps.json;$(TargetDir)VMS.DeepLearning.runtimeconfig.json"
          DestinationFolder="$(VisionSetupOutputDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(VisionSetupOutputDir)')" />
  </Target>

</Project>
