<Project>
  <!--
    솔루션 공용 버전. 모든 .csproj 가 자동 상속.
    릴리스마다 이 파일만 갱신하면 됨.
  -->
  <!--
    BuildRevision: 같은 버전을 다시 빌드해 배포할 때(화면 · 설치 버전 표기는 그대로) 올리는 빌드 번호.
    파일 버전 넷째 자리로만 들어가 지원 패키지 · 파일 속성에서 어느 빌드인지 구분한다.
    새 버전으로 올릴 때 0 으로 되돌린다.
  -->
  <PropertyGroup>
    <Version>1.48.1</Version>
    <BuildRevision>5</BuildRevision>
    <AssemblyVersion>1.48.1.0</AssemblyVersion>
    <FileVersion>$(Version).$(BuildRevision)</FileVersion>
    <Company>BODA Vision AI</Company>
    <Product>BODA VMS</Product>
    <Copyright>Copyright © BODA Vision AI 2026</Copyright>
  </PropertyGroup>
</Project>
