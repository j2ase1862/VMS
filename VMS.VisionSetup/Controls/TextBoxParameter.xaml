<UserControl x:Class="VMS.VisionSetup.Controls.TextBoxParameter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
             x:Name="Root">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,2">
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
            <controls:HelpIcon ToolType="{Binding ToolType, ElementName=Root}"
                               ParameterName="{Binding ParameterName, ElementName=Root}"
                               Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="White" Foreground="Black" BorderBrush="#AAAAAA"
                     Padding="5,3" Margin="0,0,0,5"/>
            <Button x:Name="BrowseBtn" Grid.Column="1" Content="📂" FontSize="13"
                    Click="BrowseButton_Click"
                    Width="28" Margin="3,0,0,5" Padding="0,2"
                    ToolTip="파일 탐색기에서 선택"
                    Background="#3E3E42" Foreground="White" BorderBrush="#666"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BrowseFilter, ElementName=Root, Converter={x:Static controls:NotNullToBoolConverter.Instance}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BrowseFolder, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
