<UserControl x:Class="VMS.VisionSetup.Controls.ParamCodeLink"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ComboBox ItemsSource="{Binding AvailableParamCodes, ElementName=Root}"
              SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
              DisplayMemberPath="DisplayText"
              Style="{StaticResource WindowDarkComboBox}"
              Height="22" MinHeight="22" FontSize="10" Padding="4,1"
              Margin="0,2,0,4"
              ToolTip="Web Parameter Link Code"/>
</UserControl>
