<UserControl x:Class="VMS.VisionSetup.Controls.ParamCodeLink"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel>
        <ComboBox ItemsSource="{Binding AvailableParamCodes, ElementName=Root}"
                  SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                  DisplayMemberPath="DisplayText"
                  Style="{StaticResource WindowDarkComboBox}"
                  Height="22" MinHeight="22" FontSize="10" Padding="4,1"
                  Margin="0,2,0,0"
                  ToolTip="Web Parameter Link Code"/>

        <!-- 링크 상태 배지 — "VisionSetup 에서 고쳤는데 운전에 반영 안 됨" 혼선 방지 (2026-08-19 현장).
             링크된 파라미터는 운전(AUTO RUN) 시 매 검사마다 Web 값으로 덮어써진다는 사실을
             값 입력칸 바로 아래에서 알려주고, 로컬 값과 Web 값이 다르면 경고색으로 승격. -->
        <Border x:Name="LinkBadge" Visibility="Collapsed"
                CornerRadius="3" Padding="6,3" Margin="0,3,0,4"
                Background="{StaticResource BrushInfoSoft}"
                BorderThickness="1" BorderBrush="{StaticResource BrushBorderSubtle}">
            <TextBlock x:Name="LinkBadgeText" FontSize="10" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextMuted}"/>
        </Border>
    </StackPanel>
</UserControl>
