<UserControl x:Class="VMS.VisionSetup.Controls.ParamCodeLink"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ComboBox ItemsSource="{Binding AvailableParamCodes, ElementName=Root}"
              SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
              DisplayMemberPath="DisplayText"
              Height="22" FontSize="10"
              Margin="0,2,0,4"
              ToolTip="Web Parameter Link Code">
        <ComboBox.Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="#909090"/>
                <Setter Property="BorderBrush" Value="#404040"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,1"/>
            </Style>
        </ComboBox.Style>
    </ComboBox>
</UserControl>
