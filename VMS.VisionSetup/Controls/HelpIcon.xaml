<UserControl x:Class="VMS.VisionSetup.Controls.HelpIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="20" d:DesignWidth="20">

    <UserControl.Resources>
        <Style x:Key="HelpToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="BackgroundCircle"
                                     Fill="#3399FF"
                                     Width="16" Height="16"/>
                            <TextBlock Text="?"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundCircle" Property="Fill" Value="#66B3FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundCircle" Property="Fill" Value="#0066CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 호버 트리거: 마우스 진입 시 짧은 delay 후 Popup 표시, 떠나면 자동 닫기 -->
        <ToggleButton x:Name="HelpButton"
                      Style="{StaticResource HelpToggleButtonStyle}"
                      MouseEnter="HelpButton_MouseEnter"
                      MouseLeave="HelpButton_MouseLeave"/>

        <!-- Help Popup -->
        <!--
            StaysOpen=True: 팝업 외부 클릭에 즉시 닫히지 않음.
            팝업 내부 클릭/휠 이벤트가 자식 컨트롤(Border)에서 정상 처리되도록 보장.
            닫기: X 버튼 또는 ? 아이콘 재클릭.
        -->
        <Popup x:Name="HelpPopup"
               PlacementTarget="{Binding ElementName=HelpButton}"
               Placement="Right"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border x:Name="HelpBorder"
                    Background="#2D2D30"
                    BorderBrush="#007ACC"
                    BorderThickness="1"
                    CornerRadius="5"
                    MaxWidth="400"
                    MinWidth="250"
                    Padding="15"
                    Cursor="Hand"
                    MouseEnter="HelpBorder_MouseEnter"
                    MouseLeave="HelpBorder_MouseLeave"
                    PreviewMouseWheel="HelpBorder_PreviewMouseWheel"
                    PreviewMouseLeftButtonDown="HelpBorder_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="HelpTitle"
                                   Grid.Column="0"
                                   Text="도움말"
                                   Foreground="#FFD700"
                                   FontWeight="Bold"
                                   FontSize="14"/>

                        <Button Grid.Column="1"
                                Content="X"
                                Background="Transparent"
                                Foreground="Gray"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="CloseHelp_Click"
                                Width="20" Height="20"
                                VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Cognex Equivalent (if available) -->
                    <Border x:Name="CognexBorder"
                            Grid.Row="1"
                            Background="#1E3A5F"
                            CornerRadius="3"
                            Padding="8,5"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cognex: "
                                       Foreground="#7FBADC"
                                       FontSize="11"/>
                            <TextBlock x:Name="CognexText"
                                       Foreground="#A0D0F0"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Content -->
                    <ScrollViewer x:Name="HelpScroll"
                                  Grid.Row="2"
                                  MaxHeight="600"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Description -->
                            <TextBlock x:Name="HelpDescription"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       LineHeight="20"/>

                            <!-- Usage (if available) -->
                            <Border x:Name="UsageBorder"
                                    Background="#252526"
                                    CornerRadius="3"
                                    Padding="10"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="사용 예시"
                                               Foreground="#4EC9B0"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Margin="0,0,0,5"/>
                                    <TextBlock x:Name="UsageText"
                                               Foreground="#CCCCCC"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
