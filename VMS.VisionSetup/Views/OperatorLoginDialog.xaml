<Window x:Class="VMS.VisionSetup.Views.OperatorLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        Title="Operator Login"
        Width="440" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgWindow}"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- WindowStyles 리소스는 코드 비하인드에서 InitializeComponent 직전에 Application.Resources 로 머지됨
         (VMS Launcher 가 띄울 때도 동작하도록 EnsureWindowStylesMerged 사용). -->


    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="Operator Login"
                                  ShowMinMaxButtons="False"/>

            <Grid Grid.Row="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="작업자 로그인"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="1" Text="사번과 PIN을 입력하세요. Web에 등록된 작업자만 로그인할 수 있습니다."
                           Style="{StaticResource WindowMutedText}" Margin="0,0,0,14"/>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="사번"
                               Style="{StaticResource WindowFieldLabel}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="EmployeeNumberBox"
                             Text="{Binding EmployeeNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WindowDarkTextBox}"
                             FontSize="13"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PIN"
                               Style="{StaticResource WindowFieldLabel}"
                               VerticalAlignment="Center"/>
                    <PasswordBox Grid.Column="1" x:Name="PinBox"
                                 PasswordChanged="PinBox_PasswordChanged"
                                 Background="{StaticResource BrushBgInput}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 CaretBrush="White"
                                 BorderBrush="{StaticResource BrushBorderSubtle}"
                                 BorderThickness="1"
                                 Padding="8,5"
                                 FontSize="13"
                                 KeyDown="PinBox_KeyDown"/>
                </Grid>

                <TextBlock Grid.Row="4"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource BrushDanger}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top" Margin="0,4,0,0"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel" Width="92" Margin="0,0,8,0"
                            IsCancel="True"
                            Style="{StaticResource ModernGhostButton}"/>
                    <Button Content="Login" Width="92"
                            IsDefault="True"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource ModernPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
