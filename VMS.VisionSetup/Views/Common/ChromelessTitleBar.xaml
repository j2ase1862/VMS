<UserControl x:Class="VMS.VisionSetup.Views.Common.ChromelessTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:self="clr-namespace:VMS.VisionSetup.Views.Common"
             Height="42"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{StaticResource BrushBgTitleBar}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">

            <!-- Brand (left) -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="22" Height="22" CornerRadius="5"
                        Background="{StaticResource BrushAccent}">
                    <Path Data="M3,3 L9,3 L9,9 L3,9 Z M11,3 L17,3 L17,9 L11,9 Z M3,11 L9,11 L9,17 L3,17 Z M11,11 L17,11 L17,17 L11,17 Z"
                          Fill="#0A1218" Stretch="Uniform" Width="11" Height="11"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding TitleText, ElementName=Root}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border Background="{StaticResource BrushBgSurface}"
                        CornerRadius="10" Padding="8,2" Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasStatus, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusText, ElementName=Root}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"/>
                </Border>
            </StackPanel>

            <!-- Window control buttons (right) -->
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource TitleBarCloseButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{x:Static SystemCommands.CloseWindowCommand}">
                <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.2" Width="10" Height="10"/>
            </Button>

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource TitleBarButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Visibility="{Binding ShowMinMaxButtons, ElementName=Root, Converter={StaticResource BoolToVis}}"
                    Command="{x:Static SystemCommands.MaximizeWindowCommand}">
                <Path Data="M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.2" Width="10" Height="10" Fill="Transparent"/>
            </Button>

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource TitleBarButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Visibility="{Binding ShowMinMaxButtons, ElementName=Root, Converter={StaticResource BoolToVis}}"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                <Path Data="M 0 5 L 10 5"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.2" Width="10" Height="10"/>
            </Button>

            <!-- Filler space (drag area) -->
            <Border Background="Transparent"/>
        </DockPanel>
    </Border>
</UserControl>
