<Window x:Class="VMS.VisionSetup.Views.Common.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="460"
        Style="{x:Null}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <!-- 테마 키는 WindowStyles.xaml 토큰만 사용 — VMS(참조)·VisionSetup(원본)·
         AppSetup(Linked Page) 세 앱 모두에서 로드 가능해야 한다.
         그림자/라운드는 테마 키 의존 없이 로컬 정의. -->
    <Border Background="{StaticResource BrushBgCard}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                              Color="#000000" Opacity="0.45"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: icon + title -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">
                <TextBlock x:Name="IconText"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="28"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBlock x:Name="TitleText"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Body message — 긴 메시지도 자동 줄바꿈 -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       FontSize="13"
                       Foreground="{StaticResource BrushTextSecondary}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,24"/>

            <!-- Footer buttons — 우측 정렬, Primary 가 가장 오른쪽 -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton"
                        Content="아니오"
                        Style="{StaticResource ModernGhostButton}"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Click="OnSecondaryClick"
                        Visibility="Collapsed"
                        IsCancel="True"/>
                <Button x:Name="PrimaryButton"
                        Content="확인"
                        Style="{StaticResource ModernPrimaryButton}"
                        MinWidth="90"
                        Click="OnPrimaryClick"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
