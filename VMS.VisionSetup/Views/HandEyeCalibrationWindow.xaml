<Window x:Class="VMS.VisionSetup.Views.HandEyeCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hand-Eye Calibration Wizard"
        Width="850" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Step Progress Indicator -->
        <Border Grid.Row="0" Background="#252526" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="0. Setup">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                    <Setter Property="Foreground" Value="#FF9800"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=" ► " Foreground="#444" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Text="1. Collect">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                    <Setter Property="Foreground" Value="#FF9800"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=" ► " Foreground="#444" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Text="2. Calibrate">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                    <Setter Property="Foreground" Value="#FF9800"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=" ► " Foreground="#444" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Text="3. Save">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                    <Setter Property="Foreground" Value="#FF9800"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Main Content: 2 Columns -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Controls per step -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Step 0: Setup -->
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Board Parameters" Foreground="#FF9800" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                        <TextBlock Text="Corners X" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding BoardCornersX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,2,0,8"/>

                        <TextBlock Text="Corners Y" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding BoardCornersY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,2,0,8"/>

                        <TextBlock Text="Square Size (mm)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SquareSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,2,0,8"/>

                        <TextBlock Text="Method" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Methods}"
                                  SelectedItem="{Binding SelectedMethod}"
                                  Background="#2D2D30" Foreground="Black" BorderBrush="#555"
                                  FontSize="11" Padding="4,3" MinHeight="26" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Step 1: Collect -->
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Data Collection" Foreground="#FF9800" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <Button Command="{Binding CaptureCommand}" Content="Capture"
                                    Background="#2196F3" Style="{StaticResource ActionButton}" Padding="8,5" Margin="0,0,2,0"/>
                            <Button Command="{Binding RemoveLastPairCommand}" Content="Remove"
                                    Background="#757575" Style="{StaticResource ActionButton}" Padding="8,5" Margin="2,0"/>
                            <Button Command="{Binding ClearAllPairsCommand}" Content="Clear"
                                    Background="#F44336" Style="{StaticResource ActionButton}" Padding="8,5" Margin="2,0,0,0"/>
                        </UniformGrid>

                        <TextBlock Foreground="#AAAAAA" FontSize="10" Margin="0,0,0,8">
                            <Run Text="수집된 데이터: "/>
                            <Run Text="{Binding PairCount, Mode=OneWay}"/>
                            <Run Text=" / 최소 3개"/>
                        </TextBlock>

                        <DataGrid ItemsSource="{Binding CalibrationPairs}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#252526" Foreground="White"
                                  BorderBrush="#333" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" RowHeight="24"
                                  FontSize="10" MaxHeight="300"
                                  CanUserResizeRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333"/>
                                    <Setter Property="Foreground" Value="#CCC"/>
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Setter Property="FontSize" Value="10"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#252526"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3A3A3C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="30"/>
                                <DataGridTextColumn Header="Pose" Binding="{Binding PoseText}" Width="*"/>
                                <DataGridTextColumn Header="Corners" Binding="{Binding CornerCount}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Step 2: Calibrate -->
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Calibration" Foreground="#FF9800" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                        <Button Command="{Binding CalibrateCommand}" Content="Run Calibration"
                                Background="#9C27B0" Style="{StaticResource ActionButton}"
                                Padding="16,8" Margin="0,0,0,12" HorizontalAlignment="Left"/>

                        <ProgressBar IsIndeterminate="{Binding IsCalibrating}" Height="4"
                                     Background="#333" Foreground="#9C27B0" Margin="0,0,0,12"
                                     Visibility="{Binding IsCalibrating, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="Reprojection Error:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12">
                            <Run Text="{Binding ReprojectionError, StringFormat='{}{0:F4} px', Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Text="Result Matrix (T_tcp_cam):" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ResultMatrixText, Mode=OneWay}"
                                 Background="#1A1A1A" Foreground="#4FC3F7" BorderBrush="#333"
                                 FontFamily="Consolas" FontSize="11"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" Padding="8,6"
                                 MinHeight="80"/>
                    </StackPanel>

                    <!-- Step 3: Save -->
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Save Result" Foreground="#FF9800" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                        <Button Command="{Binding SaveResultCommand}" Content="Save as JSON..."
                                Background="#4CAF50" Style="{StaticResource ActionButton}"
                                Padding="16,8" Margin="0,0,0,12" HorizontalAlignment="Left"/>

                        <TextBlock Text="Saved Path:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SavedFilePath, Mode=OneWay}"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                 TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Border Background="#252526" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Summary" Foreground="#FF9800" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                <TextBlock Foreground="#AAA" FontSize="11">
                                    <Run Text="Data Pairs: "/>
                                    <Run Text="{Binding PairCount, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="#AAA" FontSize="11">
                                    <Run Text="Method: "/>
                                    <Run Text="{Binding SelectedMethod, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="#AAA" FontSize="11">
                                    <Run Text="Error: "/>
                                    <Run Text="{Binding ReprojectionError, StringFormat='{}{0:F4} px', Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="#AAA" FontSize="11">
                                    <Run Text="Board: "/>
                                    <Run Text="{Binding BoardCornersX, Mode=OneWay}"/>
                                    <Run Text="x"/>
                                    <Run Text="{Binding BoardCornersY, Mode=OneWay}"/>
                                    <Run Text=" @ "/>
                                    <Run Text="{Binding SquareSize, StringFormat='{}{0:F1}mm', Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Right: Image Preview -->
            <Border Grid.Column="1" Background="#111111" CornerRadius="4" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="체스보드 이미지 미리보기" Foreground="#333"
                               FontSize="13" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#252526" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#AAAAAA" FontSize="11"/>
        </Border>

        <!-- Navigation Buttons -->
        <Border Grid.Row="3" Background="#1E1E1E" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding PreviousStepCommand}" Content="◄ Previous"
                        Background="#3A3A3C" Style="{StaticResource ActionButton}" Padding="16,6" Margin="0,0,8,0"/>
                <Button Command="{Binding NextStepCommand}" Content="Next ►"
                        Background="#FF9800" Style="{StaticResource ActionButton}" Padding="16,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
