<Window x:Class="VMS.VisionSetup.Views.OnnxSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dl="clr-namespace:VMS.VisionSetup.VisionTools.DeepLearning"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Inference Engine Settings"
        Width="520" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2D2D30"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Window.Resources>
        <ObjectDataProvider x:Key="ProviderValues" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="dl:OnnxExecutionProvider"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Execution Provider"
                   Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="1" x:Name="ProviderComboBox"
                  ItemsSource="{Binding Source={StaticResource ProviderValues}}"
                  Background="#3E3E42" Foreground="White"
                  BorderBrush="#555555" BorderThickness="1"
                  Padding="6,4" FontSize="13"/>

        <TextBlock Grid.Row="2" Text="TensorRT Engine Cache Folder (optional, TRT EP only)"
                   Foreground="#CCCCCC" FontSize="12" Margin="0,12,0,4"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TrtCacheTextBox"
                     Background="#3E3E42" Foreground="White"
                     BorderBrush="#555555" BorderThickness="1"
                     Padding="6,4" FontSize="13"
                     CaretBrush="White"
                     SelectionBrush="#0078D4"/>
            <Button Grid.Column="1" Content="Browse..." Width="80" Margin="6,0,0,0"
                    Click="BrowseButton_Click"
                    Background="#3E3E42" Foreground="White"
                    BorderBrush="#555555" BorderThickness="1" Padding="0,4"
                    Cursor="Hand"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="Empty = no cache. When set, TRT engines are cached here to skip rebuild on subsequent runs."
                   Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <CheckBox Grid.Row="5" x:Name="Fp16CheckBox"
                  Content="Enable TensorRT FP16 (RTX 계열에서 2~3배 속도 향상)"
                  Foreground="#CCCCCC" FontSize="12" Margin="0,14,0,0"/>

        <TextBlock Grid.Row="6"
                   Text="※ 변경된 설정은 다음번 모델 로드/세션 재생성 시점부터 적용됩니다."
                   Foreground="#888888" FontSize="10" Margin="0,14,0,0"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0"
                    IsDefault="True" Click="SaveButton_Click"
                    Background="#0078D4" Foreground="White"
                    BorderThickness="0" Padding="0,5"
                    Cursor="Hand"/>
            <Button Content="Cancel" Width="80"
                    IsCancel="True"
                    Background="#3E3E42" Foreground="White"
                    BorderBrush="#555555" BorderThickness="1" Padding="0,5"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
