<Window x:Class="VMS.VisionSetup.Views.OnnxSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        xmlns:dl="clr-namespace:VMS.VisionSetup.VisionTools.DeepLearning"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Inference Engine Settings"
        Width="580" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgWindow}"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ObjectDataProvider x:Key="ProviderValues" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="dl:OnnxExecutionProvider"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="Inference Engine Settings"
                                  ShowMinMaxButtons="False"/>

            <Grid Grid.Row="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Inference Engine"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="ONNX Runtime의 실행 백엔드와 캐시 설정을 변경합니다."
                               Style="{StaticResource WindowMutedText}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource WindowCard}">
                    <StackPanel>
                        <TextBlock Text="Execution Provider" Style="{StaticResource WindowFieldLabel}"/>
                        <ComboBox x:Name="ProviderComboBox"
                                  ItemsSource="{Binding Source={StaticResource ProviderValues}}"
                                  Style="{StaticResource WindowDarkComboBox}"/>

                        <TextBlock Text="TensorRT Engine Cache Folder (선택)"
                                   Style="{StaticResource WindowFieldLabel}" Margin="0,10,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TrtCacheTextBox"
                                     Style="{StaticResource WindowDarkTextBox}"/>
                            <Button Grid.Column="1" Content="Browse" Width="92" Margin="8,0,0,0"
                                    Click="BrowseButton_Click"
                                    Style="{StaticResource ModernGhostButton}"/>
                        </Grid>
                        <TextBlock Text="비워두면 캐시 없음. 설정 시 TensorRT 엔진을 캐시하여 재실행 시 재빌드를 건너뜁니다."
                                   Style="{StaticResource WindowMutedText}" Margin="0,4,0,0"/>

                        <CheckBox x:Name="Fp16CheckBox"
                                  Content="Enable TensorRT FP16 (RTX 계열에서 2~3배 속도 향상)"
                                  Style="{StaticResource WindowDarkCheckBox}"
                                  Margin="0,14,0,0"/>

                        <TextBlock Text="※ 변경된 설정은 다음번 모델 로드/세션 재생성 시점부터 적용됩니다."
                                   Style="{StaticResource WindowMutedText}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Save" Width="92" Margin="0,0,8,0"
                            IsDefault="True" Click="SaveButton_Click"
                            Style="{StaticResource ModernPrimaryButton}"/>
                    <Button Content="Cancel" Width="92"
                            IsCancel="True"
                            Style="{StaticResource ModernGhostButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
