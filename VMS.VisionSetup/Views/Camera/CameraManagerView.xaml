<UserControl x:Class="VMS.VisionSetup.Views.Camera.CameraManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BrushBgWindow}"
             Foreground="{StaticResource BrushTextPrimary}"
             d:DesignHeight="500" d:DesignWidth="500">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="CameraListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushBgHover}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource BrushBgSelected}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Camera List Panel -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Cameras"
                       Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="14"
                       Margin="0,0,0,10"/>

            <ListBox Grid.Row="1"
                     Background="{StaticResource BrushBgCard}"
                     BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                     ItemContainerStyle="{StaticResource CameraListItemStyle}"
                     ItemsSource="{Binding Cameras}"
                     SelectedItem="{Binding SelectedCamera, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DisplayInfo}"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Add" Command="{Binding AddCameraCommand}"
                        Style="{StaticResource ModernPrimaryButton}" Width="55" Margin="2"/>
                <Button Content="Remove" Command="{Binding RemoveCameraCommand}"
                        Style="{StaticResource ModernDangerButton}" Width="65" Margin="2"
                        IsEnabled="{Binding HasSelection}"/>
            </StackPanel>
        </Grid>

        <!-- Camera Properties Panel -->
        <Border Grid.Column="1"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="15">
            <Grid Visibility="{Binding IsPropertiesPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Camera Properties"
                           Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource WindowFieldLabel}"/>
                        <TextBox Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Manufacturer" Style="{StaticResource WindowFieldLabel}"/>
                        <ComboBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource WindowDarkComboBoxEditable}"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="Basler"/>
                            <ComboBoxItem Content="IDS"/>
                            <ComboBoxItem Content="HIK"/>
                            <ComboBoxItem Content="Allied Vision"/>
                            <ComboBoxItem Content="JAI"/>
                            <ComboBoxItem Content="Point Grey"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <TextBlock Text="Model" Style="{StaticResource WindowFieldLabel}"/>
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Serial Number" Style="{StaticResource WindowFieldLabel}"/>
                        <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Width" Style="{StaticResource WindowFieldLabel}"/>
                                <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height" Style="{StaticResource WindowFieldLabel}"/>
                                <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Connection String (IP or Device Path)" Style="{StaticResource WindowFieldLabel}"/>
                        <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>

                        <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}"
                                  Style="{StaticResource WindowDarkCheckBox}" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                    <Button Content="Save" Command="{Binding SaveCameraCommand}"
                            Style="{StaticResource ModernPrimaryButton}" Width="70" Margin="2"/>
                    <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                            Style="{StaticResource ModernSecondaryButton}" Width="70" Margin="2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
