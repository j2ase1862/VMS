<Window x:Class="VMS.VisionSetup.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VMS.VisionSetup"
        xmlns:ts="clr-namespace:VMS.VisionSetup.Views.ToolSettings"
        xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
        xmlns:converters="clr-namespace:VMS.VisionSetup.Converters"
        xmlns:vm="clr-namespace:VMS.VisionSetup.ViewModels"
        xmlns:recipe="clr-namespace:VMS.VisionSetup.Views.Recipe"
        xmlns:camera="clr-namespace:VMS.VisionSetup.Views.Camera"
        xmlns:core="clr-namespace:VMS.Core.Controls;assembly=VMS.Core"

        mc:Ignorable="d"
        Title="BODA VISION AI - OpenCvSharp Vision System"
        WindowStartupLocation="Manual"
        Left="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Left}"
        Top="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Top}"
        Width="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        Height="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStyle="None"
        ResizeMode="NoResize"
        Icon="/icon/VisionSetup.ico"
        Background="{StaticResource BrushBgWindow}">

    <Window.InputBindings>
        <!-- 폴더 이미지 네비게이션: ←/→ 키로 이전/다음 이미지 -->
        <KeyBinding Key="Left"  Command="{Binding PreviousImageCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextImageCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <converters:DisplayModeToStringConverter x:Key="DisplayModeToStringConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>

        <DropShadowEffect x:Key="ToolbarButtonShadow" ShadowDepth="1" BlurRadius="4"
                          Opacity="0.4" Color="Black" Direction="270"/>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#48FFFFFF" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Border x:Name="HoverOverlay" CornerRadius="5" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#70FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Background" Value="#15000000"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A2A2C"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#10FFFFFF"/>
                                <Setter TargetName="Content" Property="Opacity" Value="0.3"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushBgHover}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style — subtle red text/border, not red background -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
        </Style>

        <!-- Step Control Button Style -->
        <Style x:Key="StepControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgSurface}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505054"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tool Item Close Button Style -->
        <Style x:Key="ToolCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                                <Setter Property="Foreground" Value="#FF5252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Icon-only toolbar button (compact) -->
        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>
        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
        </Style>

        <!-- Toolbar group container -->
        <Style x:Key="ToolbarGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#28FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="3,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" Padding="10,5">
            <DockPanel>
                <!-- Close Button (right-aligned) -->
                <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}"
                        ToolTip="Close Application"
                        Margin="8,0,0,0" Padding="10,7" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder" CornerRadius="6"
                                    Background="Transparent" Padding="{TemplateBinding Padding}"
                                    BorderBrush="#50FFFFFF" BorderThickness="1">
                                <Path x:Name="CloseIcon"
                                      Data="M4,4 L16,16 M16,4 L4,16"
                                      Stroke="#AAAAAA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#C42B1C"/>
                                    <Setter TargetName="CloseBorder" Property="BorderBrush" Value="#E04535"/>
                                    <Setter TargetName="CloseIcon" Property="Stroke" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#A02018"/>
                                    <Setter TargetName="CloseBorder" Property="BorderBrush" Value="#C42B1C"/>
                                    <Setter TargetName="CloseIcon" Property="Stroke" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Menu Bar + Inline Actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- ═══ Menu ═══ -->
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Menu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Foreground" Value="{StaticResource BrushBgWindow}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Style.Triggers>
                                    <Trigger Property="Role" Value="TopLevelHeader">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="Role" Value="TopLevelItem">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Menu.Resources>

                        <!-- File -->
                        <!-- File -->
                        <MenuItem Header="_File">
                            <MenuItem Header="Open Image" Command="{Binding OpenImageFileCommand}" InputGestureText="Ctrl+O">
                                <MenuItem.Icon>
                                    <Path Data="M2,6 L2,16 L18,16 L18,8 L11,8 L9,6 Z"
                                          Stroke="#BBBBBB" StrokeThickness="1.2" Fill="Transparent"
                                          Width="14" Height="11" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open Folder" Command="{Binding OpenImageFolderCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M1,5 L1,15 L19,15 L19,7 L10,7 L8,5 Z M3,5 L3,3 L12,3 L14,5"
                                          Stroke="#FFC107" StrokeThickness="1.2" Fill="Transparent"
                                          Width="14" Height="11" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- Run -->
                        <MenuItem Header="_Run">
                            <MenuItem Header="Run All" Command="{Binding RunAllCommand}" InputGestureText="F5">
                                <MenuItem.Icon>
                                    <Path Data="M4,2 L16,10 L4,18 Z" Fill="#4CAF50"
                                          Width="11" Height="12" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Run Selected" Command="{Binding RunSelectedCommand}" InputGestureText="F6">
                                <MenuItem.Icon>
                                    <Canvas Width="13" Height="12">
                                        <Path Data="M1,1 L9,6 L1,11 Z" Fill="#00ADB5"/>
                                        <Path Data="M11.5,1 L11.5,11" Stroke="#00ADB5" StrokeThickness="2"/>
                                    </Canvas>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Clear All Tools" Command="{Binding ClearToolsCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M6,6 L6,17 L14,17 L14,6 M4,4 L16,4 M8,2 L12,2 M9,8 L9,15 M11,8 L11,15"
                                          Stroke="#E57373" StrokeThickness="1.2"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- Recipe -->
                        <MenuItem Header="R_ecipe">
                            <MenuItem Header="Recipe Manager" Click="RecipeManager_Click">
                                <MenuItem.Icon>
                                    <Path Data="M4,2 L4,18 L14,18 L14,6 L10,2 Z M10,2 L10,6 L14,6 M7,10 L12,10 M7,13 L11,13"
                                          Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save Recipe" Command="{Binding SaveRecipeCommand}" InputGestureText="Ctrl+S">
                                <MenuItem.Icon>
                                    <Path Data="M3,2 L3,18 L17,18 L17,6 L13,2 Z M6,2 L6,7 L12,7 L12,2 M6,12 L14,12 M6,15 L14,15"
                                          Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- Sequence -->
                        <MenuItem Header="_Sequence" Click="SequenceEditor_Click">
                            <MenuItem.Icon>
                                <Path Data="M4,4 L4,8 L8,8 L8,4 Z M12,4 L12,8 L16,8 L16,4 Z M8,6 L12,6 M6,8 L6,12 M14,8 L14,12 M4,12 L4,16 L8,16 L8,12 Z M12,12 L12,16 L16,16 L16,12 Z"
                                      Stroke="White" StrokeThickness="1.1" Fill="Transparent"
                                      Width="14" Height="13" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Deep Learning -->
                        <MenuItem Header="_Deep Learning" Click="DeepLearning_Click">
                            <MenuItem.Icon>
                                <Path Data="M10,2 C5.6,2 2,5.6 2,10 C2,14.4 5.6,18 10,18 C14.4,18 18,14.4 18,10 C18,5.6 14.4,2 10,2 Z M10,5 L12,8 L10,7 L8,8 Z M6,10 L8,8 L7,10 L8,12 Z M10,15 L8,12 L10,13 L12,12 Z M14,10 L12,12 L13,10 L12,8 Z"
                                      Stroke="#4CAF50" StrokeThickness="1.1" Fill="Transparent"
                                      Width="14" Height="13" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Batch Test Runner -->
                        <MenuItem Header="_Batch Test..." Click="BatchTest_Click">
                            <MenuItem.Icon>
                                <Path Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z M3,4 L5,6 L6,3 M10,4 L12,6 L13,3 M3,11 L5,13 L6,10 M10,11 L12,13 L13,10"
                                      Stroke="#4CAF50" StrokeThickness="1.2" Fill="Transparent"
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Synthetic OCR Data Generator -->
                        <MenuItem Header="OCR _Synth Data..." Click="SynthData_Click">
                            <MenuItem.Icon>
                                <Path Data="M2,4 L18,4 L18,8 L2,8 Z M2,10 L18,10 L18,14 L2,14 Z M4,16 L10,16 L10,18 L4,18 Z"
                                      Stroke="#9C27B0" StrokeThickness="1.1" Fill="Transparent"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Inference Engine Settings -->
                        <MenuItem Header="Inference _Settings..." Click="OnnxSettings_Click">
                            <MenuItem.Icon>
                                <Path Data="M10,6 A4,4 0 1 1 10,14 A4,4 0 1 1 10,6 M10,1 L10,4 M10,16 L10,19 M1,10 L4,10 M16,10 L19,10 M3.5,3.5 L5.5,5.5 M14.5,14.5 L16.5,16.5 M3.5,16.5 L5.5,14.5 M14.5,5.5 L16.5,3.5"
                                      Stroke="#FFD54F" StrokeThickness="1.2" Fill="Transparent"
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Camera -->
                        <MenuItem Header="_Camera">
                            <MenuItem Header="Camera Manager" Click="CameraManager_Click">
                                <MenuItem.Icon>
                                    <Path Data="M2,6 L2,15 L18,15 L18,6 L15,6 L13,4 L7,4 L5,6 Z M10,7.5 A2.5,2.5 0 1 1 10,12.5 A2.5,2.5 0 1 1 10,7.5"
                                          Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                          Width="14" Height="11" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Calibration Manager..." Click="CalibrationManager_Click">
                                <MenuItem.Icon>
                                    <Path Data="M2,2 L8,2 L8,8 L2,8 Z M10,2 L16,2 L16,8 L10,8 Z M2,10 L8,10 L8,16 L2,16 Z M10,10 L16,10 L16,16 L10,16 Z"
                                          Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CameraInfoMenuItem" Header="Camera Info" Command="{Binding ShowCameraInfoCommand}">
                                <MenuItem.Icon>
                                    <Grid Width="14" Height="12">
                                        <Path Data="M2,6 L2,15 L18,15 L18,6 L15,6 L13,4 L7,4 L5,6 Z"
                                              Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                              Width="14" Height="11" Stretch="Uniform"/>
                                        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Margin="0,-1,-1,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCameraConnected}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Acquire Image" Command="{Binding AcquireImageCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M2,6 L2,15 L18,15 L18,6 L15,6 L13,4 L7,4 L5,6 Z M10,7.5 A2.5,2.5 0 1 1 10,12.5 A2.5,2.5 0 1 1 10,7.5 M3,17 L3,19 L17,19 L17,17"
                                          Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                          Width="14" Height="13" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Receive from VMS" Command="{Binding ReceiveFromVmsCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M3,4 L3,16 L17,16 L17,4 Z M7,1 L7,4 M13,1 L13,4 M3,8 L17,8"
                                          Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Start Live Receive" Command="{Binding StartLiveReceiveCommand}">
                                <MenuItem.Icon>
                                    <Ellipse Width="10" Height="10" Fill="#4CAF50"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Stop Live Receive" Command="{Binding StopLiveReceiveCommand}">
                                <MenuItem.Icon>
                                    <Ellipse Width="10" Height="10" Fill="#F44336"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- 3D -->
                        <MenuItem Header="_3D">
                            <MenuItem Header="Save 3D Data" Command="{Binding SavePointCloudCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M3,2 L3,18 L17,18 L17,6 L13,2 Z M6,2 L6,7 L12,7 L12,2 M6,12 L14,12 M6,15 L14,15"
                                          Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Load 3D Data" Command="{Binding LoadPointCloudCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M2,6 L2,16 L18,16 L18,8 L11,8 L9,6 Z"
                                          Stroke="#BBBBBB" StrokeThickness="1.2" Fill="Transparent"
                                          Width="14" Height="11" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Generate Height Map" Command="{Binding GenerateHeightMapCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M2,16 L6,8 L10,12 L14,4 L18,10 L18,16 Z"
                                          Stroke="#BBBBBB" StrokeThickness="1.1" Fill="Transparent"
                                          Width="14" Height="13" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save Height Slicing" Command="{Binding SaveHeightSlicingCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M2,4 L18,4 M2,10 L18,10 M2,16 L18,16"
                                          Stroke="#BBBBBB" StrokeThickness="1.3" Fill="Transparent"
                                          Width="14" Height="13" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Clear Height Slicing" Command="{Binding ClearHeightSlicingCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M4,4 L16,16 M16,4 L4,16"
                                          Stroke="#E57373" StrokeThickness="1.3" Fill="Transparent"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Icon Toolbar -->
        <Border Grid.Row="1" Background="#333337" Padding="6,3" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- File -->
                <Button Command="{Binding OpenImageFileCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Open Image (Ctrl+O)">
                    <Path Data="M2,6 L2,16 L18,16 L18,8 L11,8 L9,6 Z"
                          Stroke="White" StrokeThickness="1.4" Fill="Transparent"
                          Width="15" Height="12" Stretch="Uniform"/>
                </Button>
                <Button Command="{Binding OpenImageFolderCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Open Image Folder">
                    <Path Data="M1,5 L1,15 L19,15 L19,7 L10,7 L8,5 Z M3,5 L3,3 L12,3 L14,5"
                          Stroke="#FFC107" StrokeThickness="1.4" Fill="Transparent"
                          Width="15" Height="12" Stretch="Uniform"/>
                </Button>

                <Border Width="1" Background="{StaticResource BrushBgHover}" Margin="5,4" CornerRadius="1"/>

                <!-- Recipe -->
                <Button Click="RecipeManager_Click"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Recipe Manager">
                    <Path Data="M4,2 L4,18 L14,18 L14,6 L10,2 Z M10,2 L10,6 L14,6 M7,10 L12,10 M7,13 L11,13"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent"
                          Width="13" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Command="{Binding SaveRecipeCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Save Recipe (Ctrl+S)">
                    <Path Data="M3,2 L3,18 L17,18 L17,6 L13,2 Z M6,2 L6,7 L12,7 L12,2 M6,12 L14,12 M6,15 L14,15"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent"
                          Width="13" Height="14" Stretch="Uniform"/>
                </Button>

                <Border Width="1" Background="{StaticResource BrushBgHover}" Margin="5,4" CornerRadius="1"/>

                <!-- Execute -->
                <Button Command="{Binding RunAllCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Run All Tools (F5)">
                    <Path Data="M4,2 L16,10 L4,18 Z" Fill="#4CAF50"
                          Width="12" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Command="{Binding RunSelectedCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Run Selected Tool (F6)">
                    <Canvas Width="15" Height="14">
                        <Path Data="M1,1 L10,7 L1,13 Z" Fill="#00ADB5"/>
                        <Path Data="M13,1 L13,13" Stroke="#00ADB5" StrokeThickness="2.5"/>
                    </Canvas>
                </Button>
                <Button Command="{Binding ClearToolsCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Clear All Tools">
                    <Path Data="M6,6 L6,17 L14,17 L14,6 M4,4 L16,4 M8,2 L12,2 M9,8 L9,15 M11,8 L11,15"
                          Stroke="#E57373" StrokeThickness="1.3"
                          Width="13" Height="14" Stretch="Uniform"/>
                </Button>

                <Border Width="1" Background="{StaticResource BrushBgHover}" Margin="5,4" CornerRadius="1"/>

                <!-- Camera -->
                <Button Click="CameraManager_Click"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Camera Manager">
                    <Path Data="M2,6 L2,15 L18,15 L18,6 L15,6 L13,4 L7,4 L5,6 Z M10,7.5 A2.5,2.5 0 1 1 10,12.5 A2.5,2.5 0 1 1 10,7.5"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent"
                          Width="15" Height="12" Stretch="Uniform"/>
                </Button>
                <Button Command="{Binding AcquireImageCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Acquire Image">
                    <Path Data="M2,6 L2,15 L18,15 L18,6 L15,6 L13,4 L7,4 L5,6 Z M10,7.5 A2.5,2.5 0 1 1 10,12.5 A2.5,2.5 0 1 1 10,7.5 M3,17 L3,19 L17,19 L17,17"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent"
                          Width="15" Height="14" Stretch="Uniform"/>
                </Button>

                <!-- SLM Chat Bot -->
                <Border Width="1" Background="{StaticResource BrushBgHover}" Margin="5,4" CornerRadius="1"/>
                <Button Command="{Binding ShowChatWindowCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="SLM Recipe Bot (AI)">
                    <Path Data="M12,3C17.5,3 22,6.58 22,11C22,15.42 17.5,19 12,19C10.76,19 9.57,18.82 8.47,18.5C5.55,21 2,21 2,21C4.33,18.67 4.7,17.1 4.75,16.5C3.05,15.07 2,13.13 2,11C2,6.58 6.5,3 12,3Z"
                          Fill="#007ACC" Width="14" Height="12" Stretch="Uniform"/>
                </Button>

                <!-- Folder Navigation (contextual) -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasImageFolder, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="1" Background="{StaticResource BrushBgHover}" Margin="5,4" CornerRadius="1"/>
                    <Button Command="{Binding PreviousImageCommand}"
                            Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Previous Image">
                        <Path Data="M12,4 L5,10 L12,16" Stroke="White" StrokeThickness="2"
                              Fill="Transparent" Width="10" Height="13" Stretch="Uniform"/>
                    </Button>
                    <TextBlock Text="{Binding ImageFolderInfo}" Foreground="#CCC" FontSize="12"
                               VerticalAlignment="Center" Margin="4,0" MinWidth="120" TextAlignment="Center"/>
                    <Button Command="{Binding NextImageCommand}"
                            Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Next Image">
                        <Path Data="M6,4 L13,10 L6,16" Stroke="White" StrokeThickness="2"
                              Fill="Transparent" Width="10" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Border Width="1" Background="{StaticResource BrushBgHover}" Margin="5,4" CornerRadius="1"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="Navigate" Foreground="#AAA" FontSize="11" Margin="0,0,8,0"
                                     VerticalAlignment="Center" GroupName="FolderNavMode" ToolTip="Navigate Only"
                                     IsChecked="{Binding FolderNavigationMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NavigateOnly}"/>
                        <RadioButton Content="Run All" Foreground="{StaticResource BrushSuccess}" FontSize="11" Margin="0,0,8,0"
                                     VerticalAlignment="Center" GroupName="FolderNavMode" ToolTip="Auto Run All on navigate"
                                     IsChecked="{Binding FolderNavigationMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AutoRunAll}"/>
                        <RadioButton Content="Run Selected" Foreground="{StaticResource BrushAccent}" FontSize="11"
                                     VerticalAlignment="Center" GroupName="FolderNavMode" ToolTip="Auto Run Selected on navigate"
                                     IsChecked="{Binding FolderNavigationMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AutoRunSelected}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Camera Info Popup -->
        <Popup x:Name="CameraInfoPopup"
               PlacementTarget="{Binding ElementName=CameraInfoMenuItem}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsCameraInfoPopupOpen, Mode=TwoWay}">
            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                    CornerRadius="6" Padding="16" MinWidth="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <!-- No camera selected -->
                    <TextBlock Text="카메라를 선택하세요"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,10"
                               Visibility="{Binding SelectedCamera, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}"/>

                    <!-- Camera info panel -->
                    <StackPanel Visibility="{Binding SelectedCamera, Converter={StaticResource NullToCollapsedConverter}}">
                        <!-- Header with icon and name -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="M2,6 L2,15 L18,15 L18,6 L15,6 L13,4 L7,4 L5,6 Z M10,7.5 A2.5,2.5 0 1 1 10,12.5 A2.5,2.5 0 1 1 10,7.5"
                                  Stroke="#00BCD4" StrokeThickness="1.5" Fill="Transparent"
                                  Width="20" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCamera.Name}" Foreground="White"
                                       FontSize="15" FontWeight="Bold" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Details grid -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCamera.Manufacturer}" Foreground="White" FontSize="12" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCamera.Model}" Foreground="White" FontSize="12" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="IP Address" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCamera.ConnectionString}" Foreground="White" FontSize="12" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Resolution" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCamera.Resolution}" Foreground="White" FontSize="12" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,2"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCameraConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Foreground="White" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Disconnected"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCameraConnected}" Value="True">
                                                    <Setter Property="Text" Value="Connected"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Connect/Disconnect buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                            <Button Command="{Binding ConnectCameraCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="12,5" FontSize="12" Content="Connect"/>
                            <Button Command="{Binding DisconnectCameraCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="12,5" FontSize="12" Margin="6,0,0,0" Content="Disconnect"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Recipe / Camera / Step / Tool Palette -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3D3D3D" BorderThickness="0,0,1,0"
                    Margin="0,2,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Row 0: Recipe Name -->
                        <RowDefinition Height="Auto"/>  <!-- Row 1: Camera Selector -->
                        <RowDefinition Height="Auto"/>  <!-- Row 2: Inspection Mode -->
                        <RowDefinition Height="Auto"/>  <!-- Row 3: Step Management -->
                        <RowDefinition Height="Auto"/>  <!-- Row 4: Steps DataGrid -->
                        <RowDefinition Height="*"/>     <!-- Row 5: Tool Palette -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Current Recipe Name -->
                    <Border Grid.Row="0" Background="#1B5E20" CornerRadius="3" Margin="8,8,8,4" Padding="8,6">
                        <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="Now Recipe: " Foreground="#A5D6A7"/>
                            <Run Text="{Binding CurrentRecipeName, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </Border>

                    <!-- Row 1: Camera Selector -->
                    <StackPanel Grid.Row="1" Margin="8,4,8,4">
                        <TextBlock Text="Camera" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Cameras}"
                                  SelectedItem="{Binding SelectedCamera}"
                                  Style="{StaticResource WindowDarkComboBox}"
                                  FontSize="11" Padding="6,4" MinHeight="28">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 2: Robot Status + MultiView Setup Button -->
                    <StackPanel Grid.Row="2" Margin="8,2,8,0"
                                Visibility="{Binding NeedsRobot, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Robot MultiView" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>

                            <!-- MultiView Setup 버튼 -->
                            <Button Grid.Column="1" Click="MultiViewSetup_Click" Cursor="Hand"
                                    BorderThickness="0" Padding="0"
                                    ToolTip="MultiView Scan Setup">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#3A3A3C" CornerRadius="3" Padding="8,4">
                                            <TextBlock Text="Setup" Foreground="#D0D0D0" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Robot 연결 상태 표시 (간략) -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRobotConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="6,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Robot Disconnected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRobotConnected}" Value="True">
                                                <Setter Property="Text" Value="Robot Connected"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding MultiViewStatusText}" Foreground="#777" FontSize="10"
                                       Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 3: Step Management Header + Buttons -->
                    <Grid Grid.Row="3" Margin="8,4,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Steps" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="12"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Add Step -->
                            <Button Command="{Binding AddStepCommand}" ToolTip="Add Step"
                                    Style="{StaticResource StepControlButtonStyle}">
                                <Path Data="M12,2 L12,22 M2,12 L22,12" Stroke="#4CAF50" StrokeThickness="2"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <!-- Delete Step -->
                            <Button Command="{Binding DeleteStepCommand}" ToolTip="Delete Step"
                                    Style="{StaticResource StepControlButtonStyle}">
                                <Path Data="M3,6 L21,6 M8,6 L8,2 L16,2 L16,6 M5,6 L5,22 L19,22 L19,6"
                                      Stroke="#F44336" StrokeThickness="1.5"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <!-- Generate Robot Waypoint Steps -->
                            <Button Command="{Binding GenerateWaypointsCommand}" ToolTip="Generate Robot Waypoint Steps"
                                    Style="{StaticResource StepControlButtonStyle}">
                                <Path Data="M12,2 L12,8 M12,8 L8,5 M12,8 L16,5 M4,12 A8,8 0 1,0 20,12 M20,12 L17,10 M20,12 L17,14"
                                      Stroke="#00897B" StrokeThickness="1.5"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <!-- Move Up -->
                            <Button Command="{Binding MoveStepUpCommand}" ToolTip="Move Up"
                                    Style="{StaticResource StepControlButtonStyle}">
                                <Path Data="M12,4 L4,14 L9,14 L9,20 L15,20 L15,14 L20,14 Z"
                                      Fill="#2196F3" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <!-- Move Down -->
                            <Button Command="{Binding MoveStepDownCommand}" ToolTip="Move Down"
                                    Style="{StaticResource StepControlButtonStyle}">
                                <Path Data="M12,20 L4,10 L9,10 L9,4 L15,4 L15,10 L20,10 Z"
                                      Fill="#FF9800" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 4: Step DataGrid -->
                    <DataGrid Grid.Row="4" ItemsSource="{Binding Steps}"
                              SelectedItem="{Binding SelectedStep}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" CanUserAddRows="False"
                              Background="{StaticResource BrushBgCard}" Foreground="White"
                              BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                              RowBackground="{StaticResource BrushBgCard}" AlternatingRowBackground="#333337"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#444444"
                              Margin="8,4,8,4" MaxHeight="160" MinHeight="60"
                              FontSize="11">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource BrushBgSurface}"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Name}" Width="50"/>
                            <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution, StringFormat={}{0:F3}}" Width="70"/>
                            <DataGridTextColumn Header="Tools" Binding="{Binding Tools.Count}" Width="40"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Row 5: Tool Palette -->
                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="8,4,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tool Palette"
                                       Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Expand All -->
                                <Button Click="ToolPaletteExpandAll_Click" ToolTip="Expand All"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="4,2" Margin="0,0,2,0">
                                    <Path Data="M4,4 L12,12 L20,4 M4,12 L12,20 L20,12"
                                          Stroke="#AAAAAA" StrokeThickness="1.5"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <!-- Collapse All -->
                                <Button Click="ToolPaletteCollapseAll_Click" ToolTip="Collapse All"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="4,2">
                                    <Path Data="M4,20 L12,12 L20,20 M4,12 L12,4 L20,12"
                                          Stroke="#AAAAAA" StrokeThickness="1.5"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TreeView x:Name="ToolPaletteTreeView" Grid.Row="1" ItemsSource="{Binding ToolTree}"
                                  Background="Transparent" Foreground="White" BorderThickness="0"
                                  Margin="5,0,5,5">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Tools}">
                                    <TextBlock Text="{Binding CategoryName}"
                                               Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="12"/>
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushBgSurface}" CornerRadius="3"
                                                    Padding="8,4" Margin="0,2"
                                                    PreviewMouseMove="ToolItem_PreviewMouseMove"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White" FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                    <controls:HelpIcon ToolType="{Binding ToolType}"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Center Panel - Workspace and Images -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="700"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dropped Tools Workspace -->
                <Border Grid.Column="0" Background="{StaticResource BrushBgWindow}" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Tool Workspace (Drag tools here)"
                                   Foreground="Gray" FontSize="12" Margin="10,5"/>

                        <!-- 연결선 및 도구 워크스페이스 컨테이너 -->
                        <Grid Grid.Row="1" AllowDrop="True" Drop="Sidebar2_Drop" Background="{StaticResource BrushBgCard}">
                            <!-- 연결선 렌더링 캔버스 (도구 아래에 그려짐) -->
                            <Canvas x:Name="ConnectionCanvas" IsHitTestVisible="False"/>

                            <!-- 연결 모드 진행 중 안내 텍스트 -->
                            <TextBlock x:Name="ConnectionModeHint"
                                       Text=""
                                       Foreground="#FFEB3B" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,5,0,0" Visibility="Collapsed"/>

                            <!-- 도구 아이템 표시 -->
                            <ItemsControl x:Name="WorkspaceArea"
                                          ItemsSource="{Binding DroppedTools}"
                                          Background="Transparent">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ToolOuterBorder"
                                                BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                                CornerRadius="4,4,0,0" Cursor="Hand" Margin="2"
                                                MouseLeftButtonDown="Item_MouseLeftButtonDown"
                                                MouseMove="Item_MouseMove"
                                                MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                                MouseRightButtonDown="Item_MouseRightButtonDown"
                                                MinWidth="150">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <ContextMenu.Style>
                                                        <Style TargetType="ContextMenu">
                                                            <Setter Property="Background" Value="#2D2D30"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                                        </Style>
                                                    </ContextMenu.Style>
                                                    <MenuItem Header="Rename Tool"
                                                              Click="RenameToolMenuItem_Click"/>
                                                    <Separator Background="{StaticResource BrushBorderStrong}"/>
                                                    <MenuItem Header="Connect Image"
                                                              Tag="Image"
                                                              Click="ConnectMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <Ellipse Width="10" Height="10" Fill="#4CAF50"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Connect Coordinates"
                                                              Tag="Coordinates"
                                                              Click="ConnectMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <Ellipse Width="10" Height="10" Fill="#2196F3"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Connect Result"
                                                              Tag="Result"
                                                              Click="ConnectMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <Ellipse Width="10" Height="10" Fill="#FF9800"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Background="{StaticResource BrushBorderStrong}"/>
                                                    <MenuItem Header="Remove Connections"
                                                              Click="RemoveConnectionsMenuItem_Click"/>
                                                    <Separator Background="{StaticResource BrushBorderStrong}"/>
                                                    <MenuItem Header="Delete Tool"
                                                              Click="DeleteToolMenuItem_Click"
                                                              Foreground="#FF5252"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Tab Header: ToolType + Close button -->
                                                <Border x:Name="TabHeader" Grid.Row="0"
                                                        Background="#1A3A5C"
                                                        CornerRadius="3,3,0,0"
                                                        Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding ToolType}"
                                                                   Foreground="#B0C4DE" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="1" Content="X"
                                                                Style="{StaticResource ToolCloseButtonStyle}"
                                                                Command="{Binding DataContext.RemoveToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="6,0,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Tab Body: Name -->
                                                <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}"
                                                        Padding="8,5">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White" FontSize="12"
                                                               FontWeight="Normal"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="ToolOuterBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="TabHeader" Property="Background" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 연결 모드에서 임시 연결선 표시 캔버스 -->
                            <Canvas x:Name="TempConnectionCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch"
                              HorizontalAlignment="Center" Background="#333333" Cursor="SizeWE"/>

                <!-- Image Display Area - TabControl with 2D/3D views -->
                <Border Grid.Column="2" Background="{StaticResource BrushBgWindow}" Margin="5">
                    <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#999999"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="16,6"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="4,4,0,0" Margin="0,0,2,0">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BrushBgWindow}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BrushBgSurface}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BrushBgWindow}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- 2D View Tab -->
                        <TabItem Header="2D Image (Depth Source)">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto" MaxHeight="250"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Header - ComboBox Switcher + Clear Button -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5">
                                    <ComboBox ItemsSource="{Binding DisplayModes}"
                                              SelectedItem="{Binding SelectedDisplayMode}"
                                              Style="{StaticResource WindowDarkComboBox}"
                                              FontSize="12" Padding="8,3" MinWidth="150">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource DisplayModeToStringConverter}}"
                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Content="Clear Result"
                                            Command="{Binding ClearResultImageCommand}"
                                            Background="{StaticResource BrushBgSurface}" Foreground="White"
                                            BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                            Padding="8,2" Margin="10,0,0,0"
                                            FontSize="11" Cursor="Hand"
                                            Visibility="{Binding IsOriginalImageMode, Converter={StaticResource InverseBoolToVisibility}}"/>

                                    <Button Content="💾 Save Image"
                                            Command="{Binding SaveDisplayedImageCommand}"
                                            Background="#0E639C" Foreground="White"
                                            BorderBrush="#1177BB" BorderThickness="1"
                                            Padding="8,2" Margin="6,0,0,0"
                                            FontSize="11" Cursor="Hand"
                                            ToolTip="현재 표시 중인 이미지(Original/Result)를 파일로 저장 (PNG/JPG/BMP/TIFF)"/>
                                </StackPanel>

                                <!-- Row 1: ImageCanvas -->
                                <controls:ImageCanvas x:Name="ImageCanvasControl" Grid.Row="1"
                                                      SourceImage="{Binding DisplayMat, Mode=OneWay}"
                                                      ROICollection="{Binding ROIShapes, Mode=TwoWay}"
                                                      SelectedROI="{Binding SelectedROI, Mode=TwoWay}"
                                                      IsToolbarVisible="{Binding IsOriginalImageMode}"
                                                      IsROIEditingEnabled="{Binding IsOriginalImageMode}"
                                                      ROICreated="ImageCanvas_ROICreated"
                                                      ROIModified="ImageCanvas_ROIModified"
                                                      ROISelectionChanged="ImageCanvas_ROISelectionChanged"
                                                      Margin="5"/>

                                <!-- Row 2: Tool Run Results DataGrid -->
                                <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,1,0,0"
                                        Margin="5,0,5,5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Run Results"
                                                   Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="12"
                                                   Margin="5,5,5,3"/>

                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding ToolRunResults}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="#444444"
                                                  Background="{StaticResource BrushBgWindow}"
                                                  Foreground="White"
                                                  BorderBrush="{StaticResource BrushBorderStrong}"
                                                  BorderThickness="1"
                                                  RowBackground="#2D2D2D"
                                                  AlternatingRowBackground="#252526"
                                                  Height="150"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="True"
                                                  FontSize="12">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#3C3C3C"/>
                                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tool Name"
                                                                    Binding="{Binding ToolName}"
                                                                    Width="*"
                                                                    MinWidth="120">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Padding" Value="6,3"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Pass/Fail"
                                                                    Binding="{Binding Result}"
                                                                    Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Padding" Value="6,3"/>
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Result}" Value="True">
                                                                    <Setter Property="Foreground" Value="#4EC94E"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Result}" Value="False">
                                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Result Value"
                                                                    Binding="{Binding ResultValue}"
                                                                    Width="2*"
                                                                    MinWidth="150">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Padding" Value="6,3"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Depth Map Tab -->
                        <TabItem Header="Depth Map">
                            <Border Background="{StaticResource BrushBgWindow}">
                                <Grid>
                                    <!-- Placeholder when no point cloud -->
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding CurrentPointCloud, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                        <TextBlock Text="&#xE81C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="48"
                                                   Foreground="#404040"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="No Depth Data"
                                                   Foreground="#606060"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <!-- Depth Map Viewer with integrated ColorBar and range thumbs -->
                                    <core:DepthMapViewer
                                        PointCloud="{Binding CurrentPointCloud}"
                                        ShowColorBar="True"
                                        RangeMin="{Binding DepthRangeMin, Mode=TwoWay}"
                                        RangeMax="{Binding DepthRangeMax, Mode=TwoWay}"
                                        DataMin="{Binding PointCloudYMin}"
                                        DataMax="{Binding PointCloudYMax}"
                                        Visibility="{Binding CurrentPointCloud, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- 3D View Tab -->
                        <TabItem Header="Point Cloud">
                            <Border Background="{StaticResource BrushBgWindow}">
                                <Grid>
                                    <!-- PointDrawingCanvas with 3D viewer -->
                                    <controls:PointDrawingCanvas x:Name="PointCanvasControl"
                                                                 PointCloud="{Binding CurrentPointCloud}"
                                                                 HeightSliceBaseline="{Binding HeightBaseline}"
                                                                 HeightSliceLower="{Binding HeightLowerLimit}"
                                                                 HeightSliceUpper="{Binding HeightUpperLimit}"
                                                                 Waypoints="{Binding WaypointPlanner.Waypoints}"
                                                                 Margin="0"/>
                                </Grid>
                            </Border>
                        </TabItem>

                    </TabControl>
                </Border>
            </Grid>

            <!-- Right Panel - Tool Settings -->
            <Border Grid.Column="2" Background="#252526" BorderBrush="#3D3D3D" BorderThickness="1,0,0,0"
                    Margin="0,2,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tool Settings"
                               Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="14"
                               Margin="10,10,10,5"/>

                    <ts:ToolSettingsView x:Name="ToolSettingsControl" Grid.Row="1"
                                         DataContext="{Binding SelectedToolSettings}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgCard}" BorderBrush="#3D3D3D" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#B0B0B0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ExecutionTimeText}"
                           Foreground="#B0B0B0" VerticalAlignment="Center"
                           Margin="20,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Tools: " Foreground="#B0B0B0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DroppedTools.Count}"
                               Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
