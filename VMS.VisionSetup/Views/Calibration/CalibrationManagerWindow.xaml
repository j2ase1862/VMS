<Window x:Class="VMS.VisionSetup.Views.Calibration.CalibrationManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VMS.VisionSetup.ViewModels"
        xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
        Title="Camera Calibration Manager"
        Width="980" Height="765"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 다크 테마 ComboBoxItem: 드롭다운 항목들의 배경/텍스트 색 + hover/selected 색 -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E5C8C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#264F78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 이미지 미리보기 -->
        <Border Grid.Column="0" Background="#252526" Margin="10" CornerRadius="4">
            <Grid>
                <Image x:Name="PreviewImageControl"
                       Source="{Binding PreviewImage}" Stretch="Uniform" Margin="10"
                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                       Cursor="Cross"/>
                <TextBlock Text="No image loaded. Click 'Load Image...' on the right."
                           Foreground="#666666" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 우측: 패널 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,10,10,10">
            <StackPanel>
                <controls:EnumComboBoxParameter Label="Image Source"
                    ItemsSource="{Binding AvailableSources}"
                    SelectedValue="{Binding SelectedSourceOption}"/>

                <!-- VMS Writer 활성 시 안내 -->
                <Border Background="#3D2D10" BorderBrush="#AA7A00" BorderThickness="1"
                        CornerRadius="3" Padding="6" Margin="0,0,0,6"
                        Visibility="{Binding IsVmsWriterAlive, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding AvailabilityMessage}"
                               Foreground="#FFCC66" FontSize="10" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="{Binding SourceImagePath, FallbackValue='(no image loaded)'}"
                           Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>

                <!-- File 소스 -->
                <Button Content="Load Image..." Command="{Binding LoadImageCommand}"
                        Style="{StaticResource ActionButton}" Background="#007ACC"
                        Visibility="{Binding IsFileSource, Converter={StaticResource BoolToVis}}"/>

                <!-- Camera 직접 소스 -->
                <StackPanel Visibility="{Binding IsCameraSource, Converter={StaticResource BoolToVis}}">
                    <controls:EnumComboBoxParameter Label="Camera"
                        ItemsSource="{Binding CameraOptions}"
                        SelectedValue="{Binding SelectedCameraOption}"/>
                    <Button Content="Capture from Camera"
                            Command="{Binding CaptureFromCameraCommand}"
                            Style="{StaticResource ActionButton}" Background="#007ACC"/>
                </StackPanel>

                <!-- VMS Shared Frame 소스 -->
                <StackPanel Visibility="{Binding IsVmsSharedFrameSource, Converter={StaticResource BoolToVis}}">
                    <Button Content="Receive Frame from VMS"
                            Command="{Binding ReceiveFromVmsCommand}"
                            IsEnabled="{Binding IsVmsWriterAlive}"
                            Style="{StaticResource ActionButton}" Background="#007ACC"/>
                    <TextBlock Text="VMS not detected. Start VMS and click Refresh."
                               Foreground="#888888" FontSize="10" Margin="0,0,0,4"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVmsWriterAlive}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Content="Refresh Source Availability"
                        Command="{Binding RefreshSourceAvailabilityCommand}"
                        Style="{StaticResource ActionButton}" Background="#555555"
                        Padding="8,4" FontSize="10"/>

                <controls:EnumComboBoxParameter Label="Calibration Mode"
                    ItemsSource="{Binding AvailableModes}"
                    SelectedValue="{Binding SelectedModeOption}"/>

                <!-- ── Checkerboard 패널 ── -->
                <StackPanel Visibility="{Binding IsCheckerboardMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Checkerboard Pattern" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pattern Cols (inner corners)"/>
                    <TextBox Text="{Binding PatternCols, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pattern Rows (inner corners)"/>
                    <TextBox Text="{Binding PatternRows, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Square Size (mm)"/>
                    <TextBox Text="{Binding SquareSizeMm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"/>

                    <CheckBox Content="Accumulate Multi-View"
                              IsChecked="{Binding AccumulateMultiView}"
                              Foreground="#CCCCCC" Margin="0,8,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Foreground="#999999" FontSize="11" VerticalAlignment="Center">
                            <Run Text="Accumulated: "/>
                            <Run Text="{Binding AccumulatedViewCount, Mode=OneWay, FallbackValue=0}"
                                 Foreground="#00BFFF" FontWeight="Bold"/>
                        </TextBlock>
                        <Button Content="Reset" Command="{Binding ResetAccumulatedCommand}"
                                Style="{StaticResource ActionButton}" Background="#555555"
                                Padding="8,2" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── N-Point 패널 ── -->
                <StackPanel Visibility="{Binding IsNPointMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="N-Point (planar)" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Click on the image to add a pixel point, then type its real-world mm coordinates. Need 4+ points."
                               Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding NPointPoints}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="True"
                              HeadersVisibility="Column"
                              Background="White" Foreground="Black"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="180" Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PxX" Binding="{Binding PixelX, StringFormat=F1}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="PxY" Binding="{Binding PixelY, StringFormat=F1}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Xmm" Binding="{Binding WorldXmm, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Ymm" Binding="{Binding WorldYmm, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Clear Picked Points" Command="{Binding ClearPickedPointsCommand}"
                            Style="{StaticResource ActionButton}" Background="#555555" Padding="8,2"/>
                </StackPanel>

                <!-- ── Single Scale 패널 ── -->
                <StackPanel Visibility="{Binding IsSingleScaleMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Single Scale (2 points)" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Click two points on a feature of known length. Then enter the length below."
                               Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Foreground="#999999" FontSize="11">
                        <Run Text="Point 1: "/>
                        <Run Text="{Binding ScalePoint1Display, Mode=OneWay}" Foreground="#00BFFF" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Foreground="#999999" FontSize="11" Margin="0,2,0,6">
                        <Run Text="Point 2: "/>
                        <Run Text="{Binding ScalePoint2Display, Mode=OneWay}" Foreground="#00BFFF" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Known Length (mm)"/>
                    <TextBox Text="{Binding KnownLengthMm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"/>
                    <Button Content="Clear Picked Points" Command="{Binding ClearPickedPointsCommand}"
                            Style="{StaticResource ActionButton}" Background="#555555" Padding="8,2"/>
                </StackPanel>

                <TextBlock Text="Run" Style="{StaticResource SectionHeader}"/>
                <Button Content="Run Calibration" Command="{Binding RunCalibrationCommand}"
                        Style="{StaticResource ActionButton}" Background="#2D7D46"/>

                <TextBlock Text="Result" Style="{StaticResource SectionHeader}"/>
                <TextBlock Foreground="#999999" FontSize="11">
                    <Run Text="Reprojection Error: "/>
                    <Run Text="{Binding ReprojectionError, Mode=OneWay, StringFormat='{}{0:F4} px', FallbackValue='-'}"
                         Foreground="#00BFFF" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Foreground="#999999" FontSize="11" Margin="0,2,0,8">
                    <Run Text="Pixel Size: "/>
                    <Run Text="{Binding PixelSizeMm, Mode=OneWay, StringFormat='{}{0:F5} mm/px', FallbackValue='-'}"
                         Foreground="#00BFFF" FontWeight="Bold"/>
                </TextBlock>

                <TextBlock Text="Apply" Style="{StaticResource SectionHeader}"/>
                <Button Content="Apply to Current Recipe"
                        Command="{Binding ApplyToRecipeCommand}"
                        IsEnabled="{Binding HasResult}"
                        Style="{StaticResource ActionButton}" Background="#007ACC"/>
                <Button Content="Clear Calibration from Recipe"
                        Command="{Binding ClearRecipeCalibrationCommand}"
                        Style="{StaticResource ActionButton}" Background="#8B3A3A"/>

                <TextBlock Text="Status" Style="{StaticResource SectionHeader}"/>
                <Border Background="#2D2D30" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#CCCCCC" FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>

                <Button Content="Close" Click="CloseButton_Click"
                        Style="{StaticResource ActionButton}" Background="#555555"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
