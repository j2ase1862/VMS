<UserControl x:Class="VMS.VisionSetup.Views.Recipe.RecipeListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:VMS.VisionSetup.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BrushBgWindow}" Foreground="White"
             d:DesignHeight="600" d:DesignWidth="400">

    <UserControl.Resources>
        <converters:InverseLengthToVisibilityConverter x:Key="InverseLengthToVisibilityConverter"/>
        <Style x:Key="RecipeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555"/>
                    <Setter Property="Foreground" Value="#999999"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RecipeButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrushBgSurface}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505054"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource RecipeButtonStyle}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushBgSurface}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Recipe Manager"
                   Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="16"
                   Margin="0,0,0,10"/>

        <!-- Search Box -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Background="{StaticResource BrushBgSurface}" Foreground="White"
                     BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                     Padding="8,6" FontSize="12"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource BrushBgSurface}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Grid.Column="0" Text="Search recipes..."
                       Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                       Margin="10,7,0,0" IsHitTestVisible="False"
                       Visibility="{Binding Text.Length, ElementName=SearchBox, Converter={StaticResource InverseLengthToVisibilityConverter}, FallbackValue=Visible}"/>

            <Button Grid.Column="1" Content="X"
                    Width="30" Margin="5,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ClearSearchCommand}"
                    ToolTip="Clear search"/>
        </Grid>

        <!-- Recipe List -->
        <ListBox Grid.Row="2"
                 Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                 ItemContainerStyle="{StaticResource RecipeListItemStyle}"
                 ItemsSource="{Binding Recipes}"
                 SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Name}"
                                   Foreground="White" FontWeight="SemiBold" FontSize="13"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="v" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                            <TextBlock Text="{Binding Version}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="2,0,10,0"/>
                            <TextBlock Text="{Binding StepCount}" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                            <TextBlock Text=" steps, " Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                            <TextBlock Text="{Binding ToolCount}" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                            <TextBlock Text=" tools" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding ModifiedAtDisplay}" Foreground="{StaticResource BrushTextDisabled}" FontSize="10"/>
                            <TextBlock Text=" - " Foreground="{StaticResource BrushTextDisabled}" FontSize="10"/>
                            <TextBlock Text="{Binding Author}" Foreground="{StaticResource BrushTextDisabled}" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Action Buttons -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="New" Command="{Binding NewRecipeCommand}" Style="{StaticResource RecipeButtonStyle}" Width="60"/>
            <Button Content="Load" Command="{Binding LoadRecipeCommand}" Style="{StaticResource RecipeButtonStyle}" Width="60" IsEnabled="{Binding HasSelection}"/>
            <Button Content="Duplicate" Command="{Binding DuplicateRecipeCommand}" Style="{StaticResource RecipeButtonStyle}" Width="70" IsEnabled="{Binding HasSelection}"
                    ToolTip="선택 레시피를 스텝·도구·학습 데이터까지 통째로 복사해 새 레시피로 만듭니다"/>
            <Button Content="Rename" Command="{Binding RenameRecipeCommand}" Style="{StaticResource RecipeButtonStyle}" Width="65" IsEnabled="{Binding HasSelection}"
                    ToolTip="선택 레시피의 이름을 변경합니다 (Web 연동 레시피는 Web 원장 이름은 그대로)"/>
            <Button Content="Delete" Command="{Binding DeleteRecipeCommand}" Style="{StaticResource DangerButtonStyle}" Width="60" IsEnabled="{Binding HasSelection}"/>
        </WrapPanel>

        <!-- Import/Export Buttons -->
        <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5,0,0">
            <Button Content="Import" Command="{Binding ImportRecipeCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="60"/>
            <Button Content="Export" Command="{Binding ExportRecipeCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="60" IsEnabled="{Binding HasSelection}"/>
            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="80"/>
        </WrapPanel>
    </Grid>
</UserControl>
