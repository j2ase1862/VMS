<Window x:Class="VMS.VisionSetup.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        Title="Rename Tool"
        Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgWindow}"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="Rename Tool"
                                  ShowMinMaxButtons="False"/>

            <Grid Grid.Row="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Enter new tool name"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Text="툴 표시 이름을 입력하세요."
                           Style="{StaticResource WindowMutedText}" Margin="0,0,0,10"/>

                <TextBox x:Name="NameTextBox" Grid.Row="2"
                         Style="{StaticResource WindowDarkTextBox}"
                         FontSize="13" VerticalContentAlignment="Center"
                         VerticalAlignment="Top"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="OK" Width="92" Margin="0,0,8,0"
                            IsDefault="True" Click="OkButton_Click"
                            Style="{StaticResource ModernPrimaryButton}"/>
                    <Button Content="Cancel" Width="92"
                            IsCancel="True"
                            Style="{StaticResource ModernGhostButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
