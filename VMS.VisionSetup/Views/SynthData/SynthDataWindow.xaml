<Window x:Class="VMS.VisionSetup.Views.SynthData.SynthDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VMS.VisionSetup.ViewModels"
        xmlns:ocr="clr-namespace:VMS.VisionSetup.VisionTools.Identification"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="OCR 합성 데이터 생성기 + 학습"
        Width="780" Height="860"
        Background="#252526"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style x:Key="Tb" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00BFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 폰트 -->
                <TextBlock Style="{StaticResource Hdr}" Text="Font"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="기본 폰트:" Style="{StaticResource Lbl}" Margin="0,4,8,2"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}"
                              SelectedItem="{Binding SelectedFont}"
                              Background="White" Foreground="Black" Margin="0,0,0,4"/>
                </Grid>
                <TextBlock Text="추가 폰트 (줄바꿈 또는 콤마로 구분 — 무작위 선택)" Style="{StaticResource Lbl}"/>
                <TextBox Text="{Binding AdditionalFontsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="50" Style="{StaticResource Tb}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="폰트 크기 Min (px)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding FontSizeMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Max (px)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding FontSizeMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="Bold/Italic 무작위" Foreground="LightGray"
                              IsChecked="{Binding RandomBoldItalic}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </Grid>

                <!-- 패턴 -->
                <TextBlock Style="{StaticResource Hdr}" Text="Patterns (한 줄에 하나)"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="프리셋 추가: " Style="{StaticResource Lbl}"/>
                    <Button Content="DD/MM/YYYY" Margin="2,0" Padding="6,2"
                            Command="{Binding AddPresetCommand}"
                            CommandParameter="{x:Static ocr:OcrOutputFormatPreset.DateDmy}"/>
                    <Button Content="YYYY-MM-DD" Margin="2,0" Padding="6,2"
                            Command="{Binding AddPresetCommand}"
                            CommandParameter="{x:Static ocr:OcrOutputFormatPreset.DateYmdDash}"/>
                    <Button Content="HH:MM:SS" Margin="2,0" Padding="6,2"
                            Command="{Binding AddPresetCommand}"
                            CommandParameter="{x:Static ocr:OcrOutputFormatPreset.DateTimeSec}"/>
                    <Button Content="LOT7" Margin="2,0" Padding="6,2"
                            Command="{Binding AddPresetCommand}"
                            CommandParameter="{x:Static ocr:OcrOutputFormatPreset.Lot7}"/>
                </StackPanel>
                <TextBox Text="{Binding PatternsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="80" FontFamily="Consolas" Style="{StaticResource Tb}"/>
                <TextBlock Foreground="#888" FontSize="10" TextWrapping="Wrap"
                           Text="토큰: D/M/Y/H/S/f=숫자, L=영문자, A=영숫자, ?=임의. 그 외(/, -, :, ., 공백)는 리터럴. 알려진 날짜 패턴은 실제 유효한 datetime 값 생성."/>

                <!-- 샘플 -->
                <TextBlock Style="{StaticResource Hdr}" Text="Dataset"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="샘플 수" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding SampleCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Val 비율 (0~0.5)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding ValRatio, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="출력 포맷" Style="{StaticResource Lbl}"/>
                        <ComboBox SelectedIndex="{Binding OutputFormatIndex}" Background="White" Foreground="Black" Margin="0,0,0,4">
                            <ComboBoxItem Content="PaddleOCR rec"/>
                            <ComboBoxItem Content="OCV char patches"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="출력 폴더" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputDirCommand}"
                            Padding="10,4" Margin="0,18,0,4" VerticalAlignment="Bottom"/>
                </Grid>

                <!-- 배경 -->
                <TextBlock Style="{StaticResource Hdr}" Text="Background"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="모드" Style="{StaticResource Lbl}"/>
                        <ComboBox SelectedIndex="{Binding BackgroundModeIndex}" Background="White" Foreground="Black" Margin="0,0,8,4">
                            <ComboBoxItem Content="Solid (White)"/>
                            <ComboBoxItem Content="Gradient (random grayscale)"/>
                            <ComboBoxItem Content="From Folder (실제 라벨 배경)"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="흰/검 무작위 반전"
                              Foreground="LightGray" IsChecked="{Binding RandomizeInvert}"
                              VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="배경 이미지 폴더 (FromFolder 모드)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding BackgroundFolderPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseBackgroundFolderCommand}"
                            Padding="10,4" Margin="0,18,0,4" VerticalAlignment="Bottom"/>
                </Grid>

                <!-- 증강 -->
                <TextBlock Style="{StaticResource Hdr}" Text="Augmentation"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="회전 ± (deg)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding RotationDegMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                        <TextBlock Text="Blur 최대 커널 (0/3/5)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding BlurMaxKernel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                        <TextBlock Text="밝기 jitter (±, 0~0.3)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding BrightnessJitter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="원근 jitter (0~0.05)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding PerspectiveJitter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                        <TextBlock Text="Gaussian 노이즈 std (0~25)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding NoiseStdMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                        <TextBlock Text="대비 jitter (±, 0~0.3)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding ContrastJitter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                </Grid>
                <CheckBox Content="도트 매트릭스 효과 (잉크젯/도트 프린트 모사)"
                          Foreground="LightGray" IsChecked="{Binding DotMatrixMode}" Margin="0,4,0,8"/>

                <!-- Training (Generate & Train 시 사용) -->
                <TextBlock Style="{StaticResource Hdr}" Text="Training (PP-OCR fine-tuning)"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Python 실행파일 (paddlepaddle 설치된 venv)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}" FontFamily="Consolas"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowsePythonCommand}"
                            Padding="10,4" Margin="0,18,0,4" VerticalAlignment="Bottom"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="train_ppocr.py 경로" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding TrainScriptPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="학습 출력 폴더" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding TrainOutputDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseTrainOutputCommand}"
                            Padding="10,4" Margin="0,18,0,4" VerticalAlignment="Bottom"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="사전학습 모델 prefix (.pdparams 제외)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding PretrainedModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowsePretrainedCommand}"
                            Padding="10,4" Margin="0,18,0,4" VerticalAlignment="Bottom"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Epochs" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding Epochs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Batch Size" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Learning Rate" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding LearningRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tb}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="3" Content="ONNX export" Foreground="LightGray"
                              IsChecked="{Binding ExportOnnx}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </Grid>

                <!-- 학습 진행률 + 로그 -->
                <TextBlock Style="{StaticResource Hdr}" Text="Training Progress"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,12,4" Foreground="LightGray">
                        <Run Text="Epoch:"/>
                        <Run Text="{Binding TrainEpoch, Mode=OneWay}" Foreground="#00BFFF" FontWeight="Bold"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TrainEpochTotal, Mode=OneWay}"/>
                        <Run Text="  Loss:"/>
                        <Run Text="{Binding LastLoss, Mode=OneWay, StringFormat=F4, FallbackValue=-}" Foreground="#FFCC66"/>
                        <Run Text="  Acc:"/>
                        <Run Text="{Binding LastAcc, Mode=OneWay, StringFormat=F4, FallbackValue=-}" Foreground="#4CAF50"/>
                    </TextBlock>
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TrainProgress}" Height="14"/>
                </Grid>
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ONNX 출력: " Foreground="LightGray" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ResultOnnxPath, Mode=OneWay}"
                             IsReadOnly="True" Background="#111" Foreground="#4CAF50"
                             FontFamily="Consolas" BorderBrush="#444" Padding="4,2" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Copy" Click="CopyOnnxPath_Click"
                            Padding="8,2" Margin="6,0,0,0"/>
                </Grid>

                <!-- 학습 로그 — 읽기전용 TextBox로 복사 가능 -->
                <Grid Margin="0,4,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Training Log" Foreground="LightGray" VerticalAlignment="Center"/>
                        <Button Content="Copy All" Click="CopyLog_Click" Padding="8,2" Margin="10,0,0,0"/>
                        <Button Content="Clear" Click="ClearLog_Click" Padding="8,2" Margin="4,0,0,0"/>
                        <TextBlock Text=" (Visual Studio Output 창에도 동시 출력됩니다)"
                                   Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="#555" BorderThickness="1" Background="#111">
                        <TextBox x:Name="LogTextBox" Height="180"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="#111" Foreground="#CCC" BorderThickness="0"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 진행률 + 액션 -->
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <ProgressBar Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCurrent}"
                         Height="14" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#00BFFF" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel Train" Command="{Binding CancelTrainCommand}"
                        Background="#B71C1C" Foreground="White" BorderThickness="0"
                        Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Generate" Command="{Binding GenerateCommand}"
                        Background="#3949AB" Foreground="White" BorderThickness="0"
                        Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Generate &amp; Train" Command="{Binding GenerateAndTrainCommand}"
                        Background="#007ACC" Foreground="White" BorderThickness="0"
                        Padding="16,6" Margin="0,0,8,0" FontWeight="Bold"/>
                <Button Content="Close" Click="CloseButton_Click"
                        Background="#555" Foreground="White" BorderThickness="0"
                        Padding="12,6"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
