<Window x:Class="VMS.VisionSetup.Views.WorkOrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        Title="Work Orders"
        Width="980" Height="640"
        MinWidth="780" MinHeight="480"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 모든 데이터 셀 공통 — 폰트 크기/수직 중앙 정렬 통일(셀 높이 내 클리핑 방지) -->
        <Style x:Key="WoCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="WoCellOrderNo" TargetType="TextBlock" BasedOn="{StaticResource WoCellText}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        </Style>
        <Style x:Key="WoCellProgress" TargetType="TextBlock" BasedOn="{StaticResource WoCellText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextAccent}"/>
        </Style>
        <Style x:Key="WoCellMuted" TargetType="TextBlock" BasedOn="{StaticResource WoCellText}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="Work Orders"
                                  StatusText="{Binding StatusMessage}"/>

            <!-- 필터 + 새로고침 -->
            <Border Grid.Row="1" Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="20,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="상태 필터:" Style="{StaticResource WindowFieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox SelectedValue="{Binding StatusFilter}"
                              SelectedValuePath="Content"
                              Width="140"
                              Style="{StaticResource WindowDarkComboBox}">
                        <ComboBoxItem Content="활성"/>
                        <ComboBoxItem Content="전체"/>
                        <ComboBoxItem Content="Planned"/>
                        <ComboBoxItem Content="InProgress"/>
                        <ComboBoxItem Content="Completed"/>
                    </ComboBox>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ModernGhostButton}"
                            Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource WindowDarkDataGrid}"
                      RowHeight="36"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      Margin="20,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order No" Binding="{Binding OrderNo}" Width="140" IsReadOnly="True"
                                        ElementStyle="{StaticResource WoCellOrderNo}"/>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"
                                        ElementStyle="{StaticResource WoCellText}"/>
                    <DataGridTextColumn Header="Recipe" Binding="{Binding RecipeName}" Width="180" IsReadOnly="True"
                                        ElementStyle="{StaticResource WoCellText}"/>
                    <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="100" IsReadOnly="True"
                                        ElementStyle="{StaticResource WoCellProgress}"/>
                    <DataGridTemplateColumn Header="Status" Width="100" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushNeutral}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                    <Setter Property="Background" Value="{StaticResource BrushSuccessSoft}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Background" Value="{StaticResource BrushInfoSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushInfo}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Planned Start" Binding="{Binding PlannedStartAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" IsReadOnly="True"
                                        ElementStyle="{StaticResource WoCellMuted}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 하단 액션 -->
            <Border Grid.Row="3" Background="{StaticResource BrushBgTitleBar}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="작업지시를 선택 후 'Select' 를 누르거나 행을 더블클릭하세요."
                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                               FontStyle="Italic"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Width="90" Margin="0,0,8,0"
                                IsCancel="True"
                                Style="{StaticResource ModernGhostButton}"/>
                        <Button Content="Select" Width="100"
                                Command="{Binding SelectCommand}"
                                Style="{StaticResource ModernPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
