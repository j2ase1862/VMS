<Window x:Class="VMS.VisionSetup.Views.WorkOrderCompletedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        Title="Work Order Completed"
        Width="560" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgWindow}"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="#14B8A6" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="작업지시 완료"
                                  ShowMinMaxButtons="False"/>

            <!-- 중앙: 큰 체크 아이콘 + WO 번호 + KPI 카드 -->
            <StackPanel Grid.Row="1" Margin="32,18,32,10" VerticalAlignment="Top">

                <!-- Big check icon -->
                <Border Background="#14B8A6" Width="72" Height="72" CornerRadius="36"
                        HorizontalAlignment="Center" Margin="0,8,0,12">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="40" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- WO OrderNo big text -->
                <TextBlock x:Name="OrderNoText"
                           HorizontalAlignment="Center"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"/>

                <TextBlock Text="계획 수량에 도달하여 자동 완료되었습니다"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="12" Margin="0,4,0,18"/>

                <!-- KPI cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 계획 -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBgCard}"
                            CornerRadius="6" Padding="0,10" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="계획"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlannedText" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 검사 -->
                    <Border Grid.Column="1" Background="{StaticResource BrushBgCard}"
                            CornerRadius="6" Padding="0,10" Margin="4,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="검사"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ProducedText" FontSize="22" FontWeight="Bold"
                                       Foreground="#3D7DE8"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pass -->
                    <Border Grid.Column="2" Background="{StaticResource BrushBgCard}"
                            CornerRadius="6" Padding="0,10" Margin="4,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Pass"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PassText" FontSize="22" FontWeight="Bold"
                                       Foreground="#14B8A6"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- NG -->
                    <Border Grid.Column="3" Background="{StaticResource BrushBgCard}"
                            CornerRadius="6" Padding="0,10" Margin="4,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="NG"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NgText" FontSize="22" FontWeight="Bold"
                                       Foreground="#E53935"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pass rate -->
                <TextBlock x:Name="PassRateText"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="12" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- 하단 큰 버튼 두 개 -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushBgTitleBar}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="닫기" Margin="0,0,6,0"
                            Click="CloseButton_Click"
                            Style="{StaticResource ModernGhostButton}"
                            Padding="12,10" FontSize="13"/>

                    <Button Grid.Column="1" Content="다음 작업지시 선택" Margin="6,0,0,0"
                            Click="NextButton_Click" IsDefault="True"
                            Style="{StaticResource ModernPrimaryButton}"
                            Padding="12,10" FontSize="13" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
