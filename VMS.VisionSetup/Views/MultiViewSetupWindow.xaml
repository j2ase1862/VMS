<Window x:Class="VMS.VisionSetup.Views.MultiViewSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
        Title="MultiView Scan Setup"
        Width="1020" Height="740"
        MinWidth="780" MinHeight="560"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 섹션 헤더 - 오렌지 강조색 유지 (Robot/Calibration 등의 그룹핑) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource WindowSectionHeader}">
            <Setter Property="Foreground" Value="#FFB74D"/>
        </Style>

        <!-- FieldLabel/ActionButton — 공통 스타일 별칭 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource WindowFieldLabel}"/>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}"/>
    </Window.Resources>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <c:ChromelessTitleBar Grid.Row="0" TitleText="MultiView Scan Setup"/>

        <Grid Grid.Row="1" Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Settings Panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <!-- Robot Connection -->
                <TextBlock Text="Robot Connection" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RobotIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}" FontSize="11"/>
                        <TextBox Grid.Column="1" Text="{Binding RobotPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}" FontSize="11" Margin="4,0,0,0"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Robot" Style="{StaticResource FieldLabel}" Margin="0,4,8,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding EulerConventions}"
                              SelectedItem="{Binding SelectedEulerConvention}"
                              Style="{StaticResource WindowDarkComboBox}" FontSize="11" Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="" Margin="0,6,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Command="{Binding ConnectRobotCommand}" Content="Connect"
                                Background="#4CAF50" Style="{StaticResource ActionButton}" Padding="14,5"/>
                        <Button Command="{Binding DisconnectRobotCommand}" Content="Disconnect"
                                Background="#F44336" Style="{StaticResource ActionButton}" Padding="14,5" Margin="6,0,0,0"/>
                        <Ellipse Width="10" Height="10" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F44336"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRobotConnected}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                </Grid>

                <!-- Hand-Eye Calibration -->
                <TextBlock Text="Hand-Eye Calibration" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding HandEyeCalibrationPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WindowDarkTextBox}" FontSize="10" IsReadOnly="True"
                             ToolTip="{Binding HandEyeCalibrationPath}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding BrowseHandEyeCalibrationCommand}"
                                Content="..." Background="#3A3A3C"
                                Style="{StaticResource ActionButton}" Padding="10,4" Margin="4,0,0,0"/>
                        <Button x:Name="CalibrateButton" Click="HandEyeCalibrate_Click"
                                Content="Calibrate" Background="#9C27B0"
                                Style="{StaticResource ActionButton}" Padding="10,4" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#F44336"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHandEyeCalibrated}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="#999" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Not Calibrated"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHandEyeCalibrated}" Value="True">
                                        <Setter Property="Text" Value="Calibrated"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Strategy -->
                <TextBlock Text="Registration Strategy" Style="{StaticResource SectionLabel}"/>
                <ComboBox ItemsSource="{Binding RegistrationStrategies}"
                          SelectedItem="{Binding SelectedRegistrationStrategy}"
                          Style="{StaticResource WindowDarkComboBox}" FontSize="11"/>

                <!-- Manual Capture -->
                <TextBlock Text="Manual Capture" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="3">
                    <Button Command="{Binding MultiViewCaptureCommand}" Content="Capture"
                            Background="#2196F3" Style="{StaticResource ActionButton}" Padding="8,5" Margin="0,0,2,0"/>
                    <Button Command="{Binding MultiViewProcessCommand}" Content="Process"
                            Background="#9C27B0" Style="{StaticResource ActionButton}" Padding="8,5" Margin="2,0"/>
                    <Button Command="{Binding MultiViewClearCommand}" Content="Clear"
                            Background="#757575" Style="{StaticResource ActionButton}" Padding="8,5" Margin="2,0,0,0"/>
                </UniformGrid>
                <TextBlock Text="{Binding MultiViewStatusText}" Foreground="#AAAAAA"
                           FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <!-- Waypoint Planner -->
                <TextBlock Text="Waypoint Planner" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding WaypointPatterns}"
                              SelectedItem="{Binding SelectedWaypointPattern}"
                              Style="{StaticResource WindowDarkComboBox}" FontSize="11"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Count" Style="{StaticResource FieldLabel}" Margin="0,4,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding WaypointCount, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WindowDarkTextBox}" FontSize="11" Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dist (mm)" Style="{StaticResource FieldLabel}" Margin="0,4,8,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding ScanDistance, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WindowDarkTextBox}" FontSize="11" Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Elev (°)" Style="{StaticResource FieldLabel}" Margin="0,4,8,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding ScanElevation, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WindowDarkTextBox}" FontSize="11" Margin="0,4,0,0"/>
                </Grid>

                <UniformGrid Columns="2" Margin="0,8,0,0">
                    <Button Command="{Binding GenerateWaypointsCommand}" Content="Generate"
                            Background="#00897B" Style="{StaticResource ActionButton}" Padding="8,5" Margin="0,0,3,0"/>
                    <Button Command="{Binding ClearWaypointsCommand}" Content="Clear WP"
                            Background="#757575" Style="{StaticResource ActionButton}" Padding="8,5" Margin="3,0,0,0"/>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <Button Command="{Binding StartWaypointScanCommand}" Content="▶ Auto Scan"
                            Background="#E65100" Style="{StaticResource ActionButton}" Padding="8,5" Margin="0,0,3,0"/>
                    <Button Command="{Binding StopWaypointScanCommand}" Content="■ Stop"
                            Background="#B71C1C" Style="{StaticResource ActionButton}" Padding="8,5" Margin="3,0,0,0"/>
                </UniformGrid>

                <TextBlock Text="{Binding WaypointPlanner.StatusMessage}" Foreground="#AAAAAA"
                           FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Right: 3D Preview -->
        <Border Grid.Column="1" Background="#0A0F14"
                CornerRadius="8"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                Margin="14,0,0,0">
            <Grid>
                <controls:PointDrawingCanvas x:Name="PreviewCanvas"
                    PointCloud="{Binding CurrentPointCloud}"
                    Waypoints="{Binding WaypointPlanner.Waypoints}"/>

                <!-- Hint overlay (always visible, behind 3D content) -->
                <TextBlock Text="3D Preview — Load point cloud or generate waypoints"
                           Foreground="{StaticResource BrushTextDisabled}"
                           FontSize="13" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
