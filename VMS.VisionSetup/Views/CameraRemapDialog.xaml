<Window x:Class="VMS.VisionSetup.Views.CameraRemapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        Title="미등록 카메라 재연결"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgWindow}"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="미등록 카메라 재연결"
                                  ShowMinMaxButtons="False"/>

            <Grid Grid.Row="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="13" Margin="0,0,0,4"
                           Text="이 레시피는 다른 PC 에서 등록한 카메라를 참조하고 있습니다."/>
                <TextBlock Grid.Row="1" TextWrapping="Wrap"
                           Style="{StaticResource WindowMutedText}" Margin="0,0,0,12"
                           Text="각 항목을 이 PC 의 카메라로 다시 연결하면 스텝을 그대로 사용할 수 있습니다. [적용 및 저장]을 누르면 레시피가 저장됩니다."/>

                <ItemsControl Grid.Row="2" x:Name="RowsControl" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OldIdDisplay}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding StepCountDisplay}"
                                               Style="{StaticResource WindowMutedText}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center"
                                           Margin="10,0" FontSize="14"
                                           Foreground="{StaticResource BrushTextSecondary}"/>

                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource WindowDarkComboBox}"
                                          ItemsSource="{Binding Options}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="적용 및 저장" Width="110" Margin="0,0,8,0"
                            IsDefault="True" Click="ApplyButton_Click"
                            Style="{StaticResource ModernPrimaryButton}"/>
                    <Button Content="건너뛰기" Width="92"
                            IsCancel="True"
                            Style="{StaticResource ModernGhostButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
