<Window x:Class="VMS.VisionSetup.Views.Dialogs.ModelRegistryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VMS.VisionSetup.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ModelRegistryPickerViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="레지스트리에서 모델 고르기"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        ShowInTaskbar="False">

    <!--
        MLOps 모델 레지스트리에서 참조(model://…)를 고른다.
        파일 경로 대신 참조를 쓰면 승격·롤백이 레지스트리 쪽에서 끝나고,
        라인 PC 는 다음 레시피 로드 때 알아서 새 파일을 받아 온다.
        모든 상태·조회는 ModelRegistryPickerViewModel — 이 창은 바인딩만 한다.
    -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="레지스트리에서 모델 고르기" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource BrushTextMuted}"
                       Text="파일 경로 대신 참조를 저장합니다. 운영 단계를 고르면 레지스트리에서 승격·롤백한 것이 다음 레시피 로드 때 그대로 반영됩니다."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="모델" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource BrushTextMuted}"/>
                <ListBox ItemsSource="{Binding Models}"
                         SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                         Background="{StaticResource BrushBgCard}"
                         Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorderSubtle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="무엇을 가리킬까요" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource BrushTextMuted}"/>
                <StackPanel>
                    <RadioButton GroupName="Target" Style="{StaticResource WindowDarkRadioButton}"
                                 IsChecked="{Binding UseStage, Mode=TwoWay}"
                                 Content="지금 운영 중인 버전" Margin="0,4"
                                 Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Margin="20,0,0,8" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               Text="레지스트리에서 승격·롤백하면 이 도구가 쓰는 모델도 함께 바뀝니다."/>

                    <ComboBox Margin="20,0,0,12" Style="{StaticResource WindowDarkComboBox}"
                              ItemsSource="{Binding Stages}"
                              DisplayMemberPath="Label" SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedStage, Mode=TwoWay}"
                              IsEnabled="{Binding UseStage}"/>

                    <RadioButton GroupName="Target" Style="{StaticResource WindowDarkRadioButton}"
                                 IsChecked="{Binding PinVersion, Mode=TwoWay}"
                                 Content="특정 버전 고정" Margin="0,4"
                                 Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Margin="20,0,0,8" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               Text="언제 열어도 같은 파일을 씁니다. 검증이 끝난 라인에 씁니다."/>

                    <ListBox Height="180" Margin="20,0,0,0"
                             ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                             IsEnabled="{Binding PinVersion}"
                             Background="{StaticResource BrushBgCard}"
                             Foreground="{StaticResource BrushTextPrimary}"
                             BorderBrush="{StaticResource BrushBorderSubtle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}" FontSize="11" Margin="2,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,8"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="저장될 값" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextPrimary}" Text="{Binding PreviewText}"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Status}"
                       Foreground="{StaticResource BrushTextMuted}" TextWrapping="NoWrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="취소" Width="88" Height="30" Margin="0,0,8,0"
                        Style="{StaticResource ModernSecondaryButton}" Command="{Binding CancelCommand}"/>
                <Button Content="선택" Width="88" Height="30"
                        Style="{StaticResource ModernPrimaryButton}" Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
