<Window x:Class="VMS.VisionSetup.Views.BatchTest.ThresholdEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        Title="Edit Thresholds"
        Width="980" Height="720"
        MinWidth="780" MinHeight="520"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="Edit Thresholds"
                                  StatusText="{Binding StatusMessage}"
                                  ShowMinMaxButtons="False"/>

            <!-- Help banner -->
            <Border Grid.Row="1" Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1" Padding="20,12">
                <StackPanel>
                    <TextBlock Text="도구별 Pass/Fail 임계치 — 현재 활성 Step의 도구만 표시"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="• &quot;Must Succeed&quot; 만 켜면 도구 실행 성공만 검사합니다.   • Range 임계치를 추가하면 결과 값이 Min..Max 범위 안인지 확인합니다.   • Min/Max는 둘 다 선택 — 한쪽만 입력하면 한쪽 경계 없음."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Tool cards scroll -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,14">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WindowCard}" Margin="0,0,0,12" Padding="18,14">
                                <StackPanel>
                                    <!-- Header: tool name + must succeed -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ToolName}"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="{StaticResource BrushTextMuted}"
                                                       FontSize="10" Margin="0,2,0,0">
                                                <Run Text="{Binding ToolType, Mode=OneWay}"/>
                                                <Run Text=" · ID "/>
                                                <Run Text="{Binding ToolId, Mode=OneWay}" FontFamily="Consolas"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Content="Must Succeed"
                                                  IsChecked="{Binding MustSucceed}"
                                                  Style="{StaticResource WindowDarkCheckBox}"
                                                  ToolTip="이 도구가 실패하면 즉시 FAIL"/>
                                    </Grid>

                                    <!-- Existing threshold rows -->
                                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushBgInput}"
                                                        BorderBrush="{StaticResource BrushBorderSubtle}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Padding="10,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Key}"
                                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                                       FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Foreground="{StaticResource BrushTextMuted}"
                                                                       FontSize="10" Margin="0,1,0,0">
                                                                <Run Text="last: "/>
                                                                <Run Text="{Binding LastValueText, Mode=OneWay}"
                                                                     Foreground="{StaticResource BrushTextAccent}"
                                                                     FontFamily="Consolas"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="Min"
                                                                   Foreground="{StaticResource BrushTextMuted}"
                                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Grid.Column="2"
                                                                 Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource WindowDarkTextBox}"
                                                                 ToolTip="하한 (비우면 없음)"
                                                                 VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="4" Text="≤"
                                                                   Foreground="{StaticResource BrushTextMuted}"
                                                                   FontSize="12" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBox Grid.Column="6"
                                                                 Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource WindowDarkTextBox}"
                                                                 ToolTip="상한 (비우면 없음)"
                                                                 VerticalAlignment="Center"/>

                                                        <Button Grid.Column="8" Content="✕"
                                                                Command="{Binding DataContext.RemoveThresholdRowCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ModernGhostButton}"
                                                                Padding="8,4" VerticalAlignment="Center"
                                                                ToolTip="이 임계치 삭제"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Add threshold row: key combobox + add button -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="+ Add Threshold:"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableKeysForAdd}"
                                                  SelectedItem="{Binding SelectedKeyToAdd}"
                                                  Style="{StaticResource WindowDarkComboBox}"
                                                  ToolTip="검사할 결과 키를 선택"/>
                                        <Button Grid.Column="3" Content="Add"
                                                Command="{Binding DataContext.AddThresholdRowCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModernPrimaryButton}"
                                                Padding="14,7"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom action bar -->
            <Border Grid.Row="3" Background="{StaticResource BrushBgTitleBar}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource ModernGhostButton}"
                                Width="100" Margin="0,0,8,0"/>
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource ModernPrimaryButton}"
                                Width="120"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
