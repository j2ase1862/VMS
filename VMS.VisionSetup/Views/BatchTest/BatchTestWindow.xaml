<Window x:Class="VMS.VisionSetup.Views.BatchTest.BatchTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        Title="Batch Test Runner"
        Width="1080" Height="800"
        MinWidth="780" MinHeight="560"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="Batch Test Runner"
                                  StatusText="{Binding StatusMessage}"/>

            <Grid Grid.Row="1" Margin="22,18,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="현재 레시피를 폴더 내 이미지에 일괄 적용하고, CSV 리포트와 실패 오버레이를 생성합니다."
                           Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                           Margin="0,0,0,16"/>

                <!-- Setup (2 columns) -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource WindowCard}">
                        <StackPanel>
                            <TextBlock Text="INPUT" Style="{StaticResource WindowSectionHeaderFirst}"/>

                            <TextBlock Text="이미지 폴더" Style="{StaticResource WindowFieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ImageFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}"/>
                                <Button Grid.Column="1" Content="Browse"
                                        Command="{Binding BrowseImageFolderCommand}"
                                        Style="{StaticResource ModernGhostButton}" Margin="8,0,0,0"/>
                            </Grid>

                            <CheckBox Content="하위 폴더 재귀 탐색"
                                      IsChecked="{Binding RecurseSubfolders}"
                                      Style="{StaticResource WindowDarkCheckBox}"
                                      Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource WindowCard}">
                        <StackPanel>
                            <TextBlock Text="OUTPUT" Style="{StaticResource WindowSectionHeaderFirst}"/>

                            <TextBlock Text="CSV 리포트" Style="{StaticResource WindowFieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputCsvPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}"/>
                                <Button Grid.Column="1" Content="Browse"
                                        Command="{Binding BrowseOutputCsvCommand}"
                                        Style="{StaticResource ModernGhostButton}" Margin="8,0,0,0"/>
                            </Grid>

                            <CheckBox Content="실패 케이스 오버레이 저장"
                                      IsChecked="{Binding SaveFailureOverlays}"
                                      Style="{StaticResource WindowDarkCheckBox}"
                                      Margin="0,14,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FailureOverlayDir, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}"/>
                                <Button Grid.Column="1" Content="Browse"
                                        Command="{Binding BrowseFailureDirCommand}"
                                        Style="{StaticResource ModernGhostButton}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Metric Tiles -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="10" Padding="18,14" BorderThickness="1"
                            Background="{StaticResource BrushInfoSoft}"
                            BorderBrush="{StaticResource BrushInfo}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="14" Fill="{StaticResource BrushInfo}"
                                           RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                <TextBlock Text="PROCESSED" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushInfo}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ProgressCurrent}" FontSize="28" FontWeight="Light"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text=" / " Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="14" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock Text="{Binding ProgressTotal}" Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="10" Padding="18,14" BorderThickness="1"
                            Background="{StaticResource BrushSuccessSoft}"
                            BorderBrush="{StaticResource BrushSuccess}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="14" Fill="{StaticResource BrushSuccess}"
                                           RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                <TextBlock Text="PASS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushSuccess}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PassCount}" FontSize="28" FontWeight="Light"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" CornerRadius="10" Padding="18,14" BorderThickness="1"
                            Background="{StaticResource BrushDangerSoft}"
                            BorderBrush="{StaticResource BrushDanger}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="14" Fill="{StaticResource BrushDanger}"
                                           RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                <TextBlock Text="FAIL" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushDanger}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FailCount}" FontSize="28" FontWeight="Light"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" CornerRadius="10" Padding="18,14" BorderThickness="1"
                            Background="{StaticResource BrushWarningSoft}"
                            BorderBrush="{StaticResource BrushWarning}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="14" Fill="{StaticResource BrushWarning}"
                                           RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                <TextBlock Text="AVG TIME" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushWarning}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding AvgMs, StringFormat=F1}" FontSize="28" FontWeight="Light"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text=" ms" Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Activity (progress + log) -->
                <Border Grid.Row="3" Style="{StaticResource WindowCard}" Padding="18,16,18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ACTIVITY"
                                       Style="{StaticResource WindowSectionHeaderFirst}" Margin="0"/>
                            <ProgressBar Grid.Column="1" Margin="14,0,14,2" Height="4"
                                         Minimum="0" Maximum="{Binding ProgressTotal}"
                                         Value="{Binding ProgressCurrent}"
                                         Background="{StaticResource BrushBgInput}"
                                         Foreground="{StaticResource BrushAccent}"
                                         BorderThickness="0"/>
                            <TextBlock Grid.Column="2"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold">
                                <Run Text="{Binding ProgressCurrent, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding ProgressTotal, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource BrushBgInput}"
                                CornerRadius="6" BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1" Margin="0,12,0,0">
                            <Grid>
                                <ListBox ItemsSource="{Binding LogLines}"
                                         Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"
                                         BorderThickness="0"
                                         FontFamily="Consolas" FontSize="11"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="아직 실행되지 않았습니다. Run을 눌러 시작하세요."
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="12" FontStyle="Italic"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LogLines.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Action Bar -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Command="{Binding CancelCommand}"
                                Style="{StaticResource ModernDangerButton}" Margin="0,0,8,0"/>
                        <Button Content="Run Batch" Command="{Binding RunCommand}"
                                Style="{StaticResource ModernPrimaryButton}" Padding="24,7" Margin="0,0,8,0"/>
                        <Button Content="Close"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                Style="{StaticResource ModernGhostButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
