<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.ToolSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
             xmlns:ts="clr-namespace:VMS.VisionSetup.Views.ToolSettings"
             xmlns:tools="clr-namespace:VMS.VisionSetup.Views.ToolSettings.Tools"
             xmlns:vm="clr-namespace:VMS.VisionSetup.ViewModels.ToolSettings"
             xmlns:plc="clr-namespace:VMS.PLC.Models;assembly=VMS.PLC"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="300"
             Background="{StaticResource BrushBgCard}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Expert Mode 토글 스위치 — CheckBox 베이스로 슬라이딩 핸들 + 애니메이션.
             기존 체크박스 자리를 그대로 대체 (IsChecked TwoWay 호환). -->
        <Style x:Key="ExpertModeToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                            <Border x:Name="Track" Width="34" Height="18" CornerRadius="9"
                                    Background="{StaticResource BrushBorderStrong}" BorderBrush="#3F3F46" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7"
                                        Background="#CCCCCC" HorizontalAlignment="Left"
                                        Margin="1,0,0,0" SnapsToDevicePixels="True">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#005FA3"/>
                                <Setter TargetName="Thumb" Property="Background" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="16" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplates for each tool ViewModel type -->
        <DataTemplate x:Key="GrayscaleTemplate" DataType="{x:Type vm:GrayscaleToolSettingsViewModel}">
            <tools:GrayscaleToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="BlurTemplate" DataType="{x:Type vm:BlurToolSettingsViewModel}">
            <tools:BlurToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="ThresholdTemplate" DataType="{x:Type vm:ThresholdToolSettingsViewModel}">
            <tools:ThresholdToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="EdgeDetectionTemplate" DataType="{x:Type vm:EdgeDetectionToolSettingsViewModel}">
            <tools:EdgeDetectionToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="MorphologyTemplate" DataType="{x:Type vm:MorphologyToolSettingsViewModel}">
            <tools:MorphologyToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="HistogramTemplate" DataType="{x:Type vm:HistogramToolSettingsViewModel}">
            <tools:HistogramToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="FeatureMatchTemplate" DataType="{x:Type vm:FeatureMatchToolSettingsViewModel}">
            <tools:FeatureMatchToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="BlobTemplate" DataType="{x:Type vm:BlobToolSettingsViewModel}">
            <tools:BlobToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="CaliperTemplate" DataType="{x:Type vm:CaliperToolSettingsViewModel}">
            <tools:CaliperToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="LineFitTemplate" DataType="{x:Type vm:LineFitToolSettingsViewModel}">
            <tools:LineFitToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="CircleFitTemplate" DataType="{x:Type vm:CircleFitToolSettingsViewModel}">
            <tools:CircleFitToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="HeightSlicerTemplate" DataType="{x:Type vm:HeightSlicerToolSettingsViewModel}">
            <tools:HeightSlicerToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="CodeReaderTemplate" DataType="{x:Type vm:CodeReaderToolSettingsViewModel}">
            <tools:CodeReaderToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="GeometryTemplate" DataType="{x:Type vm:GeometryToolSettingsViewModel}">
            <tools:GeometryToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="OCRTemplate" DataType="{x:Type vm:OCRToolSettingsViewModel}">
            <tools:OCRToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="OCVTemplate" DataType="{x:Type vm:OCVToolSettingsViewModel}">
            <tools:OCVToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="ImageEnhanceTemplate" DataType="{x:Type vm:ImageEnhanceToolSettingsViewModel}">
            <tools:ImageEnhanceToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="PolarUnwrapTemplate" DataType="{x:Type vm:PolarUnwrapToolSettingsViewModel}">
            <tools:PolarUnwrapToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="DetectionTemplate" DataType="{x:Type vm:DetectionToolSettingsViewModel}">
            <tools:DetectionToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="ClassifyTemplate" DataType="{x:Type vm:ClassifyToolSettingsViewModel}">
            <tools:ClassifyToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="AnomalyTemplate" DataType="{x:Type vm:AnomalyToolSettingsViewModel}">
            <tools:AnomalyToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="EnsembleTemplate" DataType="{x:Type vm:EnsembleToolSettingsViewModel}">
            <tools:EnsembleToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="PlaneFitTemplate" DataType="{x:Type vm:PlaneFitToolSettingsViewModel}">
            <tools:PlaneFitToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="Geometry3DTemplate" DataType="{x:Type vm:Geometry3DToolSettingsViewModel}">
            <tools:Geometry3DToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type vm:ResultToolSettingsViewModel}">
            <tools:ResultToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="ImageRectifyTemplate" DataType="{x:Type vm:ImageRectifyToolSettingsViewModel}">
            <tools:ImageRectifyToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="SegmentationTemplate" DataType="{x:Type vm:SegmentationToolSettingsViewModel}">
            <tools:SegmentationToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="YoloSegTemplate" DataType="{x:Type vm:YoloSegToolSettingsViewModel}">
            <tools:YoloSegToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="ShapeMatchTemplate" DataType="{x:Type vm:ShapeMatchToolSettingsViewModel}">
            <tools:ShapeMatchToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="ColorExtractTemplate" DataType="{x:Type vm:ColorExtractToolSettingsViewModel}">
            <tools:ColorExtractToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="ColorMatchTemplate" DataType="{x:Type vm:ColorMatchToolSettingsViewModel}">
            <tools:ColorMatchToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="PointCloudFilterTemplate" DataType="{x:Type vm:PointCloudFilterToolSettingsViewModel}">
            <tools:PointCloudFilterToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="PointCloudRegistrationTemplate" DataType="{x:Type vm:PointCloudRegistrationToolSettingsViewModel}">
            <tools:PointCloudRegistrationToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="PointCloudClusterTemplate" DataType="{x:Type vm:PointCloudClusterToolSettingsViewModel}">
            <tools:PointCloudClusterToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="PointCloudDeviationTemplate" DataType="{x:Type vm:PointCloudDeviationToolSettingsViewModel}">
            <tools:PointCloudDeviationToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="PointCloudMaskCropTemplate" DataType="{x:Type vm:PointCloudMaskCropToolSettingsViewModel}">
            <tools:PointCloudMaskCropToolSettings/>
        </DataTemplate>
        <DataTemplate x:Key="PhotometricStereoTemplate" DataType="{x:Type vm:PhotometricStereoToolSettingsViewModel}">
            <tools:PhotometricStereoToolSettings/>
        </DataTemplate>

        <ts:ToolSettingsTemplateSelector x:Key="ToolTemplateSelector"
            GrayscaleTemplate="{StaticResource GrayscaleTemplate}"
            BlurTemplate="{StaticResource BlurTemplate}"
            ThresholdTemplate="{StaticResource ThresholdTemplate}"
            EdgeDetectionTemplate="{StaticResource EdgeDetectionTemplate}"
            MorphologyTemplate="{StaticResource MorphologyTemplate}"
            HistogramTemplate="{StaticResource HistogramTemplate}"
            FeatureMatchTemplate="{StaticResource FeatureMatchTemplate}"
            BlobTemplate="{StaticResource BlobTemplate}"
            CaliperTemplate="{StaticResource CaliperTemplate}"
            LineFitTemplate="{StaticResource LineFitTemplate}"
            CircleFitTemplate="{StaticResource CircleFitTemplate}"
            HeightSlicerTemplate="{StaticResource HeightSlicerTemplate}"
            CodeReaderTemplate="{StaticResource CodeReaderTemplate}"
            GeometryTemplate="{StaticResource GeometryTemplate}"
            OCRTemplate="{StaticResource OCRTemplate}"
            OCVTemplate="{StaticResource OCVTemplate}"
            ImageEnhanceTemplate="{StaticResource ImageEnhanceTemplate}"
            PolarUnwrapTemplate="{StaticResource PolarUnwrapTemplate}"
            DetectionTemplate="{StaticResource DetectionTemplate}"
            ClassifyTemplate="{StaticResource ClassifyTemplate}"
            AnomalyTemplate="{StaticResource AnomalyTemplate}"
            EnsembleTemplate="{StaticResource EnsembleTemplate}"
            PlaneFitTemplate="{StaticResource PlaneFitTemplate}"
            Geometry3DTemplate="{StaticResource Geometry3DTemplate}"
            ResultTemplate="{StaticResource ResultTemplate}"
            ImageRectifyTemplate="{StaticResource ImageRectifyTemplate}"
            SegmentationTemplate="{StaticResource SegmentationTemplate}"
            YoloSegTemplate="{StaticResource YoloSegTemplate}"
            ShapeMatchTemplate="{StaticResource ShapeMatchTemplate}"
            ColorExtractTemplate="{StaticResource ColorExtractTemplate}"
            ColorMatchTemplate="{StaticResource ColorMatchTemplate}"
            PointCloudFilterTemplate="{StaticResource PointCloudFilterTemplate}"
            PointCloudRegistrationTemplate="{StaticResource PointCloudRegistrationTemplate}"
            PointCloudClusterTemplate="{StaticResource PointCloudClusterTemplate}"
            PointCloudDeviationTemplate="{StaticResource PointCloudDeviationTemplate}"
            PointCloudMaskCropTemplate="{StaticResource PointCloudMaskCropTemplate}"
            PhotometricStereoTemplate="{StaticResource PhotometricStereoTemplate}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Tool Header — 좌측: 도구 이름 + Help, 우측: Expert 모드 토글.
                 토글은 현재 선택된 도구의 ToolType 에 대해서만 작동 — 같은 타입의 모든 인스턴스에 즉시 반영,
                 system_config 와 별도의 expert_mode.json 에 영구 저장. -->
            <DockPanel Margin="0,0,0,10">
                <CheckBox DockPanel.Dock="Right" Content="Expert Mode"
                          IsChecked="{Binding IsExpertMode, Mode=TwoWay}"
                          Style="{StaticResource ExpertModeToggleStyle}"
                          ToolTip="이 도구 타입의 고급 파라미터를 표시/숨김. 같은 타입의 모든 도구 인스턴스에 적용되고, 다음 실행에도 유지됩니다."/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}"
                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <controls:HelpIcon ToolType="{Binding ToolType}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Tool-Specific Parameters via DataTemplateSelector -->
            <ContentControl Content="{Binding}"
                            ContentTemplateSelector="{StaticResource ToolTemplateSelector}"/>

            <!-- Common Settings -->
            <TextBlock Text="Common Settings" Style="{StaticResource SectionHeaderStyle}"/>

            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled, FallbackValue=True}"
                          Style="{StaticResource WindowDarkCheckBox}"/>
                <controls:HelpIcon ToolType="Common"
                                   ParameterName="Enabled"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- UseROI + ROI Settings: hidden when HasCustomROISection is true -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCustomROISection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <CheckBox Content="Use ROI" IsChecked="{Binding UseROI, FallbackValue=False}"
                          Style="{StaticResource WindowDarkCheckBox}"/>
                <controls:HelpIcon ToolType="Common"
                                   ParameterName="UseROI"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ROI Settings -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="{Binding UseROI, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCustomROISection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="ROI Settings" Style="{StaticResource SectionHeaderStyle}"/>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <Button Content="Show ROI" Command="{Binding ShowROICommand}"
                            Background="{StaticResource BrushSuccess}" Foreground="White" BorderBrush="#1E5C32"
                            Padding="10,4" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="Draw ROI" Command="{Binding DrawROICommand}"
                            Background="{StaticResource BrushAccentPressed}" Foreground="White" BorderBrush="#005A9E"
                            Padding="10,4" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="Clear ROI" Command="{Binding ClearROICommand}"
                            Background="{StaticResource BrushBorderStrong}" Foreground="White" BorderBrush="#444444"
                            Padding="10,4" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <!-- PLC Output Mappings (HidePlcSection=true이면 숨김) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HidePlcSection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

            <TextBlock Text="PLC Output" Style="{StaticResource SectionHeaderStyle}"/>

            <!-- 매핑 카드 스택 — Tool Settings 패널이 300px 로 좁아 DataGrid 컬럼 텍스트가 잘리던 문제를
                 카드 레이아웃으로 해결. 각 매핑이 라벨–컨트롤 세로 쌍으로 풀폭을 사용. -->
            <ItemsControl ItemsSource="{Binding PlcMappings}" Margin="0,3,0,3">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                CornerRadius="3" Margin="0,0,0,4" Padding="6,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Key + Remove 버튼 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Key"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,4,2"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding DataContext.AvailableResultKeys, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding ResultKey, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource WindowDarkComboBox}"
                                          Margin="0,0,0,2"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="X"
                                        Command="{Binding DataContext.RemovePlcMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" Foreground="{StaticResource BrushDanger}"
                                        BorderThickness="0" Cursor="Hand"
                                        FontWeight="Bold" Padding="6,0" Margin="4,0,0,2"
                                        ToolTip="Remove mapping"/>

                                <!-- Row 1: Device -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Device"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,2,4,2"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                          ItemsSource="{Binding DataContext.AvailableDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValuePath="DeviceId"
                                          SelectedValue="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=MainPLC, FallbackValue=MainPLC}"
                                          Style="{StaticResource WindowDarkComboBox}"
                                          Margin="0,2,0,2">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DeviceId}" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding TypeBadge}" Foreground="{StaticResource BrushTextMuted}"
                                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Row 2: Address / Channel -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Address"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,2,4,2"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                         Text="{Binding PlcAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}"
                                         Margin="0,2,0,2"
                                         ToolTip="PLC: 어드레스 (예: D100, M100) / IO 보드: 채널 번호 (예: 0, 5)"/>

                                <!-- Row 3: Type -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Type"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,2,4,0"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                          ItemsSource="{Binding DataContext.PlcDataTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource WindowDarkComboBox}"
                                          Margin="0,2,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ Add PLC Mapping"
                    Command="{Binding AddPlcMappingCommand}"
                    Background="{StaticResource BrushBgSurface}" Foreground="{StaticResource BrushTextPrimary}"
                    BorderBrush="{StaticResource BrushBorderStrong}" Padding="8,4"
                    HorizontalAlignment="Left" Margin="0,2,0,5"
                    Cursor="Hand"/>

            </StackPanel>

            <!-- Execution Info -->
            <TextBlock Text="Execution Info" Style="{StaticResource SectionHeaderStyle}"/>

            <TextBlock Style="{StaticResource SettingLabelStyle}">
                <Run Text="Last Execution Time: "/>
                <Run Text="{Binding ExecutionTime, StringFormat='{}{0:F2} ms', FallbackValue='N/A'}"
                     Foreground="{StaticResource BrushTextAccent}" FontWeight="Bold"/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
