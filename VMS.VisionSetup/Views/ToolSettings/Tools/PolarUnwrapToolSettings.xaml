<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.PolarUnwrapToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
             xmlns:conv="clr-namespace:VMS.VisionSetup.Converters"
             xmlns:ip="clr-namespace:VMS.VisionSetup.VisionTools.ImageProcessing">
    <StackPanel>
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Center / Radius" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Center는 수동 입력 또는 CircleFit Tool 결과를 Coordinates 연결로 자동 주입. 캡/약병/파이프 라벨에 사용."/>
                <controls:TextBoxParameter Label="Center X (px)"
                    Value="{Binding CenterX, UpdateSourceTrigger=PropertyChanged}"
                    ToolType="PolarUnwrapTool" ParameterName="CenterX"/>
                <controls:TextBoxParameter Label="Center Y (px)"
                    Value="{Binding CenterY, UpdateSourceTrigger=PropertyChanged}"
                    ToolType="PolarUnwrapTool" ParameterName="CenterY"/>
                <controls:TextBoxParameter Label="Inner Radius (px)"
                    Value="{Binding InnerRadius, UpdateSourceTrigger=PropertyChanged}"
                    ToolType="PolarUnwrapTool" ParameterName="InnerRadius"/>
                <controls:TextBoxParameter Label="Outer Radius (px)"
                    Value="{Binding OuterRadius, UpdateSourceTrigger=PropertyChanged}"
                    ToolType="PolarUnwrapTool" ParameterName="OuterRadius"/>
                <Button Content="Draw Annulus ROI" Margin="0,8,0,0" Padding="10,4"
                        Background="#FF9800" Foreground="White" BorderBrush="#E65100"
                        Command="{Binding DrawAnnulusCommand}"
                        ToolTip="캔버스에 도넛(원환) ROI를 그려서 Center/Inner/Outer를 동시에 설정"/>
            </StackPanel>
        </Expander>

        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Orientation" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Start Angle (°)"
                    Value="{Binding StartAngleDeg}" Minimum="0" Maximum="360"
                    TickFrequency="15" ValueFormat="F0"
                    ToolType="PolarUnwrapTool" ParameterName="StartAngleDeg"/>
                <controls:EnumComboBoxParameter Label="Direction"
                    ItemsSource="{conv:EnumValues {x:Type ip:PolarUnwrapDirection}}"
                    SelectedValue="{Binding Direction}"
                    ToolType="PolarUnwrapTool" ParameterName="Direction"/>
            </StackPanel>
        </Expander>

        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Output Size" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="0이면 자동: Width = 2π × OuterRadius, Height = Outer−Inner. 후속 OCR/CodeReader의 입력 해상도 강제하려면 명시."/>
                <controls:TextBoxParameter Label="Output Width (0=auto)"
                    Value="{Binding OutputWidth, UpdateSourceTrigger=PropertyChanged}"
                    ToolType="PolarUnwrapTool" ParameterName="OutputWidth"/>
                <controls:TextBoxParameter Label="Output Height (0=auto)"
                    Value="{Binding OutputHeight, UpdateSourceTrigger=PropertyChanged}"
                    ToolType="PolarUnwrapTool" ParameterName="OutputHeight"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
