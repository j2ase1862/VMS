<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.DetectionToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <StackPanel>
        <!-- Model -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Model" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:TextBoxParameter Label="Model Path (.onnx)"
                    Value="{Binding ModelPath}"
                    BrowseFilter="ONNX Models (*.onnx)|*.onnx|All Files (*.*)|*.*"
                    ToolType="DetectionTool" ParameterName="ModelPath"/>
                <controls:SliderParameter Label="Inference Size (px)"
                    Value="{Binding InputSize}" Minimum="320" Maximum="1280"
                    TickFrequency="32" ValueFormat="F0"
                    ToolTip="YOLO 추론 시 이미지를 리사이즈하는 정사각형 크기 (NxN).&#x0a;학습 시 사용한 imgsz와 동일하게 설정하세요.&#x0a;기본값: 640 (YOLOv8 기본 학습 크기)&#x0a;큰 값 = 정밀도↑ 속도↓ / 작은 값 = 속도↑ 정밀도↓"
                    ToolType="DetectionTool" ParameterName="InputSize"/>
            </StackPanel>
        </Expander>

        <!-- SAHI Tiled Inference -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="SAHI (Tiled Inference)" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Use SAHI"
                    IsChecked="{Binding UseSahi}"
                    ToolType="DetectionTool" ParameterName="UseSahi"
                    ToolTip="Slicing Aided Hyper Inference.&#x0a;고해상도(4K+) 영상에서 작은 결함이 리사이즈로 사라지는 것을 방지합니다.&#x0a;타일별 추론 후 전역 NMS로 병합합니다."/>
                <controls:SliderParameter Label="Tile Size (px)"
                    Value="{Binding SahiTileSize}" Minimum="320" Maximum="1536"
                    TickFrequency="64" ValueFormat="F0"
                    ToolTip="타일 한 변 크기. Inference Size와 동일하게 두면 원본 해상도로 추론 (기본 640)"
                    ToolType="DetectionTool" ParameterName="SahiTileSize"/>
                <controls:SliderParameter Label="Overlap Ratio"
                    Value="{Binding SahiOverlapRatio}" Minimum="0.0" Maximum="0.5"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolTip="타일 간 겹침 비율. 0.2=20%. 경계에 걸친 객체를 보존하기 위해 필요"
                    ToolType="DetectionTool" ParameterName="SahiOverlapRatio"/>
            </StackPanel>
        </Expander>

        <!-- Preprocessing (CLAHE) -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Preprocessing (CLAHE)" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Use CLAHE"
                    IsChecked="{Binding UseClahe}"
                    ToolType="DetectionTool" ParameterName="UseClahe"
                    ToolTip="추론 전 CLAHE(Contrast Limited Adaptive Histogram Equalization)로 대비를 향상시킵니다.&#x0a;공장 조명 변동 환경에서 결함 검출률 개선에 효과적입니다."/>
                <controls:SliderParameter Label="Clip Limit"
                    Value="{Binding ClaheClipLimit}" Minimum="1.0" Maximum="10.0"
                    TickFrequency="0.5" ValueFormat="F1"
                    ToolTip="대비 증폭 한계. 높을수록 대비 강화, 노이즈 증폭 위험↑ (기본 2.0)"
                    ToolType="DetectionTool" ParameterName="ClaheClipLimit"/>
                <controls:SliderParameter Label="Tile Grid Size"
                    Value="{Binding ClaheTileGridSize}" Minimum="2" Maximum="16"
                    TickFrequency="1" ValueFormat="F0"
                    ToolTip="타일 N×N 분할 크기. 작을수록 국소 적응 강해지지만 아티팩트 증가 (기본 8)"
                    ToolType="DetectionTool" ParameterName="ClaheTileGridSize"/>
            </StackPanel>
        </Expander>

        <!-- Detection -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Detection" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Confidence Threshold"
                    Value="{Binding ConfidenceThreshold}" Minimum="0.1" Maximum="1.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolTip="전체 클래스에 적용될 기본 Confidence 임계값.&#x0a;Use Per-Class를 켜면 클래스별 값이 우선 적용됩니다."
                    ToolType="DetectionTool" ParameterName="ConfidenceThreshold"/>
                <controls:SliderParameter Label="IoU Threshold"
                    Value="{Binding IouThreshold}" Minimum="0.1" Maximum="1.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="DetectionTool" ParameterName="IouThreshold"/>

                <!-- Per-class Confidence Toggle -->
                <controls:CheckBoxParameter Label="Use Per-Class Thresholds"
                    IsChecked="{Binding UsePerClassThresholds}"
                    ToolType="DetectionTool" ParameterName="UsePerClassThresholds"
                    ToolTip="결함 클래스별로 Confidence 임계값을 개별 설정합니다.&#x0a;예: 중요 결함은 임계값↓(민감), 노이즈성 클래스는 임계값↑(강건)"/>

                <!-- Per-class Threshold List -->
                <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3"
                        Padding="6" Margin="0,4,0,4"
                        Visibility="{Binding UsePerClassThresholds, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="Per-Class Confidence"
                                   Foreground="#AAA" FontSize="11" FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding ClassThresholds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ClassName}"
                                                   Foreground="#4FC3F7" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Slider Grid.Column="1"
                                                Value="{Binding Threshold}"
                                                Minimum="0.05" Maximum="1.0"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" Margin="4,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Threshold, StringFormat=F2}"
                                                   Foreground="#DDD" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Foreground="#666" FontSize="10" FontStyle="Italic"
                                   Margin="0,4,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="모델을 선택하면 클래스가 자동으로 로드됩니다."/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClassThresholds.Count, FallbackValue=0}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Class Names: 모델 메타데이터에서 자동 로드 -->
                <StackPanel Margin="0,5,0,5">
                    <TextBlock Text="Class Names" Foreground="LightGray" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ModelClassNames}"
                              SelectedIndex="0">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource SettingComboBoxStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelClassNames.Count, FallbackValue=0}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Foreground="#666" FontSize="10" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value=""/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelClassNames.Count, FallbackValue=0}" Value="0">
                                        <Setter Property="Text" Value="모델을 선택하면 클래스가 자동으로 로드됩니다."/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Dot Cluster Analysis -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Dot Cluster Analysis" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Use Dot Analysis"
                    IsChecked="{Binding UseDotAnalysis}"
                    ToolType="DetectionTool" ParameterName="UseDotAnalysis"
                    ToolTip="YOLO가 검출한 각 바운딩 박스 내부에서 dot 군락의 개수와 배치 각도를 추가 분석합니다.&#x0a;활성화 시 클래스별 기대값(아래 표)과 비교하여 Pass/Fail을 판정합니다."/>

                <StackPanel Visibility="{Binding UseDotAnalysis, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <!-- Detection Method -->
                    <TextBlock Text="Detection Method" Foreground="LightGray" FontSize="12" Margin="0,6,0,2"/>
                    <ComboBox ItemsSource="{Binding DotDetectionMethodValues}"
                              SelectedItem="{Binding DotDetectionMethod}"
                              Style="{StaticResource SettingComboBoxStyle}"/>

                    <controls:SliderParameter Label="Min Dot Area (px²)"
                        Value="{Binding MinDotArea}" Minimum="1" Maximum="1000"
                        TickFrequency="1" ValueFormat="F0"
                        ToolTip="이 면적보다 작은 얼룩은 노이즈로 간주해 무시"
                        ToolType="DetectionTool" ParameterName="MinDotArea"/>
                    <controls:SliderParameter Label="Max Dot Area (px²)"
                        Value="{Binding MaxDotArea}" Minimum="10" Maximum="5000"
                        TickFrequency="10" ValueFormat="F0"
                        ToolTip="이 면적보다 큰 얼룩은 dot이 아닌 큰 결함으로 간주해 무시"
                        ToolType="DetectionTool" ParameterName="MaxDotArea"/>
                    <controls:SliderParameter Label="Circularity (0~1)"
                        Value="{Binding DotCircularityThreshold}" Minimum="0.0" Maximum="1.0"
                        TickFrequency="0.05" ValueFormat="F2"
                        ToolTip="원형도 최소값. 1.0=완벽한 원. Blob 방식에서만 적용"
                        ToolType="DetectionTool" ParameterName="DotCircularityThreshold"/>
                    <controls:SliderParameter Label="Min Dot Distance (px)"
                        Value="{Binding MinDotDistance}" Minimum="0" Maximum="100"
                        TickFrequency="1" ValueFormat="F0"
                        ToolTip="이 거리 이하로 가까운 dot은 하나로 병합"
                        ToolType="DetectionTool" ParameterName="MinDotDistance"/>

                    <!-- Pattern Metric -->
                    <TextBlock Text="Pattern Angle Metric" Foreground="LightGray" FontSize="12" Margin="0,6,0,2"/>
                    <ComboBox ItemsSource="{Binding DotPatternMetricValues}"
                              SelectedItem="{Binding DotPatternMetric}"
                              Style="{StaticResource SettingComboBoxStyle}"
                              ToolTip="MainAxisAngle = 전체 dot의 PCA 주축 방향&#x0a;LongestLineAngle = 가장 멀리 떨어진 두 dot의 연결선 각도"/>

                    <!-- Low-Contrast Enhancement -->
                    <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3"
                            Padding="6" Margin="0,8,0,4">
                        <StackPanel>
                            <TextBlock Text="Low-Contrast Enhancement"
                                       Foreground="#AAA" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="Preprocess Mode" Foreground="LightGray" FontSize="12" Margin="0,2,0,2"/>
                            <ComboBox ItemsSource="{Binding DotPreprocessModeValues}"
                                      SelectedItem="{Binding DotPreprocessMode}"
                                      Style="{StaticResource SettingComboBoxStyle}"
                                      ToolTip="None = 전처리 없음&#x0a;Clahe = 국소 대비 강화 (저대비 일반)&#x0a;TopHat = dot이 주변보다 밝을 때&#x0a;BottomHat = dot이 주변보다 어두울 때"/>

                            <controls:SliderParameter Label="CLAHE Clip Limit"
                                Value="{Binding DotClaheClipLimit}" Minimum="1.0" Maximum="10.0"
                                TickFrequency="0.5" ValueFormat="F1"
                                ToolTip="Clahe 모드에서만 사용. 값↑ = 대비 강화 + 노이즈 증폭"
                                ToolType="DetectionTool" ParameterName="DotClaheClipLimit"/>
                            <controls:SliderParameter Label="Morph Kernel Size (px)"
                                Value="{Binding DotMorphKernelSize}" Minimum="3" Maximum="51"
                                TickFrequency="2" ValueFormat="F0"
                                ToolTip="TopHat/BottomHat 모드에서만 사용. dot보다 크고 주변 구조보다 작게 설정"
                                ToolType="DetectionTool" ParameterName="DotMorphKernelSize"/>

                            <TextBlock Text="Threshold Mode" Foreground="LightGray" FontSize="12" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding DotThresholdModeValues}"
                                      SelectedItem="{Binding DotThresholdMode}"
                                      Style="{StaticResource SettingComboBoxStyle}"
                                      ToolTip="Otsu = 전역 단일 임계값&#x0a;Adaptive = 국소 평균 기준 (저대비·조명 불균일에 강함)"/>

                            <controls:SliderParameter Label="Adaptive Block Size"
                                Value="{Binding DotAdaptiveBlockSize}" Minimum="3" Maximum="101"
                                TickFrequency="2" ValueFormat="F0"
                                ToolTip="Adaptive 모드에서만 사용. 국소 영역 크기(홀수 px)"
                                ToolType="DetectionTool" ParameterName="DotAdaptiveBlockSize"/>
                            <controls:SliderParameter Label="Adaptive C"
                                Value="{Binding DotAdaptiveC}" Minimum="-10.0" Maximum="30.0"
                                TickFrequency="1" ValueFormat="F1"
                                ToolTip="국소 평균에서 뺄 값. 값↑ = 더 엄격(작은 대비 거름)"
                                ToolType="DetectionTool" ParameterName="DotAdaptiveC"/>
                        </StackPanel>
                    </Border>

                    <!-- Per-Class Expectations Table -->
                    <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3"
                            Padding="6" Margin="0,8,0,4">
                        <StackPanel>
                            <TextBlock Text="Per-Class Dot Expectations"
                                       Foreground="#AAA" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding DotExpectations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
                                                Padding="2,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ClassName}"
                                                           Foreground="#4FC3F7" FontSize="11"
                                                           FontWeight="Bold" Margin="0,0,0,2"/>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Expected" Foreground="#BBB"
                                                               FontSize="10" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Text="{Binding ExpectedCount}"
                                                                 Width="50" FontSize="11"
                                                                 ToolTip="기대 dot 개수 (0=검사 안함)"/>
                                                        <TextBlock Text=" ±" Foreground="#888"
                                                                   VerticalAlignment="Center" Margin="4,0"/>
                                                        <TextBox Text="{Binding CountTolerance}"
                                                                 Width="40" FontSize="11"
                                                                 ToolTip="허용 편차"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="Check Angle"
                                                              IsChecked="{Binding CheckAngle}"
                                                              Foreground="#BBB" FontSize="10"
                                                              VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Text="{Binding ReferenceAngle, StringFormat=F1}"
                                                                 Width="50" FontSize="11"
                                                                 ToolTip="기준 각도 (도, -90~+90)"/>
                                                        <TextBlock Text="° ±" Foreground="#888"
                                                                   VerticalAlignment="Center" Margin="4,0"/>
                                                        <TextBox Text="{Binding AngleTolerance, StringFormat=F1}"
                                                                 Width="50" FontSize="11"
                                                                 ToolTip="허용 각도 편차"/>
                                                        <TextBlock Text="°" Foreground="#888"
                                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Foreground="#666" FontSize="10" FontStyle="Italic"
                                       Margin="0,4,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="모델을 선택하면 클래스별 기대값을 편집할 수 있습니다."/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DotExpectations.Count, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Display -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Display" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Draw Overlay"
                    IsChecked="{Binding DrawOverlay}"
                    ToolType="DetectionTool" ParameterName="DrawOverlay"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
