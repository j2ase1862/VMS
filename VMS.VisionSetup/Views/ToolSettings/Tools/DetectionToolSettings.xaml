<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.DetectionToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls">
    <StackPanel>
        <!-- Model -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Model" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:TextBoxParameter Label="Model Path (.onnx)"
                    Value="{Binding ModelPath}"
                    BrowseFilter="ONNX Models (*.onnx)|*.onnx|All Files (*.*)|*.*"
                    ToolType="DetectionTool" ParameterName="ModelPath"/>
                <controls:SliderParameter Label="Inference Size (px)"
                    Value="{Binding InputSize}" Minimum="320" Maximum="1280"
                    TickFrequency="32" ValueFormat="F0"
                    ToolTip="YOLO 추론 시 이미지를 리사이즈하는 정사각형 크기 (NxN).&#x0a;학습 시 사용한 imgsz와 동일하게 설정하세요.&#x0a;기본값: 640 (YOLOv8 기본 학습 크기)&#x0a;큰 값 = 정밀도↑ 속도↓ / 작은 값 = 속도↑ 정밀도↓"
                    ToolType="DetectionTool" ParameterName="InputSize"/>
            </StackPanel>
        </Expander>

        <!-- Detection -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Detection" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Confidence Threshold"
                    Value="{Binding ConfidenceThreshold}" Minimum="0.1" Maximum="1.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="DetectionTool" ParameterName="ConfidenceThreshold"/>
                <controls:SliderParameter Label="IoU Threshold"
                    Value="{Binding IouThreshold}" Minimum="0.1" Maximum="1.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="DetectionTool" ParameterName="IouThreshold"/>
                <!-- Class Names: 모델 메타데이터에서 자동 로드 -->
                <StackPanel Margin="0,5,0,5">
                    <TextBlock Text="Class Names" Foreground="LightGray" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ModelClassNames}"
                              SelectedIndex="0">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource SettingComboBoxStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelClassNames.Count, FallbackValue=0}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Foreground="#666" FontSize="10" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value=""/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelClassNames.Count, FallbackValue=0}" Value="0">
                                        <Setter Property="Text" Value="모델을 선택하면 클래스가 자동으로 로드됩니다."/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Display -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Display" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Draw Overlay"
                    IsChecked="{Binding DrawOverlay}"
                    ToolType="DetectionTool" ParameterName="DrawOverlay"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
