<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.ShapeMatchToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
        <!-- Expert Mode 토글은 ToolSettingsView 헤더로 통합됨 — 본문 자체 토글 제거.
             IsExpertMode 가 ON 일 때 Search Range / Speed Expander 노출. -->

        <!-- Template + Training Region -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Template" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#999999" FontSize="11" Margin="0,4,0,4">
                    <Run Text="Status: "/>
                    <Run Text="{Binding TrainStatus, Mode=OneWay}" Foreground="#00BFFF" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="1) Load image. 2) Define Training Region below. 3) Click 'Train Template'."/>

                <!-- Training Region -->
                <CheckBox Content="Use Training Region" Foreground="White" Margin="0,8,0,2"
                          IsChecked="{Binding UseROI, Mode=TwoWay}"/>
                <StackPanel Visibility="{Binding UseROI, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="X:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="0" Grid.Column="0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,5"
                                 Style="{StaticResource SettingTextBoxStyle}"
                                 Text="{Binding ROIX, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Y:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="0" Grid.Column="2"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,5"
                                 Style="{StaticResource SettingTextBoxStyle}"
                                 Text="{Binding ROIY, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="W:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="1" Grid.Column="0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,10,5"
                                 Style="{StaticResource SettingTextBoxStyle}"
                                 Text="{Binding ROIWidth, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="H:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="1" Grid.Column="2"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,5"
                                 Style="{StaticResource SettingTextBoxStyle}"
                                 Text="{Binding ROIHeight, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,5">
                        <Button Content="Show ROI" Style="{StaticResource SuccessButtonStyle}"
                                Padding="8,4" Margin="0,0,5,0"
                                Command="{Binding ShowROICommand}"/>
                        <Button Content="Draw ROI" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="8,4" Margin="0,0,5,0"
                                Command="{Binding DrawROICommand}"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                Command="{Binding ClearROICommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Train Template" Command="{Binding TrainTemplateCommand}"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            Padding="10,4" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Clear Template" Command="{Binding ClearTemplateCommand}"
                            Background="#555555" Foreground="White" BorderThickness="0"
                            Padding="10,4" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Search Range (전문가 모드에서만 표시) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}"
                  Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
            <Expander.Header>
                <TextBlock Text="Search Range" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Angle range fixed to ±180°. Adjust AngleStep for precision/speed trade-off."/>
                <controls:SliderParameter Label="Angle Step (°)"
                    Value="{Binding AngleStep}" Minimum="0.5" Maximum="30"
                    TickFrequency="0.5" ValueFormat="F1"
                    ToolType="ShapeMatchTool" ParameterName="AngleStep"/>
                <controls:SliderParameter Label="Min Scale"
                    Value="{Binding MinScale}" Minimum="0.2" Maximum="2.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="ShapeMatchTool" ParameterName="MinScale"/>
                <controls:SliderParameter Label="Max Scale"
                    Value="{Binding MaxScale}" Minimum="0.2" Maximum="3.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="ShapeMatchTool" ParameterName="MaxScale"/>
                <controls:SliderParameter Label="Scale Step"
                    Value="{Binding ScaleStep}" Minimum="0.01" Maximum="0.5"
                    TickFrequency="0.01" ValueFormat="F2"
                    ToolType="ShapeMatchTool" ParameterName="ScaleStep"/>
            </StackPanel>
        </Expander>

        <!-- Acceptance & Multi-Instance -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Acceptance / Multi-Instance" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Score Threshold"
                    Value="{Binding ScoreThreshold}" Minimum="0.0" Maximum="1.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="ShapeMatchTool" ParameterName="ScoreThreshold"/>
                <controls:ParamCodeLink
                    AvailableParamCodes="{Binding AvailableParamCodes}"
                    SelectedItem="{Binding SelectedScoreThresholdCode}"/>
                <controls:SliderParameter Label="Max Instances"
                    Value="{Binding MaxInstances}" Minimum="1" Maximum="20"
                    TickFrequency="1" ValueFormat="F0"
                    ToolType="ShapeMatchTool" ParameterName="MaxInstances"/>
                <controls:SliderParameter Label="NMS Distance Factor"
                    Value="{Binding NmsDistanceFactor}" Minimum="0.1" Maximum="2.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="ShapeMatchTool" ParameterName="NmsDistanceFactor"/>
            </StackPanel>
        </Expander>

        <!-- Speed / Pyramid -->
        <!-- Speed (전문가 모드에서만 표시) -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}"
                  Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
            <Expander.Header>
                <TextBlock Text="Speed (Pyramid + Coarse-to-Fine)" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Pyramid Levels"
                    Value="{Binding NumPyramidLevels}" Minimum="1" Maximum="4"
                    TickFrequency="1" ValueFormat="F0"
                    ToolType="ShapeMatchTool" ParameterName="NumPyramidLevels"/>
                <controls:SliderParameter Label="Top Candidates to Refine"
                    Value="{Binding TopCandidates}" Minimum="1" Maximum="10"
                    TickFrequency="1" ValueFormat="F0"
                    ToolType="ShapeMatchTool" ParameterName="TopCandidates"/>
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Higher pyramid levels = faster. Lower TopCandidates = faster but may miss optimum. Defaults are balanced."/>
            </StackPanel>
        </Expander>

        <!-- Search Region (FeatureMatchTool과 동일 컨셉) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Search Region" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Use Search Region"
                    IsChecked="{Binding UseSearchRegion}"
                    ToolType="ShapeMatchTool" ParameterName="UseSearchRegion"/>
                <controls:TextBoxParameter Label="X"
                    Value="{Binding SearchRegionX}"
                    ToolType="ShapeMatchTool" ParameterName="SearchRegionX"/>
                <controls:TextBoxParameter Label="Y"
                    Value="{Binding SearchRegionY}"
                    ToolType="ShapeMatchTool" ParameterName="SearchRegionY"/>
                <controls:TextBoxParameter Label="Width"
                    Value="{Binding SearchRegionWidth}"
                    ToolType="ShapeMatchTool" ParameterName="SearchRegionWidth"/>
                <controls:TextBoxParameter Label="Height"
                    Value="{Binding SearchRegionHeight}"
                    ToolType="ShapeMatchTool" ParameterName="SearchRegionHeight"/>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <Button Content="Draw Search Region" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="8,4" Margin="0,0,5,0"
                            Command="{Binding DrawSearchRegionCommand}"/>
                    <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,4"
                            Command="{Binding ClearSearchRegionCommand}"/>
                </StackPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
