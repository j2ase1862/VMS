<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.PointCloudClusterToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
             xmlns:conv="clr-namespace:VMS.VisionSetup.Converters"
             xmlns:pc="clr-namespace:VMS.VisionSetup.VisionTools.PointCloud">
    <StackPanel>
        <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,8"
                   Text="점군을 덩어리(물체)별로 나눕니다 — 트레이 위 부품 개수 세기, 가장 큰 물체만 골라내기, 부스러기 덩어리 제거에 사용. Tolerance(mm) 이내로 가까운 점들이 같은 물체로 묶입니다."/>

        <!-- Clustering Parameters -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Clustering Parameters" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Tolerance (mm)"
                    Value="{Binding Tolerance}" Minimum="0.1" Maximum="50.0"
                    TickFrequency="0.1" ValueFormat="F2"
                    ToolType="PointCloudClusterTool" ParameterName="Tolerance"/>
                <controls:TextBoxParameter Label="Min Points"
                    Value="{Binding MinPoints}"
                    ToolType="PointCloudClusterTool" ParameterName="MinPoints"/>
                <controls:TextBoxParameter Label="Max Points"
                    Value="{Binding MaxPoints}"
                    ToolType="PointCloudClusterTool" ParameterName="MaxPoints"/>
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="단위: 점 개수 — Min보다 작은 덩어리는 노이즈로, Max보다 큰 덩어리는 배경으로 보고 무시합니다."/>
                <controls:SliderParameter Label="Max Reported Clusters"
                    Value="{Binding MaxReportedClusters}" Minimum="1" Maximum="50"
                    TickFrequency="1" ValueFormat="F0"
                    ToolType="PointCloudClusterTool" ParameterName="MaxReportedClusters"/>
            </StackPanel>
        </Expander>

        <!-- Output -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Output Mode" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:EnumComboBoxParameter Label="Output Mode"
                    ItemsSource="{conv:EnumValues {x:Type pc:PointCloudClusterTool+ClusterOutputMode}}"
                    SelectedValue="{Binding OutputMode}"
                    ToolType="PointCloudClusterTool" ParameterName="OutputMode"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
