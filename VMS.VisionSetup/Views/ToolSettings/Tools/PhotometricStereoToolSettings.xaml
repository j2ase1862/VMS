<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.PhotometricStereoToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
             xmlns:conv="clr-namespace:VMS.VisionSetup.Converters"
             xmlns:sa="clr-namespace:VMS.VisionSetup.VisionTools.SurfaceAnalysis">
    <StackPanel>
        <!-- Output -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Output" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:EnumComboBoxParameter Label="Output Type"
                    ItemsSource="{conv:EnumValues {x:Type sa:PsOutputType}}"
                    SelectedValue="{Binding OutputType}"
                    ToolType="PhotometricStereoTool" ParameterName="OutputType"
                    ToolTip="NormalMap = 법선 RGB 시각화&#x0a;Albedo = 반사율(질감)&#x0a;DefectEnhanced = 곡률 기반 결함강조(스크래치·덴트)"/>
                <controls:SliderParameter Label="Curvature Gain"
                    Value="{Binding CurvatureGain}" Minimum="1" Maximum="30"
                    TickFrequency="1" ValueFormat="F1"
                    ToolTip="DefectEnhanced 출력의 결함 강조 강도. 값↑ = 미세 결함 부각 + 노이즈 증폭"
                    ToolType="PhotometricStereoTool" ParameterName="CurvatureGain"/>
            </StackPanel>
        </Expander>

        <!-- Shadow / Highlight Rejection -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Shadow / Highlight Rejection" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Shadow Threshold"
                    Value="{Binding ShadowThreshold}" Minimum="0" Maximum="100"
                    TickFrequency="1" ValueFormat="F0"
                    ToolTip="이 밝기 이하 픽셀은 그림자로 간주 (해당 조명 신뢰 제외). 0=비활성"
                    ToolType="PhotometricStereoTool" ParameterName="ShadowThreshold"/>
                <controls:SliderParameter Label="Highlight Threshold"
                    Value="{Binding HighlightThreshold}" Minimum="155" Maximum="255"
                    TickFrequency="1" ValueFormat="F0"
                    ToolTip="이 밝기 이상 픽셀은 정반사 포화로 간주 (해당 조명 신뢰 제외). 255=비활성"
                    ToolType="PhotometricStereoTool" ParameterName="HighlightThreshold"/>
            </StackPanel>
        </Expander>

        <!-- Light Sources -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Light Sources (≥3)" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Text="조명별 방향벡터(Lx,Ly,Lz)와 해당 조명에서 촬영한 이미지 경로를 지정합니다. (A 방식)"
                           Foreground="#888" FontSize="10" FontStyle="Italic"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>

                <ItemsControl ItemsSource="{Binding Lights}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3"
                                    Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <!-- Header: index label + remove -->
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="X"
                                                Command="{Binding DataContext.RemoveLightCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="#E05555"
                                                BorderThickness="0" FontWeight="Bold" Padding="6,0"
                                                Cursor="Hand" ToolTip="조명 제거"/>
                                        <TextBlock Text="Light" Foreground="#4FC3F7" FontSize="11"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Direction Lx / Ly / Lz -->
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                            <TextBlock Text="Lx" Foreground="#AAA" FontSize="10"/>
                                            <TextBox Text="{Binding Lx, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                            <TextBlock Text="Ly" Foreground="#AAA" FontSize="10"/>
                                            <TextBox Text="{Binding Ly, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                            <TextBlock Text="Lz" Foreground="#AAA" FontSize="10"/>
                                            <TextBox Text="{Binding Lz, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Image path with browse -->
                                    <controls:TextBoxParameter Label="Image"
                                        Value="{Binding ImagePath}"
                                        BrowseFilter="이미지 파일|*.png;*.jpg;*.jpeg;*.bmp;*.tif;*.tiff|모든 파일|*.*"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ Add Light"
                        Command="{Binding AddLightCommand}"
                        Background="{StaticResource BrushBgSurface}" Foreground="{StaticResource BrushTextPrimary}"
                        BorderBrush="{StaticResource BrushBorderStrong}" Padding="8,4"
                        HorizontalAlignment="Left" Margin="0,2,0,2" Cursor="Hand"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
