<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.OCVToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
        <!-- Training Region + Train (분할 학습) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Font Library Training" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,6"
                           Text="1) Training Region을 학습용 텍스트에 맞춤. 2) Known String 입력. 3) Train 클릭. 분할 개수와 Known String 길이가 일치해야 학습 성공."/>

                <TextBlock Foreground="#999999" FontSize="11" Margin="0,2,0,2">
                    <Run Text="Status: "/>
                    <Run Text="{Binding TrainStatus, Mode=OneWay}" Foreground="#00BFFF" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Foreground="#999999" FontSize="11" Margin="0,2,0,2">
                    <Run Text="Library: "/>
                    <Run Text="{Binding LibraryCount, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                    <Run Text=" templates"/>
                </TextBlock>
                <TextBlock Foreground="#999999" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap">
                    <Run Text="Chars: "/>
                    <Run Text="{Binding LibraryChars, Mode=OneWay}" Foreground="#FFCC66" FontFamily="Consolas"/>
                </TextBlock>

                <!-- Training Region (UseROI / ROI*) -->
                <CheckBox Content="Use Training Region" Foreground="White" Margin="0,8,0,2"
                          IsChecked="{Binding UseROI, Mode=TwoWay}"/>
                <StackPanel Visibility="{Binding UseROI, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="X:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="0" Grid.Column="0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,5"
                                 Text="{Binding ROIX, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Y:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="0" Grid.Column="2"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,5"
                                 Text="{Binding ROIY, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="W:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="1" Grid.Column="0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,10,5"
                                 Text="{Binding ROIWidth, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="H:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="1" Grid.Column="2"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,5"
                                 Text="{Binding ROIHeight, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,5">
                        <Button Content="Show ROI" Padding="8,4" Margin="0,0,5,0"
                                Background="#2D7D46" Foreground="White" BorderBrush="#1E5C32"
                                Command="{Binding ShowROICommand}"/>
                        <Button Content="Draw ROI" Padding="8,4" Margin="0,0,5,0"
                                Background="#007ACC" Foreground="White" BorderBrush="#005A9E"
                                Command="{Binding DrawROICommand}"/>
                        <Button Content="Clear" Padding="8,4"
                                Background="#555555" Foreground="White" BorderBrush="#444"
                                Command="{Binding ClearROICommand}"/>
                    </StackPanel>
                </StackPanel>

                <controls:TextBoxParameter Label="Known String"
                    Value="{Binding KnownString, UpdateSourceTrigger=PropertyChanged}"
                    ToolType="OCVTool" ParameterName="KnownString"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Train" Command="{Binding TrainCommand}"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            Padding="12,4" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Clear Library" Command="{Binding ClearLibraryCommand}"
                            Background="#555555" Foreground="White" BorderThickness="0"
                            Padding="12,4" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Segmentation -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Segmentation" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Invert Image"
                    IsChecked="{Binding InvertImage}"
                    ToolType="OCVTool" ParameterName="InvertImage"/>
                <controls:SliderParameter Label="Min Char Height"
                    Value="{Binding MinCharHeight}" Minimum="2" Maximum="200"
                    TickFrequency="2" ValueFormat="F0"
                    ToolType="OCVTool" ParameterName="MinCharHeight"/>
                <controls:SliderParameter Label="Max Char Height"
                    Value="{Binding MaxCharHeight}" Minimum="10" Maximum="500"
                    TickFrequency="10" ValueFormat="F0"
                    ToolType="OCVTool" ParameterName="MaxCharHeight"/>
                <controls:SliderParameter Label="Min Char Width"
                    Value="{Binding MinCharWidth}" Minimum="1" Maximum="100"
                    TickFrequency="1" ValueFormat="F0"
                    ToolType="OCVTool" ParameterName="MinCharWidth"/>
            </StackPanel>
        </Expander>

        <!-- Matching -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Matching" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Match Threshold"
                    Value="{Binding MatchThreshold}" Minimum="0" Maximum="1"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="OCVTool" ParameterName="MatchThreshold"/>
                <controls:TextBoxParameter Label="Expected Text (optional)"
                    Value="{Binding ExpectedText, UpdateSourceTrigger=PropertyChanged}"
                    ToolType="OCVTool" ParameterName="ExpectedText"/>
            </StackPanel>
        </Expander>

        <!-- Search Region (Execute가 사용 — Training Region과 분리) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Search Region" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Execute가 문자를 검색할 영역. 학습 영역과 다른 위치에서 검증 가능. 미사용 시 전체 이미지 검색."/>
                <controls:CheckBoxParameter Label="Use Search Region"
                    IsChecked="{Binding UseSearchRegion}"
                    ToolType="OCVTool" ParameterName="UseSearchRegion"/>
                <controls:TextBoxParameter Label="X"
                    Value="{Binding SearchRegionX}"
                    ToolType="OCVTool" ParameterName="SearchRegionX"/>
                <controls:TextBoxParameter Label="Y"
                    Value="{Binding SearchRegionY}"
                    ToolType="OCVTool" ParameterName="SearchRegionY"/>
                <controls:TextBoxParameter Label="Width"
                    Value="{Binding SearchRegionWidth}"
                    ToolType="OCVTool" ParameterName="SearchRegionWidth"/>
                <controls:TextBoxParameter Label="Height"
                    Value="{Binding SearchRegionHeight}"
                    ToolType="OCVTool" ParameterName="SearchRegionHeight"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <Button Content="Draw Search Region" Padding="8,4" Margin="0,0,5,0"
                            Background="#007ACC" Foreground="White" BorderBrush="#005A9E"
                            Command="{Binding DrawSearchRegionCommand}"/>
                    <Button Content="Clear" Padding="8,4"
                            Background="#555555" Foreground="White" BorderBrush="#444"
                            Command="{Binding ClearSearchRegionCommand}"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Display -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Display" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Draw Overlay"
                    IsChecked="{Binding DrawOverlay}"
                    ToolType="OCVTool" ParameterName="DrawOverlay"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
