<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.Geometry3DToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
             xmlns:conv="clr-namespace:VMS.VisionSetup.Converters"
             xmlns:meas="clr-namespace:VMS.VisionSetup.VisionTools.Measurement">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel>
        <controls:EnumComboBoxParameter Label="Operation"
            ItemsSource="{conv:EnumValues {x:Type meas:Geometry3DOperation}}"
            SelectedValue="{Binding Operation}"
            ToolType="Geometry3DTool" ParameterName="Operation"/>

        <controls:CheckBoxParameter Label="Use Manual Points"
            IsChecked="{Binding UseManualPoints}"
            ToolType="Geometry3DTool" ParameterName="UseManualPoints"/>

        <!-- Manual Point Input (visible when UseManualPoints and operation needs points) -->
        <StackPanel Visibility="{Binding ShowManualPoints, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Point A (pixel)" Foreground="#AAAAAA" FontWeight="Bold"
                       Margin="0,8,0,4" FontSize="11"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="X" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding PointAX, UpdateSourceTrigger=PropertyChanged}"
                         Background="#2D2D30" Foreground="White" BorderBrush="#555" FontSize="11" Padding="4,3"/>
                <TextBlock Grid.Column="2" Text="Y" Foreground="#999" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Grid.Column="3" Text="{Binding PointAY, UpdateSourceTrigger=PropertyChanged}"
                         Background="#2D2D30" Foreground="White" BorderBrush="#555" FontSize="11" Padding="4,3"/>
            </Grid>

            <!-- Point B (only for PointToPoint) -->
            <StackPanel Visibility="{Binding ShowPointB, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Point B (pixel)" Foreground="#AAAAAA" FontWeight="Bold"
                           Margin="0,8,0,4" FontSize="11"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding PointBX, UpdateSourceTrigger=PropertyChanged}"
                             Background="#2D2D30" Foreground="White" BorderBrush="#555" FontSize="11" Padding="4,3"/>
                    <TextBlock Grid.Column="2" Text="Y" Foreground="#999" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Column="3" Text="{Binding PointBY, UpdateSourceTrigger=PropertyChanged}"
                             Background="#2D2D30" Foreground="White" BorderBrush="#555" FontSize="11" Padding="4,3"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Connected Source Geometries -->
        <TextBlock Text="Source Geometries" Foreground="#AAAAAA" FontWeight="Bold"
                   Margin="0,10,0,5" FontSize="12"/>

        <ItemsControl ItemsSource="{Binding SourceGeometries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1"
                            Padding="4,3" Margin="0,1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Foreground="#CCCCCC" FontSize="11"
                                       Text="{Binding ToolName, Mode=OneWay}"/>
                            <TextBlock Foreground="#999999" FontSize="10" Margin="0,2,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Point:{0} Plane:{1} Line:{2}">
                                        <Binding Path="HasPoint" Mode="OneWay"/>
                                        <Binding Path="HasPlane" Mode="OneWay"/>
                                        <Binding Path="HasLine" Mode="OneWay"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No source geometries connected" Foreground="#666666"
                   FontSize="11" Margin="0,5,0,0" FontStyle="Italic">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SourceGeometries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
