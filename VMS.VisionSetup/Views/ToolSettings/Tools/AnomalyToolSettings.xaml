<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.AnomalyToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls">
    <StackPanel>
        <!-- Model -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Model" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:TextBoxParameter Label="Model Path (.onnx)"
                    Value="{Binding ModelPath}"
                              ShowRegistryPicker="True" RegistryTaskType="anomaly"
                    BrowseFilter="ONNX Models (*.onnx)|*.onnx|All Files (*.*)|*.*"
                    ToolType="AnomalyTool" ParameterName="ModelPath"/>
                <controls:SliderParameter Label="Input Size"
                    Value="{Binding InputSize}" Minimum="64" Maximum="512"
                    TickFrequency="32" ValueFormat="F0"
                    ToolType="AnomalyTool" ParameterName="InputSize"/>
            </StackPanel>
        </Expander>

        <!-- Anomaly Detection -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Anomaly Detection" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Anomaly Threshold"
                    Value="{Binding AnomalyThreshold}" Minimum="0.0" Maximum="1.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="AnomalyTool" ParameterName="AnomalyThreshold"/>
            </StackPanel>
        </Expander>

        <!-- Auto Calibration -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Auto Threshold Calibration" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="정상 이미지 폴더의 점수 분포로 threshold를 자동 산출합니다. 공식: threshold = mean + σ × std"/>

                <TextBlock Text="Normal Images Folder" Foreground="LightGray" FontSize="12" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CalibrationFolder, UpdateSourceTrigger=LostFocus}"
                             FontSize="12" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="..." Width="30" Margin="4,0,0,0"
                            Command="{Binding BrowseCalibrationFolderCommand}"
                            ToolTip="정상 이미지만 있는 폴더를 선택하세요."/>
                </Grid>

                <controls:SliderParameter Label="Sigma (k)"
                    Value="{Binding CalibrationSigma}" Minimum="1.0" Maximum="6.0"
                    TickFrequency="0.5" ValueFormat="F1"
                    ToolTip="표준편차 배수. 2σ=95% / 3σ=99.7%(권장) / 4σ=99.994%. 값↑ = 보수적(미검↑, 과검↓)"
                    ToolType="AnomalyTool" ParameterName="CalibrationSigma"/>

                <Button Content="Calibrate Threshold"
                        Command="{Binding CalibrateCommand}"
                        Margin="0,4,0,4" Padding="8,6">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Setter Property="Content" Value="Calibrate Threshold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content" Value="Calibrating..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="{Binding CalibrationReport, FallbackValue=''}"
                           Foreground="#4FC3F7" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Expander>

        <!-- Display -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Display" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Draw Overlay"
                    IsChecked="{Binding DrawOverlay}"
                    ToolType="AnomalyTool" ParameterName="DrawOverlay"/>
                <controls:CheckBoxParameter Label="Show Heatmap"
                    IsChecked="{Binding ShowHeatmap}"
                    ToolType="AnomalyTool" ParameterName="ShowHeatmap"/>
                <controls:SliderParameter Label="Heatmap Opacity"
                    Value="{Binding HeatmapOpacity}" Minimum="0.0" Maximum="1.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="AnomalyTool" ParameterName="HeatmapOpacity"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
