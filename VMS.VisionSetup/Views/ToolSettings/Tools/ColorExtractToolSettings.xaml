<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.ColorExtractToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
        <!-- Expert Mode 토글은 ToolSettingsView 헤더로 통합됨 — 본문 자체 토글 제거.
             IsExpertMode 가 ON 일 때 하단 H/S/V 수동 조정 Expander 노출. -->

        <!-- Models (다중 컬러 모델) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Models (컬러 모델 목록)" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,4"
                           Text="조명/그라데이션 등으로 같은 색이 미묘하게 다를 때 여러 모델로 분할 학습. Execute는 활성 모델들의 OR로 합산됩니다."/>
                <ListBox ItemsSource="{Binding Models}"
                         SelectedItem="{Binding SelectedModel}"
                         Background="#2D2D30" Foreground="White" BorderBrush="#555"
                         Margin="0,4,0,4" MaxHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <!-- 평균 컬러 미리보기 -->
                                <Border Grid.Column="1" Width="22" Height="22"
                                        Background="{Binding AverageBrush}"
                                        BorderBrush="#888" BorderThickness="1"
                                        CornerRadius="3" Margin="0,0,6,0"
                                        ToolTip="{Binding AverageHsvText}"/>
                                <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="100"
                                         Background="Transparent" Foreground="White"
                                         BorderBrush="Transparent" BorderThickness="0,0,0,1"
                                         VerticalAlignment="Center" Padding="2,0"/>
                                <!-- 마지막 Run의 매칭 픽셀 수 -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding LastPixelCount, StringFormat={}{0:N0} px}"
                                           Foreground="#00BFFF" FontSize="10"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           ToolTip="마지막 Run의 매칭 픽셀 수"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <Button Content="+ Add" Command="{Binding AddModelCommand}"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            Padding="8,3" Margin="0,0,5,0" Cursor="Hand"/>
                    <Button Content="− Remove" Command="{Binding RemoveModelCommand}"
                            Background="#8B3A3A" Foreground="White" BorderThickness="0"
                            Padding="8,3" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Train (Training Region + Train 버튼) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Train Selected Model" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,4"
                           Text="1) Models에서 학습할 모델 선택. 2) 'Use Training Region' 체크 → 'Draw ROI'로 학습할 색 영역 그리기. 3) 'Train Selected Model' 클릭."/>

                <!-- Training Region -->
                <CheckBox Content="Use Training Region" Foreground="White" Margin="0,8,0,2"
                          IsChecked="{Binding UseROI, Mode=TwoWay}"/>
                <StackPanel Visibility="{Binding UseROI, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="X:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="0" Grid.Column="0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,5"
                                 Style="{StaticResource SettingTextBoxStyle}"
                                 Text="{Binding ROIX, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Y:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="0" Grid.Column="2"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,5"
                                 Style="{StaticResource SettingTextBoxStyle}"
                                 Text="{Binding ROIY, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="W:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="1" Grid.Column="0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,10,5"
                                 Style="{StaticResource SettingTextBoxStyle}"
                                 Text="{Binding ROIWidth, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="H:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="1" Grid.Column="2"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,5"
                                 Style="{StaticResource SettingTextBoxStyle}"
                                 Text="{Binding ROIHeight, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,5">
                        <Button Content="Show ROI" Style="{StaticResource SuccessButtonStyle}"
                                Padding="8,4" Margin="0,0,5,0"
                                Command="{Binding ShowROICommand}"/>
                        <Button Content="Draw ROI" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="8,4" Margin="0,0,5,0"
                                Command="{Binding DrawROICommand}"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                Command="{Binding ClearROICommand}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Foreground="#999999" FontSize="11" Margin="0,8,0,4">
                    <Run Text="Status: "/>
                    <Run Text="{Binding TrainStatus, Mode=OneWay}" Foreground="#00BFFF" FontWeight="Bold"/>
                </TextBlock>

                <!-- 학습 컬러 시각화 -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                    <TextBlock Text="Learned color:" Foreground="LightGray" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Width="48" Height="24"
                            Background="{Binding LearnedColorBrush}"
                            BorderBrush="#888" BorderThickness="1"
                            CornerRadius="3"/>
                    <TextBlock Text="{Binding LearnedColorText, Mode=OneWay}"
                               Foreground="#CCCCCC" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Button Content="Train Selected Model"
                        Command="{Binding TrainSelectedModelCommand}"
                        Background="#2D7D46" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Padding="10,4" Cursor="Hand"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Expander>

        <!-- Hue (전문가 모드에서만 표시) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}"
                  Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
            <Expander.Header>
                <TextBlock Text="Hue (색상)" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Hue Min (0-179)"
                    Value="{Binding HueMin}" Minimum="0" Maximum="179"
                    TickFrequency="5" ValueFormat="F0"
                    ToolType="ColorExtractTool" ParameterName="HueMin"/>
                <controls:SliderParameter Label="Hue Max (0-179)"
                    Value="{Binding HueMax}" Minimum="0" Maximum="179"
                    TickFrequency="5" ValueFormat="F0"
                    ToolType="ColorExtractTool" ParameterName="HueMax"/>
            </StackPanel>
        </Expander>

        <!-- Saturation (전문가 모드에서만 표시) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}"
                  Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
            <Expander.Header>
                <TextBlock Text="Saturation (채도)" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Saturation Min"
                    Value="{Binding SaturationMin}" Minimum="0" Maximum="255"
                    TickFrequency="5" ValueFormat="F0"
                    ToolType="ColorExtractTool" ParameterName="SaturationMin"/>
                <controls:SliderParameter Label="Saturation Max"
                    Value="{Binding SaturationMax}" Minimum="0" Maximum="255"
                    TickFrequency="5" ValueFormat="F0"
                    ToolType="ColorExtractTool" ParameterName="SaturationMax"/>
            </StackPanel>
        </Expander>

        <!-- Value (전문가 모드에서만 표시) -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}"
                  Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
            <Expander.Header>
                <TextBlock Text="Value (명도)" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Value Min"
                    Value="{Binding ValueMin}" Minimum="0" Maximum="255"
                    TickFrequency="5" ValueFormat="F0"
                    ToolType="ColorExtractTool" ParameterName="ValueMin"/>
                <controls:SliderParameter Label="Value Max"
                    Value="{Binding ValueMax}" Minimum="0" Maximum="255"
                    TickFrequency="5" ValueFormat="F0"
                    ToolType="ColorExtractTool" ParameterName="ValueMax"/>
            </StackPanel>
        </Expander>

        <!-- Post-processing -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Post-processing" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Morphology Kernel"
                    Value="{Binding MorphKernelSize}" Minimum="0" Maximum="15"
                    TickFrequency="1" ValueFormat="F0"
                    ToolType="ColorExtractTool" ParameterName="MorphKernelSize"/>
                <controls:CheckBoxParameter Label="Invert Mask"
                    IsChecked="{Binding InvertMask}"
                    ToolType="ColorExtractTool" ParameterName="InvertMask"/>
            </StackPanel>
        </Expander>

        <!-- Display -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Display" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Show Overlay"
                    IsChecked="{Binding ShowOverlay}"
                    ToolType="ColorExtractTool" ParameterName="ShowOverlay"/>
                <controls:SliderParameter Label="Overlay Opacity"
                    Value="{Binding OverlayOpacity}" Minimum="0.0" Maximum="1.0"
                    TickFrequency="0.05" ValueFormat="F2"
                    ToolType="ColorExtractTool" ParameterName="OverlayOpacity"/>
            </StackPanel>
        </Expander>

        <!-- Search Region (Execute 시 검색 범위) -->
        <Expander IsExpanded="False" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Search Region" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Use Search Region"
                    IsChecked="{Binding UseSearchRegion}"
                    ToolType="ColorExtractTool" ParameterName="UseSearchRegion"/>
                <controls:TextBoxParameter Label="X"
                    Value="{Binding SearchRegionX}"
                    ToolType="ColorExtractTool" ParameterName="SearchRegionX"/>
                <controls:TextBoxParameter Label="Y"
                    Value="{Binding SearchRegionY}"
                    ToolType="ColorExtractTool" ParameterName="SearchRegionY"/>
                <controls:TextBoxParameter Label="Width"
                    Value="{Binding SearchRegionWidth}"
                    ToolType="ColorExtractTool" ParameterName="SearchRegionWidth"/>
                <controls:TextBoxParameter Label="Height"
                    Value="{Binding SearchRegionHeight}"
                    ToolType="ColorExtractTool" ParameterName="SearchRegionHeight"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <Button Content="Draw Search Region" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="8,4" Margin="0,0,5,0"
                            Command="{Binding DrawSearchRegionCommand}"/>
                    <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,4"
                            Command="{Binding ClearSearchRegionCommand}"/>
                </StackPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
