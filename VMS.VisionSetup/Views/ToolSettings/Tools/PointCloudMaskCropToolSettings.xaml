<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.PointCloudMaskCropToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
             xmlns:conv="clr-namespace:VMS.VisionSetup.Converters"
             xmlns:pc="clr-namespace:VMS.VisionSetup.VisionTools.PointCloud">
    <StackPanel>
        <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,4"
                   Text="2D 이미지에서 정한 영역으로 3D 점군을 잘라냅니다. 이미지에서 밝은(0이 아닌) 픽셀 자리에 해당하는 점만 남고, 남은 점군은 뒤에 오는 도구(Cluster 등)와 3D 뷰어에서 사용됩니다."/>
        <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="사용법 두 가지 — ① 자동: 마스크를 만드는 도구(YOLOv8-seg의 Output Mask, Threshold, Height Slicer 등)를 Image로 연결. ② 수동: 2D 이미지를 그대로 연결하고, 이 도구를 선택한 뒤 이미지 뷰어에서 ROI(사각형·원·다각형)를 그리면 그 영역의 점군만 남습니다."/>

        <!-- Mask Interpretation -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Mask Interpretation" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:SliderParameter Label="Min Mask Value"
                    Value="{Binding MinMaskValue}" Minimum="1" Maximum="255"
                    TickFrequency="1" ValueFormat="F0"
                    ToolType="PointCloudMaskCropTool" ParameterName="MinMaskValue"/>
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="'물체'로 인정할 최소 밝기입니다. 흑백(0/255) 마스크라면 1 그대로 두면 됩니다. 회색조 마스크에서 확실한 부분만 쓰고 싶을 때만 값을 올리세요."/>
                <controls:SliderParameter Label="Dilate (px)"
                    Value="{Binding DilatePixels}" Minimum="0" Maximum="50"
                    TickFrequency="1" ValueFormat="F0"
                    ToolType="PointCloudMaskCropTool" ParameterName="DilatePixels"/>
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="영역을 바깥으로 몇 픽셀 넓힐지입니다. 잘라낸 점군이 물체 가장자리를 조금 못 담을 때 2~5 정도 올려 보세요. 0 = 넓히지 않음."/>
                <controls:CheckBoxParameter Label="Invert Mask"
                    IsChecked="{Binding InvertMask}"
                    ToolType="PointCloudMaskCropTool" ParameterName="InvertMask"/>
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="체크하면 반대로 영역 바깥의 점만 남깁니다 — 물체를 지우고 배경만 보고 싶을 때."/>
            </StackPanel>
        </Expander>

        <!-- Combine Mode -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Combine Mode" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:EnumComboBoxParameter Label="Combine Mode"
                    ItemsSource="{conv:EnumValues {x:Type pc:PointCloudMaskCropTool+CropCombineMode}}"
                    SelectedValue="{Binding CombineMode}"
                    ToolType="PointCloudMaskCropTool" ParameterName="CombineMode"/>
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Replace(기본): 현재 남아 있는 점군에서 잘라 교체 — 크롭 하나만 쓰거나 직렬로 점점 좁힐 때. Union: Run 시작 시점의 점군에서 잘라 기존 결과에 합침 — Mask Crop 여러 개를 나란히(각기 다른 ROI로) 쓸 때 두 번째 크롭부터 Union을 선택하세요. 전부 Replace면 첫 크롭이 점군을 이미 좁혀서 두 번째 크롭 영역에 점이 없어 실패합니다."/>
            </StackPanel>
        </Expander>

        <!-- Point Filtering -->
        <Expander IsExpanded="True" Style="{StaticResource SettingExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="Point Filtering" Style="{StaticResource ExpanderHeaderStyle}"/>
            </Expander.Header>
            <StackPanel Margin="5,0,0,0">
                <controls:CheckBoxParameter Label="Skip Invalid Z (=0)"
                    IsChecked="{Binding SkipInvalidZ}"
                    ToolType="PointCloudMaskCropTool" ParameterName="SkipInvalidZ"/>
                <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="3D 카메라가 측정에 실패한 자리는 높이가 0으로 저장됩니다 — 켜두면 이런 가짜 점이 결과에 섞이지 않습니다. 특별한 이유가 없으면 켠 상태를 유지하세요."/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
