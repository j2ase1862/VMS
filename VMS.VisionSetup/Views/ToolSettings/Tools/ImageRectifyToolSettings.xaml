<UserControl x:Class="VMS.VisionSetup.Views.ToolSettings.Tools.ImageRectifyToolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VMS.VisionSetup.Controls">
    <StackPanel>
        <controls:CheckBoxParameter Label="Undistort (lens distortion)"
            IsChecked="{Binding Undistort}"
            ToolType="ImageRectifyTool" ParameterName="Undistort"/>
        <controls:CheckBoxParameter Label="Apply Homography (NPoint planar)"
            IsChecked="{Binding ApplyHomography}"
            ToolType="ImageRectifyTool" ParameterName="ApplyHomography"/>
        <TextBlock Text="Uses Recipe.Calibration / VisionService.CurrentCalibrationMetadata. If no calibration is loaded, this tool passes the image through unchanged."
                   Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
