<Window x:Class="VMS.VisionSetup.Views.ToolSettings.TrainMaskEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common"
        Title="학습 마스크 편집"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgWindow}"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="학습 마스크 편집 (don't-care 영역)"
                                  ShowMinMaxButtons="False"/>

            <!-- 도구 바 -->
            <Grid Grid.Row="1" Margin="18,12,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="BrushModeBtn" Grid.Column="0" Content="브러시"
                             Style="{StaticResource WindowDarkRadioButton}"
                             IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RectModeBtn" Grid.Column="1" Content="사각형"
                             Style="{StaticResource WindowDarkRadioButton}"
                             Margin="0,0,14,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="EraserModeBtn" Grid.Column="2" Content="지우개"
                             Style="{StaticResource WindowDarkRadioButton}"
                             Margin="0,0,18,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="크기" VerticalAlignment="Center" Margin="0,0,6,0"
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                <Slider x:Name="BrushSizeSlider" Grid.Column="4" Width="120" Minimum="4" Maximum="80"
                        Value="18" VerticalAlignment="Center"
                        ValueChanged="BrushSizeSlider_ValueChanged"/>

                <Button Grid.Column="6" Content="모두 지우기" Style="{StaticResource ModernGhostButton}"
                        Padding="10,4" Click="OnClearAllClick"/>
            </Grid>

            <!-- 편집 캔버스: 템플릿 + 마스크 오버레이(반투명 빨강) + 사각형 러버밴드 -->
            <Border Grid.Row="2" Margin="18,0,18,8" Padding="8"
                    Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1" CornerRadius="6">
                <Grid x:Name="EditArea" Cursor="Cross"
                      MouseLeftButtonDown="EditArea_MouseDown"
                      MouseMove="EditArea_MouseMove"
                      MouseLeftButtonUp="EditArea_MouseUp"
                      Background="Transparent">
                    <Image x:Name="TemplateView" Stretch="Fill"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Image x:Name="OverlayView" Stretch="Fill"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           IsHitTestVisible="False"/>
                    <Canvas x:Name="RubberBandCanvas" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 하단: 안내 + 저장/취소 -->
            <Grid Grid.Row="3" Margin="18,0,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                           Text="빨간 영역이 학습에서 제외됩니다 (그림자·가변 각인·반사 등). 저장 시 즉시 재학습되어 특징 이미지로 확인할 수 있습니다."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                    <Button Content="저장" Style="{StaticResource ModernPrimaryButton}"
                            MinWidth="96" Margin="0,0,8,0" Click="OnSaveClick"/>
                    <Button Content="취소" Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="80" Click="OnCancelClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
