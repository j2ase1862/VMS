<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RootNamespace>BODA_VISION_AI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>icon\VisionSetup.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon\VisionSetup.ico" />
    <Resource Include="icon\RecipeManager.ico" />
    <!-- 예제 템플릿 다이어그램 (RecipeTemplateCatalog 기준 생성, 재생성은
         dotnet test 의 TemplateDiagramGenerator 필터 사용) -->
    <Resource Include="Resources\Templates\*.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VMS.VisionSetup.Tests" />
  </ItemGroup>

  <!-- Python 학습 스크립트 — 빌드 시 bin/scripts/로 복사 -->
  <ItemGroup>
    <Content Include="scripts\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Publish 시 제외 — VMS.DeepLearning 와 같은 경로 충돌 + 운영자 PC 에 불필요 -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.21.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.11.0.20250507" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMS.Camera\VMS.Camera.csproj" />
    <ProjectReference Include="..\VMS.Core\VMS.Core.csproj" />
    <ProjectReference Include="..\VMS.PLC\VMS.PLC.csproj" />
    <ProjectReference Include="..\VMS.DeepLearning\VMS.DeepLearning.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\NativeVision\NativeVision.dll" Condition="Exists('..\NativeVision\NativeVision.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>NativeVision.dll</Link>
    </None>
  </ItemGroup>

  <!-- After build, copy output to VMS output directory.
       VMS launcher 의 TargetFramework 는 net8.0-windows7.0 이므로 7.0 명시 필수 —
       이전 오타("net8.0-windows") 로 잘못된 폴더에 복사돼 VMS.DeepLearning.dll
       등이 누락, DeepLearning 메뉴 실행시 "application to execute does not exist"
       런타임 에러 발생했음. -->
  <Target Name="CopyToVmsOutput" AfterTargets="Build">
    <PropertyGroup>
      <VmsOutputDir>..\VMS\bin\$(Configuration)\net8.0-windows7.0\</VmsOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <VisionSetupOutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(VmsOutputDir)" Condition="!Exists('$(VmsOutputDir)')" />
    <Copy SourceFiles="@(VisionSetupOutputFiles)" DestinationFolder="$(VmsOutputDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
