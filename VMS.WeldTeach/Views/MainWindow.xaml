<Window x:Class="VMS.WeldTeach.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:ctrl="clr-namespace:VMS.WeldTeach.Controls"
        xmlns:helpers="clr-namespace:VMS.WeldTeach.Helpers"
        Title="VMS WeldTeach — CAD 용접 경로 오프라인 티칭 (PoC)"
        Width="1536" Height="864"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
    <!-- 윈도우 크롬(타이틀바/닫기 버튼)은 Themes/WindowStyles.xaml 의 기본 Window 스타일이 제공 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:IndexPlusOneConverter x:Key="IndexPlusOne"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 툴바 -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface.Base}" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="STEP 열기" Style="{StaticResource ModernButton}"
                        Command="{Binding OpenStepCommand}" Margin="0,0,8,0"/>
                <Button Content="샘플 시편 생성" Style="{StaticResource Button.Subtle}"
                        Command="{Binding GenerateSampleCommand}" Margin="0,0,8,0"/>
                <Button Content="경로 내보내기 (JSON)" Style="{StaticResource Button.Subtle}"
                        Command="{Binding ExportPathCommand}" Margin="0,0,24,0"/>

                <TextBlock Text="피킹 임계값(mm)" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ctrl:HelpIcon VerticalAlignment="Center" Margin="0,0,6,0"
                               HelpTitle="피킹 임계값 (mm)"
                               HelpText="마우스로 모서리를 잡는 허용 거리입니다. 클릭 위치와 모서리 사이 거리가 이 값(모델 단위 mm) 이내면 그 모서리가 선택됩니다.&#x0a;&#x0a;• 모서리가 잘 안 잡히면 값을 키우세요.&#x0a;• 가까운 다른 모서리가 자꾸 잡히면 값을 줄이세요."/>
                <TextBox Text="{Binding PickThreshold, UpdateSourceTrigger=PropertyChanged}" Width="56"
                         VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Text="체이닝 각도 허용(°)" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ctrl:HelpIcon VerticalAlignment="Center" Margin="0,0,6,0"
                               HelpTitle="체이닝 각도 허용 (°)"
                               HelpText="클릭한 모서리에 이어진 모서리를 자동으로 따라가 하나의 용접 경로로 묶을 때(체이닝), 두 모서리가 만나는 지점의 접선 방향 차이가 이 각도 이내면 같은 경로로 잇습니다.&#x0a;&#x0a;• 값을 키우면 꺾인 모서리까지 이어집니다.&#x0a;• 값을 줄이면 매끄럽게 이어지는 구간만 묶입니다. (기본 15° = C1 연속)"/>
                <TextBox Text="{Binding ChainAngleToleranceDeg, UpdateSourceTrigger=PropertyChanged}" Width="56"
                         VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Text="기본 포즈 간격(mm)" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ctrl:HelpIcon VerticalAlignment="Center" Margin="0,0,6,0"
                               HelpTitle="기본 포즈 간격 (mm)"
                               HelpText="용접 심을 따라 로봇에게 넘겨줄 목표점(포즈)들 사이의 거리 기본값입니다. 새로 추가하는 경로에 적용되며, [전체 적용]을 누르면 이미 선택한 모든 경로에도 반영됩니다.&#x0a;&#x0a;경로마다 다른 간격이 필요하면(직선은 넓게, 곡선은 좁게) 우측 경로 목록에서 경로를 선택한 뒤 '선택 경로 간격'에서 개별 조정하세요.&#x0a;&#x0a;선택한 경로의 포즈 위치는 화면에 노란 점으로 표시됩니다."/>
                <TextBox Text="{Binding PoseSpacingMm, UpdateSourceTrigger=PropertyChanged}" Width="56"
                         VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <CheckBox Content="곡률 적응" IsChecked="{Binding AdaptiveSampling}"
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ctrl:HelpIcon VerticalAlignment="Center" Margin="0,0,8,0"
                               HelpTitle="곡률 적응 간격"
                               HelpText="켜면 포즈 간격이 구간의 곡률에 따라 자동으로 조절됩니다 — 직선 구간은 설정한 간격(최대치)을 그대로 쓰고, 곡선 구간은 경로가 실제 곡선에서 벗어나는 오차(현 오차)가 0.05mm 를 넘지 않도록 자동으로 촘촘해집니다.&#x0a;&#x0a;직선과 곡선이 섞인 경로에서 포인트 수를 최소로 유지하면서 곡선 정밀도를 확보할 때 사용하세요. 새 경로에 적용되며, [전체 적용]으로 기존 경로에도 반영됩니다."/>
                <Button Content="전체 적용" Style="{StaticResource Button.Subtle}"
                        Padding="10,6" FontSize="11"
                        ToolTip="기본 포즈 간격·곡률 적응 설정을 모든 경로에 일괄 적용합니다"
                        Command="{Binding ApplySpacingToAllCommand}"/>

                <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="120" Height="6" Margin="20,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource Brush.Primary}"
                             Background="{StaticResource Brush.Surface.Overlay}"
                             BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 3D 뷰포트: 마우스 훅업은 코드비하인드(뷰 전용 상호작용) -->
            <Border Background="{StaticResource Brush.Surface.Base}"
                    CornerRadius="{StaticResource Radius.Md}">
                <helix:HelixViewport3D x:Name="Viewport"
                                       Background="Transparent"
                                       ShowCoordinateSystem="True"
                                       ZoomExtentsWhenLoaded="True"
                                       MouseMove="Viewport_MouseMove"
                                       MouseLeftButtonDown="Viewport_MouseLeftButtonDown">
                    <helix:DefaultLights/>
                </helix:HelixViewport3D>
            </Border>

            <!-- 우측 패널: 경로 목록(용접 순서) + 포즈 -->
            <Border Grid.Column="1" Margin="12,0,0,0"
                    Background="{StaticResource Brush.Surface.Raised}"
                    CornerRadius="{StaticResource Radius.Md}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock Text="용접 경로" Style="{StaticResource Text.SectionHeader}" Margin="0,0,6,0"/>
                            <ctrl:HelpIcon VerticalAlignment="Top" Margin="0,3,0,0"
                                           HelpTitle="용접 경로 목록"
                                           HelpText="모서리를 클릭할 때마다 경로가 목록에 추가되고, 목록의 순서가 곧 용접 순서입니다.&#x0a;&#x0a;• 이미 선택한 경로의 모서리를 다시 클릭하면 그 경로가 해제됩니다.&#x0a;• 목록에서 경로를 클릭하면 그 경로의 포즈가 아래 표에 표시됩니다.&#x0a;• 내보내기(JSON)는 목록의 모든 경로를 순서대로 저장합니다."/>
                            <Border/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="모서리 클릭 → 경로 추가 (숫자 = 용접 순서). 같은 경로를 다시 클릭하면 해제됩니다."/>
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Contours}"
                             SelectedItem="{Binding SelectedContour}"
                             MaxHeight="200" Margin="0,0,0,8"
                             Background="Transparent" BorderThickness="0"
                             AlternationCount="1000"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bg" Background="{StaticResource Brush.Surface.Base}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.Surface.Overlay}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.Primary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <!-- 순번 뱃지 (목록 순서 = 용접 순서) -->
                                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11"
                                            Background="{StaticResource Brush.Accent}" Margin="0,0,8,0">
                                        <TextBlock Foreground="White" FontWeight="Bold" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding (ItemsControl.AlternationIndex),
                                                          RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                          Converter={StaticResource IndexPlusOne}}"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Width="20" Height="20"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="이 경로 제거"
                                            Command="{Binding DataContext.RemoveContourCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="✕" Foreground="{StaticResource Brush.Text.Tertiary}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding PathId}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="선택 경로 간격(mm)"
                                       Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ctrl:HelpIcon DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0"
                                           HelpTitle="선택 경로 간격 (mm)"
                                           HelpText="목록에서 선택한 경로에만 적용되는 개별 포즈 간격입니다. 값을 바꾸면 그 경로의 포즈만 즉시 다시 계산됩니다.&#x0a;&#x0a;• 직선 위주 경로 → 넓게 (예: 5~10mm)&#x0a;• 곡선(원형 심 등) 경로 → 좁게 (예: 1~2mm)&#x0a;&#x0a;각 경로의 현재 간격은 목록 요약의 @값으로 표시됩니다."/>
                            <TextBox DockPanel.Dock="Left" Width="56"
                                     Text="{Binding SelectedPathSpacingMm, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox DockPanel.Dock="Left" Content="곡률 적응" FontSize="11"
                                      IsChecked="{Binding SelectedPathAdaptive}"
                                      VerticalAlignment="Center"
                                      ToolTip="선택한 경로만 곡률 적응 간격을 사용합니다"/>
                        </DockPanel>
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="전체 지우기" Style="{StaticResource Button.Subtle}"
                                    Padding="10,6" FontSize="11"
                                    Command="{Binding ClearContoursCommand}"/>
                            <CheckBox DockPanel.Dock="Left" Content="전체 보기" FontSize="11"
                                      IsChecked="{Binding ShowAllPaths}"
                                      VerticalAlignment="Center" Margin="10,0,0,0"
                                      ToolTip="모든 경로의 포즈 점과 토치 방향을 동시에 표시합니다"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Caption}"
                                       Text="{Binding Contours.Count, StringFormat=경로 {0}개}"/>
                        </DockPanel>
                    </StackPanel>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Poses}" IsReadOnly="True">
                        <DataGrid.Resources>
                            <!-- 수치 열 — 우측 정렬로 자릿수 비교가 쉬워진다 -->
                            <Style x:Key="NumCell" TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <!-- 좁은 6열 패널에 맞춰 셀/헤더 패딩 축소 (테마 기본 12,8 → 6,6) -->
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="6,6"/>
                            </Style>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Padding" Value="6,10"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F1}" Width="*" ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F1}" Width="*" ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=F1}" Width="*" ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="R°" Binding="{Binding RollDeg, StringFormat=F1}" Width="*" ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="P°" Binding="{Binding PitchDeg, StringFormat=F1}" Width="*" ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Y°" Binding="{Binding YawDeg, StringFormat=F1}" Width="*" ElementStyle="{StaticResource NumCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 상태 바 -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface.Raised}"
                CornerRadius="{StaticResource Radius.Sm}" Padding="12,8" Margin="12">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Text.Secondary}"/>
        </Border>
    </Grid>
</Window>
