<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VMS.AppSetup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMS.Camera\VMS.Camera.csproj" />
    <ProjectReference Include="..\VMS.PLC\VMS.PLC.csproj" />
  </ItemGroup>

  <!-- VMS.VisionSetup 의 다크 디자인 시스템(Indigo/Slate)을 VMS.AppSetup 에서
       그대로 사용하기 위해 WindowStyles.xaml 을 Linked Page 로 컴파일.
       - ProjectReference 대신 파일 링크 사용: VisionSetup 의 무거운 어셈블리
         (OpenCvSharp / HelixToolkit 등) 의존성 회피
       - 단일 소스 원천 유지: VisionSetup 에서 수정하면 다음 빌드시 자동 반영
       - 런타임 pack URI: pack://application:,,,/VMS.AppSetup;component/Styles/WindowStyles.xaml -->
  <ItemGroup>
    <Page Include="..\VMS.VisionSetup\Styles\WindowStyles.xaml" Link="Styles\WindowStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- VisionSetup 의 HelpIcon(? 아이콘 → hover/클릭 팝업) 컨트롤을 동일한 Linked Page
       방식으로 재사용 — 4개 앱 도움말 UX 통일. HelpContent.cs 는 HelpIcon.xaml.cs 의
       컴파일 의존성(도구 도움말 사전) — AppSetup 에서는 CustomTitle/CustomDescription 경로만 사용. -->
  <ItemGroup>
    <Page Include="..\VMS.VisionSetup\Controls\HelpIcon.xaml" Link="Controls\HelpIcon.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\VMS.VisionSetup\Controls\HelpIcon.xaml.cs" Link="Controls\HelpIcon.xaml.cs" />
    <Compile Include="..\VMS.VisionSetup\Models\HelpContent.cs" Link="Models\HelpContent.cs" />
  </ItemGroup>

  <!-- 공용 다크 메시지 다이얼로그 (WPF 기본 MessageBox 대체) — HelpIcon 과 동일한
       Linked Page 방식. WindowStyles.xaml 토큰만 사용하므로 AppSetup 에서 그대로 렌더링. -->
  <ItemGroup>
    <Page Include="..\VMS.VisionSetup\Views\Common\MessageDialog.xaml" Link="Views\Common\MessageDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\VMS.VisionSetup\Views\Common\MessageDialog.xaml.cs" Link="Views\Common\MessageDialog.xaml.cs" />
  </ItemGroup>

  <!-- VMS.Core 의 라이선스 검증 코드를 Linked Compile 로 재사용 (spec §8) —
       VMS.Core ProjectReference 는 OpenCvSharp/HelixToolkit 을 끌고 오므로 회피.
       tools/licgen 과 동일한 패턴: canonical JSON 정규화가 제품/도구 간 단일 구현이
       되도록 파일 자체를 공유한다. LicenseBootCheck 는 AuditLogger 의존이라 제외. -->
  <ItemGroup>
    <Compile Include="..\VMS.Core\Security\Licensing\LicensePayload.cs" Link="Licensing\LicensePayload.cs" />
    <Compile Include="..\VMS.Core\Security\Licensing\LicenseCanonicalJson.cs" Link="Licensing\LicenseCanonicalJson.cs" />
    <Compile Include="..\VMS.Core\Security\Licensing\LicenseCrypto.cs" Link="Licensing\LicenseCrypto.cs" />
    <Compile Include="..\VMS.Core\Security\Licensing\LicenseKeyring.cs" Link="Licensing\LicenseKeyring.cs" />
    <Compile Include="..\VMS.Core\Security\Licensing\LicenseValidator.cs" Link="Licensing\LicenseValidator.cs" />
    <Compile Include="..\VMS.Core\Security\Licensing\LicenseEvaluation.cs" Link="Licensing\LicenseEvaluation.cs" />
    <Compile Include="..\VMS.Core\Security\Licensing\MachineFingerprint.cs" Link="Licensing\MachineFingerprint.cs" />
    <Compile Include="..\VMS.Core\Security\Licensing\LicenseFileStore.cs" Link="Licensing\LicenseFileStore.cs" />
  </ItemGroup>

  <!-- After build, copy output to VMS output directory -->
  <Target Name="CopyToVmsOutput" AfterTargets="Build">
    <PropertyGroup>
      <VmsOutputDir>..\VMS\bin\$(Configuration)\net8.0-windows7.0\</VmsOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <AppSetupOutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(VmsOutputDir)" Condition="!Exists('$(VmsOutputDir)')" />
    <Copy SourceFiles="@(AppSetupOutputFiles)" DestinationFolder="$(VmsOutputDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
