<UserControl x:Class="VMS.AppSetup.Controls.CameraItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="70" d:DesignWidth="400">

    <Border Background="{StaticResource BrushBgCard}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
            CornerRadius="6" Padding="12,10" Margin="0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Enable Checkbox -->
            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                      Style="{StaticResource WindowDarkCheckBox}"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"/>

            <!-- Camera Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text=" - " Foreground="{StaticResource BrushTextSecondary}" FontSize="13"/>
                    <TextBlock Text="{Binding Manufacturer}"
                               Foreground="#0078D4" FontSize="13"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="ID: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding Id}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"
                               MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="  |  IP: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding IpAddress}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Indicator: 활성 green / 비활성 muted -->
            <Border Grid.Column="2" Width="12" Height="12" CornerRadius="6"
                    VerticalAlignment="Center" Margin="10,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Background" Value="{StaticResource BrushBorderStrong}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Border>
</UserControl>
