<Window x:Class="VMS.AppSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:VMS.AppSetup.Converters"
        mc:Ignorable="d"
        Title="BODA Vision System Setup"
        Width="960" Height="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="80" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:PageToVisibilityConverter x:Key="PageConverter"/>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Button / TextBox / ComboBox 는 WindowStyles 의 Modern* / WindowDark* 키
             직접 사용 — 로컬 정의 제거로 단일 디자인 시스템 유지. -->

        <!-- Label Style — WindowFieldLabel(FontSize 11) 보다 큰 wizard 용 13px 라벨. -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header — chromeless 윈도우의 드래그 영역 + 페이지 타이틀/Step + 윈도우 컨트롤 -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgTitleBar}" Padding="30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding PageTitle}"
                               Foreground="#FFD700" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PageDescription}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap" MaxWidth="550" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Page Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,16,0">
                    <TextBlock Text="Step " Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                    <TextBlock Text="{Binding CurrentPage}" Foreground="#FFD700" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text=" of 6" Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                </StackPanel>

                <!-- 윈도우 컨트롤 (최소화 / 닫기 — wizard 는 NoResize 라 최대화 없음).
                     ResizeMode=NoResize 고정 사이즈(960x820) 라 최대화 의미 없음. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource ModernGhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            ToolTip="최소화"
                            Width="32" Height="28" Padding="0">
                        <TextBlock Text="&#xE921;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                    </Button>

                    <Button Style="{StaticResource ModernGhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            ToolTip="닫기"
                            Width="32" Height="28" Padding="0" Margin="4,0,0,0">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushDanger}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page Content -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgWindow}" Padding="30">
            <Grid>
                <!-- Page 1: Welcome -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=1}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="BODA" FontSize="72" Foreground="#0078D4"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Vision System" FontSize="28" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                        <TextBlock Text="Machine Vision Configuration Wizard" FontSize="14"
                                   Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Page 2: Application Settings -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=2}">
                    <StackPanel MaxWidth="500" VerticalAlignment="Top">
                        <TextBlock Text="Application Name" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,20"/>

                        <TextBlock Text="System IP Address" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding SystemIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}"/>

                        <TextBlock Text="This is the IP address of the machine vision system PC."
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,5,0,0"/>

                        <!-- Web Server Integration -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,25,0,0">
                            <StackPanel>
                                <TextBlock Text="Web Server Integration" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFD700" Margin="0,0,0,12"/>

                                <TextBlock Text="Client Index" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ClientIndex, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,5"/>
                                <TextBlock Text="BODA.VMS.Web에서 이 클라이언트를 식별하는 고유 번호입니다."
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,15"/>

                                <TextBlock Text="Web Server URL" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding WebServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,5"/>
                                <TextBlock Text="BODA.VMS.Web 서버 주소 (Heartbeat, 파라미터 동기화)"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,15"/>

                                <TextBlock Text="Vision Server URL" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding VisionServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,5"/>
                                <TextBlock Text="VisionServer API 주소 (클라이언트 자동 등록)"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,15"/>

                                <TextBlock Text="Web Client API Key" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ClientApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,5"/>
                                <TextBlock Text="X-API-Key 헤더 비밀 (Web 서버 ClientApiKey:Value 와 동일). 비워두면 헤더 미송신 (서버 호환 모드에서만 통과)."
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Page 3: Camera Configuration -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=3}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Mode Selection -->
                    <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Live Mode (Scan Network)" GroupName="CameraMode"
                                         IsChecked="{Binding CameraMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Live}"
                                         Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="0,0,40,0"
                                         VerticalContentAlignment="Center"/>
                            <RadioButton Content="Virtual Mode (Manual Setup)" GroupName="CameraMode"
                                         IsChecked="{Binding CameraMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Virtual}"
                                         Style="{StaticResource WindowDarkRadioButton}" FontSize="13"
                                         VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Controls -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Add Camera" Command="{Binding AddCameraCommand}"
                                Style="{StaticResource ModernPrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Scan Network" Command="{Binding ScanForCamerasCommand}"
                                Style="{StaticResource ModernSecondaryButton}"/>
                    </StackPanel>

                    <!-- Camera List -->
                    <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cameras}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                                CornerRadius="6" Padding="15,12" Margin="0,4">
                                            <StackPanel>
                                                <!-- Row 1: Basic Info -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Enable Checkbox -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Style="{StaticResource WindowDarkCheckBox}"
                                                              VerticalAlignment="Center" Margin="0,0,15,0"
                                                              ToolTip="Enable/Disable Camera"/>

                                                    <!-- Camera Info -->
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:"
                                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,6"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="IP:"
                                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource WindowDarkTextBox}"/>
                                                    </Grid>

                                                    <!-- Camera Type -->
                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding DataContext.CameraTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding CameraType}"
                                                              Width="110" Margin="10,0"
                                                              VerticalAlignment="Center"
                                                              Style="{StaticResource WindowDarkComboBox}"/>

                                                    <!-- Manufacturer -->
                                                    <ComboBox Grid.Column="3"
                                                              ItemsSource="{Binding DataContext.CameraManufacturers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Manufacturer}"
                                                              Width="110" Margin="0,0,10,0"
                                                              VerticalAlignment="Center"
                                                              Style="{StaticResource WindowDarkComboBox}"/>

                                                    <!-- Remove Button -->
                                                    <Button Grid.Column="4" Content="✕"
                                                            Command="{Binding DataContext.RemoveCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ModernDangerButton}"
                                                            Width="32" Height="32" FontSize="14" Padding="0"
                                                            ToolTip="Remove Camera"/>
                                                </Grid>

                                                <!-- Row 2: Area Scan Parameters -->
                                                <Border Background="{StaticResource BrushBgCard}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding IsAreaScan, Converter={StaticResource BoolToVisConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Exposure (μs)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding Exposure, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Gain" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Row 3: Line Scan Parameters -->
                                                <Border Background="{StaticResource BrushBgCard}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding IsLineScan, Converter={StaticResource BoolToVisConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Trigger" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.TriggerSources, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding TriggerSource}"
                                                                      Style="{StaticResource WindowDarkComboBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Line Rate (Hz)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding LineRate, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="Scan Length" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding ScanLength, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="6"
                                                                    Visibility="{Binding ShowEncoderResolution, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="Encoder Res (P/mm)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding EncoderResolution, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Row 4: 3D Camera Parameters -->
                                                <Border Background="{StaticResource BrushBgCard}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding Is3DCamera, Converter={StaticResource BoolToVisConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Capture Mode" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.CaptureModes3D, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding CaptureMode}"
                                                                      Style="{StaticResource WindowDarkComboBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Filter Strength" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding FilterStrength, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="Z Min (mm)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding ZRangeMin, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="6">
                                                            <TextBlock Text="Z Max (mm)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding ZRangeMax, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Row 5: Frame Grabber Parameters (Matrox/Dalsa) -->
                                                <Border Background="{StaticResource BrushBgCard}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding IsFrameGrabber, Converter={StaticResource BoolToVisConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Frame Grabber (MIL)" Foreground="#FF9800" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="0.6*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="0.6*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Board Type" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                                <ComboBox Text="{Binding BoardType}"
                                                                          IsEditable="True" IsReadOnly="False"
                                                                          Style="{StaticResource WindowDarkComboBox}">
                                                                    <sys:String>SOLIOS</sys:String>
                                                                    <sys:String>RAPIXO</sys:String>
                                                                    <sys:String>RADIENT</sys:String>
                                                                    <sys:String>ORION</sys:String>
                                                                    <sys:String>MORPHIS</sys:String>
                                                                    <sys:String>GIGE</sys:String>
                                                                    <sys:String>USB3</sys:String>
                                                                    <sys:String>GENTL</sys:String>
                                                                    <sys:String>HOST</sys:String>
                                                                </ComboBox>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Board #" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                                <TextBox Text="{Binding BoardNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="Digitizer #" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                                <TextBox Text="{Binding DigitizerNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <TextBlock Text="DCF File (Camera Link)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Grid.Column="0"
                                                                         Text="{Binding DcfFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                                                <Button Grid.Column="1" Content="..." Margin="4,0,0,0"
                                                                        Width="32" FontWeight="Bold"
                                                                        Click="BrowseDcfFile_Click"
                                                                        Style="{StaticResource ModernGhostButton}"
                                                                        ToolTip="Browse DCF file"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Page 5: Robot Configuration -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=5}">
                    <StackPanel MaxWidth="600" VerticalAlignment="Top">
                        <!-- Robot Enable Toggle -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox Content="Enable Robot Integration" IsChecked="{Binding IsRobotEnabled}"
                                          Style="{StaticResource WindowDarkCheckBox}"
                                          FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="멀티뷰 3D 스캔을 위해 로봇을 사용하려면 활성화하세요."
                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="20,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Robot Settings (visible when enabled) -->
                        <StackPanel Visibility="{Binding IsRobotEnabled, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Robot Vendor Selection -->
                            <TextBlock Text="Robot Vendor" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                <StackPanel>
                                    <RadioButton Content="Universal Robots (UR)" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=UR}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Doosan Robotics" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Doosan}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Jaka Robotics" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Jaka}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="ABB" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ABB}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Fanuc" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Fanuc}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                </StackPanel>
                            </Border>

                            <!-- Connection Settings -->
                            <TextBlock Text="Connection Settings" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Robot IP Address" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding RobotIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource WindowDarkTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding RobotPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource WindowDarkTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Communication Protocol -->
                            <TextBlock Text="Communication Protocol" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Content="Vendor Native" GroupName="RobotProtocol"
                                                     IsChecked="{Binding SelectedRobotProtocolMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VendorNative}"
                                                     Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="0,0,20,0"/>
                                        <RadioButton Content="Modbus-TCP" GroupName="RobotProtocol"
                                                     IsChecked="{Binding SelectedRobotProtocolMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ModbusTcp}"
                                                     Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="0,0,20,0"
                                                     Visibility="{Binding ShowRobotModbusOption, Converter={StaticResource BoolToVisConverter}}"/>
                                        <RadioButton Content="Custom Socket (CSV)" GroupName="RobotProtocol"
                                                     IsChecked="{Binding SelectedRobotProtocolMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CustomSocket}"
                                                     Style="{StaticResource WindowDarkRadioButton}" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RobotProtocolDescription}"
                                               Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap"/>

                                    <!-- Modbus-TCP Settings (visible when Modbus mode selected) -->
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsRobotModbusMode, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Unit ID" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding RobotModbusUnitId, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Pose Start Register" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding RobotModbusPoseRegister, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Holding Register 주소입니다. 기본값 270은 Doosan 표준 TCP 포즈 레지스터입니다."
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Euler Convention (auto-selected by vendor, but editable) -->
                            <TextBlock Text="Euler Convention" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding EulerConventions}"
                                              SelectedItem="{Binding SelectedEulerConvention}"
                                              Style="{StaticResource WindowDarkComboBox}"/>
                                    <TextBlock Text="로봇 제조사 선택 시 자동으로 설정됩니다. 필요 시 수동 변경 가능합니다."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page 4: PLC Configuration -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=4}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Left Column: PLC Vendor + Performance & Stability -->
                        <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0">

                            <!-- PLC Vendor Selection -->
                            <TextBlock Text="PLC Vendor" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                <StackPanel>
                                    <RadioButton Content="Mitsubishi" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Mitsubishi}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Siemens" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Siemens}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="LS Electric" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=LS}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Omron" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Omron}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Modbus TCP" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Modbus}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="None (No PLC)" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=None}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                </StackPanel>
                            </Border>

                            <!-- Performance & Stability -->
                            <TextBlock Text="Performance &amp; Stability" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Polling Interval (ms)" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding PollingIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>

                                    <CheckBox Content="Use Heartbeat" IsChecked="{Binding UseHeartbeat}"
                                              Style="{StaticResource WindowDarkCheckBox}"
                                              FontSize="13" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding HeartbeatAddress, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"
                                             IsEnabled="{Binding UseHeartbeat}">
                                        <TextBox.Tag>
                                            <TextBlock Text="Heartbeat Address (e.g. D100)" Foreground="{StaticResource BrushTextMuted}"/>
                                        </TextBox.Tag>
                                    </TextBox>

                                    <CheckBox Content="Auto Reconnect" IsChecked="{Binding AutoReconnect}"
                                              Style="{StaticResource WindowDarkCheckBox}"
                                              FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <!-- Data Synchronization -->
                            <TextBlock Text="Data Synchronization" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Write Mode" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding WriteModes}"
                                              SelectedItem="{Binding WriteMode}"
                                              Style="{StaticResource WindowDarkComboBox}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Endian Mode" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding EndianModes}"
                                              SelectedItem="{Binding EndianMode}"
                                              Style="{StaticResource WindowDarkComboBox}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Communication Settings -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,0">

                            <!-- Communication Type -->
                            <TextBlock Text="Communication Type" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding CommunicationTypes}"
                                      SelectedItem="{Binding SelectedCommunicationType}"
                                      Style="{StaticResource WindowDarkComboBox}" Margin="0,0,0,15"/>

                            <!-- Modbus Unit ID (visible when Modbus selected) -->
                            <StackPanel Visibility="{Binding IsModbusVendor, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Modbus Unit ID (1-255)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ModbusUnitId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,15"/>
                            </StackPanel>

                            <!-- Ethernet Settings (visible when NOT Serial) -->
                            <StackPanel Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="PLC IP Address" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding PlcIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,15"/>

                                <TextBlock Text="PLC Port" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding PlcPort, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,15"/>
                            </StackPanel>

                            <!-- Serial Settings (visible when Serial selected) -->
                            <StackPanel Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Serial Port" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Port Name" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding SerialPortName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Text="Baud Rate" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding BaudRateOptions}"
                                          SelectedItem="{Binding BaudRate}"
                                          Style="{StaticResource WindowDarkComboBox}" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Data Bits" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding DataBitsOptions}"
                                                  SelectedItem="{Binding DataBits}"
                                                  Style="{StaticResource WindowDarkComboBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Parity" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding SerialParities}"
                                                  SelectedItem="{Binding Parity}"
                                                  Style="{StaticResource WindowDarkComboBox}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Stop Bits" Style="{StaticResource LabelStyle}" Margin="0,10,0,6"/>
                                <ComboBox ItemsSource="{Binding SerialStopBitsValues}"
                                          SelectedItem="{Binding StopBits}"
                                          Style="{StaticResource WindowDarkComboBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Page 6: IO Board Configuration (Phase 2b) -->
                <!-- PLC 와 동시 사용 가능한 디지털 IO 보드 (ADLink PCI-743x / Advantech PCI-17xx) CRUD. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=6}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: 보드 리스트 + Add/Remove -->
                        <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="등록된 IO 보드"
                                           Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>

                                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="+ Add"
                                            Command="{Binding AddIoBoardCommand}"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="− Remove"
                                            Command="{Binding RemoveIoBoardCommand}"
                                            Style="{StaticResource ModernDangerButton}"
                                            Margin="4,0,0,0"
                                            IsEnabled="{Binding SelectedIoBoard, Converter={StaticResource NullToBoolConverter}}"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding IoBoardItems}"
                                         SelectedItem="{Binding SelectedIoBoard, Mode=TwoWay}"
                                         Style="{StaticResource WindowDarkListBox}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding DeviceId}" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                                                    <Run Text="{Binding Vendor, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Model, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Right: 선택된 보드 폼 -->
                        <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedIoBoard}"
                                            IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource NullToBoolConverter}}">

                                    <TextBlock Text="제조사 (Vendor)" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.IoBoardVendorValues, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Vendor, Mode=TwoWay}"
                                              Style="{StaticResource WindowDarkComboBox}" Margin="0,0,0,12"/>

                                    <TextBlock Text="모델 (예: PCI-7432, PCI-1716)" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,12"/>

                                    <TextBlock Text="디바이스 ID (시퀀스 노드에서 참조할 식별자)"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Board ID" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Text="{Binding BoardId, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <TextBlock Text="Input 채널 수" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Text="{Binding InputChannelCount, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <TextBlock Text="Output 채널 수" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Text="{Binding OutputChannelCount, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="활성화 (체크 해제 시 시스템 부팅 시 인스턴스 생성 skip)"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Style="{StaticResource WindowDarkCheckBox}"
                                              Margin="0,0,0,12"/>

                                    <TextBlock Text="설명 (선택)" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,12"/>

                                    <Border Background="#1E3A5F" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                        <TextBlock Foreground="#A0D0F0" FontSize="11" TextWrapping="Wrap">
                                            ※ 현재 Mock 구현만 활성 — 실제 ADLink DASK / Advantech DAQNavi SDK 통합은 Phase 3 작업입니다.
                                            Phase 1+2 까지는 인프라 검증용으로 보드 등록 후 시퀀스에서 채널 read/write 호출 시 in-memory 동작합니다.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer with Navigation -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource ModernSecondaryButton}"
                        HorizontalAlignment="Left" Width="100"/>

                <Button Grid.Column="1" Content="{Binding NextButtonText}"
                        Command="{Binding GoNextCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        HorizontalAlignment="Right" MinWidth="120"/>
            </Grid>
        </Border>
    </Grid>
</Window>
