<Window x:Class="VMS.AppSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:VMS.AppSetup.Converters"
        xmlns:controls="clr-namespace:VMS.VisionSetup.Controls"
        mc:Ignorable="d"
        Title="BODA Vision System Setup"
        Icon="/icon/AppSetup.ico"
        Width="960" Height="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="80" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:PageToVisibilityConverter x:Key="PageConverter"/>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Button / TextBox / ComboBox 는 WindowStyles 의 Modern* / WindowDark* 키
             직접 사용 — 로컬 정의 제거로 단일 디자인 시스템 유지. -->

        <!-- Label Style — WindowFieldLabel(FontSize 11) 보다 큰 wizard 용 13px 라벨. -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 접이식 "고급 설정" 토글 — 텍스트 링크 + 화살표(▸/▾). 다크 카드 위에서
             기본 ToggleButton 크롬(밝은 버튼면)이 튀지 않도록 크롬 없는 템플릿. -->
        <Style x:Key="WizardDisclosureToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Chevron" Text="▸" FontSize="13" Margin="0,0,6,0"
                                           Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="▾"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 어두운 테마 툴팁 — 윈도우 버튼·라디오·콤보 등 컨트롤 자체 ToolTip 용.
             입력란 라벨 도움말은 VisionSetup 과 동일한 HelpIcon(? 아이콘 → hover 팝업)
             컨트롤로 표시한다 (매뉴얼 §2.5 표와 동일 문구 유지). -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource BrushBgTitleBar}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="330" FontSize="12"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header — chromeless 윈도우의 드래그 영역 + 페이지 타이틀/Step + 윈도우 컨트롤 -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgTitleBar}" Padding="30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PageTitle}"
                                   Foreground="#FFD700" FontSize="24" FontWeight="Bold"/>
                        <!-- 다중 인스턴스 배지 — "instance" 인자로 실행됐을 때만 표시 -->
                        <Border Visibility="{Binding IsNamedInstance, Converter={StaticResource BoolToVisConverter}}"
                                Background="#1E3A5F" BorderBrush="#3B6EA5" BorderThickness="1"
                                CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InstanceName, Mode=OneWay, StringFormat='인스턴스: {0}'}"
                                       Foreground="#A0D0F0" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding PageDescription}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap" MaxWidth="550" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Page Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,16,0">
                    <TextBlock Text="Step " Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                    <TextBlock Text="{Binding CurrentPage}" Foreground="#FFD700" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text=" of 7" Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                </StackPanel>

                <!-- 윈도우 컨트롤 (최소화 / 닫기 — wizard 는 NoResize 라 최대화 없음).
                     ResizeMode=NoResize 고정 사이즈(960x820) 라 최대화 의미 없음. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource ModernGhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            ToolTip="최소화"
                            Width="32" Height="28" Padding="0">
                        <TextBlock Text="&#xE921;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                    </Button>

                    <Button Style="{StaticResource ModernGhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            ToolTip="닫기"
                            Width="32" Height="28" Padding="0" Margin="4,0,0,0">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushDanger}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page Content -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgWindow}" Padding="30">
            <Grid>
                <!-- Page 1: Welcome -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=1}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="BODA" FontSize="72" Foreground="#0078D4"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Vision System" FontSize="28" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                        <TextBlock Text="Machine Vision Configuration Wizard" FontSize="14"
                                   Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Page 2: Application Settings -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=2}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="500" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Application Name"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Application Name" CustomDescription="이 장비(라인)를 부르는 이름입니다. VMS 화면 제목 등에 표시됩니다. 예: OP102." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                        <TextBox Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,20"/>

                        <TextBlock Style="{StaticResource LabelStyle}"><Run Text="System IP Address"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="System IP Address" CustomDescription="이 비전 PC 의 IP 주소입니다. 카메라·PLC 와 같은 네트워크 대역이어야 합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                        <TextBox Text="{Binding SystemIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}"/>

                        <TextBlock Text="This is the IP address of the machine vision system PC."
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,5,0,0"/>

                        <!-- Web Server Integration -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,25,0,0">
                            <StackPanel>
                                <TextBlock Text="Web Server Integration" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFD700" Margin="0,0,0,12"/>

                                <CheckBox Content="Web 서버 미사용 — 단독(Standalone) 모드"
                                          IsChecked="{Binding IsStandaloneMode}"
                                          Style="{StaticResource WindowDarkCheckBox}" Margin="0,0,0,5"/>
                                <TextBlock Text="체크하면 Web 서버 주소를 비운 채 저장되어, VMS가 작업자 로그인·작업지시 없이 단독으로 검사를 운전합니다 (생산 이력·기준값의 Web 관리 비활성). 최근 검사 결과는 VMS 화면의 Recent Inspections에서 확인합니다."
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>

                                <StackPanel IsEnabled="{Binding IsWebFieldsEnabled}">
                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Client Index"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Client Index" CustomDescription="Web 서버가 이 장비를 구분하는 라인 번호입니다. 라인마다 1, 2, 3… 처럼 겹치지 않게 지정하세요." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <TextBox Text="{Binding ClientIndex, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,5"/>
                                <TextBlock Text="BODA.VMS.Web에서 이 클라이언트를 식별하는 고유 번호입니다."
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,15"/>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Web Server URL"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Web Server URL" CustomDescription="BODA.VMS.Web 관리 서버 주소입니다. 예: https://192.168.0.10:7144 — 검사 결과 업로드와 레시피 동기화에 사용됩니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <TextBox Text="{Binding WebServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,5"/>
                                <TextBlock Text="BODA.VMS.Web 서버 주소 (Heartbeat, 파라미터 동기화)"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,15"/>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Vision Server URL"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Vision Server URL" CustomDescription="VisionServer 를 함께 쓰는 구성에서의 API 주소입니다. 사용하지 않으면 그대로 두면 됩니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <TextBox Text="{Binding VisionServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,5"/>
                                <TextBlock Text="VisionServer API 주소 (클라이언트 자동 등록)"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,15"/>

                                <!-- 고급 설정 — Web Client API Key.
                                     일반 현장은 비워 두는 항목(Web 서버 기본 = 호환 모드)이라 접어서 노출.
                                     값을 틀리게 넣으면 Web 연동이 401 로 끊기므로 고객 관리자가 무심코
                                     건드리지 않도록 "필요할 때만 펼치는" 형태로 둔다. 저장된 키가 있으면
                                     VM 이 자동으로 펼친다(기존 설정 확인 가능). -->
                                <ToggleButton IsChecked="{Binding IsAdvancedWebSettingsVisible}"
                                              Style="{StaticResource WizardDisclosureToggle}"
                                              Content="고급 설정 — Web Client API Key (관리자가 Web 서버에 API 키 강제를 켠 경우에만)"/>
                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding IsAdvancedWebSettingsVisible, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Web Client API Key"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Web Client API Key" CustomDescription="일반적으로 비워 둡니다. Web 서버 관리자가 'API 키 강제' 를 켠 경우에만, 관리자에게 받은 키를 그대로 입력하세요. 틀리게 입력하면 Web 연동이 끊깁니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <TextBox Text="{Binding ClientApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,5"/>
                                    <TextBlock Text="일반적으로 비워 둡니다. Web 서버 관리자가 API 키 강제를 켠 경우에만 관리자에게 받은 키를 그대로 입력하세요. 값이 다르면 Web 연동(작업지시·이력 업로드)이 끊깁니다."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Web 서버 초기 구성 (MSI 동봉 로컬 서버) — MSI 는 파일+서비스(demand)만
                             설치, admin 시드·Jwt:Key·서비스 기동은 이 카드가 수행 (msi_build_guide §13) -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Web 서버 초기 구성 (이 PC)" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFD700" Margin="0,0,0,12"/>

                                <!-- 상태 1: 미설치 — 안내만 -->
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWebServerInstalled}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    이 PC 에는 Web 서버가 설치되어 있지 않습니다. 함께 설치하려면 MSI 설치에서
                                    "BODA VMS Web 서버" 기능을 포함하세요. 다른 PC 의 Web 서버를 쓰는 구성이면
                                    위 Web Server URL 만 지정하면 됩니다.
                                </TextBlock>

                                <!-- 상태 2: 설치됨 + 미구성 — 비밀번호 입력 + 구성 실행 -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsWebServerInstalled}" Value="True"/>
                                                        <Condition Binding="{Binding IsWebServerConfigured}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                               Foreground="{StaticResource BrushTextMuted}">
                                        <Bold>구성 전에는 Web 서버가 시작되지 않습니다.</Bold>
                                        admin 비밀번호를 정하면 보안 키(Jwt:Key)가 자동 생성되고 서비스가
                                        부팅 자동시작으로 전환된 뒤 바로 시작됩니다 (관리자 권한 승인 필요).
                                    </TextBlock>

                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Web Admin 비밀번호"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Web Admin 비밀번호" CustomDescription="Web 서버 관리자(admin) 계정의 초기 비밀번호입니다. 최소 8자, 12자 이상을 권장합니다. 첫 로그인 후 Web 관리 화면에서 변경할 수 있습니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <PasswordBox x:Name="WebAdminPasswordBox"
                                                 PasswordChanged="WebAdminPasswordBox_PasswordChanged"
                                                 IsVisibleChanged="WebAdminPasswordBox_IsVisibleChanged"
                                                 Style="{StaticResource WindowDarkPasswordBox}" Margin="0,0,0,12"/>

                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="비밀번호 확인"/></TextBlock>
                                    <PasswordBox x:Name="WebAdminPasswordConfirmBox"
                                                 PasswordChanged="WebAdminPasswordConfirmBox_PasswordChanged"
                                                 IsVisibleChanged="WebAdminPasswordBox_IsVisibleChanged"
                                                 Style="{StaticResource WindowDarkPasswordBox}" Margin="0,0,0,12"/>

                                    <Button Content="초기 구성 실행 (관리자 권한)"
                                            Command="{Binding ConfigureWebServerCommand}"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            HorizontalAlignment="Left"/>
                                    <TextBlock Text="구성 적용 중... (관리자 승인 → 설정 작성 → 서비스 시작 → 응답 확인)"
                                               FontSize="11" Foreground="#FFD700" Margin="0,8,0,0"
                                               Visibility="{Binding IsConfiguringWebServer, Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>

                                <!-- 상태 3: 구성 완료 — 서비스 상태 표시 -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWebServerConfigured}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="✔ 초기 구성 완료" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushSuccess}" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding WebServerServiceStatus}" FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 서비스가 내려간 경우만 노출 — 마이그레이션(§13.4)으로 설정만
                                             이어받았거나 구성 후 서비스가 멈춘 PC 의 수동 시작 경로 -->
                                        <Button Content="서비스 시작 (관리자 권한)"
                                                Command="{Binding StartWebServerCommand}"
                                                Margin="0,0,10,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernPrimaryButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWebServerServiceRunning}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="상태 새로고침"
                                                Command="{Binding RefreshWebServerStatusCommand}"
                                                Style="{StaticResource ModernSecondaryButton}"/>
                                    </StackPanel>
                                    <TextBlock Text="서비스 시작 중... (관리자 승인 → 자동시작 전환 → 시작 → 응답 확인)"
                                               FontSize="11" Foreground="#FFD700" Margin="0,8,0,0"
                                               Visibility="{Binding IsStartingWebServer, Converter={StaticResource BoolToVisConverter}}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                               Foreground="{StaticResource BrushTextMuted}">
                                        admin 비밀번호 재설정은 Web 배포 폴더의 Reset-AdminPassword 도구를 사용하세요.
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Web SSO (단일 사용자 계정 통합) — SSO Migration Plan §2.2 / PR5 -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Web SSO (Single Sign-On)" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFD700" Margin="0,0,0,12"/>

                                <CheckBox Content="Web SSO 활성 — Admin/Manager 인증을 BODA.VMS.Web 으로 위임"
                                          IsChecked="{Binding WebSsoEnabled}"
                                          Style="{StaticResource WindowDarkCheckBox}" Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,15"
                                           Foreground="{StaticResource BrushTextMuted}">
                                    활성 시 일반 사용자는 Web 의 admin 계정으로 로그인 (단일 계정 관리).
                                    Web 도달 불가 시 비상 계정 'local-admin' 만 진입 가능 (제한 권한 — 운영 데이터 변경 불가).
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 초기 비밀번호 (Option C, 2026-06-04) — 디폴트 시드 제거 후 명시 입력 필수 -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Initial Admin Passwords (보안 — 강한 비밀번호 필수)" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFD700" Margin="0,0,0,12"/>

                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                           Foreground="{StaticResource BrushTextMuted}">
                                    <Bold>신규 install 시 두 비밀번호 입력 필수:</Bold> 디폴트 비밀번호 자동 시드는 제거됨 (GS 보안성 위반).
                                    최소 8 자, 12 자+ 권장. 기존 install 에 이미 admin/local-admin 존재 시 비워두면 변경 안 함.
                                </TextBlock>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="VMS Admin 비밀번호"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="VMS Admin 비밀번호" CustomDescription="VMS 관리자(admin) 계정의 초기 비밀번호입니다. 최소 8자, 12자 이상을 권장합니다. Web SSO 활성 시에는 admin 로그인이 Web 계정으로 위임되어 이 값은 사용되지 않습니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <!-- SSO 활성 시 로컬 admin 은 로그인에 사용되지 않으므로 입력을 막아
                                     "비밀번호를 설정했다" 는 착각을 차단. 비활성화 시 code-behind 가 입력값도 폐기. -->
                                <PasswordBox x:Name="InitialAdminPasswordBox"
                                             PasswordChanged="InitialAdminPasswordBox_PasswordChanged"
                                             IsEnabledChanged="InitialAdminPasswordBox_IsEnabledChanged"
                                             Margin="0,0,0,5">
                                    <PasswordBox.Style>
                                        <Style TargetType="PasswordBox" BasedOn="{StaticResource WindowDarkPasswordBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WebSsoEnabled}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </PasswordBox.Style>
                                </PasswordBox>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                           Foreground="{StaticResource BrushTextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WebSsoEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    사용자 인증용 정규 admin 계정 — VMS 단독 운영 / SSO 비활성 환경에서 사용.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                           Foreground="#FFD700"
                                           Visibility="{Binding WebSsoEnabled, Converter={StaticResource BoolToVisConverter}}">
                                    ⚠ Web SSO 활성 — admin 로그인은 Web 계정 비밀번호를 사용하므로 이 입력란은 비활성화됩니다.
                                    admin 비밀번호 관리는 Web 관리 화면에서 하세요.
                                </TextBlock>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Local Fallback Admin 비밀번호 (비상용)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Local Fallback Admin 비밀번호 (비상용)" CustomDescription="Web 에 접속할 수 없을 때만 쓰는 비상 계정(local-admin)의 비밀번호입니다. 안전한 곳에 따로 보관하세요." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <PasswordBox x:Name="LocalAdminPasswordBox"
                                             PasswordChanged="LocalAdminPasswordBox_PasswordChanged"
                                             Style="{StaticResource WindowDarkPasswordBox}" Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}">
                                    'local-admin' 계정 — Web 도달 불가 시에만 사용 (제한 권한). 운영자가 안전한 곳에 별도 보관.
                                    상세 절차: docs/msi_build_guide.md §10 / §11.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>

                <!-- Page 3: Camera Configuration -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=3}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Mode Selection -->
                    <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Live Mode (Scan Network)" GroupName="CameraMode"
                                         IsChecked="{Binding CameraMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Live}"
                                         Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="0,0,40,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="네트워크를 검색해서 실제 연결된 카메라를 찾아 등록합니다."/>
                            <RadioButton Content="Virtual Mode (Manual Setup)" GroupName="CameraMode"
                                         IsChecked="{Binding CameraMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Virtual}"
                                         Style="{StaticResource WindowDarkRadioButton}" FontSize="13"
                                         VerticalContentAlignment="Center"
                                         ToolTip="카메라 없이 항목을 직접 만들어 구성합니다. 장비 설치 전에 미리 설정할 때 사용합니다."/>
                        </StackPanel>
                    </Border>

                    <!-- Controls -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Add Camera" Command="{Binding AddCameraCommand}"
                                Style="{StaticResource ModernPrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Scan Network" Command="{Binding ScanForCamerasCommand}"
                                Style="{StaticResource ModernSecondaryButton}"/>
                    </StackPanel>

                    <!-- Camera List -->
                    <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cameras}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                                CornerRadius="6" Padding="15,12" Margin="0,4">
                                            <StackPanel>
                                                <!-- Row 1: Basic Info -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Enable Checkbox -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Style="{StaticResource WindowDarkCheckBox}"
                                                              VerticalAlignment="Center" Margin="0,0,15,0"
                                                              ToolTip="Enable/Disable Camera"/>

                                                    <!-- Camera Info -->
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"><Run Text="Name:"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Name" CustomDescription="카메라를 구분하는 이름입니다. 예: Cam1, 상면카메라." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,6"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"><Run Text="IP:"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="IP" CustomDescription="카메라의 IP 주소입니다 (GigE 카메라). 비전 PC 와 같은 네트워크 대역이어야 합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource WindowDarkTextBox}"/>
                                                    </Grid>

                                                    <!-- Camera Type -->
                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding DataContext.CameraTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding CameraType}"
                                                              Width="110" Margin="10,0"
                                                              VerticalAlignment="Center"
                                                              Style="{StaticResource WindowDarkComboBox}"
                                                              ToolTip="카메라 종류입니다 — 에어리어/라인 스캔 × 2D/3D. 종류에 따라 아래에 해당 파라미터 입력란이 나타납니다."/>

                                                    <!-- Manufacturer -->
                                                    <ComboBox Grid.Column="3"
                                                              ItemsSource="{Binding DataContext.CameraManufacturers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Manufacturer}"
                                                              Width="110" Margin="0,0,10,0"
                                                              VerticalAlignment="Center"
                                                              Style="{StaticResource WindowDarkComboBox}"
                                                              ToolTip="카메라 제조사입니다. 선택에 따라 연결에 사용할 드라이버(SDK)가 결정됩니다."/>

                                                    <!-- Remove Button -->
                                                    <Button Grid.Column="4" Content="✕"
                                                            Command="{Binding DataContext.RemoveCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ModernDangerButton}"
                                                            Width="32" Height="32" FontSize="14" Padding="0"
                                                            ToolTip="Remove Camera"/>
                                                </Grid>

                                                <!-- Row 2: Area Scan Parameters -->
                                                <Border Background="{StaticResource BrushBgCard}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding IsAreaScan, Converter={StaticResource BoolToVisConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Exposure (μs)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Exposure (μs)" CustomDescription="노출 시간(마이크로초)입니다. 길수록 이미지가 밝아지지만, 움직이는 대상은 흐려질 수 있습니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <TextBox Text="{Binding Exposure, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Gain"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Gain" CustomDescription="신호 증폭(감도)입니다. 높이면 밝아지지만 노이즈도 함께 커집니다. 노출로 먼저 맞추고 부족할 때만 올리세요." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <TextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Row 3: Line Scan Parameters -->
                                                <Border Background="{StaticResource BrushBgCard}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding IsLineScan, Converter={StaticResource BoolToVisConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Trigger"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Trigger" CustomDescription="라인 스캔 촬영 신호원입니다 — Internal(카메라 자체 주기) / Encoder(컨베이어 엔코더 펄스) / External(외부 신호)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <ComboBox ItemsSource="{Binding DataContext.TriggerSources, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding TriggerSource}"
                                                                      Style="{StaticResource WindowDarkComboBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Line Rate (Hz)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Line Rate (Hz)" CustomDescription="초당 스캔하는 라인 수입니다. 제품 이송 속도에 맞춰야 이미지가 눌리거나 늘어나지 않습니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <TextBox Text="{Binding LineRate, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Scan Length"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Scan Length" CustomDescription="라인 몇 줄을 모아 이미지 한 장으로 만들지(이미지 세로 크기)입니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <TextBox Text="{Binding ScanLength, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="6"
                                                                    Visibility="{Binding ShowEncoderResolution, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Encoder Res (P/mm)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Encoder Res (P/mm)" CustomDescription="엔코더 분해능 — 1mm 이동할 때 나오는 펄스 수입니다. Trigger 가 Encoder 일 때 사용합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <TextBox Text="{Binding EncoderResolution, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Row 4: 3D Camera Parameters -->
                                                <Border Background="{StaticResource BrushBgCard}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding Is3DCamera, Converter={StaticResource BoolToVisConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Capture Mode"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Capture Mode" CustomDescription="3D 카메라가 무엇을 취득할지입니다 — Mode2D(밝기 이미지만) / Mode3D(높이 데이터만) / Both(둘 다)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <ComboBox ItemsSource="{Binding DataContext.CaptureModes3D, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding CaptureMode}"
                                                                      Style="{StaticResource WindowDarkComboBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Filter Strength"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Filter Strength" CustomDescription="3D 높이 데이터의 노이즈 제거 강도입니다. 값이 클수록 표면이 매끈해지지만 미세한 요철도 함께 지워질 수 있습니다. (3D 카메라 연동 구성에서 사용)" Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <TextBox Text="{Binding FilterStrength, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Z Min (mm)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Z Min (mm)" CustomDescription="측정할 높이 범위의 아래 한계(mm)입니다. 이보다 낮은 데이터는 버려집니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <TextBox Text="{Binding ZRangeMin, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="6">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Z Max (mm)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Z Max (mm)" CustomDescription="측정할 높이 범위의 위 한계(mm)입니다. 이보다 높은 데이터는 버려집니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <TextBox Text="{Binding ZRangeMax, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Row 5: Frame Grabber Parameters (Matrox/Dalsa) -->
                                                <Border Background="{StaticResource BrushBgCard}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding IsFrameGrabber, Converter={StaticResource BoolToVisConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Frame Grabber (MIL)" Foreground="#FF9800" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="0.6*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="0.6*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Board Type"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Board Type" CustomDescription="Matrox 프레임 그래버 보드 종류입니다. PC 에 설치된 보드에 맞게 선택하세요." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                                <ComboBox Text="{Binding BoardType}"
                                                                          IsEditable="True" IsReadOnly="False"
                                                                          Style="{StaticResource WindowDarkComboBox}">
                                                                    <sys:String>SOLIOS</sys:String>
                                                                    <sys:String>RAPIXO</sys:String>
                                                                    <sys:String>RADIENT</sys:String>
                                                                    <sys:String>ORION</sys:String>
                                                                    <sys:String>MORPHIS</sys:String>
                                                                    <sys:String>GIGE</sys:String>
                                                                    <sys:String>USB3</sys:String>
                                                                    <sys:String>GENTL</sys:String>
                                                                    <sys:String>HOST</sys:String>
                                                                </ComboBox>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Board #"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Board #" CustomDescription="같은 보드가 여러 장 설치되어 있을 때 몇 번째 보드인지입니다 (0부터)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                                <TextBox Text="{Binding BoardNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="Digitizer #"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Digitizer #" CustomDescription="보드 안에서 카메라가 연결된 입력 채널 번호입니다 (0부터)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                                <TextBox Text="{Binding DigitizerNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"><Run Text="DCF File (Camera Link)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="DCF File (Camera Link)" CustomDescription="Camera Link 카메라의 설정 파일(DCF) 경로입니다. 카메라/보드 제조사가 제공합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Grid.Column="0"
                                                                         Text="{Binding DcfFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                                                <Button Grid.Column="1" Content="..." Margin="4,0,0,0"
                                                                        Width="32" FontWeight="Bold"
                                                                        Click="BrowseDcfFile_Click"
                                                                        Style="{StaticResource ModernGhostButton}"
                                                                        ToolTip="Browse DCF file"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Page 5: Robot Configuration -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=5}">
                    <StackPanel MaxWidth="600" VerticalAlignment="Top">
                        <!-- Robot Enable Toggle -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox Content="Enable Robot Integration" IsChecked="{Binding IsRobotEnabled}"
                                          Style="{StaticResource WindowDarkCheckBox}"
                                          FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="멀티뷰 3D 스캔을 위해 로봇을 사용하려면 활성화하세요."
                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="20,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Robot Settings (visible when enabled) -->
                        <StackPanel Visibility="{Binding IsRobotEnabled, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Robot Vendor Selection -->
                            <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Robot Vendor"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Robot Vendor" CustomDescription="로봇 제조사입니다. 선택하면 통신 프로토콜과 자세 표현(오일러 순서)이 자동으로 맞춰집니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                <StackPanel>
                                    <RadioButton Content="Universal Robots (UR)" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=UR}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Doosan Robotics" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Doosan}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Jaka Robotics" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Jaka}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="ABB" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ABB}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Fanuc" GroupName="RobotVendor"
                                                 IsChecked="{Binding SelectedRobotVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Fanuc}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                </StackPanel>
                            </Border>

                            <!-- Connection Settings -->
                            <TextBlock Text="Connection Settings" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Robot IP Address"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Robot IP Address" CustomDescription="로봇 컨트롤러의 IP 주소입니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                        <TextBox Text="{Binding RobotIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource WindowDarkTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Port"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Port" CustomDescription="로봇 통신 포트입니다. 제조사를 선택하면 표준 포트가 자동으로 입력됩니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                        <TextBox Text="{Binding RobotPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource WindowDarkTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Communication Protocol -->
                            <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Communication Protocol"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Communication Protocol" CustomDescription="로봇과 데이터를 주고받는 방식입니다. 보통 Vendor Native(제조사 기본 방식)를 사용합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Content="Vendor Native" GroupName="RobotProtocol"
                                                     IsChecked="{Binding SelectedRobotProtocolMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VendorNative}"
                                                     Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="0,0,20,0"/>
                                        <RadioButton Content="Modbus-TCP" GroupName="RobotProtocol"
                                                     IsChecked="{Binding SelectedRobotProtocolMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ModbusTcp}"
                                                     Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="0,0,20,0"
                                                     Visibility="{Binding ShowRobotModbusOption, Converter={StaticResource BoolToVisConverter}}"/>
                                        <RadioButton Content="Custom Socket (CSV)" GroupName="RobotProtocol"
                                                     IsChecked="{Binding SelectedRobotProtocolMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CustomSocket}"
                                                     Style="{StaticResource WindowDarkRadioButton}" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RobotProtocolDescription}"
                                               Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap"/>

                                    <!-- Modbus-TCP Settings (visible when Modbus mode selected) -->
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsRobotModbusMode, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4"><Run Text="Unit ID"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Unit ID" CustomDescription="Modbus 장비 번호입니다. 로봇 컨트롤러에 설정된 값과 같아야 합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                <TextBox Text="{Binding RobotModbusUnitId, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4"><Run Text="Pose Start Register"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Pose Start Register" CustomDescription="로봇의 현재 위치(포즈) 값 6개를 읽기 시작할 레지스터 주소입니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                                <TextBox Text="{Binding RobotModbusPoseRegister, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Holding Register 주소입니다. 기본값 270은 Doosan 표준 TCP 포즈 레지스터입니다."
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Euler Convention (auto-selected by vendor, but editable) -->
                            <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Euler Convention"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Euler Convention" CustomDescription="로봇이 자세(회전)를 표현하는 축 순서입니다. 제조사 선택 시 자동으로 설정되며, 잘못되면 멀티뷰 3D 정합이 틀어집니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding EulerConventions}"
                                              SelectedItem="{Binding SelectedEulerConvention}"
                                              Style="{StaticResource WindowDarkComboBox}"/>
                                    <TextBlock Text="로봇 제조사 선택 시 자동으로 설정됩니다. 필요 시 수동 변경 가능합니다."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page 4: PLC Configuration -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=4}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Left Column: PLC Vendor + Performance & Stability -->
                        <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0">

                            <!-- PLC Vendor Selection -->
                            <TextBlock Style="{StaticResource LabelStyle}"><Run Text="PLC Vendor"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="PLC Vendor" CustomDescription="PLC 제조사를 선택하세요. 제조사에 맞는 통신 방식이 자동으로 적용됩니다. PLC 를 쓰지 않으면 None 을 선택합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                <StackPanel>
                                    <RadioButton Content="Mitsubishi" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Mitsubishi}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Siemens" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Siemens}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="LS Electric" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=LS}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Omron" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Omron}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="Modbus TCP" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Modbus}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                    <RadioButton Content="None (No PLC)" GroupName="PlcVendor"
                                                 IsChecked="{Binding SelectedPlcVendor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=None}"
                                                 Style="{StaticResource WindowDarkRadioButton}" FontSize="13" Margin="5"/>
                                </StackPanel>
                            </Border>

                            <!-- Performance & Stability -->
                            <TextBlock Text="Performance &amp; Stability" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Polling Interval (ms)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Polling Interval (ms)" CustomDescription="PLC 값을 읽어 오는 주기(밀리초)입니다. 짧을수록 반응이 빠르지만 PLC 통신 부하가 커집니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <TextBox Text="{Binding PollingIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>

                                    <CheckBox Content="Use Heartbeat" IsChecked="{Binding UseHeartbeat}"
                                              Style="{StaticResource WindowDarkCheckBox}"
                                              FontSize="13" Margin="0,0,0,8"
                                              ToolTip="체크하면 아래 주소에 주기적으로 신호를 써서 PLC 와 서로 살아 있음을 확인합니다."/>
                                    <TextBox Text="{Binding HeartbeatAddress, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"
                                             IsEnabled="{Binding UseHeartbeat}">
                                        <TextBox.Tag>
                                            <TextBlock Text="Heartbeat Address (e.g. D100)" Foreground="{StaticResource BrushTextMuted}"/>
                                        </TextBox.Tag>
                                    </TextBox>

                                    <CheckBox Content="Auto Reconnect" IsChecked="{Binding AutoReconnect}"
                                              Style="{StaticResource WindowDarkCheckBox}"
                                              FontSize="13"
                                              ToolTip="연결이 끊기면 자동으로 다시 연결을 시도합니다."/>
                                </StackPanel>
                            </Border>

                            <!-- Data Synchronization -->
                            <TextBlock Text="Data Synchronization" Style="{StaticResource LabelStyle}"/>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Write Mode"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Write Mode" CustomDescription="검사 결과 값을 PLC 에 기록하는 방식입니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <ComboBox ItemsSource="{Binding WriteModes}"
                                              SelectedItem="{Binding WriteMode}"
                                              Style="{StaticResource WindowDarkComboBox}" Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Endian Mode"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Endian Mode" CustomDescription="32비트 값을 워드 2개로 나눠 보낼 때의 순서입니다. PLC 쪽 설정과 같아야 값이 깨지지 않습니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <ComboBox ItemsSource="{Binding EndianModes}"
                                              SelectedItem="{Binding EndianMode}"
                                              Style="{StaticResource WindowDarkComboBox}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Communication Settings -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,0">

                            <!-- Communication Type -->
                            <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Communication Type"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Communication Type" CustomDescription="PLC 와의 연결 방식입니다 — Ethernet(네트워크 케이블) 또는 Serial(시리얼 케이블)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                            <ComboBox ItemsSource="{Binding CommunicationTypes}"
                                      SelectedItem="{Binding SelectedCommunicationType}"
                                      Style="{StaticResource WindowDarkComboBox}" Margin="0,0,0,15"/>

                            <!-- Modbus Unit ID (visible when Modbus selected) -->
                            <StackPanel Visibility="{Binding IsModbusVendor, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Modbus Unit ID (1-255)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Modbus Unit ID (1-255)" CustomDescription="Modbus 장비 번호(1~255)입니다. PLC 쪽에 설정된 Unit ID 와 같아야 합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <TextBox Text="{Binding ModbusUnitId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,15"/>
                            </StackPanel>

                            <!-- Ethernet Settings (visible when NOT Serial) -->
                            <StackPanel Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="PLC IP Address"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="PLC IP Address" CustomDescription="PLC 의 IP 주소입니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <TextBox Text="{Binding PlcIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,15"/>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="PLC Port"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="PLC Port" CustomDescription="PLC 통신 포트 번호입니다. 예: Modbus TCP 는 502." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <TextBox Text="{Binding PlcPort, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,15"/>
                            </StackPanel>

                            <!-- Serial Settings (visible when Serial selected) -->
                            <StackPanel Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Serial Port" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Port Name"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Port Name" CustomDescription="시리얼 포트 이름입니다. 예: COM1." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <TextBox Text="{Binding SerialPortName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Baud Rate"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Baud Rate" CustomDescription="시리얼 통신 속도입니다. PLC 쪽 설정과 같아야 합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <ComboBox ItemsSource="{Binding BaudRateOptions}"
                                          SelectedItem="{Binding BaudRate}"
                                          Style="{StaticResource WindowDarkComboBox}" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Data Bits"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Data Bits" CustomDescription="시리얼 통신 세부 설정입니다. PLC 쪽과 동일하게 맞추세요 (보통 8)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                        <ComboBox ItemsSource="{Binding DataBitsOptions}"
                                                  SelectedItem="{Binding DataBits}"
                                                  Style="{StaticResource WindowDarkComboBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Parity"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Parity" CustomDescription="오류 검출 방식입니다. PLC 쪽과 동일하게 맞추세요 (보통 None)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                        <ComboBox ItemsSource="{Binding SerialParities}"
                                                  SelectedItem="{Binding Parity}"
                                                  Style="{StaticResource WindowDarkComboBox}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource LabelStyle}" Margin="0,10,0,6"><Run Text="Stop Bits"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Stop Bits" CustomDescription="정지 비트 수입니다. PLC 쪽과 동일하게 맞추세요 (보통 One)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                <ComboBox ItemsSource="{Binding SerialStopBitsValues}"
                                          SelectedItem="{Binding StopBits}"
                                          Style="{StaticResource WindowDarkComboBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Page 6: IO Board Configuration (Phase 2b) -->
                <!-- PLC 와 동시 사용 가능한 디지털 IO 보드 (ADLink PCI-743x / Advantech PCI-17xx) CRUD. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=6}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: 보드 리스트 + Add/Remove -->
                        <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="등록된 IO 보드"
                                           Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>

                                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="+ Add"
                                            Command="{Binding AddIoBoardCommand}"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="− Remove"
                                            Command="{Binding RemoveIoBoardCommand}"
                                            Style="{StaticResource ModernDangerButton}"
                                            Margin="4,0,0,0"
                                            IsEnabled="{Binding SelectedIoBoard, Converter={StaticResource NullToBoolConverter}}"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding IoBoardItems}"
                                         SelectedItem="{Binding SelectedIoBoard, Mode=TwoWay}"
                                         Style="{StaticResource WindowDarkListBox}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding DeviceId}" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                                                    <Run Text="{Binding Vendor, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Model, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Right: 선택된 보드 폼 -->
                        <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedIoBoard}"
                                            IsEnabled="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource NullToBoolConverter}}">

                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="제조사 (Vendor)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="제조사 (Vendor)" CustomDescription="IO 보드 제조사입니다 — ADLink 또는 Advantech." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <ComboBox ItemsSource="{Binding DataContext.IoBoardVendorValues, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Vendor, Mode=TwoWay}"
                                              Style="{StaticResource WindowDarkComboBox}" Margin="0,0,0,12"/>

                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="모델 (예: PCI-7432, PCI-1716)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="모델 (예: PCI-7432, PCI-1716)" CustomDescription="설치된 IO 보드의 모델명입니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,12"/>

                                    <TextBlock Style="{StaticResource LabelStyle}"><Run Text="디바이스 ID (시퀀스 노드에서 참조할 식별자)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="디바이스 ID (시퀀스 노드에서 참조할 식별자)" CustomDescription="검사 시퀀스에서 이 보드를 부를 때 쓰는 이름입니다. 예: IoBoard_1." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Board ID"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Board ID" CustomDescription="같은 모델 보드가 여러 장일 때 몇 번째 보드인지입니다 (0부터)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                            <TextBox Text="{Binding BoardId, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Input 채널 수"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Input 채널 수" CustomDescription="보드의 입력 채널 개수입니다. 모델 사양에 맞게 입력하세요." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                            <TextBox Text="{Binding InputChannelCount, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource LabelStyle}"><Run Text="Output 채널 수"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Output 채널 수" CustomDescription="보드의 출력 채널 개수입니다. 모델 사양에 맞게 입력하세요." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                            <TextBox Text="{Binding OutputChannelCount, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WindowDarkTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="활성화 (체크 해제 시 시스템 부팅 시 인스턴스 생성 skip)"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Style="{StaticResource WindowDarkCheckBox}"
                                              Margin="0,0,0,12"/>

                                    <TextBlock Text="설명 (선택)" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}" Margin="0,0,0,12"/>

                                    <Border Background="#1E3A5F" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                        <TextBlock Foreground="#A0D0F0" FontSize="11" TextWrapping="Wrap">
                                            ※ 현재 Mock 구현만 활성 — 실제 ADLink DASK / Advantech DAQNavi SDK 통합은 Phase 3 작업입니다.
                                            Phase 1+2 까지는 인프라 검증용으로 보드 등록 후 시퀀스에서 채널 read/write 호출 시 in-memory 동작합니다.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Page 7: Security Mode -->
                <!-- RELEASE 빌드 VMS 는 securityMode 미명시 시 부팅 중단 (SecurityLoadPolicy.RequireExplicit).
                     wizard 가 항상 이 키를 기록해 현장 설치 직후 "보안 정책 오류" 부팅 실패를 방지. -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageConverter}, ConverterParameter=7}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="500" VerticalAlignment="Top">
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FFD700" Margin="0,0,0,12"><Run Text="Security Mode (보안 모드 — 필수)"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="Security Mode (보안 모드)" CustomDescription="VMS 가 네트워크 통신에 적용할 보안 수준입니다. 현장(운영) PC 는 반드시 Production 을 선택하세요." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,15"
                                           Foreground="{StaticResource BrushTextMuted}">
                                    운영 배포(RELEASE) VMS 는 보안 모드가 명시되지 않으면 시작하지 않습니다.
                                    여기서 선택한 값이 system_config.json 의 securityMode 로 저장됩니다.
                                </TextBlock>

                                <RadioButton Content="Production (운영 — 권장)" GroupName="SecurityMode"
                                             IsChecked="{Binding SecurityMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Production}"
                                             Style="{StaticResource WindowDarkRadioButton}" FontSize="13"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="24,3,0,15"
                                           Foreground="{StaticResource BrushTextMuted}">
                                    HTTPS 강제 + 인증서 엄격 검증. 현장 설치 PC 는 반드시 이 모드를 사용하세요.
                                </TextBlock>

                                <RadioButton Content="Development (개발 — 사내 테스트 전용)" GroupName="SecurityMode"
                                             IsChecked="{Binding SecurityMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Development}"
                                             Style="{StaticResource WindowDarkRadioButton}" FontSize="13"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="24,3,0,0"
                                           Foreground="{StaticResource BrushTextMuted}">
                                    HTTP 허용 + self-signed 인증서 우회. 로컬/사내 테스트 환경에서만 사용하세요.
                                    운영 PC 에 설정하면 GS 보안성 항목 감점 사유가 됩니다.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E3A5F" CornerRadius="4" Padding="10" Margin="0,15,0,0">
                            <TextBlock Foreground="#A0D0F0" FontSize="11" TextWrapping="Wrap">
                                ※ 환경변수 BODA_VMS_SECURITY_MODE 가 설정된 PC 에서는 환경변수가 이 설정보다 우선합니다
                                (docs/msi_build_guide.md §9 참고).
                            </TextBlock>
                        </Border>

                        <!-- SW 라이선스 활성화 (docs/design/license-spec.md §6) — 지문 코드를 본사에
                             전달해 발급받은 license.lic 를 USB 로 반입 후 여기서 설치 -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="15" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FFD700" Margin="0,0,0,12"><Run Text="SW 라이선스"/><InlineUIContainer BaselineAlignment="Center"><controls:HelpIcon CustomTitle="SW 라이선스" CustomDescription="이 PC 의 지문 코드를 본사에 전달하면 라이선스 파일(license.lic)이 발급됩니다. 발급받은 파일을 USB 등으로 가져와 [라이선스 파일 가져오기]로 설치하세요. 현재는 라이선스가 없어도 경고만 표시되고 동작에는 제한이 없습니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="이 PC 의 지문 코드 (발급 요청 시 본사에 전달)"/></TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBox Text="{Binding MachineFingerprintCode, Mode=OneWay}" IsReadOnly="True"
                                             Style="{StaticResource WindowReadOnlyTextBox}" Width="200"
                                             FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                    <Button Content="복사" Command="{Binding CopyFingerprintCommand}"
                                            Style="{StaticResource ModernSecondaryButton}" Margin="8,0,0,0"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource LabelStyle}"><Run Text="현재 상태"/></TextBlock>
                                <TextBlock Text="{Binding LicenseStatusText}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LicenseStatusLevel}" Value="Ok">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LicenseStatusLevel}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="라이선스 파일 가져오기..."
                                            Command="{Binding ImportLicenseCommand}"
                                            Style="{StaticResource ModernPrimaryButton}" Margin="0,0,10,0"/>
                                    <Button Content="상태 새로고침"
                                            Command="{Binding RefreshLicenseStatusCommand}"
                                            Style="{StaticResource ModernSecondaryButton}"/>
                                </StackPanel>
                                <TextBlock Text="설치 중... (파일 검증 → 설치 경로 복사 — 권한이 필요하면 관리자 승인 창이 뜹니다)"
                                           FontSize="11" Foreground="#FFD700" Margin="0,8,0,0"
                                           Visibility="{Binding IsImportingLicense, Converter={StaticResource BoolToVisConverter}}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{StaticResource BrushTextMuted}">
                                    라이선스가 없어도 지금은 경고만 표시됩니다 (도입 전환기). PC 교체·재구성으로
                                    지문이 바뀐 경우에는 위 지문 코드로 재발급을 요청하세요.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer with Navigation -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource ModernSecondaryButton}"
                        HorizontalAlignment="Left" Width="100"/>

                <Button Grid.Column="1" Content="{Binding NextButtonText}"
                        Command="{Binding GoNextCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        HorizontalAlignment="Right" MinWidth="120"/>
            </Grid>
        </Border>
    </Grid>
</Window>
