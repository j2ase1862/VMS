<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppDataPaths.ResetForTests — 인스턴스 해석 상태 초기화 (테스트 전용) -->
    <InternalsVisibleTo Include="VMS.Core.Tests" />
  </ItemGroup>

  <!-- Mech-Mind SDK: prefer netstandard2.0 (compatible with .NET 8), fallback to net48 -->
  <PropertyGroup Condition="Exists('C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\netstandard2.0\MechEyeApiNet.dll') Or Exists('C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\net48\MechEyeApiNet.dll')">
    <DefineConstants>$(DefineConstants);MECHMIND_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\netstandard2.0\MechEyeApiNet.dll')">
    <Reference Include="MechEyeApiNet">
      <HintPath>C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\netstandard2.0\MechEyeApiNet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\netstandard2.0\MechEyeApiNet.dll') And Exists('C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\net48\MechEyeApiNet.dll')">
    <Reference Include="MechEyeApiNet">
      <HintPath>C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\net48\MechEyeApiNet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Mech-Mind native DLLs (C++ SDK) must be copied to output for P/Invoke -->
  <ItemGroup Condition="Exists('C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\MechEyeApi.dll')">
    <None Include="C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\MechEyeApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>MechEyeApi.dll</Link>
    </None>
    <None Include="C:\Mech-Mind\Mech-Eye SDK-2.5.4\API\dll\MechEyeApiWrapper.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>MechEyeApiWrapper.dll</Link>
    </None>
  </ItemGroup>

  <!-- Basler Pylon SDK: Developer 프로파일 설치 시 BASLER_AVAILABLE 정의.
       pylon 26.07 부터 .NET 어셈블리 경로가 net8.0\x64 로 변경 (net6.0 은 구버전 스위트 폴백).
       관리 어셈블리만 참조 — native 런타임은 pylon Runtime 설치 + PATH 로 해석되므로
       현장 PC 에는 pylon Runtime(카메라·GigE 필터 드라이버 포함) 설치가 별도로 필요. -->
  <PropertyGroup>
    <BaslerPylonNet8Dll>C:\Program Files\Basler\pylon 7\Development\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</BaslerPylonNet8Dll>
    <BaslerPylonNet6Dll>C:\Program Files\Basler\pylon 7\Development\Assemblies\Basler.Pylon\net6.0\Basler.Pylon.dll</BaslerPylonNet6Dll>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(BaslerPylonNet8Dll)') Or Exists('$(BaslerPylonNet6Dll)')">
    <DefineConstants>$(DefineConstants);BASLER_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(BaslerPylonNet8Dll)')">
    <Reference Include="Basler.Pylon">
      <HintPath>$(BaslerPylonNet8Dll)</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(BaslerPylonNet8Dll)') And Exists('$(BaslerPylonNet6Dll)')">
    <Reference Include="Basler.Pylon">
      <HintPath>$(BaslerPylonNet6Dll)</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Matrox MIL SDK: define MIL_AVAILABLE when MIL is installed -->
  <PropertyGroup Condition="Exists('C:\Program Files\Matrox Imaging\MIL\MIL.NET\Matrox.MatroxImagingLibrary.dll')">
    <DefineConstants>$(DefineConstants);MIL_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('C:\Program Files\Matrox Imaging\MIL\MIL.NET\Matrox.MatroxImagingLibrary.dll')">
    <Reference Include="Matrox.MatroxImagingLibrary">
      <HintPath>C:\Program Files\Matrox Imaging\MIL\MIL.NET\Matrox.MatroxImagingLibrary.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
