<Application x:Class="Boda.LicGen.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- VisionSetup 다크 디자인 시스템 — csproj Linked Page 로 컴파일해
                     자체 컴포넌트 경로로 참조 (AppSetup 과 동일 관례). -->
                <ResourceDictionary Source="pack://application:,,,/LicGenApp;component/Styles/WindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
