<UserControl x:Class="VMS.Core.Controls.PointCloudViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             mc:Ignorable="d"
             Background="#1E1E1E">

    <UserControl.Resources>
        <Style x:Key="ViewerToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerToolbarToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E6BD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- 3D Viewport -->
        <hx:Viewport3DX x:Name="Viewport"
                         Background="Black"
                         ShowCoordinateSystem="True"
                         CoordinateSystemLabelForeground="White"
                         CoordinateSystemLabelX="X"
                         CoordinateSystemLabelY="Z"
                         CoordinateSystemLabelZ="Y"
                         ShowFrameRate="False"
                         EnableDeferredRendering="False"
                         IsShadowMappingEnabled="False"
                         FXAALevel="None"
                         EnableSSAO="False"
                         EnableAutoOctreeUpdate="False"
                         IsRotationEnabled="False"
                         IsPanEnabled="False"
                         IsZoomEnabled="False"
                         IsInertiaEnabled="False"
                         IsMoveEnabled="False"
                         IsChangeFieldOfViewEnabled="False">

            <hx:Viewport3DX.Camera>
                <hx:PerspectiveCamera x:Name="MainCamera"
                                       Position="200,200,200"
                                       LookDirection="-200,-200,-200"
                                       UpDirection="0,-1,0"
                                       FarPlaneDistance="10000"
                                       NearPlaneDistance="0.1"
                                       FieldOfView="45"/>
            </hx:Viewport3DX.Camera>

            <hx:AmbientLight3D Color="#404040"/>
            <hx:DirectionalLight3D Direction="-1,-1,-1" Color="White"/>

            <!-- Grid (데이터 바운딩 박스 바닥면에 정합 — Mech-Eye Viewer 스타일) -->
            <hx:LineGeometryModel3D x:Name="GridLines" Color="#5A5A5A" Thickness="0.5"/>

            <!-- Data Bounding Box (반투명 청록 와이어프레임) -->
            <hx:LineGeometryModel3D x:Name="BoundsBoxLines" Color="#7F5FB0C8" Thickness="1.0"/>

            <!-- Axis Lines -->
            <hx:LineGeometryModel3D x:Name="AxisLines" Thickness="2.0"/>

            <!-- Point Cloud -->
            <hx:PointGeometryModel3D x:Name="PointCloudModel" Size="5,5" Color="White"/>

            <!-- Axis Labels (Billboard Text) -->
            <hx:BillboardTextModel3D x:Name="AxisLabelX" FixedSize="True"/>
            <hx:BillboardTextModel3D x:Name="AxisLabelY" FixedSize="True"/>
            <hx:BillboardTextModel3D x:Name="AxisLabelZ" FixedSize="True"/>

            <!-- Grid Tick Labels -->
            <hx:BillboardTextModel3D x:Name="GridTickLabels" FixedSize="True"/>

        </hx:Viewport3DX>

        <!-- Point count (top-left) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="6,6,0,0">
            <TextBlock x:Name="PointCountText"
                       Foreground="#AAAAAA" FontSize="10"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="LodIndicator"
                       Foreground="#FF9800" FontSize="10"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Measure Toolbar (top center, Mech-Eye style) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,6,0,0">
            <ToggleButton x:Name="BtnMeasureDistance" Content="Distance"
                          ToolTip="거리 측정 — 점 2개를 클릭"
                          Style="{StaticResource ViewerToolbarToggle}"
                          Checked="BtnMeasureDistance_Checked"
                          Unchecked="MeasureMode_Unchecked"/>
            <ToggleButton x:Name="BtnMeasureAngle" Content="Angle"
                          ToolTip="각도 측정 — 점 3개를 클릭 (두 번째 점이 꼭짓점)"
                          Style="{StaticResource ViewerToolbarToggle}"
                          Checked="BtnMeasureAngle_Checked"
                          Unchecked="MeasureMode_Unchecked"/>
            <Button x:Name="BtnMeasureClear" Content="Clear"
                    ToolTip="측정 결과 모두 지우기"
                    Style="{StaticResource ViewerToolbarButton}"
                    Click="BtnMeasureClear_Click"/>
            <Border x:Name="MeasureHintPanel" Background="#88000000" CornerRadius="3"
                    Padding="6,2" Margin="6,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="MeasureHintText"
                           Foreground="#FFD54F" FontSize="10"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- View Toolbar (right vertical, Mech-Eye style) -->
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,6,6,0">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource ViewerToolbarButton}">
                    <Setter Property="Margin" Value="0,0,0,3"/>
                    <Setter Property="MinWidth" Value="38"/>
                </Style>
            </StackPanel.Resources>
            <Button x:Name="BtnResetView" Content="Reset" ToolTip="데이터에 맞춰 시점 초기화"
                    Click="BtnResetView_Click"/>
            <Button x:Name="BtnTopView" Content="Top" ToolTip="위에서 보기"
                    Click="BtnTopView_Click"/>
            <Button x:Name="BtnFrontView" Content="Front" ToolTip="정면에서 보기"
                    Click="BtnFrontView_Click"/>
            <Button x:Name="BtnSideView" Content="Side" ToolTip="측면에서 보기"
                    Click="BtnSideView_Click"/>
            <Button x:Name="BtnToggleGrid" Content="Grid" ToolTip="그리드/박스/눈금 표시 전환"
                    Click="BtnToggleGrid_Click"/>
            <Button x:Name="BtnLodMode" Content="자동"
                    ToolTip="표시 밀도 전환: 자동 → 전체 → 1/2 → 1/4 — 점군이 성기게 보이면 '전체', 화면이 느리면 1/2·1/4 를 선택하세요"
                    Click="BtnLodMode_Click"/>
        </StackPanel>

        <!-- Depth Range + Color Bar (left side, Mech-Eye style) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Margin="6,34,0,10" Width="66"
                Background="#88000000" CornerRadius="3" Padding="4"
                x:Name="ColorBarPanel" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="MaxValueLabel" Text=""
                           Foreground="White" FontSize="9" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,1"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Width="12" Margin="0,6" RadiusX="2" RadiusY="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF0000FF" Offset="0.0"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.25"/>
                                <GradientStop Color="#FF00FF00" Offset="0.5"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.75"/>
                                <GradientStop Color="#FFFF0000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- 깊이 표시 범위 — 상/하한 슬라이더 겹침 배치 (범위 슬라이더 대용) -->
                    <Grid Grid.Column="1" Margin="2,0,0,0">
                        <Slider x:Name="DepthMaxSlider" Orientation="Vertical"
                                HorizontalAlignment="Left" Width="18"
                                ValueChanged="DepthSlider_ValueChanged"
                                ToolTip="표시 상한 (mm)"/>
                        <Slider x:Name="DepthMinSlider" Orientation="Vertical"
                                HorizontalAlignment="Right" Width="18"
                                ValueChanged="DepthSlider_ValueChanged"
                                ToolTip="표시 하한 (mm)"/>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2" x:Name="MinValueLabel" Text=""
                           Foreground="White" FontSize="9" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,1"/>

                <Button Grid.Row="3" x:Name="BtnResetDepthRange" Content="전체"
                        ToolTip="깊이 표시 범위를 전체 데이터로 초기화"
                        Click="BtnResetDepthRange_Click"
                        Style="{StaticResource ViewerToolbarButton}"
                        Margin="0,3,0,0" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- Status Bar (bottom) -->
        <Border x:Name="StatusBarPanel"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Background="#88000000" Padding="10,4"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusBarText" Text=""
                       Foreground="#CCCCCC" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
