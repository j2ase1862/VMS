<Application x:Class="VMS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VMS.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- VMS.VisionSetup 의 통일 다크 윈도우 디자인 시스템 (색 토큰, 컨트롤,
                     모던 버튼). VMS 의 독립 다이얼로그(AuditLogViewer / HealthCheck /
                     BackupRestore / AutoBackupSettings) 들이 동일 스타일 사용. -->
                <ResourceDictionary Source="/VMS.VisionSetup;component/Styles/WindowStyles.xaml"/>

                <!-- VMS 디자인 토큰 (v1.0, 2026-06-01) — Colors / Typography / Spacing / Controls.
                     순서 중요: Colors → Typography(Brush 참조) → Spacing → Controls(이전 모두 참조). -->
                <ResourceDictionary Source="/VMS;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/VMS;component/Themes/Typography.xaml"/>
                <ResourceDictionary Source="/VMS;component/Themes/Spacing.xaml"/>
                <ResourceDictionary Source="/VMS;component/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:StatusStateToColorConverter x:Key="StatusStateToColorConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:UserGradeToColorConverter x:Key="UserGradeToColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
