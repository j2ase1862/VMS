<Window x:Class="VMS.Views.AutoBackupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자동 백업 설정 — Auto Backup Settings"
        Width="640" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="자동 백업 설정 — Auto Backup Settings"
                   Foreground="#2196F3" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Settings card -->
        <Border Grid.Row="1" Background="#2D2D2D" CornerRadius="6" Padding="16">
            <StackPanel>
                <!-- Enabled -->
                <CheckBox Content="자동 백업 활성화"
                          IsChecked="{Binding Enabled}"
                          Foreground="#E0E0E0" FontSize="14"
                          Margin="0,0,0,16"/>

                <!-- Interval -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="백업 주기 (시간)" Foreground="#B0B0B0"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding IntervalHours}"
                             Background="#1E1E1E" Foreground="#E0E0E0"
                             BorderBrush="#555" Padding="6,3"/>
                    <TextBlock Grid.Column="2" Text="[1, 720]" Foreground="#707070"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Retention -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="보존 기간 (일)" Foreground="#B0B0B0"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding RetentionDays}"
                             Background="#1E1E1E" Foreground="#E0E0E0"
                             BorderBrush="#555" Padding="6,3"/>
                    <TextBlock Grid.Column="2" Text="[1, 365]" Foreground="#707070"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Backup dir -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="백업 위치" Foreground="#B0B0B0"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding BackupDir}"
                             Background="#1E1E1E" Foreground="#E0E0E0"
                             BorderBrush="#555" Padding="6,3"
                             ToolTip="비워두면 %LocalAppData%\BODA VISION AI\backups"/>
                    <Button Grid.Column="2" Content="Browse..."
                            Command="{Binding PickBackupDirCommand}"
                            Padding="12,4" Margin="8,0,0,0"
                            Background="#424242" Foreground="White"
                            BorderThickness="0"/>
                </Grid>

                <!-- IncludeAudit -->
                <CheckBox Content="감사 로그 (audit/) 포함"
                          IsChecked="{Binding IncludeAudit}"
                          Foreground="#E0E0E0" Margin="0,4,0,12"
                          ToolTip="활성화하면 매 백업이 크게 증가합니다 — 감사 보존이 별도 정책에 의해 관리되므로 보통 꺼둡니다."/>

                <!-- Product version -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ProductVersion (manifest)" Foreground="#B0B0B0"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ProductVersion}"
                             Background="#1E1E1E" Foreground="#E0E0E0"
                             BorderBrush="#555" Padding="6,3"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" Background="#2D2D2D" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2" Width="6"
                        Background="{Binding StatusColor}" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           Foreground="#E0E0E0" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reload" Command="{Binding LoadCommand}"
                    Padding="14,6" Margin="0,0,8,0"
                    Background="#424242" Foreground="White" BorderThickness="0"/>
            <Button Content="Save" Command="{Binding SaveCommand}"
                    Padding="14,6"
                    Background="#1976D2" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
