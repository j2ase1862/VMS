<Window x:Class="VMS.Views.AutoBackupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자동 백업 설정 — Auto Backup Settings"
        Width="680" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="자동 백업 설정 — Auto Backup Settings"
                   Style="{StaticResource WindowSectionHeaderFirst}"
                   FontSize="16"
                   Margin="0,0,0,12"/>

        <!-- Settings card -->
        <Border Grid.Row="1" Style="{StaticResource WindowCard}" Padding="18,16">
            <StackPanel>
                <!-- Enabled -->
                <CheckBox Content="자동 백업 활성화"
                          IsChecked="{Binding Enabled}"
                          Style="{StaticResource WindowDarkCheckBox}"
                          FontSize="13"
                          Margin="0,0,0,18"/>

                <!-- Interval -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="백업 주기 (시간)"
                               Style="{StaticResource WindowFieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding IntervalHours}"
                             Style="{StaticResource WindowDarkTextBox}"/>
                    <TextBlock Grid.Column="2" Text="[1, 720]"
                               Style="{StaticResource WindowMutedText}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- Retention -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="보존 기간 (일)"
                               Style="{StaticResource WindowFieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding RetentionDays}"
                             Style="{StaticResource WindowDarkTextBox}"/>
                    <TextBlock Grid.Column="2" Text="[1, 365]"
                               Style="{StaticResource WindowMutedText}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- Backup dir -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="백업 위치"
                               Style="{StaticResource WindowFieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding BackupDir}"
                             Style="{StaticResource WindowDarkTextBox}"
                             ToolTip="비워두면 %LocalAppData%\BODA VISION AI\backups"/>
                    <Button Grid.Column="2" Content="Browse..."
                            Command="{Binding PickBackupDirCommand}"
                            Style="{StaticResource ModernGhostButton}"
                            Margin="10,0,0,0"/>
                </Grid>

                <!-- IncludeAudit -->
                <CheckBox Content="감사 로그 (audit/) 포함"
                          IsChecked="{Binding IncludeAudit}"
                          Style="{StaticResource WindowDarkCheckBox}"
                          Margin="0,8,0,14"
                          ToolTip="활성화하면 매 백업 크기가 증가합니다 — 감사 보존이 별도 정책으로 관리되므로 보통 끕니다."/>

                <!-- Product version -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ProductVersion (manifest)"
                               Style="{StaticResource WindowFieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding ProductVersion}"
                             Style="{StaticResource WindowDarkTextBox}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" Style="{StaticResource WindowSurface}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2" Width="6"
                        Background="{Binding StatusColor}" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           Style="{StaticResource WindowBodyText}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reload" Command="{Binding LoadCommand}"
                    Style="{StaticResource ModernSecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}"
                    Style="{StaticResource ModernPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
