<Window x:Class="VMS.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Border Background="{StaticResource Brush.Surface.Raised}"
            BorderBrush="{StaticResource Brush.Surface.Divider}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Md}"
            Margin="16"
            Effect="{StaticResource Elevation.Dialog}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: icon + title -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">
                <TextBlock x:Name="IconText"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="28"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource Text.Title}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Body message — 긴 메시지도 자동 줄바꿈 -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,24"/>

            <!-- Footer buttons — 우측 정렬, Primary 가 가장 오른쪽 -->
            <StackPanel x:Name="ButtonPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton"
                        Content="아니오"
                        Style="{StaticResource Button.Subtle}"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Click="OnSecondaryClick"
                        Visibility="Collapsed"
                        IsCancel="True"/>
                <Button x:Name="PrimaryButton"
                        Content="확인"
                        Style="{StaticResource ModernButton}"
                        MinWidth="90"
                        Click="OnPrimaryClick"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
