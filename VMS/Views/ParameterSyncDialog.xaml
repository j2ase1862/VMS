<Window x:Class="VMS.Views.ParameterSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspection Parameters"
        Width="750" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface.Base}"
        ResizeMode="CanResize">
    <!--
        Resources 의 명시 Style override(AccentButton / SubtleButton / RecipeComboBox)
        제거 — 디폴트 ModernButton / Button.Subtle / ComboBox 자동 적용으로 indigo
        다크 톤 통일. DataGrid 내부 ColumnHeader/Cell/Row 도 디폴트 사용.
    -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Inspection Parameters"
                       Style="{StaticResource Text.Title}"/>
            <TextBlock x:Name="txtSyncStatus"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface.Raised}"
                CornerRadius="{StaticResource Radius.Md}"
                Padding="12,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Recipe"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontSize="{StaticResource Font.Size.Body}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="cboRecipes"
                          Width="240"
                          DisplayMemberPath="Name"
                          SelectionChanged="CboRecipes_SelectionChanged"/>
                <Button x:Name="btnSync" Content="Sync"
                        Click="BtnSync_Click"
                        Style="{StaticResource ModernButton}"
                        Margin="10,0,0,0"
                        MinWidth="70"/>
                <TextBlock x:Name="txtItemCount"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{StaticResource Brush.Text.Tertiary}"/>
            </StackPanel>
        </Border>

        <!-- Parameter DataGrid — 디폴트 indigo DataGrid 스타일 자동 적용 -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface.Raised}"
                BorderBrush="{StaticResource Brush.Surface.Divider}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Md}"
                ClipToBounds="True">
            <DataGrid x:Name="dgParameters"
                      Background="Transparent"
                      BorderThickness="0"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code"        Binding="{Binding ParamCode}" Width="80"/>
                    <DataGridTextColumn Header="Value"       Binding="{Binding ParamValue, StringFormat=F4}" Width="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Category"    Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Unit"        Binding="{Binding Unit}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="BtnClose_Click"
                    Style="{StaticResource Button.Subtle}"
                    MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
