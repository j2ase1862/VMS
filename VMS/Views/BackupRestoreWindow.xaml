<Window x:Class="VMS.Views.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="백업 / 복원 — Backup / Restore"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="백업 / 복원 — Backup / Restore"
                   Foreground="#2196F3" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Backup card -->
        <Border Grid.Row="1" Background="#2D2D2D" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="백업 생성"
                           Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Content="감사 로그 (audit/) 포함"
                              IsChecked="{Binding IncludeAudit}"
                              Foreground="#E0E0E0"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ProductVersion" Foreground="#B0B0B0"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ProductVersion}" Width="100"
                                 Background="#1E1E1E" Foreground="#E0E0E0"
                                 BorderBrush="#555" Padding="6,2"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="3" Padding="8,3" MinWidth="60">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{Binding BackupStatusColor}"/>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BackupStatus}"
                                   Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding LastBackupSummary}"
                               Foreground="#B0B0B0" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Content="Run Backup..."
                            Command="{Binding RunBackupCommand}"
                            Padding="14,6" Background="#1976D2" Foreground="White"
                            BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Restore card -->
        <Border Grid.Row="2" Background="#2D2D2D" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="백업 복원"
                           Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding RestoreFilePath}"
                             IsReadOnly="True"
                             Background="#1E1E1E" Foreground="#E0E0E0"
                             BorderBrush="#555" Padding="6,4" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse..."
                            Command="{Binding PickRestoreFileCommand}"
                            Padding="14,6" Background="#424242" Foreground="White"
                            BorderThickness="0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="기존 파일 덮어쓰기 (Overwrite)"
                              IsChecked="{Binding Overwrite}"
                              Foreground="#E0E0E0" Margin="0,0,16,0"/>
                    <CheckBox Content="감사 로그도 복원 (Restore Audit)"
                              IsChecked="{Binding RestoreAudit}"
                              Foreground="#E0E0E0"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="3" Padding="8,3" MinWidth="60">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{Binding RestoreStatusColor}"/>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RestoreStatus}"
                                   Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding LastRestoreSummary}"
                               Foreground="#B0B0B0" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Content="Run Restore"
                            Command="{Binding RunRestoreCommand}"
                            Padding="14,6" Background="#1976D2" Foreground="White"
                            BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Manifest summary -->
        <Border Grid.Row="3" Background="#2D2D2D" CornerRadius="6" Padding="14">
            <StackPanel>
                <TextBlock Text="복원된 백업 manifest"
                           Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{Binding ManifestSummary}"
                           Foreground="#B0B0B0" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Foreground="#707070" FontSize="11" Margin="0,12,0,0"
                   TextWrapping="Wrap">
            <Run Text="모든 작업은 AuditCategory.Configuration / BackupCreated / BackupRestored 이벤트로 기록됩니다. 복원 후에는 VMS 재시작을 권장합니다."/>
        </TextBlock>
    </Grid>
</Window>
