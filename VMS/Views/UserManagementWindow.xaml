<Window x:Class="VMS.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:VMS.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common;assembly=VMS.VisionSetup"
        Title="User Management"
        Width="880" Height="720"
        MinWidth="760" MinHeight="560"
        Style="{x:Null}"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface.Base}"
        ResizeMode="CanResizeWithGrip">

    <!-- 다른 관리 창과 같은 어두운 제목줄 — 종전 OS 제목 표시줄은 모양이 달랐다 (VM-25).
         기본 크기는 Last Login 칸과 오른쪽 버튼 · 결과 안내가 스크롤 없이 보이게 키웠다. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <c:ChromelessTitleBar Grid.Row="0" TitleText="사용자 관리 — User Management"/>

    <Grid Grid.Row="1" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- User List -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Surface.Raised}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Users"
                           FontWeight="SemiBold" Foreground="#2196F3"
                           FontSize="16" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="{StaticResource Brush.Surface.Raised}"
                          Foreground="White"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#3D3D3D"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          RowBackground="{StaticResource Brush.Surface.Raised}"
                          AlternatingRowBackground="{StaticResource Brush.Surface.Overlay}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#3D3D3D"/>
                            <Setter Property="Foreground" Value="#B0B0B0"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="100"/>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="120"/>
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="80"/>
                        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right Panel: Add / Edit -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Add New User Section -->
                <Border Background="{StaticResource Brush.Surface.Raised}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Add New User"
                                   FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Username" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource Brush.Surface.Overlay}" Foreground="White" BorderBrush="#3D3D3D"
                                 Padding="6,4" Margin="0,0,0,6" CaretBrush="White"/>

                        <TextBlock Text="Display Name" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource Brush.Surface.Overlay}" Foreground="White" BorderBrush="#3D3D3D"
                                 Padding="6,4" Margin="0,0,0,6" CaretBrush="White"/>

                        <TextBlock Text="Password" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Background="{StaticResource Brush.Surface.Overlay}" Foreground="White" BorderBrush="#3D3D3D"
                                     Padding="6,4" Margin="0,0,0,6" CaretBrush="White"/>

                        <TextBlock Text="Grade" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding GradeValues}"
                                  SelectedItem="{Binding NewGrade}"
                                  Background="White" Foreground="Black" BorderBrush="#3D3D3D"
                                  Padding="6,4" Margin="0,0,0,8"/>

                        <Button Content="Add User"
                                Command="{Binding AddUserCommand}"
                                Click="AddUser_Click"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource Brush.Success}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Edit Selected User Section -->
                <Border Background="{StaticResource Brush.Surface.Raised}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Edit Selected User"
                                   FontWeight="SemiBold" Foreground="{StaticResource Brush.Warning}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Display Name" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedUser.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource Brush.Surface.Overlay}" Foreground="White" BorderBrush="#3D3D3D"
                                 Padding="6,4" Margin="0,0,0,6" CaretBrush="White"
                                 IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <TextBlock Text="Grade" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding GradeValues}"
                                  SelectedItem="{Binding SelectedUser.Grade}"
                                  Background="White" Foreground="Black" BorderBrush="#3D3D3D"
                                  Padding="6,4" Margin="0,0,0,8"
                                  IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <Button Content="Save Changes"
                                Command="{Binding SaveUserCommand}"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource Brush.Warning}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"/>

                        <!-- Change Password -->
                        <TextBlock Text="New Password" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,8,0,2"/>
                        <PasswordBox x:Name="ChangePasswordBox"
                                     Background="{StaticResource Brush.Surface.Overlay}" Foreground="White" BorderBrush="#3D3D3D"
                                     Padding="6,4" Margin="0,0,0,6" CaretBrush="White"/>

                        <Button Content="Change Password"
                                Command="{Binding ChangePasswordCommand}"
                                Click="ChangePassword_Click"
                                Style="{StaticResource ModernButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"/>

                        <!-- Delete -->
                        <Button Content="Delete User"
                                Command="{Binding DeleteUserCommand}"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource Brush.Danger}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
    </Border>
</Window>
