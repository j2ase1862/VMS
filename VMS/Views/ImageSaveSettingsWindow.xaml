<Window x:Class="VMS.Views.ImageSaveSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common;assembly=VMS.VisionSetup"
        Title="Inspection Image Save Settings"
        Width="720" Height="840"
        MinWidth="640" MinHeight="600"
        Style="{x:Null}"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="검사 이미지 저장 — Image Save Settings"
                                  ShowMinMaxButtons="False"/>

            <Grid Grid.Row="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- 저장 경로 -->
                        <Border Style="{StaticResource WindowCard}" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="저장" Style="{StaticResource WindowSectionHeaderFirst}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                                    <CheckBox Content="양품(OK) 이미지 저장"
                                              IsChecked="{Binding SaveOkImages}"
                                              Style="{StaticResource WindowDarkCheckBox}"
                                              FontSize="13" Margin="0,0,24,0"/>
                                    <CheckBox Content="불량(NG) 이미지 저장"
                                              IsChecked="{Binding SaveNgImages}"
                                              Style="{StaticResource WindowDarkCheckBox}"
                                              FontSize="13"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="저장 경로"
                                               Style="{StaticResource WindowFieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding BaseDir, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}"
                                             ToolTip="이미지 저장 루트 폴더"/>
                                    <Button Grid.Column="2" Content="Browse..."
                                            Command="{Binding PickBaseDirCommand}"
                                            Style="{StaticResource ModernGhostButton}"
                                            Margin="10,0,0,0"/>
                                </Grid>

                                <TextBlock Style="{StaticResource WindowMutedText}" TextWrapping="Wrap">
                                    <Run Text="저장 경로 아래에 "/>
                                    <Run FontWeight="SemiBold" Text="{}{연월일}\{OK|NG}"/>
                                    <Run Text=" 폴더가 자동 생성되어 이미지가 분류 저장됩니다. (예: …\2026-06-11\OK\)"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 포맷 / 품질 -->
                        <Border Style="{StaticResource WindowCard}" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="포맷 / 품질" Style="{StaticResource WindowSectionHeaderFirst}"/>

                                <Grid Margin="0,10,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="파일 포맷"
                                               Style="{StaticResource WindowFieldLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableFormats}"
                                              SelectedItem="{Binding SelectedFormat}"
                                              Style="{StaticResource WindowDarkComboBox}"
                                              HorizontalAlignment="Left" MinWidth="160"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="JPEG 품질"
                                               Style="{StaticResource WindowFieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding JpegQuality}"
                                             Style="{StaticResource WindowDarkTextBox}"
                                             ToolTip="JPEG 포맷에서만 적용 — 값이 클수록 고화질/큰 용량"/>
                                    <TextBlock Grid.Column="2" Text="[1, 100] (JPEG 전용)"
                                               Style="{StaticResource WindowMutedText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 파일명 규칙 -->
                        <Border Style="{StaticResource WindowCard}" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="파일명 규칙" Style="{StaticResource WindowSectionHeaderFirst}"/>
                                <TextBlock Style="{StaticResource WindowMutedText}" Margin="0,4,0,10" TextWrapping="Wrap"
                                           Text="체크한 토큰을 위에서부터 순서대로 구분자로 연결합니다. ▲▼ 로 순서를 바꾸세요. 값이 없는 토큰(미선택 WO/Lot 등)은 자동으로 생략됩니다. 확장자는 항상 맨 끝에 붙습니다."/>

                                <ItemsControl ItemsSource="{Binding Tokens}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushBgInput}"
                                                    CornerRadius="4" Margin="0,3" Padding="10,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              Content="{Binding DisplayName}"
                                                              IsChecked="{Binding Enabled}"
                                                              Style="{StaticResource WindowDarkCheckBox}"
                                                              VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.MoveTokenUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ModernGhostButton}"
                                                            Padding="8,2" Margin="0,0,4,0"
                                                            ToolTip="위로">
                                                        <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.MoveTokenDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ModernGhostButton}"
                                                            Padding="8,2"
                                                            ToolTip="아래로">
                                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="구분자"
                                               Style="{StaticResource WindowFieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource WindowDarkTextBox}"
                                             MaxLength="4"
                                             ToolTip="토큰 사이 구분자 (기본 _)"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 미리보기 -->
                        <Border Style="{StaticResource WindowCard}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="예시" Style="{StaticResource WindowSectionHeaderFirst}"/>
                                <TextBlock Text="파일명" Style="{StaticResource WindowFieldLabel}" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding PreviewFileName}"
                                           Style="{StaticResource WindowMonospace}"
                                           Foreground="{StaticResource BrushTextAccent}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="전체 경로" Style="{StaticResource WindowFieldLabel}" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding PreviewPath}"
                                           Style="{StaticResource WindowMonospace}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status -->
                <Border Grid.Row="1" Style="{StaticResource WindowSurface}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="2" Width="6"
                                Background="{Binding StatusColor}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                                   Style="{StaticResource WindowBodyText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Reload" Command="{Binding LoadCommand}"
                            Style="{StaticResource ModernSecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Close" Click="CloseButton_Click"
                            Style="{StaticResource ModernGhostButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource ModernPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
