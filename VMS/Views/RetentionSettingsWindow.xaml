<Window x:Class="VMS.Views.RetentionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common;assembly=VMS.VisionSetup"
        Title="Retention Settings"
        Width="760" Height="780"
        MinWidth="680" MinHeight="540"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0" TitleText="보존 정책 — Retention Settings"/>

            <Grid Grid.Row="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Intro -->
                <Border Grid.Row="0" Style="{StaticResource WindowSurface}" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource WindowBodyText}" TextWrapping="Wrap">
                        <Run Text="전역 보존 (Audit / AutoBackup / UploadQueue) 과 카테고리별 차등 보존 (9 audit 카테고리) 을 한 화면에서 편집합니다. 다른 system_config.json 키는 보존됩니다. 변경은 "/>
                        <Run FontWeight="SemiBold" Text="VMS 재시작 후 적용"/>
                        <Run Text="됩니다."/>
                    </TextBlock>
                </Border>

                <!-- Settings — ScrollViewer 로 카테고리 추가 시도 안전 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 빠른 프리셋 -->
                        <Border Style="{StaticResource WindowSurface}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="빠른 프리셋"
                                           Style="{StaticResource WindowFieldLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource WindowMutedText}"
                                           VerticalAlignment="Center" Margin="12,0,12,0"
                                           TextWrapping="Wrap">
                                    <Run Text="Conservative: 규제/컴플라이언스 사이트 · Standard: GS 권장 기본 · Minimal: 소형/디스크 제한 사이트. 적용 후 Save 를 눌러야 디스크에 기록됩니다."/>
                                </TextBlock>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Conservative"
                                            Command="{Binding ApplyPresetCommand}"
                                            CommandParameter="Conservative"
                                            Style="{StaticResource ModernGhostButton}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Standard"
                                            Command="{Binding ApplyPresetCommand}"
                                            CommandParameter="Standard"
                                            Style="{StaticResource ModernGhostButton}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Minimal"
                                            Command="{Binding ApplyPresetCommand}"
                                            CommandParameter="Minimal"
                                            Style="{StaticResource ModernGhostButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 전역 3종 -->
                        <Border Style="{StaticResource WindowCard}" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="전역 보존 (일)" Style="{StaticResource WindowSectionHeaderFirst}"/>

                                <Grid Margin="0,8,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="감사 로그 (audit/)"
                                               Style="{StaticResource WindowFieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding AuditRetentionDays}"
                                             Style="{StaticResource WindowDarkTextBox}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AuditRange}"
                                               Style="{StaticResource WindowMutedText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="자동 백업 (backups/)"
                                               Style="{StaticResource WindowFieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding AutoBackupRetentionDays}"
                                             Style="{StaticResource WindowDarkTextBox}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AutoBackupRange}"
                                               Style="{StaticResource WindowMutedText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="업로드 큐 (upload_queue/)"
                                               Style="{StaticResource WindowFieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding UploadQueueRetentionDays}"
                                             Style="{StaticResource WindowDarkTextBox}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding UploadQueueRange}"
                                               Style="{StaticResource WindowMutedText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 카테고리별 차등 -->
                        <Border Style="{StaticResource WindowCard}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="카테고리별 차등 보존 (일)" Style="{StaticResource WindowSectionHeaderFirst}"/>
                                <TextBlock Style="{StaticResource WindowMutedText}" Margin="0,4,0,8" TextWrapping="Wrap">
                                    <Run Text="전역 정리 후 남은 jsonl 의 라인을 카테고리별 보존 기간 기준으로 재필터합니다 (PR39). 기본값은 GS 권장 — 보안/사용자/설정 1095일, 인증/권한/레시피 730일, 시퀀스/검사 365일, 시스템 90일."/>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding CategoryRetentions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                           Style="{StaticResource WindowMutedText}"
                                                           VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding Days}"
                                                         Style="{StaticResource WindowDarkTextBox}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Range}"
                                                           Style="{StaticResource WindowMutedText}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status -->
                <Border Grid.Row="2" Style="{StaticResource WindowSurface}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="2" Width="6"
                                Background="{Binding StatusColor}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                                   Style="{StaticResource WindowBodyText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Reload" Command="{Binding LoadCommand}"
                            Style="{StaticResource ModernSecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource ModernPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
