<Window x:Class="VMS.Views.HealthCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:health="clr-namespace:VMS.Core.Health;assembly=VMS.Core"
        Title="시작 헬스 체크 — Startup Health Check"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- 상태별 전경색 — Pass/Warn/Fail/기타 -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#9E9E9E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static health:HealthCheckStatus.Pass}">
                    <Setter Property="Background" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static health:HealthCheckStatus.Warn}">
                    <Setter Property="Background" Value="#FF9800"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static health:HealthCheckStatus.Fail}">
                    <Setter Property="Background" Value="#F44336"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="시작 헬스 체크 — Startup Health Check"
                   Foreground="#2196F3" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Summary card -->
        <Border Grid.Row="1" Background="#2D2D2D" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Overall" Foreground="#B0B0B0" FontSize="11"/>
                    <Border CornerRadius="4" Padding="10,4" Margin="0,4,0,0" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#9E9E9E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverallStatus}" Value="Pass">
                                        <Setter Property="Background" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallStatus}" Value="Warn">
                                        <Setter Property="Background" Value="#FF9800"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallStatus}" Value="Fail">
                                        <Setter Property="Background" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding OverallStatus}"
                                   Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryLine}" Foreground="#E0E0E0" FontSize="13"/>
                    <TextBlock Foreground="#909090" FontSize="11" Margin="0,2,0,0">
                        <Run Text="Last run: "/>
                        <Run Text="{Binding LastRunAt, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Padding="14,6" Margin="0,0,8,0"
                            Background="#1976D2" Foreground="White" BorderThickness="0"/>
                    <Button Content="Copy" Command="{Binding CopyToClipboardCommand}"
                            Padding="14,6"
                            Background="#424242" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Items list -->
        <Border Grid.Row="2" Background="#2D2D2D" CornerRadius="6" Padding="8">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E1E" CornerRadius="4"
                                Padding="10,8" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status badge -->
                                <Border Grid.Column="0" Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Name -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="#E0E0E0" FontSize="13"
                                           VerticalAlignment="Center" Margin="12,0,12,0"/>

                                <!-- Message -->
                                <TextBlock Grid.Column="2" Text="{Binding Message}"
                                           Foreground="#B0B0B0" FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Foreground="#707070" FontSize="11" Margin="0,12,0,0">
            <Run Text="결과는 자동으로 AuditCategory.System / StartupHealthCheck 이벤트에 기록됩니다."/>
        </TextBlock>
    </Grid>
</Window>
