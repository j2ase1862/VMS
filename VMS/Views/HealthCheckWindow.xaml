<Window x:Class="VMS.Views.HealthCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:health="clr-namespace:VMS.Core.Health;assembly=VMS.Core"
        Title="시작 헬스 체크 — Startup Health Check"
        Width="760" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        ResizeMode="CanResizeWithGrip"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 상태별 뱃지 색 — Pass/Warn/Fail/기타 -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource BrushNeutral}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static health:HealthCheckStatus.Pass}">
                    <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static health:HealthCheckStatus.Warn}">
                    <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static health:HealthCheckStatus.Fail}">
                    <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="시작 헬스 체크 — Startup Health Check"
                   Style="{StaticResource WindowSectionHeaderFirst}"
                   FontSize="16"
                   Margin="0,0,0,12"/>

        <!-- Summary card -->
        <Border Grid.Row="1" Style="{StaticResource WindowCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="OVERALL" Style="{StaticResource WindowFieldLabel}" Margin="0,0,0,4"/>
                    <Border CornerRadius="4" Padding="12,5" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource BrushNeutral}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverallStatus}" Value="Pass">
                                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallStatus}" Value="Warn">
                                        <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallStatus}" Value="Fail">
                                        <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding OverallStatus}"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="22,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryLine}" Style="{StaticResource WindowBodyText}"/>
                    <TextBlock Style="{StaticResource WindowMutedText}" Margin="0,2,0,0">
                        <Run Text="Last run: "/>
                        <Run Text="{Binding LastRunAt, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ModernPrimaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Copy" Command="{Binding CopyToClipboardCommand}"
                            Style="{StaticResource ModernSecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Items list -->
        <Border Grid.Row="2" Style="{StaticResource WindowCard}" Padding="8">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource WindowSurface}" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status badge -->
                                <Border Grid.Column="0" Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Name -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="{StaticResource BrushTextPrimary}" FontSize="12"
                                           VerticalAlignment="Center" Margin="12,0,12,0"/>

                                <!-- Message -->
                                <TextBlock Grid.Column="2" Text="{Binding Message}"
                                           Style="{StaticResource WindowBodyText}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Style="{StaticResource WindowMutedText}" Margin="0,12,0,0">
            <Run Text="결과는 자동으로 AuditCategory.System / StartupHealthCheck 이벤트에 기록됩니다."/>
        </TextBlock>
    </Grid>
</Window>
