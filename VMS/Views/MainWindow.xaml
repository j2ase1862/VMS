<Window x:Class="VMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:VMS.Controls"
        xmlns:vs="clr-namespace:VMS.VisionSetup.Controls;assembly=VMS.VisionSetup"
        Title="{Binding ApplicationTitle}"
        WindowState="Maximized"
        Background="{StaticResource Brush.Surface.Base}"
        Style="{x:Null}"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
        PR #88 의 default Window chrome 을 opt-out (Style=null) — 메인 윈도우는
        기존 48px 헤더 안에 시스템 컨트롤(최소화/최대화/닫기) 을 통합하여 한 줄로
        통일된 인상. CaptionHeight=0 + 헤더 Border MouseLeftButtonDown 핸들러로
        드래그/더블클릭 max 토글 직접 처리.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Panel animation -->
        <Storyboard x:Key="OpenPanel">
            <DoubleAnimation Storyboard.TargetName="SidePanel"
                             Storyboard.TargetProperty="Width"
                             To="320" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ClosePanel">
            <DoubleAnimation Storyboard.TargetName="SidePanel"
                             Storyboard.TargetProperty="Width"
                             To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="ToggleButton.Checked" SourceName="PanelToggle">
            <BeginStoryboard Storyboard="{StaticResource OpenPanel}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ToggleButton.Unchecked" SourceName="PanelToggle">
            <BeginStoryboard Storyboard="{StaticResource ClosePanel}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 0: Header Bar + User Info (시스템 컨트롤 통합 — chromeless drag) -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface.Raised}"
                MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                Cursor="Arrow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- AUTO RUN/STOP 전용 고정 열 — chips(col 1)가 좁은 해상도에서
                         넘쳐도 Primary 액션은 절대 잘리지 않도록 분리 -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0">
                    <Border Background="White" CornerRadius="1" Padding="6,2"
                            VerticalAlignment="Center">
                        <Image Source="/icon/ci_img2.png"
                               Height="24"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="{Binding ApplicationTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Center: 운영 흐름 (Operator → Work Order → AUTO RUN) -->
                <!-- Grab/Live/Roller 는 Settings 사이드 패널의 Camera Control 섹션으로 이동 -->
                <!-- Recipe 표시는 사이드 패널 Recipe 섹션에 있음 — 헤더에서 제거 -->
                <!-- chips 폭이 상태(로그인/WO 선택)에 따라 늘어나므로, 좁은 해상도에서는
                     잘라내는 대신 가로 스크롤 허용 — Ctx 의 S/N 입력(바코드)까지 항상 접근 가능. -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <!-- 48px 헤더 안에서 콘텐츠(34px)를 가리지 않도록 슬림 스크롤바 -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Height" Value="8"/>
                        </Style>
                    </ScrollViewer.Resources>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <!-- ═══ Stage 1: 작업자 chip (Web 인증 — VMS LoginWindow의 시스템 사용자와 별개) ═══ -->
                    <Border Background="{StaticResource Brush.Surface.Overlay}" CornerRadius="4" Padding="10,0" Height="32"
                            BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Operator:" Foreground="{StaticResource Brush.Accent}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Login..." Command="{Binding LoginOperatorCommand}"
                                    Height="22" Padding="10,0" FontSize="11"
                                    Background="{StaticResource Brush.Accent}" Foreground="White" BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" ToolTip="Web에 등록된 작업자(사번+PIN)로 로그인">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOperatorLoggedIn}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOperatorLoggedIn}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding CurrentOperatorName, Mode=OneWay}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding CurrentOperatorEmployeeNumber, Mode=OneWay}"
                                         Foreground="{StaticResource Brush.Text.Secondary}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <!-- D10: Role 뱃지 — Lead/Supervisor 일 때만 표시 -->
                                <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentOperatorRole}" Value="Lead">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentOperatorRole}" Value="Supervisor">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CurrentOperatorRole}"
                                               Foreground="White" FontSize="9" FontWeight="Bold"/>
                                </Border>
                                <Button Content="Logout" Command="{Binding LogoutOperatorCommand}"
                                        Margin="10,0,0,0" Height="22" Padding="8,0" FontSize="10"
                                        Background="Transparent" Foreground="{StaticResource Brush.Text.Secondary}"
                                        BorderBrush="{StaticResource Brush.Surface.Divider}" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Work Orders 버튼 (로그인 후만 활성) -->
                    <Button Command="{Binding OpenWorkOrderListCommand}"
                            AutomationProperties.Name="Work Orders"
                            Margin="6,0,0,0" Height="32" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold"
                            Background="{StaticResource Brush.Surface.Deep}" Foreground="{StaticResource Brush.Accent}"
                            BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1"
                            Cursor="Hand" VerticalAlignment="Center"
                            ToolTip="작업 지시 목록 — 로그인 후 활성">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Work Orders" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 선택된 작업지시 표시 — 텍스트 + 진행률 ProgressBar (B4) -->
                    <Border Background="{StaticResource Brush.Surface.Deep}" CornerRadius="4" Padding="10,0" Margin="6,0,0,0" Height="32"
                            BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="현재 선택된 작업지시 — 진행률 실시간">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WO:" Foreground="{StaticResource Brush.Accent}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SelectedWorkOrderText}"
                                       Foreground="White" FontSize="11"
                                       VerticalAlignment="Center"/>

                            <!-- 진행률 ProgressBar — 얇은 가로 (B4) -->
                            <ProgressBar Width="80" Height="6"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding SelectedWorkOrderProgressPercent, Mode=OneWay}"
                                         Margin="10,0,0,0" VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Visibility="{Binding HasSelectedWorkOrderProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border CornerRadius="3" Background="{StaticResource Brush.Surface.Deep}">
                                            <Grid HorizontalAlignment="Stretch" ClipToBounds="True">
                                                <Border x:Name="PART_Track"/>
                                                <Border x:Name="PART_Indicator"
                                                        HorizontalAlignment="Left"
                                                        Background="{StaticResource Brush.Accent}"
                                                        CornerRadius="3"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </StackPanel>
                    </Border>

                    <!-- 현재 로드된 Recipe 표시 (WO 선택 시 자동 로드 결과) -->
                    <Border Background="{StaticResource Brush.Surface.Deep}" CornerRadius="4" Padding="10,0" Margin="6,0,0,0" Height="32"
                            BorderBrush="{StaticResource Brush.Primary}" BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="{Binding CurrentRecipe, Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="현재 로드된 레시피 — 작업지시 선택 시 자동 로드">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Recipe:" Foreground="{StaticResource Brush.Primary}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentRecipeName}"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Phase 3: Inspection Context (Web 업로드 시 자동 첨부) ═══ -->
                    <Border Background="{StaticResource Brush.Surface.Overlay}" CornerRadius="4" Padding="10,0" Margin="6,0,0,0" Height="32"
                            VerticalAlignment="Center"
                            ToolTip="검사 결과 업로드 시 자동 첨부 (WO/Lot/Op ID + Serial)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctx:" Foreground="{StaticResource Brush.Accent}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="WO" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBox Text="{Binding WorkOrderIdText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="50" Height="22" FontSize="11"
                                     Background="{StaticResource Brush.Surface.Deep}" Foreground="White" BorderBrush="#555"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="WorkOrder ID (정수)"/>
                            <TextBlock Text="Lot" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" VerticalAlignment="Center" Margin="6,0,3,0"/>
                            <TextBox Text="{Binding LotIdText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="50" Height="22" FontSize="11"
                                     Background="{StaticResource Brush.Surface.Deep}" Foreground="White" BorderBrush="#555"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="Lot ID (정수)"/>
                            <TextBlock Text="S/N" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" VerticalAlignment="Center" Margin="6,0,3,0"/>
                            <TextBox Text="{Binding SerialNumberText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" Height="22" FontSize="11"
                                     Background="{StaticResource Brush.Surface.Deep}" Foreground="White" BorderBrush="#555"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="제품 시리얼 (바코드 스캐너 OK)"/>
                            <Button Content="✕" Command="{Binding ClearInspectionContextCommand}"
                                    Margin="6,0,0,0" Height="22" Padding="6,0" FontSize="10"
                                    Background="Transparent" Foreground="{StaticResource Brush.Text.Secondary}"
                                    BorderBrush="#555" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" ToolTip="모든 컨텍스트 필드 비우기"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Plan §5.3 V5: 예측 NG율 위젯 (60초 폴링) ═══ -->
                    <!-- 임계 색상: < 5% Green / < 10% Orange / ≥ 10% Red / non-ok Gray -->
                    <Border Background="{StaticResource Brush.Surface.Overlay}" CornerRadius="4" Padding="10,0" Margin="6,0,0,0" Height="32"
                            BorderBrush="{Binding PredictionAccentBrush}" BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="{Binding PredictionTooltip}"
                            Visibility="{Binding CurrentPrediction, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{Binding PredictionAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="다음 1시간:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding PredictionDisplayText}"
                                       Foreground="{Binding PredictionAccentBrush}"
                                       FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                <!-- ═══ AUTO RUN — 운영 흐름의 단일 Primary 액션 ═══ -->
                <!-- chips StackPanel 밖 고정 열(col 2) — 어떤 해상도에서도 항상 표시 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">

                    <Button Command="{Binding StartInspectionCommand}"
                            IsEnabled="{Binding CanStartStop}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                            Background="{StaticResource Brush.Accent}" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Padding="20,0" Margin="0,0,6,0" Height="34"
                            VerticalAlignment="Center"
                            FontSize="13" FontWeight="Bold"
                            ToolTip="검사 시작 — 카메라 연결 + 작업자 로그인 + 작업지시 선택 후 활성"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="{StaticResource Brush.Surface.Overlay}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="AUTO RUN" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopInspectionCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{StaticResource Brush.Danger}" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Padding="20,0" Margin="0,0,6,0" Height="34"
                            VerticalAlignment="Center"
                            FontSize="13" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="STOP" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- User Info (clickable for user switch) -->
                <Border Grid.Column="3" Background="{StaticResource Brush.Surface.Overlay}" CornerRadius="4"
                        Padding="10,0" Margin="0,0,8,0" Height="32"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Visibility="{Binding CurrentUserDisplay, Converter={StaticResource NullToVisibilityConverter}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding SwitchUserCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{Binding CurrentUserGrade, Converter={StaticResource UserGradeToColorConverter}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentUserDisplay}"
                                   Foreground="White"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right: Toolbar buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,8,0">
                    <!-- User Management (Admin only) -->
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding OpenUserManagementCommand}"
                            AutomationProperties.Name="User Management"
                            IsEnabled="{Binding CanManageUsers}"
                            ToolTip="User Management"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="&#xE748;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>

                    <!-- Admin Tools 통합 드롭다운 (Admin only) — 5개 진단/관리 도구를 하나의 메뉴로.
                         아이콘 E712 (More, 수직 3점) — Settings Panel 기어(E713)와 시각 구분 + dropdown trigger 표준. -->
                    <Button x:Name="AdminToolsButton"
                            Style="{StaticResource IconButton}"
                            Click="AdminToolsButton_Click"
                            IsEnabled="{Binding CanManageUsers}"
                            ToolTip="Admin Tools (감사 / 헬스 / 백업 / 자동백업 / 지원 패키지)"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="&#xE712;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                        <Button.ContextMenu>
                            <ContextMenu Background="{StaticResource Brush.Surface.Raised}"
                                         BorderBrush="{StaticResource Brush.Surface.Divider}" BorderThickness="1"
                                         Foreground="{StaticResource Brush.Text.Primary}"
                                         Placement="Bottom">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Audit Log Viewer"
                                          Command="{Binding OpenAuditLogViewerCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Health Check"
                                          Command="{Binding OpenHealthCheckCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Backup / Restore"
                                          Command="{Binding OpenBackupRestoreCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Auto Backup Settings"
                                          Command="{Binding OpenAutoBackupSettingsCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Retention Settings..."
                                          Command="{Binding OpenRetentionSettingsCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Support Package..."
                                          Command="{Binding OpenSupportPackageCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding SaveLayoutCommand}"
                            ToolTip="Save Layout">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>

                    <ToggleButton x:Name="PanelToggle"
                                  IsChecked="{Binding IsSidePanelOpen, Mode=TwoWay}"
                                  Style="{StaticResource IconToggleButton}"
                                  ToolTip="Settings Panel"
                                  Margin="4,0">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </ToggleButton>

                    <Rectangle Width="1" Fill="{StaticResource Brush.Surface.Overlay}" Margin="8,8"/>

                    <!-- 윈도우 컨트롤 (최소화 / 최대화 토글 / 닫기) — Windows 표준 순서.
                         Segoe MDL2 표준 글리프(ChromeMinimize/Maximize/Restore/Close) +
                         IconButton 베이스로 사이드 패널 다른 IconButton 들과 톤 통일.
                         닫기는 SystemCommands 가 아닌 ExitApplicationCommand 사용 —
                         앱 정리(상태 저장, 카메라 해제 등) 후 종료. -->
                    <Button Style="{StaticResource IconButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            ToolTip="최소화">
                        <TextBlock Text="&#xE921;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaxRestoreButton_Click"
                            ToolTip="최대화/복원">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ExitApplicationCommand}"
                            ToolTip="닫기">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource Brush.Danger}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 1: Dashboard KPI Strip (always visible) -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Surface.Deep}">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TACT TIME -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Surface.Raised}" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TACT TIME" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dashboard.IsTactTimeExceeded}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding Dashboard.TactTime, StringFormat={}{0:F2}}"/><Run Text="s" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- YIELD -->
                <Border Grid.Column="1" Background="{StaticResource Brush.Surface.Raised}" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="YIELD" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dashboard.Yield, Converter={StaticResource CountToVisibilityConverter}}" Value="Collapsed">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding Dashboard.Yield, StringFormat={}{0:F1}}"/><Run Text="%" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- TOTAL -->
                <Border Grid.Column="2" Background="{StaticResource Brush.Surface.Raised}" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Dashboard.TotalCount}"
                                   FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- OK -->
                <Border Grid.Column="3" Background="{StaticResource Brush.Surface.Raised}" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="OK" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Dashboard.OkCount}"
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.Success}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- NG -->
                <Border Grid.Column="4" Background="{StaticResource Brush.Surface.Raised}" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="NG" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Dashboard.NgCount}"
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.Danger}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Reset button -->
                <Button Grid.Column="5" Style="{StaticResource IconButton}"
                        Command="{Binding ResetDashboardCommand}"
                        ToolTip="Reset Statistics"
                        VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="{StaticResource Brush.Text.Tertiary}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 2: Main Content Area + NG History Sidebar -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Camera Display Area -->
            <Canvas x:Name="CameraCanvas"
                    Grid.Column="0"
                    Background="{StaticResource Brush.Surface.Base}"
                    ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding Cameras}"
                              Width="{Binding ActualWidth, ElementName=CameraCanvas}"
                              Height="{Binding ActualHeight, ElementName=CameraCanvas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:CameraDisplayControl
                                Width="{Binding Width}"
                                Height="{Binding Height}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Alignment guide lines overlay -->
                <Canvas x:Name="AlignmentGuideCanvas"
                        IsHitTestVisible="False"
                        Width="{Binding ActualWidth, ElementName=CameraCanvas}"
                        Height="{Binding ActualHeight, ElementName=CameraCanvas}"/>
            </Canvas>

            <!-- NG Image History Sidebar (always visible) -->
            <Border Grid.Column="1" Width="120" Background="{StaticResource Brush.Surface.Deep}"
                    BorderBrush="{StaticResource Brush.Surface.Overlay}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NG History"
                               Foreground="{StaticResource Brush.Danger}" FontWeight="SemiBold"
                               FontSize="11" Margin="8,6"
                               HorizontalAlignment="Center"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Dashboard.NgImageHistory}"
                             SelectedItem="{Binding SelectedNgImage}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.Surface.Raised}" CornerRadius="4"
                                        Margin="4,2" Padding="2">
                                    <StackPanel>
                                        <Image Source="{Binding Thumbnail}"
                                               Width="100" Height="75"
                                               Stretch="Uniform"/>
                                        <TextBlock Text="{Binding CameraName}"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                   Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="8"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Sliding Side Panel -->
            <Border x:Name="SidePanel"
                    Grid.Column="2"
                    Width="0"
                    Background="{StaticResource Brush.Surface.Raised}"
                    BorderBrush="{StaticResource Brush.Surface.Overlay}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Panel Header -->
                        <TextBlock Text="Settings"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,16"/>

                        <!-- Camera Control Section — 헤더에서 옮겨온 도구 액션 -->
                        <Border Background="{StaticResource Brush.Surface.Overlay}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Primary}"
                                           Margin="0,0,0,12"><Run Text="Camera Control"/><InlineUIContainer BaselineAlignment="Center"><vs:HelpIcon CustomTitle="Camera Control" CustomDescription="카메라 수동 조작입니다. 검사(AUTO RUN)가 멈춰 있을 때 사진 한 장 촬영(Grab), 실시간 영상(Live), 롤러 검사 모드를 사용할 수 있습니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <!-- Grab (single shot) -->
                                <Button Command="{Binding GrabCommand}"
                                        AutomationProperties.Name="Grab"
                                        IsEnabled="{Binding CanStartStop}"
                                        Visibility="{Binding IsLiveMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                        Background="{StaticResource Brush.Surface.Overlay}" Foreground="White"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="단일 이미지 캡처">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource Brush.Primary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Grab"/>
                                    </StackPanel>
                                </Button>

                                <!-- Live Start -->
                                <Button Command="{Binding StartLiveCommand}"
                                        AutomationProperties.Name="Live Start"
                                        IsEnabled="{Binding CanStartStop}"
                                        Visibility="{Binding IsLiveMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                        Background="{StaticResource Brush.Surface.Overlay}" Foreground="White"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="연속 라이브 그랩 시작">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource Brush.Success}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Live Start"/>
                                    </StackPanel>
                                </Button>

                                <!-- Live Stop -->
                                <Button Command="{Binding StopLiveCommand}"
                                        AutomationProperties.Name="Live Stop"
                                        Visibility="{Binding IsLiveMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{StaticResource Brush.Surface.Overlay}" Foreground="White"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        ToolTip="라이브 영상 표시를 중지합니다">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource Brush.Warning}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Live Stop"/>
                                    </StackPanel>
                                </Button>

                                <!-- Roller Toggle -->
                                <Button Command="{Binding ToggleRollerInspectionCommand}"
                                        AutomationProperties.Name="Roller"
                                        IsEnabled="{Binding CanStartStop}"
                                        Foreground="White"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="롤러 검사 모드 토글">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Overlay}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRollerInspecting}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE8B0;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRollerInspecting}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Roller"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRollerInspecting}" Value="True">
                                                            <Setter Property="Text" Value="Roller Stop"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Recipe Section -->
                        <Border Background="{StaticResource Brush.Surface.Overlay}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Primary}"
                                           Margin="0,0,0,12"><Run Text="Recipe"/><InlineUIContainer BaselineAlignment="Center"><vs:HelpIcon CustomTitle="Recipe" CustomDescription="검사 레시피 관리입니다. 현재 레시피 확인과 불러오기·새로 만들기·저장을 합니다. 작업지시를 선택하면 레시피는 자동으로 불러와집니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <!-- Current Recipe Display -->
                                <Border Background="{StaticResource Brush.Surface.Overlay}"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentRecipeName}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentRecipe.Version, StringFormat='v{0}', FallbackValue=''}"
                                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Recipe List -->
                                <TextBlock Text="Available Recipes"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           FontSize="11"
                                           Margin="0,0,0,4"/>
                                <ListBox ItemsSource="{Binding RecipeList}"
                                         SelectedItem="{Binding SelectedRecipeInfo}"
                                         Background="{StaticResource Brush.Surface.Overlay}"
                                         BorderThickness="0"
                                         MaxHeight="120"
                                         Margin="0,0,0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,2">
                                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                <TextBlock Text="{Binding ModifiedAt, StringFormat='Modified: {0:yyyy-MM-dd}'}"
                                                           Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Recipe Buttons -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Command="{Binding LoadRecipeCommand}"
                                            AutomationProperties.Name="Load"
                                            Style="{StaticResource ModernButton}"
                                            Margin="0,0,4,0"
                                            ToolTip="목록에서 선택한 레시피를 불러옵니다">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="Load"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Command="{Binding NewRecipeCommand}"
                                            AutomationProperties.Name="New"
                                            IsEnabled="{Binding CanEditRecipe}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="4,0,0,0"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="새 레시피를 만듭니다 (레시피 편집 권한 필요)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="New"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Command="{Binding SaveCurrentRecipeCommand}"
                                            AutomationProperties.Name="Save Recipe"
                                            IsEnabled="{Binding CanEditRecipe}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="0,0,2,0"
                                            ToolTip="현재 레시피를 저장합니다 (레시피 편집 권한 필요)">
                                        <TextBlock Text="&#xE74E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Command="{Binding ExportRecipeCommand}"
                                            AutomationProperties.Name="Export Recipe"
                                            Style="{StaticResource ModernButton}"
                                            Margin="2,0,2,0"
                                            ToolTip="현재 레시피를 파일로 내보냅니다">
                                        <TextBlock Text="&#xEDE1;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Command="{Binding ImportRecipeCommand}"
                                            AutomationProperties.Name="Import Recipe"
                                            IsEnabled="{Binding CanEditRecipe}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="2,0,0,0"
                                            ToolTip="레시피 파일을 가져옵니다 (레시피 편집 권한 필요)">
                                        <TextBlock Text="&#xE8B5;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- External Tools Section — D10: Supervisor 전용 -->
                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding CanSupervisor, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionHeader}"><Run Text="External Tools"/><InlineUIContainer BaselineAlignment="Center"><vs:HelpIcon CustomTitle="External Tools" CustomDescription="엔지니어용 외부 도구입니다 — 비전 설정(Vision Tool Setup)과 시스템 설정(System Setup). Supervisor·Admin 등급에서만 보입니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <Button Command="{Binding LaunchVisionToolSetupCommand}"
                                        AutomationProperties.Name="Vision Tool Setup"
                                        IsEnabled="{Binding CanLaunchVisionSetup}"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"
                                        ToolTip="비전 설정(VMS.VisionSetup)을 실행합니다 — 비전 도구 파이프라인 구성">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7AC;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Vision Tool Setup"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding LaunchSetupCommand}"
                                        AutomationProperties.Name="System Setup"
                                        IsEnabled="{Binding CanLaunchAppSetup}"
                                        Style="{StaticResource Button.Subtle}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="시스템 설정 마법사(VMS.AppSetup)를 실행합니다 — 카메라/PLC/네트워크">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="System Setup"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Updates Section — 비차단 알림 + 수동 체크 (Phase B).
                             업데이트 가능 시 Card.Accent (warning 색 하단 border) 로 변형. -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter Property="BorderBrush"     Value="{StaticResource Brush.Warning}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionHeader}"
                                           Foreground="{StaticResource Brush.Warning}"><Run Text="Updates"/><InlineUIContainer BaselineAlignment="Center"><vs:HelpIcon CustomTitle="Updates" CustomDescription="프로그램 새 버전 확인입니다. 새 버전이 감지되면 이 섹션에 배지가 표시됩니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <!-- 새 버전 감지 배지 — 클릭 시 상세 다이얼로그 -->
                                <Button Command="{Binding ShowUpdateDetailsCommand}"
                                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource Button.Badge}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"
                                        ToolTip="클릭하여 릴리스 노트 확인 + 다운로드 페이지 열기">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding UpdateBadgeText}"/>
                                    </StackPanel>
                                </Button>

                                <!-- 수동 체크 버튼 — 항상 표시 -->
                                <Button Command="{Binding CheckForUpdatesCommand}"
                                        AutomationProperties.Name="Check for updates"
                                        Style="{StaticResource Button.Subtle}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="지금 새 버전이 있는지 확인합니다">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Check for updates"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Web Sync Section -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionHeader}"
                                           Foreground="{StaticResource Brush.Accent}"><Run Text="Web Parameters"/><InlineUIContainer BaselineAlignment="Center"><vs:HelpIcon CustomTitle="Web Parameters" CustomDescription="Web 서버와의 파라미터 동기화입니다. 평소 60초마다 자동으로 동기화되며, 아래 버튼은 기다리지 않고 지금 즉시 반영할 때 사용합니다." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <Button Command="{Binding OpenSyncParametersCommand}"
                                        AutomationProperties.Name="Sync Parameters"
                                        Style="{StaticResource Button.Subtle}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="Web 서버의 레시피 파라미터를 지금 즉시 가져옵니다">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Sync Parameters"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Image Saving Section — 검사 판정(양품/불량) 이미지 저장 설정. Admin 전용. -->
                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionHeader}"
                                           Foreground="{StaticResource Brush.Accent}"><Run Text="Image Saving"/><InlineUIContainer BaselineAlignment="Center"><vs:HelpIcon CustomTitle="Image Saving" CustomDescription="검사 판정 이미지(양품/불량)의 저장 위치·형식·보존 기간 설정입니다 (Admin 전용)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <Button Command="{Binding OpenImageSaveSettingsCommand}"
                                        AutomationProperties.Name="Image Save Settings"
                                        Style="{StaticResource Button.Subtle}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="양품/불량 이미지 저장 폴더 및 품질 설정">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"
                                                   ToolTip="이미지 저장"/>
                                        <TextBlock Text="Image Save Settings"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- D8: Recent Inspections (VMS 자체 히스토리 — Web 의존 없음) -->
                        <Border Background="{StaticResource Brush.Surface.Overlay}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}"
                                               VerticalAlignment="Center"><Run Text="Recent Inspections"/><InlineUIContainer BaselineAlignment="Center"><vs:HelpIcon CustomTitle="Recent Inspections" CustomDescription="최근 검사 결과를 VMS 안에 최대 200건까지 보관해 보여줍니다. Web 연결이 끊겨도 확인할 수 있고, VMS 를 다시 시작하면 비워집니다 (전체 이력은 Web 의 Production History)." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>
                                    <Button Grid.Column="1"
                                            Content="Clear"
                                            Command="{Binding ClearRecentInspectionsCommand}"
                                            Height="22" Padding="8,0" FontSize="10"
                                            Background="Transparent" Foreground="{StaticResource Brush.Text.Secondary}"
                                            BorderBrush="#555" BorderThickness="1"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            ToolTip="목록을 비웁니다 (Web 에 저장된 검사 이력은 지워지지 않습니다)"/>
                                </Grid>

                                <!-- 3-cell stats: Total / Pass / NG -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Total" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RecentInspections.TotalCount}"
                                                   Foreground="White" FontWeight="Bold" FontSize="18"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Pass" Foreground="{StaticResource Brush.Accent}" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RecentInspections.PassCount}"
                                                   Foreground="{StaticResource Brush.Accent}" FontWeight="Bold" FontSize="18"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="NG" Foreground="{StaticResource Brush.Danger}" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RecentInspections.NgCount}"
                                                   Foreground="{StaticResource Brush.Danger}" FontWeight="Bold" FontSize="18"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding RecentInspections.PassRate, StringFormat={}Pass rate {0:N1}%}"
                                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                <!-- ListBox — 최근 N건 (Items 는 ObservableCollection, [0]=최신) -->
                                <ListBox ItemsSource="{Binding RecentInspections.Items}"
                                         Background="{StaticResource Brush.Surface.Deep}" BorderThickness="0"
                                         MaxHeight="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3" ToolTip="{Binding TimestampFull}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimestampShort}"
                                                           Foreground="{StaticResource Brush.Text.Tertiary}" FontFamily="Consolas" FontSize="10"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" CornerRadius="3" Padding="4,1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Foreground="White" FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                                        <Setter Property="Text" Value="OK"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               Foreground="White" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding NgCodesText}"
                                                               Foreground="{StaticResource Brush.Danger}" FontSize="9"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Statistics Section -->
                        <Border Background="{StaticResource Brush.Surface.Overlay}"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Primary}"
                                           Margin="0,0,0,12"><Run Text="Statistics"/><InlineUIContainer BaselineAlignment="Center"><vs:HelpIcon CustomTitle="Statistics" CustomDescription="이번 실행(세션) 동안의 누적 통계입니다 — 전체 / 합격 / 불량 건수와 합격률." Margin="5,0,0,0"/></InlineUIContainer></TextBlock>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalInspections}" Foreground="White" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pass" Foreground="{StaticResource Brush.Success}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalPass}" Foreground="{StaticResource Brush.Success}" FontWeight="Bold" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fail" Foreground="{StaticResource Brush.Danger}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalFail}" Foreground="{StaticResource Brush.Danger}" FontWeight="Bold" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Pass Rate" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding PassRate, StringFormat={}{0:N1}%}"
                                               Foreground="White" FontWeight="Bold" Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 3: System Log Viewer -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource Brush.Surface.Deep}"
                BorderBrush="{StaticResource Brush.Surface.Overlay}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log Header -->
                <Border Grid.Row="0" Background="{StaticResource Brush.Surface.Deep}" Padding="8,4">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="System Log"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ClearLogCommand}"
                                ToolTip="Clear Log"
                                Padding="4">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Log List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding LogService.LogEntries}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         x:Name="LogListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="4,1">
                                <Run Text="{Binding Timestamp, StringFormat='[HH:mm:ss]'}" Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                <Run Text="{Binding Source, StringFormat='[{0}]'}" Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                <Run Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 4: Status Bar — Equipment Connection Status -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{StaticResource Brush.Surface.Raised}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- [0] System Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsRunning, Converter={StaticResource BoolToColorConverter}}"
                             Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SystemStatus}"
                               Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- [1] Separator -->
                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Brush.Surface.Overlay}" Margin="10,6"/>

                <!-- [2] Camera Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Surface.Overlay}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CameraConnectionStatus}" Value="All">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CameraConnectionStatus}" Value="Partial">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CameraConnectionStatus}" Value="None">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center">
                        <Run Text="CAM"/>
                        <Run Text="{Binding ConnectedCameraCount, Mode=OneWay}"/>/<Run Text="{Binding TotalCameraCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- [3] Separator -->
                <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Brush.Surface.Overlay}" Margin="10,6"/>

                <!-- [4] PLC Status -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Surface.Overlay}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPlcConfigured}" Value="True"/>
                                            <Condition Binding="{Binding IsPlcConnected}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPlcConfigured}" Value="True"/>
                                            <Condition Binding="{Binding IsPlcConnected}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                                <Setter Property="Text" Value="PLC N/A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlcConfigured}" Value="True">
                                        <Setter Property="Text" Value="{Binding PlcVendorName}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PlcIpAddress}" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding IsPlcConfigured, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- [5] Separator -->
                <Rectangle Grid.Column="5" Width="1" Fill="{StaticResource Brush.Surface.Overlay}" Margin="10,6"/>

                <!-- [6] Web Status -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Surface.Overlay}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWebConnected}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding WebStatusText}" FontSize="12"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebConnected}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- [7] Spacer -->

                <!-- [8] Robot (placeholder) -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="{StaticResource Brush.Text.Tertiary}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Surface.Divider}" Margin="0,0,5,0"/>
                    <TextBlock Text="ROBOT N/A" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
