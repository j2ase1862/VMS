<Window x:Class="VMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VMS.Controls"
        Title="{Binding ApplicationTitle}"
        WindowState="Maximized"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Panel animation -->
        <Storyboard x:Key="OpenPanel">
            <DoubleAnimation Storyboard.TargetName="SidePanel"
                             Storyboard.TargetProperty="Width"
                             To="320" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ClosePanel">
            <DoubleAnimation Storyboard.TargetName="SidePanel"
                             Storyboard.TargetProperty="Width"
                             To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="ToggleButton.Checked" SourceName="PanelToggle">
            <BeginStoryboard Storyboard="{StaticResource OpenPanel}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ToggleButton.Unchecked" SourceName="PanelToggle">
            <BeginStoryboard Storyboard="{StaticResource ClosePanel}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 0: Header Bar + User Info -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#2D2D2D">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0">
                    <Border Background="White" CornerRadius="1" Padding="6,2"
                            VerticalAlignment="Center">
                        <Image Source="/icon/ci_img2.png"
                               Height="24"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="{Binding ApplicationTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Center: 운영 흐름 (Operator → Work Order → AUTO RUN) -->
                <!-- Grab/Live/Roller 는 Settings 사이드 패널의 Camera Control 섹션으로 이동 -->
                <!-- Recipe 표시는 사이드 패널 Recipe 섹션에 있음 — 헤더에서 제거 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <!-- ═══ Stage 1: 작업자 chip (Web 인증 — VMS LoginWindow의 시스템 사용자와 별개) ═══ -->
                    <Border Background="#3D3D3D" CornerRadius="4" Padding="10,0" Height="32"
                            BorderBrush="#14B8A6" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Operator:" Foreground="#14B8A6" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Login..." Command="{Binding LoginOperatorCommand}"
                                    Height="22" Padding="10,0" FontSize="11"
                                    Background="#14B8A6" Foreground="White" BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" ToolTip="Web에 등록된 작업자(사번+PIN)로 로그인">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOperatorLoggedIn}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOperatorLoggedIn}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding CurrentOperatorName, Mode=OneWay}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding CurrentOperatorEmployeeNumber, Mode=OneWay}"
                                         Foreground="#B0B0B0"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <!-- D10: Role 뱃지 — Lead/Supervisor 일 때만 표시 -->
                                <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="#3D7DE8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentOperatorRole}" Value="Lead">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#3D7DE8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentOperatorRole}" Value="Supervisor">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#E85D3D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CurrentOperatorRole}"
                                               Foreground="White" FontSize="9" FontWeight="Bold"/>
                                </Border>
                                <Button Content="Logout" Command="{Binding LogoutOperatorCommand}"
                                        Margin="10,0,0,0" Height="22" Padding="8,0" FontSize="10"
                                        Background="Transparent" Foreground="#B0B0B0"
                                        BorderBrush="#707070" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Work Orders 버튼 (로그인 후만 활성) -->
                    <Button Command="{Binding OpenWorkOrderListCommand}"
                            Margin="6,0,0,0" Height="32" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold"
                            Background="#252525" Foreground="#14B8A6"
                            BorderBrush="#14B8A6" BorderThickness="1"
                            Cursor="Hand" VerticalAlignment="Center"
                            ToolTip="작업 지시 목록 — 로그인 후 활성">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Work Orders" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 선택된 작업지시 표시 — 텍스트 + 진행률 ProgressBar (B4) -->
                    <Border Background="#252525" CornerRadius="4" Padding="10,0" Margin="6,0,0,0" Height="32"
                            BorderBrush="#14B8A6" BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedWorkOrder, Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="현재 선택된 작업지시 — 진행률 실시간">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WO:" Foreground="#14B8A6" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SelectedWorkOrderText}"
                                       Foreground="White" FontSize="11"
                                       VerticalAlignment="Center"/>

                            <!-- 진행률 ProgressBar — 얇은 가로 (B4) -->
                            <ProgressBar Width="80" Height="6"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding SelectedWorkOrderProgressPercent, Mode=OneWay}"
                                         Margin="10,0,0,0" VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Visibility="{Binding HasSelectedWorkOrderProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border CornerRadius="3" Background="#1A1A1C">
                                            <Grid HorizontalAlignment="Stretch" ClipToBounds="True">
                                                <Border x:Name="PART_Track"/>
                                                <Border x:Name="PART_Indicator"
                                                        HorizontalAlignment="Left"
                                                        Background="#14B8A6"
                                                        CornerRadius="3"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </StackPanel>
                    </Border>

                    <!-- 현재 로드된 Recipe 표시 (WO 선택 시 자동 로드 결과) -->
                    <Border Background="#252525" CornerRadius="4" Padding="10,0" Margin="6,0,0,0" Height="32"
                            BorderBrush="#3D7DE8" BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="{Binding CurrentRecipe, Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="현재 로드된 레시피 — 작업지시 선택 시 자동 로드">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="#3D7DE8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Recipe:" Foreground="#3D7DE8" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentRecipeName}"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Phase 3: Inspection Context (Web 업로드 시 자동 첨부) ═══ -->
                    <Border Background="#3D3D3D" CornerRadius="4" Padding="10,0" Margin="6,0,0,0" Height="32"
                            VerticalAlignment="Center"
                            ToolTip="검사 결과 업로드 시 자동 첨부 (WO/Lot/Op ID + Serial)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctx:" Foreground="#14B8A6" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="WO" Foreground="#B0B0B0" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBox Text="{Binding WorkOrderIdText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="50" Height="22" FontSize="11"
                                     Background="#252525" Foreground="White" BorderBrush="#555"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="WorkOrder ID (정수)"/>
                            <TextBlock Text="Lot" Foreground="#B0B0B0" FontSize="10" VerticalAlignment="Center" Margin="6,0,3,0"/>
                            <TextBox Text="{Binding LotIdText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="50" Height="22" FontSize="11"
                                     Background="#252525" Foreground="White" BorderBrush="#555"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="Lot ID (정수)"/>
                            <TextBlock Text="S/N" Foreground="#B0B0B0" FontSize="10" VerticalAlignment="Center" Margin="6,0,3,0"/>
                            <TextBox Text="{Binding SerialNumberText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" Height="22" FontSize="11"
                                     Background="#252525" Foreground="White" BorderBrush="#555"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="제품 시리얼 (바코드 스캐너 OK)"/>
                            <Button Content="✕" Command="{Binding ClearInspectionContextCommand}"
                                    Margin="6,0,0,0" Height="22" Padding="6,0" FontSize="10"
                                    Background="Transparent" Foreground="#B0B0B0"
                                    BorderBrush="#555" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" ToolTip="모든 컨텍스트 필드 비우기"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Plan §5.3 V5: 예측 NG율 위젯 (60초 폴링) ═══ -->
                    <!-- 임계 색상: < 5% Green / < 10% Orange / ≥ 10% Red / non-ok Gray -->
                    <Border Background="#3D3D3D" CornerRadius="4" Padding="10,0" Margin="6,0,0,0" Height="32"
                            BorderBrush="{Binding PredictionAccentBrush}" BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="{Binding PredictionTooltip}"
                            Visibility="{Binding CurrentPrediction, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{Binding PredictionAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="다음 1시간:" Foreground="#B0B0B0" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding PredictionDisplayText}"
                                       Foreground="{Binding PredictionAccentBrush}"
                                       FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ AUTO RUN — 운영 흐름의 단일 Primary 액션 ═══ -->
                    <Rectangle Width="1" Fill="#404040" Margin="14,8"/>

                    <Button Command="{Binding StartInspectionCommand}"
                            IsEnabled="{Binding CanStartStop}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                            Background="#00ADB5" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Padding="20,0" Margin="0,0,6,0" Height="34"
                            VerticalAlignment="Center"
                            FontSize="13" FontWeight="Bold"
                            ToolTip="검사 시작 — 카메라 연결 + 작업자 로그인 + 작업지시 선택 후 활성"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#2D5A5C"/>
                                        <Setter Property="Foreground" Value="#7A9A9C"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#12C1CA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="AUTO RUN" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopInspectionCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#E53935" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Padding="20,0" Margin="0,0,6,0" Height="34"
                            VerticalAlignment="Center"
                            FontSize="13" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EF5350"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="STOP" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- User Info (clickable for user switch) -->
                <Border Grid.Column="2" Background="#3D3D3D" CornerRadius="4"
                        Padding="10,0" Margin="0,0,8,0" Height="32"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Visibility="{Binding CurrentUserDisplay, Converter={StaticResource NullToVisibilityConverter}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding SwitchUserCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{Binding CurrentUserGrade, Converter={StaticResource UserGradeToColorConverter}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentUserDisplay}"
                                   Foreground="White"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right: Toolbar buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0">
                    <!-- User Management (Admin only) -->
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding OpenUserManagementCommand}"
                            IsEnabled="{Binding CanManageUsers}"
                            ToolTip="User Management"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="&#xE748;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding SaveLayoutCommand}"
                            ToolTip="Save Layout">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </Button>

                    <ToggleButton x:Name="PanelToggle"
                                  IsChecked="{Binding IsSidePanelOpen, Mode=TwoWay}"
                                  Style="{StaticResource IconToggleButton}"
                                  ToolTip="Settings Panel"
                                  Margin="4,0">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>
                    </ToggleButton>

                    <Rectangle Width="1" Fill="#404040" Margin="8,8"/>

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ExitApplicationCommand}"
                            ToolTip="Exit">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#F44336"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 1: Dashboard KPI Strip (always visible) -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#252525">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TACT TIME -->
                <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TACT TIME" Foreground="#808080" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dashboard.IsTactTimeExceeded}" Value="True">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding Dashboard.TactTime, StringFormat={}{0:F2}}"/><Run Text="s" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- YIELD -->
                <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="YIELD" Foreground="#808080" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dashboard.Yield, Converter={StaticResource CountToVisibilityConverter}}" Value="Collapsed">
                                            <Setter Property="Foreground" Value="#FF9800"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding Dashboard.Yield, StringFormat={}{0:F1}}"/><Run Text="%" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- TOTAL -->
                <Border Grid.Column="2" Background="#2D2D2D" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL" Foreground="#808080" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Dashboard.TotalCount}"
                                   FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- OK -->
                <Border Grid.Column="3" Background="#2D2D2D" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="OK" Foreground="#808080" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Dashboard.OkCount}"
                                   FontSize="24" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- NG -->
                <Border Grid.Column="4" Background="#2D2D2D" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="NG" Foreground="#808080" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Dashboard.NgCount}"
                                   FontSize="24" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Reset button -->
                <Button Grid.Column="5" Style="{StaticResource IconButton}"
                        Command="{Binding ResetDashboardCommand}"
                        ToolTip="Reset Statistics"
                        VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="#808080"/>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 2: Main Content Area + NG History Sidebar -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Camera Display Area -->
            <Canvas x:Name="CameraCanvas"
                    Grid.Column="0"
                    Background="#1E1E1E"
                    ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding Cameras}"
                              Width="{Binding ActualWidth, ElementName=CameraCanvas}"
                              Height="{Binding ActualHeight, ElementName=CameraCanvas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:CameraDisplayControl
                                Width="{Binding Width}"
                                Height="{Binding Height}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Alignment guide lines overlay -->
                <Canvas x:Name="AlignmentGuideCanvas"
                        IsHitTestVisible="False"
                        Width="{Binding ActualWidth, ElementName=CameraCanvas}"
                        Height="{Binding ActualHeight, ElementName=CameraCanvas}"/>
            </Canvas>

            <!-- NG Image History Sidebar (always visible) -->
            <Border Grid.Column="1" Width="120" Background="#252525"
                    BorderBrush="#3D3D3D" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NG History"
                               Foreground="#F44336" FontWeight="SemiBold"
                               FontSize="11" Margin="8,6"
                               HorizontalAlignment="Center"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Dashboard.NgImageHistory}"
                             SelectedItem="{Binding SelectedNgImage}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D2D" CornerRadius="4"
                                        Margin="4,2" Padding="2">
                                    <StackPanel>
                                        <Image Source="{Binding Thumbnail}"
                                               Width="100" Height="75"
                                               Stretch="Uniform"/>
                                        <TextBlock Text="{Binding CameraName}"
                                                   Foreground="#B0B0B0" FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                   Foreground="#808080" FontSize="8"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Sliding Side Panel -->
            <Border x:Name="SidePanel"
                    Grid.Column="2"
                    Width="0"
                    Background="#2D2D2D"
                    BorderBrush="#3D3D3D"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Panel Header -->
                        <TextBlock Text="Settings"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,16"/>

                        <!-- Camera Control Section — 헤더에서 옮겨온 도구 액션 -->
                        <Border Background="#3D3D3D"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Camera Control"
                                           FontWeight="SemiBold"
                                           Foreground="#2196F3"
                                           Margin="0,0,0,12"/>

                                <!-- Grab (single shot) -->
                                <Button Command="{Binding GrabCommand}"
                                        IsEnabled="{Binding CanStartStop}"
                                        Visibility="{Binding IsLiveMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                        Background="#404040" Foreground="White"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="단일 이미지 캡처">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#2196F3" Margin="0,0,8,0"/>
                                        <TextBlock Text="Grab"/>
                                    </StackPanel>
                                </Button>

                                <!-- Live Start -->
                                <Button Command="{Binding StartLiveCommand}"
                                        IsEnabled="{Binding CanStartStop}"
                                        Visibility="{Binding IsLiveMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                        Background="#404040" Foreground="White"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="연속 라이브 그랩 시작">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#4CAF50" Margin="0,0,8,0"/>
                                        <TextBlock Text="Live Start"/>
                                    </StackPanel>
                                </Button>

                                <!-- Live Stop -->
                                <Button Command="{Binding StopLiveCommand}"
                                        Visibility="{Binding IsLiveMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#404040" Foreground="White"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#FF9800" Margin="0,0,8,0"/>
                                        <TextBlock Text="Live Stop"/>
                                    </StackPanel>
                                </Button>

                                <!-- Roller Toggle -->
                                <Button Command="{Binding ToggleRollerInspectionCommand}"
                                        IsEnabled="{Binding CanStartStop}"
                                        Foreground="White"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="롤러 검사 모드 토글">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                            <Setter Property="Background" Value="#404040"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRollerInspecting}" Value="True">
                                                    <Setter Property="Background" Value="#4A2020"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE8B0;"/>
                                                    <Setter Property="Foreground" Value="#00ADB5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRollerInspecting}" Value="True">
                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Roller"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRollerInspecting}" Value="True">
                                                            <Setter Property="Text" Value="Roller Stop"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Recipe Section -->
                        <Border Background="#3D3D3D"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Recipe"
                                           FontWeight="SemiBold"
                                           Foreground="#2196F3"
                                           Margin="0,0,0,12"/>

                                <!-- Current Recipe Display -->
                                <Border Background="#404040"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentRecipeName}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentRecipe.Version, StringFormat='v{0}', FallbackValue=''}"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Recipe List -->
                                <TextBlock Text="Available Recipes"
                                           Foreground="#B0B0B0"
                                           FontSize="11"
                                           Margin="0,0,0,4"/>
                                <ListBox ItemsSource="{Binding RecipeList}"
                                         SelectedItem="{Binding SelectedRecipeInfo}"
                                         Background="#404040"
                                         BorderThickness="0"
                                         MaxHeight="120"
                                         Margin="0,0,0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,2">
                                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                <TextBlock Text="{Binding ModifiedAt, StringFormat='Modified: {0:yyyy-MM-dd}'}"
                                                           Foreground="#808080" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Recipe Buttons -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Command="{Binding LoadRecipeCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="Load"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Command="{Binding NewRecipeCommand}"
                                            IsEnabled="{Binding CanEditRecipe}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="New"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Command="{Binding SaveCurrentRecipeCommand}"
                                            IsEnabled="{Binding CanEditRecipe}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="0,0,2,0"
                                            ToolTip="Save Recipe">
                                        <TextBlock Text="&#xE74E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Command="{Binding ExportRecipeCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="2,0,2,0"
                                            ToolTip="Export Recipe">
                                        <TextBlock Text="&#xEDE1;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Command="{Binding ImportRecipeCommand}"
                                            IsEnabled="{Binding CanEditRecipe}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="2,0,0,0"
                                            ToolTip="Import Recipe">
                                        <TextBlock Text="&#xE8B5;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- External Tools Section — D10: Supervisor 전용 -->
                        <Border Background="#3D3D3D"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16"
                                Visibility="{Binding CanSupervisor, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="External Tools"
                                           FontWeight="SemiBold"
                                           Foreground="#2196F3"
                                           Margin="0,0,0,12"/>

                                <Button Command="{Binding LaunchVisionToolSetupCommand}"
                                        IsEnabled="{Binding CanLaunchVisionSetup}"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7AC;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Vision Tool Setup"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding LaunchSetupCommand}"
                                        IsEnabled="{Binding CanLaunchAppSetup}"
                                        Background="#404040"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="System Setup"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Web Sync Section -->
                        <Border Background="#3D3D3D"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Web Parameters"
                                           FontWeight="SemiBold"
                                           Foreground="#00ADB5"
                                           Margin="0,0,0,12"/>

                                <Button Command="{Binding OpenSyncParametersCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Background="#404040"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Sync Parameters"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- D8: Recent Inspections (VMS 자체 히스토리 — Web 의존 없음) -->
                        <Border Background="#3D3D3D"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Recent Inspections"
                                               FontWeight="SemiBold" Foreground="#14B8A6"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Clear"
                                            Command="{Binding ClearRecentInspectionsCommand}"
                                            Height="22" Padding="8,0" FontSize="10"
                                            Background="Transparent" Foreground="#B0B0B0"
                                            BorderBrush="#555" BorderThickness="1"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 3-cell stats: Total / Pass / NG -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Total" Foreground="#B0B0B0" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RecentInspections.TotalCount}"
                                                   Foreground="White" FontWeight="Bold" FontSize="18"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Pass" Foreground="#14B8A6" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RecentInspections.PassCount}"
                                                   Foreground="#14B8A6" FontWeight="Bold" FontSize="18"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="NG" Foreground="#E53935" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RecentInspections.NgCount}"
                                                   Foreground="#E53935" FontWeight="Bold" FontSize="18"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding RecentInspections.PassRate, StringFormat={}Pass rate {0:N1}%}"
                                           Foreground="#B0B0B0" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                <!-- ListBox — 최근 N건 (Items 는 ObservableCollection, [0]=최신) -->
                                <ListBox ItemsSource="{Binding RecentInspections.Items}"
                                         Background="#252525" BorderThickness="0"
                                         MaxHeight="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3" ToolTip="{Binding TimestampFull}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimestampShort}"
                                                           Foreground="#808080" FontFamily="Consolas" FontSize="10"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" CornerRadius="3" Padding="4,1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E53935"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                                    <Setter Property="Background" Value="#14B8A6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Foreground="White" FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                                        <Setter Property="Text" Value="OK"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               Foreground="White" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding NgCodesText}"
                                                               Foreground="#E53935" FontSize="9"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Statistics Section -->
                        <Border Background="#3D3D3D"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Statistics"
                                           FontWeight="SemiBold"
                                           Foreground="#2196F3"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total" Foreground="#B0B0B0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalInspections}" Foreground="White" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pass" Foreground="#4CAF50" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalPass}" Foreground="#4CAF50" FontWeight="Bold" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fail" Foreground="#F44336" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalFail}" Foreground="#F44336" FontWeight="Bold" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Pass Rate" Foreground="#B0B0B0" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding PassRate, StringFormat={}{0:N1}%}"
                                               Foreground="White" FontWeight="Bold" Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 3: System Log Viewer -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#1A1A1A"
                BorderBrush="#3D3D3D" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log Header -->
                <Border Grid.Row="0" Background="#252525" Padding="8,4">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="#808080"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="System Log"
                                       Foreground="#B0B0B0"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ClearLogCommand}"
                                ToolTip="Clear Log"
                                Padding="4">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="#808080"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Log List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding LogService.LogEntries}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         x:Name="LogListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="4,1">
                                <Run Text="{Binding Timestamp, StringFormat='[HH:mm:ss]'}" Foreground="#606060"/>
                                <Run Text="{Binding Source, StringFormat='[{0}]'}" Foreground="#808080"/>
                                <Run Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- Row 4: Status Bar — Equipment Connection Status -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#2D2D2D">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- [0] System Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsRunning, Converter={StaticResource BoolToColorConverter}}"
                             Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SystemStatus}"
                               Foreground="#B0B0B0" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- [1] Separator -->
                <Rectangle Grid.Column="1" Width="1" Fill="#404040" Margin="10,6"/>

                <!-- [2] Camera Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="#B0B0B0"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#555555"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CameraConnectionStatus}" Value="All">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CameraConnectionStatus}" Value="Partial">
                                        <Setter Property="Fill" Value="#FF9800"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CameraConnectionStatus}" Value="None">
                                        <Setter Property="Fill" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="#B0B0B0" FontSize="12" VerticalAlignment="Center">
                        <Run Text="CAM"/>
                        <Run Text="{Binding ConnectedCameraCount, Mode=OneWay}"/>/<Run Text="{Binding TotalCameraCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- [3] Separator -->
                <Rectangle Grid.Column="3" Width="1" Fill="#404040" Margin="10,6"/>

                <!-- [4] PLC Status -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="#B0B0B0"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#555555"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPlcConfigured}" Value="True"/>
                                            <Condition Binding="{Binding IsPlcConnected}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPlcConfigured}" Value="True"/>
                                            <Condition Binding="{Binding IsPlcConnected}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="#F44336"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                <Setter Property="Text" Value="PLC N/A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlcConfigured}" Value="True">
                                        <Setter Property="Text" Value="{Binding PlcVendorName}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PlcIpAddress}" Foreground="#808080" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding IsPlcConfigured, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- [5] Separator -->
                <Rectangle Grid.Column="5" Width="1" Fill="#404040" Margin="10,6"/>

                <!-- [6] Web Status -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="#B0B0B0"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#555555"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWebConnected}" Value="False">
                                        <Setter Property="Fill" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding WebStatusText}" FontSize="12"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebConnected}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- [7] Spacer -->

                <!-- [8] Robot (placeholder) -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="#808080"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Fill="#555555" Margin="0,0,5,0"/>
                    <TextBlock Text="ROBOT N/A" Foreground="#808080" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
