<Window x:Class="VMS.Views.SupportPackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common;assembly=VMS.VisionSetup"
        Title="Support Package Export"
        Width="720" Height="620"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="지원 패키지 — Support Package Export"
                                  ShowMinMaxButtons="False"/>

            <Grid Grid.Row="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Intro -->
                <Border Grid.Row="0" Style="{StaticResource WindowSurface}" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource WindowBodyText}" TextWrapping="Wrap">
                        <Run Text="원격 지원 / 엔지니어링 분석용 ZIP 패키지를 생성합니다. 백업과 달리 사용자 DB (BCrypt 해시) 와 레시피는 "/>
                        <Run FontWeight="SemiBold" Text="포함되지 않습니다"/>
                        <Run Text="."/>
                    </TextBlock>
                </Border>

                <!-- Options -->
                <Border Grid.Row="1" Style="{StaticResource WindowCard}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="옵션" Style="{StaticResource WindowSectionHeaderFirst}"/>

                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="포함할 감사 로그 일수"
                                       Style="{StaticResource WindowFieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding AuditDays}"
                                     Style="{StaticResource WindowDarkTextBox}"/>
                            <TextBlock Grid.Column="2" Text="[1, 90]"
                                       Style="{StaticResource WindowMutedText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ProductVersion (manifest)"
                                       Style="{StaticResource WindowFieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding ProductVersion}"
                                     Style="{StaticResource WindowDarkTextBox}"/>
                        </Grid>

                        <CheckBox Content="환경 정보 포함 (OS / .NET / CPU / 메모리 / 드라이브)"
                                  IsChecked="{Binding IncludeEnvironment}"
                                  Style="{StaticResource WindowDarkCheckBox}"/>
                        <CheckBox Content="백업 인덱스 포함 (파일명 / 크기 / 시각만 — 내용 X)"
                                  IsChecked="{Binding IncludeBackupIndex}"
                                  Style="{StaticResource WindowDarkCheckBox}"/>
                        <CheckBox Content="MachineName / DomainName 포함 (사이트 식별 PII — 기본 제외)"
                                  IsChecked="{Binding IncludeMachineName}"
                                  Style="{StaticResource WindowDarkCheckBox}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2"/>

                <!-- Status -->
                <Border Grid.Row="3" Style="{StaticResource WindowSurface}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3" Padding="8,3" MinWidth="64">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding StatusColor}"/>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding SummaryLine}"
                                   Style="{StaticResource WindowBodyText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Action -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource WindowMutedText}"
                               VerticalAlignment="Center">
                        <Run Text="감사: AuditCategory.System / SupportPackageCreated 이벤트로 기록됩니다."/>
                    </TextBlock>
                    <Button Grid.Column="1" Content="Run Export..."
                            Command="{Binding RunExportCommand}"
                            Style="{StaticResource ModernPrimaryButton}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
