<Window x:Class="VMS.Views.AuditLogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:VMS.VisionSetup.Views.Common;assembly=VMS.VisionSetup"
        xmlns:sec="clr-namespace:VMS.Core.Security;assembly=VMS.Core"
        Title="Audit Log Viewer"
        Width="1200" Height="680"
        MinWidth="900" MinHeight="520"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgWindow}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BrushBgWindow}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:ChromelessTitleBar Grid.Row="0"
                                  TitleText="감사 로그 조회 — Audit Log Viewer"
                                  StatusText="{Binding StatusMessage}"/>

            <Grid Grid.Row="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0" Style="{StaticResource WindowCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From"
                                   Style="{StaticResource WindowFieldLabel}" Margin="0,0,8,0"/>
                        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding FromDate}"
                                    Style="{StaticResource WindowDarkDatePicker}"
                                    Margin="0,0,14,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To"
                                   Style="{StaticResource WindowFieldLabel}" Margin="0,0,8,0"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding ToDate}"
                                    Style="{StaticResource WindowDarkDatePicker}"
                                    Margin="0,0,14,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Category"
                                   Style="{StaticResource WindowFieldLabel}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="5"
                                  ItemsSource="{Binding CategoryOptions}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Style="{StaticResource WindowDarkComboBox}"
                                  Margin="0,0,14,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="(전체)"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Outcome"
                                   Style="{StaticResource WindowFieldLabel}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="7"
                                  ItemsSource="{Binding OutcomeOptions}"
                                  SelectedItem="{Binding SelectedOutcome}"
                                  Style="{StaticResource WindowDarkComboBox}"
                                  Margin="0,0,14,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="(전체)"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="8" Text="Search"
                                   Style="{StaticResource WindowFieldLabel}" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="0" Grid.Column="9"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WindowDarkTextBox}"
                                 MinWidth="180"
                                 ToolTip="Action / User / Source / Details 텍스트 검색"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="10"
                                    Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="조회" Command="{Binding SearchCommand}"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="필터 초기화" Command="{Binding ResetFiltersCommand}"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="CSV 내보내기" Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource ModernSuccessButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Results DataGrid -->
                <Border Grid.Row="1" Style="{StaticResource WindowCard}" Padding="2">
                    <DataGrid ItemsSource="{Binding Entries}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource WindowDarkDataGrid}"
                              VerticalScrollBarVisibility="Auto"
                              FontFamily="Consolas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp (UTC)"
                                                Binding="{Binding TimestampUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="125"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="170"/>
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Outcome}" Value="Success">
                                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Outcome}" Value="Failure">
                                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Outcome}" Value="Denied">
                                                <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="170"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Status Bar -->
                <Border Grid.Row="2" Style="{StaticResource WindowSurface}" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource WindowMutedText}">
                        <Run Text="저장 위치: "/>
                        <Run Text="%LocalAppData%\BODA VISION AI\audit\YYYY-MM-DD.jsonl"
                             FontFamily="Consolas"
                             Foreground="{StaticResource BrushTextSecondary}"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
