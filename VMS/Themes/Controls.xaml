<!--
  Design tokens — Controls (v1.0 / 2026-06-01)

  - 기존 App.xaml 인라인 스타일(ModernButton/IconButton/IconToggleButton)을 그대로 이전.
  - 색상은 토큰 참조. 인터랙션(hover/disabled) 일관화.
  - 새로 추가: Card / Card.Accent / Button.Subtle — 사이드 패널/대시보드 카드, 배경 톤이
    Surface.Raised 인 기본 카드 vs 강조색(예: 업데이트 배지) 인 카드 두 종.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ──────────────── Card (Border) ────────────────
         사이드 패널 섹션 / 대시보드 카드 베이스. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"    Value="{StaticResource Brush.Surface.Raised}"/>
        <Setter Property="CornerRadius"  Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding"       Value="{StaticResource Spacing.Card.Padding}"/>
        <Setter Property="Margin"        Value="{StaticResource Spacing.Card.Gap}"/>
        <Setter Property="Effect"        Value="{StaticResource Elevation.Card}"/>
    </Style>

    <!-- 강조 카드 — 사이드 패널의 Updates / 알림 영역 등.
         테두리 강조색으로 가벼운 시선 유도. -->
    <Style x:Key="Card.Accent" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush"     Value="{StaticResource Brush.Warning}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- ──────────────── ModernButton ────────────────
         Primary action — 채워진 강조색 버튼. -->
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource Brush.Primary}"/>
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.OnPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontFamily"      Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize"        Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Primary.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ──────────────── Button.Subtle ────────────────
         배경이 Surface 와 동일하나 hover 시 살짝 밝아짐. 사이드 패널의 secondary
         action(예: Sync Parameters, Check for updates) 에 적합. -->
    <Style x:Key="Button.Subtle" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource Brush.Surface.Overlay}"/>
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontFamily"      Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize"        Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Surface.Divider}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ──────────────── Button.Badge ────────────────
         경고색 배경의 강조 배지(예: "새 버전 v1.2.0"). -->
    <Style x:Key="Button.Badge" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource Brush.Warning}"/>
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.OnWarning}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontFamily"      Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize"        Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F59E0B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ──────────────── IconButton ────────────────
         Toolbar/inline 아이콘 액션. Transparent 배경, hover 시 옅은 강조. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="8"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Surface.Overlay}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ──────────────── IconToggleButton ──────────────── -->
    <Style x:Key="IconToggleButton" TargetType="ToggleButton">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="8"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Surface.Overlay}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ──────────────── SettingsSlider ──────────────── -->
    <Style x:Key="SettingsSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
    </Style>
</ResourceDictionary>
