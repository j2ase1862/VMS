<!--
  Design tokens — Typography (v1.0 / 2026-06-01)

  Segoe UI 패밀리(Windows 기본) 기반. 산업 환경 가독성을 위해 일반 본문은 13pt 이상.
  스타일은 BasedOn TextBlock 으로 적용, view 에서는 Style="{StaticResource Text.Body}" 식.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Font.Family">Segoe UI</FontFamily>

    <!-- ──────────────── Size tokens ────────────────
         산업 환경(거리감, 조명, 안경 착용 운영자)을 고려하여 본문 13pt 최소. -->
    <system:Double x:Key="Font.Size.Display"  xmlns:system="clr-namespace:System;assembly=mscorlib">28</system:Double>
    <system:Double x:Key="Font.Size.Title"    xmlns:system="clr-namespace:System;assembly=mscorlib">18</system:Double>
    <system:Double x:Key="Font.Size.Subtitle" xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="Font.Size.Body"     xmlns:system="clr-namespace:System;assembly=mscorlib">13</system:Double>
    <system:Double x:Key="Font.Size.Caption"  xmlns:system="clr-namespace:System;assembly=mscorlib">11</system:Double>

    <!-- ──────────────── Styles ──────────────── -->

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize"   Value="{StaticResource Font.Size.Display}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize"   Value="{StaticResource Font.Size.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>

    <!-- 사이드 패널 섹션 헤더용 — Title 보다 한 단계 작고 강조색 적용 가능. -->
    <Style x:Key="Text.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize"   Value="{StaticResource Font.Size.Subtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
        <Setter Property="Margin"     Value="0,0,0,12"/>
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize"   Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize"   Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
    </Style>
</ResourceDictionary>
