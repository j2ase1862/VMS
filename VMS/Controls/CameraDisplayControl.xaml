<UserControl x:Class="VMS.Controls.CameraDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VMS.ViewModels"
             xmlns:controls="clr-namespace:VMS.Controls"
             xmlns:core="clr-namespace:VMS.Core.Controls;assembly=VMS.Core"
             d:DataContext="{d:DesignInstance vm:CameraViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Background="{StaticResource Brush.Surface.Raised}"
            BorderBrush="{StaticResource Brush.Surface.Overlay}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Header with camera name and drag handle -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Surface.Overlay}"
                    CornerRadius="6,6,0,0"
                    Cursor="SizeAll"
                    x:Name="DragHandle">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
                        <TextBlock Text="&#xE722;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <!-- Connection status indicator -->
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F44336"/>
                                    <Setter Property="ToolTip" Value="Disconnected"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                            <Setter Property="ToolTip" Value="Connected"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Settings icon and Status indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Settings Button (toggles inline control box) -->
                        <Button x:Name="SettingsButton"
                                Command="{Binding ToggleControlBoxCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="6,4"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                ToolTip="Camera Settings">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#505050"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Status indicator -->
                        <Border Background="{Binding StatusText, Converter={StaticResource StatusStateToColorConverter}}"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="0,4,8,4">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Camera 2D / Depth Map / Point Cloud view tabs -->
            <TabControl Grid.Row="1" Margin="4"
                        SelectedIndex="{Binding SelectedViewTab}"
                        Background="{StaticResource Brush.Surface.Base}"
                        BorderThickness="0">
                <TabControl.Resources>
                    <!-- 카메라 디스플레이 위에 작은 사이즈 탭 — 디폴트 TabItem 스타일을
                         override 하여 컴팩트한 헤더. 색은 토큰 참조. -->
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="{StaticResource Brush.Surface.Raised}"/>
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4,4,0,0"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="1,0">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Brush.Surface.Base}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Brush.Surface.Overlay}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 0: 2D View -->
                <TabItem Header="2D">
                    <Border Background="{StaticResource Brush.Surface.Base}">
                        <Grid>
                            <!-- Placeholder when no image -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding CurrentImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xE714;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="48"
                                           Foreground="#404040"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="No Image"
                                           Foreground="#606060"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Actual camera image -->
                            <Image Source="{Binding CurrentImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Tab 1: Depth Map -->
                <TabItem Header="Depth Map">
                    <Border Background="{StaticResource Brush.Surface.Base}">
                        <Grid>
                            <!-- Placeholder when no point cloud -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding CurrentPointCloud, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xE81C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="48"
                                           Foreground="#404040"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="No Depth Data"
                                           Foreground="#606060"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Depth Map Viewer -->
                            <core:DepthMapViewer
                                PointCloud="{Binding CurrentPointCloud}"
                                Visibility="{Binding CurrentPointCloud, Converter={StaticResource NullToVisibilityConverter}}"/>

                        </Grid>
                    </Border>
                </TabItem>

                <!-- Tab 2: Point Cloud (3D viewer) -->
                <TabItem Header="Point Cloud">
                    <Border Background="{StaticResource Brush.Surface.Base}">
                        <Grid>
                            <!-- Placeholder when no point cloud -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding CurrentPointCloud, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xF158;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="48"
                                           Foreground="#404040"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="No 3D Data"
                                           Foreground="#606060"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Point Cloud Viewer -->
                            <core:PointCloudViewer
                                PointCloud="{Binding CurrentPointCloud}"
                                Visibility="{Binding CurrentPointCloud, Converter={StaticResource NullToVisibilityConverter}}"/>

                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Row 2: Tool Run Results DataGrid -->
            <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,1,0,0"
                    Margin="4,0,4,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,3,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Run Results"
                                   Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastExecutionTimeMs, StringFormat={}{0:F1} ms}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ToolRunResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#444444"
                              Background="{StaticResource Brush.Surface.Base}"
                              Foreground="White"
                              BorderBrush="#555555"
                              BorderThickness="1"
                              RowBackground="{StaticResource Brush.Surface.Raised}"
                              AlternatingRowBackground="#252526"
                              MaxHeight="120"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              FontSize="11">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="BorderBrush" Value="#555555"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="22"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0078D4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tool Name"
                                                Binding="{Binding ToolName}"
                                                Width="*"
                                                MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="P/F"
                                                Binding="{Binding Result}"
                                                Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Result}" Value="True">
                                                <Setter Property="Foreground" Value="#4EC94E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="False">
                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Result Value"
                                                Binding="{Binding ResultValue}"
                                                Width="2*"
                                                MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Footer with Pass checkbox and info -->
            <Border Grid.Row="3" Background="{StaticResource Brush.Surface.Overlay}" CornerRadius="0,0,6,6">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pass checkbox -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsPassed}"
                              VerticalAlignment="Center">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="CheckBorder"
                                                        Width="20" Height="20"
                                                        Background="{StaticResource Brush.Surface.Overlay}"
                                                        BorderBrush="{StaticResource Brush.Surface.Divider}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <TextBlock x:Name="CheckMark"
                                                               Text="&#xE73E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="LimeGreen"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="Collapsed"/>
                                                </Border>
                                                <TextBlock Text="Pass"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="CheckBorder" Property="Background" Value="#2D5A2D"/>
                                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="LimeGreen"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#808080"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <!-- Camera info -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding IpAddress}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <!-- Inspection count -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Count: " Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding InspectionCount}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 8-direction resize handles -->
            <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="5">
                <Grid.Resources>
                    <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- Edge handles (6px thick) -->
                <Thumb x:Name="ResizeTop" Height="6" VerticalAlignment="Top"
                       Margin="8,0,8,0" Cursor="SizeNS"
                       Style="{StaticResource ResizeThumbStyle}"/>
                <Thumb x:Name="ResizeBottom" Height="6" VerticalAlignment="Bottom"
                       Margin="8,0,8,0" Cursor="SizeNS"
                       Style="{StaticResource ResizeThumbStyle}"/>
                <Thumb x:Name="ResizeLeft" Width="6" HorizontalAlignment="Left"
                       Margin="0,8,0,8" Cursor="SizeWE"
                       Style="{StaticResource ResizeThumbStyle}"/>
                <Thumb x:Name="ResizeRight" Width="6" HorizontalAlignment="Right"
                       Margin="0,8,0,8" Cursor="SizeWE"
                       Style="{StaticResource ResizeThumbStyle}"/>

                <!-- Corner handles (8x8) -->
                <Thumb x:Name="ResizeTopLeft" Width="8" Height="8"
                       VerticalAlignment="Top" HorizontalAlignment="Left"
                       Cursor="SizeNWSE" Style="{StaticResource ResizeThumbStyle}"/>
                <Thumb x:Name="ResizeTopRight" Width="8" Height="8"
                       VerticalAlignment="Top" HorizontalAlignment="Right"
                       Cursor="SizeNESW" Style="{StaticResource ResizeThumbStyle}"/>
                <Thumb x:Name="ResizeBottomLeft" Width="8" Height="8"
                       VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       Cursor="SizeNESW" Style="{StaticResource ResizeThumbStyle}"/>
                <Thumb x:Name="ResizeBottomRight" Width="8" Height="8"
                       VerticalAlignment="Bottom" HorizontalAlignment="Right"
                       Cursor="SizeNWSE" Style="{StaticResource ResizeThumbStyle}"/>
            </Grid>

            <!-- Inline Control Box Overlay -->
            <Border Grid.Row="0" Grid.RowSpan="4"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Width="280"
                    Margin="4,34,4,0"
                    Panel.ZIndex="10"
                    Background="#F0282828"
                    BorderBrush="#505050"
                    BorderThickness="1"
                    CornerRadius="0,0,6,6"
                    Padding="12,8"
                    RenderTransformOrigin="0.5,0"
                    Opacity="0">
                <Border.RenderTransform>
                    <ScaleTransform ScaleY="0"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsControlBoxOpen}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="True"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- Step selector -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Step:" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="11"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Steps}"
                                  SelectedItem="{Binding SelectedStep}"
                                  DisplayMemberPath="Name"
                                  Background="{StaticResource Brush.Surface.Overlay}"
                                  Foreground="White"
                                  BorderThickness="0"
                                  Padding="6,4">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>

                    <!-- 카메라 설정 유지 — 체크(기본) 시 촬영 때 카메라의 현재 노출/게인 그대로 사용 -->
                    <CheckBox Content="카메라 설정 유지"
                              IsChecked="{Binding Use2DCameraDefault}"
                              Foreground="{StaticResource Brush.Text.Secondary}"
                              FontSize="11" Margin="0,0,0,4"
                              ToolTip="체크(기본)하면 촬영 시 카메라에 저장된 노출/게인을 그대로 사용합니다 — Mech-Eye Viewer 등에서 튜닝한 값이 보존됩니다. 해제하면 아래 슬라이더 값을 촬영 전에 카메라에 적용합니다."/>
                    <TextBlock Text="{Binding CameraCurrentSettingsText}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CameraCurrentSettingsText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Exposure — Mech-Eye Viewer 와 동일한 ms 단위 입력 (200 = 200ms).
                         내부 저장/적용은 µs 유지, UI 만 ms (Scan2DExposureTime 0.1~999ms) -->
                    <Grid Margin="0,0,0,6" IsEnabled="{Binding IsManualExposureEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Exposure:" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ExposureMs, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="6,3"
                                 VerticalAlignment="Center"
                                 ToolTip="노출 시간 (ms) — Mech-Eye Viewer 2D 파라미터의 노출 시간(Scan2DExposureTime, 0.1~999ms)과 동일 단위. 예: 200 = 200ms"/>
                        <TextBlock Grid.Column="2" Text="ms"
                                   Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Gain — 정밀 입력을 위해 TextBox (dB) -->
                    <Grid Margin="0,0,0,8" IsEnabled="{Binding IsManualExposureEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Gain:" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="6,3"
                                 VerticalAlignment="Center"
                                 ToolTip="게인 (dB). Mech-Mind 2D 파라미터의 게인(Scan2DGain)에 해당"/>
                        <TextBlock Grid.Column="2" Text="dB"
                                   Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Action buttons row 1: Grab / Live / Open / Inspect -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding GrabCommand}"
                                Padding="6,4" Margin="0,0,2,0">
                            <!-- Live 중 단발 Grab 은 획득 루프와 충돌 — 비활성 -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveGrabbing}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Grab" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <!-- Live 토글 — 시작/정지는 MainViewModel 이 조정 (AutoRun 상호 배타,
                             전체 활성 카메라 대상 = 기존 사이드 패널 Live 와 동일 동작) -->
                        <Button Grid.Column="1"
                                Command="{Binding DataContext.StartLiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding DataContext.CanOperateCamera, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.IsLiveMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                Style="{StaticResource ModernButton}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="연속 라이브 그랩 시작 (활성 카메라 전체)"
                                Padding="6,4" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                           Foreground="#4CAF50"/>
                                <TextBlock Text="Live" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding DataContext.StopLiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.IsLiveMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource ModernButton}"
                                ToolTip="라이브 영상 표시를 중지합니다"
                                Padding="6,4" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                           Foreground="#FF9800"/>
                                <TextBlock Text="Stop" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding OpenImageCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="6,4" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Open" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding ManualInspectCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="6,4" Margin="2,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Inspect" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Action buttons row 2: Save Parameter / Save 3D / Close -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding SaveSettingsCommand}"
                                Background="#4CAF50"
                                Style="{StaticResource ModernButton}"
                                ToolTip="스텝별 노출/게인 설정을 저장합니다"
                                Padding="6,4" Margin="0,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Save Parameter" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding SavePointCloudCommand}"
                                Style="{StaticResource ModernButton}"
                                ToolTip="Grab한 3D 데이터를 .vpc 파일로 저장합니다 — VisionSetup에서 열 수 있습니다"
                                Padding="6,4" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Save 3D" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding CloseControlBoxCommand}"
                                Background="{StaticResource Brush.Surface.Divider}"
                                Style="{StaticResource ModernButton}"
                                Padding="6,4" Margin="2,0,0,0">
                            <TextBlock Text="Close" FontSize="11"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
