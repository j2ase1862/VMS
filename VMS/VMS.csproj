<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon\Vasim.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 릴리즈(Release) 배포는 self-contained(.NET 런타임 동봉) — 현장 PC에 .NET 설치 불필요.
       AppendRuntimeIdentifierToOutputPath=false 로 출력 경로를 기존과 동일하게 유지
       (VMS 출력으로의 post-build 복사·MSI harvest 경로가 RID 세그먼트를 모름). -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>


  <ItemGroup>
    <Resource Include="icon\Vasim.ico" />
    <Resource Include="icon\Vasim.png" />
    <Resource Include="icon\ci_img2.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.11.0.20250507" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ci.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMS.Camera\VMS.Camera.csproj" />
    <ProjectReference Include="..\VMS.Core\VMS.Core.csproj" />
  </ItemGroup>

  <!-- Build order: VMS.VisionSetup and VMS.AppSetup must build first (post-build copies to this output) -->
  <ItemGroup>
    <ProjectReference Include="..\VMS.VisionSetup\VMS.VisionSetup.csproj" />
    <ProjectReference Include="..\VMS.AppSetup\VMS.AppSetup.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\VMS.Updater\VMS.Updater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\VMS.PLC\VMS.PLC.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 통합 테스트가 internal RecipeService ctor 등에 접근 — 운영 코드는 영향 없음. -->
    <InternalsVisibleTo Include="VMS.Tests" />
  </ItemGroup>


  <ItemGroup>
    <!-- VC++ 런타임 app-local 동봉(tools/vcredist) — OpenCvSharpExtern·NativeVision(OpenMP)·
         onnxruntime 이 요구. 현장 PC에 vc_redist 설치 불필요. -->
    <None Include="../tools/vcredist/x64/*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
